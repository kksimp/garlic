## favicon: the small picture a site names for its tabs. `url_of` finds it
## in the page (`<link rel="icon">`, else `/favicon.ico` at the site's
## root), `decode` turns ICO, PNG, GIF or JPEG bytes into a bitmap for the
## host, and `fetch` does both over the page's connection pool, keeping
## what it learned per icon address so a site is asked once.

use std.net
use std.net.jar
use std.app
use html
use page
use image
use images

## The icon's address for the page `d` at `base`: the first `<link>` whose
## `rel` names an icon, else the site's `/favicon.ico`; "" for a page with
## no site (a file).
pub fn url_of(d html.Doc, base str) str
    mut touch := ""
    for id in d.all("link")
        rel := (d.attr(id, "rel") else continue).to_lower()
        href := d.attr(id, "href") else continue
        if href.trim() == ""
            continue
        words := rel.split(" ")
        if words.contains("icon")
            return page.resolve(base, href)
        if touch == "" and words.contains("apple-touch-icon")
            touch = page.resolve(base, href)
    if touch != ""
        return touch
    s := page.scheme(base)
    if s != "http" and s != "https"
        return ""
    page.resolve(base, "/favicon.ico")

## The icon as the host draws it, or none when the bytes are not a picture
## this module reads.
pub fn decode(raw List[int]) images.Bitmap?
    if raw.len() >= 6 and raw[0] == 0 and raw[1] == 0 and raw[2] == 1 and raw[3] == 0
        return ico(raw)
    px := image.decode(raw) else return none
    images.Bitmap(w: px.width, h: px.height, data: app.bitmap_data(px.bytes()))

fn le16(d List[int], at int) int
    d[at] + d[at + 1] * 256

fn le32(d List[int], at int) int
    le16(d, at) + le16(d, at + 2) * 65536

## An ICO file: the directory entry nearest 32 pixels wide, as PNG or as a
## Windows DIB (1, 4, 8, 24 or 32 bits a pixel, bottom-up, with the 1-bit
## AND mask when the pixels carry no alpha).
fn ico(d List[int]) images.Bitmap?
    n := le16(d, 4)
    mut best := -1
    mut best_w := 0
    for k in 0..n
        at := 6 + k * 16
        if at + 16 > d.len()
            break
        w := if d[at] == 0 then 256 else d[at]
        if best < 0 or (w - 32).abs() < (best_w - 32).abs()
            best = k
            best_w = w
    if best < 0
        return none
    e := 6 + best * 16
    size := le32(d, e + 8)
    off := le32(d, e + 12)
    if off + size > d.len() or size < 40
        return none
    data := [d[off + i] for i in 0..size]
    if data[0] == 0x89 and data[1] == 0x50
        px := image.decode(data) else return none
        return images.Bitmap(w: px.width, h: px.height, data: app.bitmap_data(px.bytes()))
    dib(data)

## Palette entry `i`, black when the palette is short.
fn color_at(pal List[int], i int) int
    if i < pal.len() then pal[i] else 0

## A DIB with a BITMAPINFOHEADER, as ICO entries carry it: height counts
## the XOR and AND masks together.
fn dib(d List[int]) images.Bitmap?
    hdr := le32(d, 0)
    if hdr < 40
        return none
    w := le32(d, 4)
    h := le32(d, 8) / 2
    bpp := le16(d, 14)
    if le32(d, 16) != 0 or w <= 0 or h <= 0 or w > 256 or h > 256
        return none
    mut colors := le32(d, 32)
    if bpp <= 8 and colors == 0
        colors = 1.shl(bpp)
    mut pal := List[int]()
    mut at := hdr
    if bpp <= 8
        for _ in 0..colors
            if at + 4 > d.len()
                return none
            pal.push(d[at + 2].shl(16).bit_or(d[at + 1].shl(8)).bit_or(d[at]))
            at += 4
    row := ((w * bpp + 31) / 32) * 4
    mask_row := ((w + 31) / 32) * 4
    xor := at
    mask := xor + row * h
    if mask + mask_row * h > d.len() and bpp != 32
        return none
    mut px := [0 for _ in 0..w * h]
    mut any_alpha := false
    for y in 0..h
        r := xor + (h - 1 - y) * row
        for x in 0..w
            mut c := 0
            if bpp == 32
                i := r + x * 4
                a := d[i + 3]
                if a != 0
                    any_alpha = true
                c = a.shl(24).bit_or(d[i + 2].shl(16)).bit_or(d[i + 1].shl(8)).bit_or(d[i])
            elif bpp == 24
                i := r + x * 3
                c = 0xff000000 + d[i + 2].shl(16).bit_or(d[i + 1].shl(8)).bit_or(d[i])
            elif bpp == 8
                c = 0xff000000 + color_at(pal, d[r + x])
            elif bpp == 4
                v := d[r + x / 2]
                idx := if x % 2 == 0 then v.shr(4) else v.bit_and(15)
                c = 0xff000000 + color_at(pal, idx)
            elif bpp == 1
                v := d[r + x / 8]
                idx := v.shr(7 - x % 8).bit_and(1)
                c = 0xff000000 + color_at(pal, idx)
            else
                return none
            px[y * w + x] = c
    ## The AND mask makes pixels transparent, unless 32-bit pixels brought
    ## their own alpha.
    if not (bpp == 32 and any_alpha) and mask + mask_row * h <= d.len()
        for y in 0..h
            r := mask + (h - 1 - y) * mask_row
            for x in 0..w
                if d[r + x / 8].shr(7 - x % 8).bit_and(1) == 1
                    px[y * w + x] = px[y * w + x].bit_and(0xffffff)
    images.Bitmap(w: w, h: h, data: app.bitmap_data(image.Rgba(width: w, height: h, px: px).bytes()))

## Fetches the icon for the page `d` at `url` unless `icons` already has
## its address: the decoded icon, or one of zero size when the site has
## none. Returns the address ("" when there is none to show).
pub fn fetch(
    d html.Doc,
    url str,
    cj jar.Jar,
    o net.Options,
    mut icons Map[str, images.Bitmap],
) str
    at := url_of(d, page.base_of(d, url))
    if at == ""
        return ""
    if not icons.contains(at)
        icons[at] = images.Bitmap(w: 0, h: 0, data: "")
        if raw := images.load(at, o, url, cj)
            if bm := decode(raw)
                icons[at] = bm
    if icons[at].w == 0 then "" else at

# ---- Tests -----------------------------------------------------------------

@test fn the_icon_link_wins_over_the_root_favicon()
    d := html.parse("<link rel=\"shortcut icon\" href=\"/i.png\"><p>x")
    assert_eq(url_of(d, "https://a.test/b/c.html"), "https://a.test/i.png")
    assert_eq(url_of(html.parse("<p>x"), "https://a.test/b/c.html"), "https://a.test/favicon.ico")
    assert_eq(url_of(html.parse("<p>x"), "file:///tmp/x.html"), "")
    t := html.parse("<link rel=\"apple-touch-icon\" href=\"t.png\"><link rel=\"icon\" href=\"i.ico\">")
    assert_eq(url_of(t, "https://a.test/"), "https://a.test/i.ico")

## A 2 by 1 ICO with one 32-bit DIB entry: an opaque red pixel and a
## transparent one.
fn tiny_ico() List[int]
    mut d := [0, 0, 1, 0, 1, 0]
    d.extend([2, 1, 0, 0, 1, 0, 32, 0])
    body := 40 + 8 + 4
    d.extend([body, 0, 0, 0, 22, 0, 0, 0])
    d.extend([40, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0, 1, 0, 32, 0])
    d.extend([0 for _ in 0..24])
    d.extend([0, 0, 255, 255, 0, 0, 0, 0])
    d.extend([0, 0, 0, 0])
    d

@test fn a_dib_icon_decodes_with_its_alpha()
    bm := decode(tiny_ico()) else
        assert(false)
        return
    assert_eq((bm.w, bm.h), (2, 1))
    assert_eq(bm.data, app.bitmap_data([255, 0, 0, 255, 0, 0, 0, 0]))
    assert(decode([1, 2, 3]) == none)

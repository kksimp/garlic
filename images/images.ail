## Image sizes for the pixel window (docs/design/garlic-browser.md).
##
## `prefetch` fetches the pictures a page shows, over the same keep-alive
## pool as the page, and keeps each one's pixel size, so `gfx` can reserve
## the room before the host draws the picture. The size comes from the
## header alone (`image.dims`); `image.decode` gives the pixels when a host
## can take them.

use std.net
use std.net.jar
use std.fs
use std.app
use html
use page
use image

## Pictures fetched per page, and the largest one taken.
MAX_IMAGES := 24
MAX_BYTES := 16000000

## A decoded picture for the window host: its pixel size and its `R, G, B, A`
## bytes in base64 (`app.bitmap_data`).
pub struct Bitmap
    pub w int
    pub h int
    pub data str

## Largest picture (in pixels) that is decoded for the host.
MAX_PIXELS := 4000000

## The `[width, height]` of every `<img>` on `d` (by resolved address) that
## isn't in `sizes` yet. An address that can't be fetched or read as an
## image is stored as `[0, 0]` so it isn't asked for again.
pub fn prefetch(
    d html.Doc,
    url str,
    from str,
    cj jar.Jar,
    o net.Options,
    mut sizes Map[str, List[int]],
    mut bits Map[str, Bitmap],
)
    mut n := 0
    for id in d.all("img")
        src := d.attr(id, "src") else continue
        if src.starts_with("data:")
            # A `data:` picture is its own bytes; the URL is its key.
            if sizes.contains(src)
                continue
            raw := data_image(src) else
                sizes[src] = [0, 0]
                continue
            sizes[src] = image.dims(raw)
            if sizes[src][0] * sizes[src][1] <= MAX_PIXELS
                px := image.decode(raw) else continue
                bits[src] = Bitmap(w: px.width, h: px.height, data: app.bitmap_data(px.bytes()))
            continue
        at := page.resolve(url, src)
        if sizes.contains(at)
            continue
        if n == MAX_IMAGES
            break
        n += 1
        raw := load(at, o, from, cj) else
            sizes[at] = [0, 0]
            continue
        sizes[at] = image.dims(raw)
        if sizes[at][0] * sizes[at][1] <= MAX_PIXELS
            px := image.decode(raw) else continue
            bits[at] = Bitmap(w: px.width, h: px.height, data: app.bitmap_data(px.bytes()))
    # A `<canvas>` a script drew on: the engine publishes its bitmap as a
    # `data:` picture in `data-garlic-pixels` (js/vm/canvas2d.ail).
    mut live := Set[str]()
    for id in d.all("canvas")
        src := d.attr(id, "data-garlic-pixels") else continue
        live.add(src)
        add_data_picture(src, mut sizes, mut bits)
    # Each redraw makes a new address; forget the pictures of earlier ones.
    if bits.len() > 48
        for k in bits.keys()
            if k.starts_with(PNG_PREFIX) and not live.contains(k)
                bits.remove(k)
                sizes.remove(k)

PNG_PREFIX := "data:image/png;base64,"

## Decodes the `data:` picture `src` for the host, once.
fn add_data_picture(src str, mut sizes Map[str, List[int]], mut bits Map[str, Bitmap])
    if sizes.contains(src)
        return
    raw := data_image(src) else
        sizes[src] = [0, 0]
        return
    sizes[src] = image.dims(raw)
    if sizes[src][0] * sizes[src][1] <= MAX_PIXELS
        px := image.decode(raw) else return
        bits[src] = Bitmap(w: px.width, h: px.height, data: app.bitmap_data(px.bytes()))

## The bytes of a base64 `data:` image URL (RFC 2397), or none.
pub fn data_image(src str) List[int]?
    comma := src.find(",") else return none
    meta := src.slice(5, comma).to_lower()
    if not meta.ends_with(";base64")
        return none
    payload := src.slice(comma + 1, src.chars().len())
    if payload.chars().len() > MAX_BYTES
        return none
    raw := bytes.from_base64(payload) else return none
    [v.to_int() for v in raw.to_list()]

## The bytes of the picture at `at`, or none.
pub fn load(at str, base net.Options, from str, cj jar.Jar) List[int]?
    s := page.scheme(at)
    if s == "http" or s == "https"
        mut o := base
        cookie := cj.header_from(at, from, false)
        if cookie != ""
            o.headers["cookie"] = cookie
        sent := page.referrer(from, at)
        if sent != ""
            o.headers["referer"] = sent
        r := net.request_bytes("GET", at, o) else return none
        if r.status >= 400 or r.data.len() > MAX_BYTES
            return none
        return [v.to_int() for v in r.data.to_list()]
    raw := fs.read_bytes(page.file_path(at)) else return none
    if raw.len() > MAX_BYTES
        return none
    [v.to_int() for v in raw.to_list()]

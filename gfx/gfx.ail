## The width in pixels of `text` at `size`, in a proportional or (`mono`)
## fixed font.
pub fn text_width(text str, size float, bold bool, mono bool) float
    if mono
        return text.chars().len().to_float() * size * 0.6
    mut units := 0
    for c in text.chars()
        k := c.code()
        units += if k >= 32 and k <= 126 then WIDTHS[k - 32] else 600
    ## The host's sans font is wider than Helvetica, so estimates err a
    ## little wide; lines draw as whole strings, so only wrapping depends on it.
    scale := if bold then 1.1 else 1.06
    units.to_float() * size * scale / 1000.0

fn fmax(a float, b float) float
    if a > b then a else b

fn fmin(a float, b float) float
    if a < b then a else b

# ---- Values ---------------------------------------------------------------

## A length in pixels: `px`, `em`, `rem`, `pt`, `%` (of `rel`) or `0`.
## `none` for `auto`, keywords and anything else.
pub fn length(v str, size float, rel float) float?
    t := v.trim().to_lower()
    if inner := t.strip_prefix("calc(")
        return calc_sum(inner.slice(0, inner.chars().len() - 1), size, rel)
    mut scale := 1.0
    mut num := t
    if r := t.strip_suffix("px")
        num = r
    elif r := t.strip_suffix("rem")
        scale = 16.0
        num = r
    elif r := t.strip_suffix("em")
        scale = size
        num = r
    elif r := t.strip_suffix("pt")
        scale = 4.0 / 3.0
        num = r
    elif r := t.strip_suffix("%")
        scale = rel / 100.0
        num = r
    elif t != "0"
        return none
    x := num.trim().to_float()?
    x * scale

## `a + b - c` of products, as in `calc()` (CSS Values 4): `+` and `-`
## need spaces around them.
fn calc_sum(s str, size float, rel float) float?
    cs := s.chars()
    mut depth := 0
    mut total := 0.0
    mut sign := 1.0
    mut cur := List[char]()
    for k in 0..cs.len()
        ch := cs[k]
        if ch == '('
            depth += 1
        elif ch == ')'
            depth -= 1
        spaced := k > 0 and k + 1 < cs.len() and cs[k - 1] == ' ' and cs[k + 1] == ' '
        if depth == 0 and spaced and (ch == '+' or ch == '-')
            total += sign * calc_prod(cur.join(""), size, rel)?
            sign = 1.0
            if ch == '-'
                sign = -1.0
            cur.clear()
        else
            cur.push(ch)
    total + sign * calc_prod(cur.join(""), size, rel)?

## `a * b / c` of atoms.
fn calc_prod(s str, size float, rel float) float?
    cs := s.chars()
    mut depth := 0
    mut acc := 1.0
    mut times := true
    mut cur := List[char]()
    for ch in cs
        if ch == '('
            depth += 1
        elif ch == ')'
            depth -= 1
        if depth == 0 and (ch == '*' or ch == '/')
            v := calc_atom(cur.join(""), size, rel)?
            acc = if times then acc * v else acc / v
            times = ch == '*'
            cur.clear()
        else
            cur.push(ch)
    v := calc_atom(cur.join(""), size, rel)?
    if times then acc * v else acc / v

## A length, a number or a parenthesised sum.
fn calc_atom(s str, size float, rel float) float?
    t := s.trim()
    if t.starts_with("(") and t.ends_with(")")
        return calc_sum(t.slice(1, t.chars().len() - 1), size, rel)
    if t.starts_with("calc(") and t.ends_with(")")
        return calc_sum(t.slice(5, t.chars().len() - 1), size, rel)
    if v := length(t, size, rel)
        return v
    t.to_float()

NAMED := {
    "black": 0x000000,
    "white": 0xffffff,
    "red": 0xff0000,
    "green": 0x008000,
    "blue": 0x0000ff,
    "gray": 0x808080,
    "grey": 0x808080,
    "silver": 0xc0c0c0,
    "yellow": 0xffff00,
    "orange": 0xffa500,
    "purple": 0x800080,
    "navy": 0x000080,
    "teal": 0x008080,
    "maroon": 0x800000,
    "lime": 0x00ff00,
    "aqua": 0x00ffff,
    "fuchsia": 0xff00ff,
    "olive": 0x808000,
    "pink": 0xffc0cb,
    "brown": 0xa52a2a,
    "gold": 0xffd700,
    "crimson": 0xdc143c,
    "lightgray": 0xd3d3d3,
    "lightgrey": 0xd3d3d3,
    "darkgray": 0xa9a9a9,
    "darkgrey": 0xa9a9a9,
    "whitesmoke": 0xf5f5f5,
    "dimgray": 0x696969,
    "darkblue": 0x00008b,
    "lightblue": 0xadd8e6,
    "skyblue": 0x87ceeb,
    "royalblue": 0x4169e1,
    "tomato": 0xff6347,
    "coral": 0xff7f50,
    "indigo": 0x4b0082,
    "violet": 0xee82ee,
}

fn hex_digit(c char) int?
    c.to_digit(16)

## A color: `#rgb`, `#rrggbb`, `rgb()`, `rgba()` or a name. `none` for
## `transparent`, a nearly invisible `rgba()` and anything unknown.
pub fn color(v str) int?
    color_over(v, 0xffffff)

## A color as `color` reads it, with `rgba()` and `#rrggbbaa` mixed into the
## `under` color it is drawn over.
pub fn color_over(v str, under int) int?
    t := v.trim().to_lower()
    if inner := t.strip_prefix("light-dark(")
        ## The screen is dark (CSS Color 5): take the second color.
        cs := inner.chars()
        mut depth := 0
        for k in 0..cs.len()
            if cs[k] == '('
                depth += 1
            elif cs[k] == ')'
                depth -= 1
            elif cs[k] == ',' and depth == 0
                last := inner.chars().len() - 1
                return color_over(inner.slice(k + 1, last), under)
        return none
    if t.starts_with("#")
        cs := t.chars()
        mut ds := List[int]()
        for k in 1..cs.len()
            ds.push(hex_digit(cs[k])?)
        if ds.len() == 3 or ds.len() == 4
            alpha := if ds.len() == 4 then ds[3].to_float() / 15.0 else 1.0
            return mix(ds[0] * 17, ds[1] * 17, ds[2] * 17, alpha, under)
        if ds.len() == 6 or ds.len() == 8
            alpha := if ds.len() == 8 then (ds[6] * 16 + ds[7]).to_float() / 255.0 else 1.0
            return mix(ds[0] * 16 + ds[1], ds[2] * 16 + ds[3], ds[4] * 16 + ds[5], alpha, under)
        return none
    if t.starts_with("rgb")
        open := t.find("(")?
        close := t.find(")")?
        inner := t.slice(open + 1, close).replace("/", ",").replace(" ", ",")
        mut parts := List[float]()
        for p in inner.split(",")
            q := p.trim()
            if q == ""
                continue
            if r := q.strip_suffix("%")
                parts.push((r.to_float()? * 2.55))
            else
                parts.push(q.to_float()?)
        if parts.len() < 3
            return none
        mut alpha := 1.0
        if parts.len() > 3
            alpha = parts[3]
            if inner.contains("%") and alpha > 1.0
                alpha = alpha / 100.0
        r := fmin(fmax(parts[0], 0.0), 255.0).to_int()
        g := fmin(fmax(parts[1], 0.0), 255.0).to_int()
        b := fmin(fmax(parts[2], 0.0), 255.0).to_int()
        return mix(r, g, b, alpha, under)
    NAMED.get(t)

## Channels `r`, `g`, `b` at opacity `alpha` over `under`; none when clear.
fn mix(r int, g int, b int, alpha float, under int) int?
    if alpha < 0.02
        return none
    a := fmin(alpha, 1.0)
    ur := under / 65536
    ug := under / 256 % 256
    ub := under % 256
    nr := (r.to_float() * a + ur.to_float() * (1.0 - a)).round().to_int()
    ng := (g.to_float() * a + ug.to_float() * (1.0 - a)).round().to_int()
    nb := (b.to_float() * a + ub.to_float() * (1.0 - a)).round().to_int()
    nr * 65536 + ng * 256 + nb

## Splits `v` at spaces that are not inside parentheses.
fn tokens(v str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    mut depth := 0
    for c in v.chars()
        if c == '('
            depth += 1
        elif c == ')'
            depth -= 1
        if c == ' ' and depth == 0
            if cur.len() > 0
                out.push(cur.join(""))
                cur = []
        else
            cur.push(c)
    if cur.len() > 0
        out.push(cur.join(""))
    out

## One to four lengths as (top, right, bottom, left), and whether the
## left and right are `auto`.
fn sides(v str, size float, rel float)(float, float, float, float, bool, bool)
    ts := tokens(v)
    mut vals := List[float]()
    mut autos := List[bool]()
    for t in ts
        autos.push(t == "auto")
        vals.push(length(t, size, rel) else 0.0)
    if vals.len() == 0
        return (0.0, 0.0, 0.0, 0.0, false, false)
    if vals.len() == 1
        return (vals[0], vals[0], vals[0], vals[0], autos[0], autos[0])
    if vals.len() == 2
        return (vals[0], vals[1], vals[0], vals[1], autos[1], autos[1])
    if vals.len() == 3
        return (vals[0], vals[1], vals[2], vals[1], autos[1], autos[1])
    (vals[0], vals[1], vals[2], vals[3], autos[3], autos[1])

# ---- Styles ---------------------------------------------------------------

## The inherited text style.
struct St
    color int
    size float
    bold bool
    italic bool
    underline bool
    mono bool
    serif bool
    pre bool
    align str
    lh float
    href str
    ## The node of the link this text is in, or -1.
    node int
    upper bool
    nowrap bool
    ## A link's `aria-label` or `title`: what its icon-only content says.
    alt str
    ## The background colour text and boxes are drawn over, for `rgba()`.
    under int

## A block's own box: margins, borders, padding, background and width.
struct Bx
    bg int?
    mt float
    mr float
    mb float
    ml float
    pt float
    pr float
    pb float
    pl float
    bt float
    br float
    bb float
    bl float
    bcolor int
    width float?
    max_width float?
    height float?
    ## `border-radius` in pixels (negative: a percentage of the smaller side).
    radius float
    ## `position` ("" for static), its offsets, and `float`.
    pos str
    top float?
    right float?
    left float?
    float_side str
    bottom float?
    ml_auto bool
    mr_auto bool

fn Bx.boxed(self) bool
    bg != none or bt > 0.0 or br > 0.0 or bb > 0.0 or bl > 0.0

fn Bx.padded(self) bool
    pt > 0.0 or pb > 0.0 or bt > 0.0 or bb > 0.0

## A column at least this wide is `max_content`'s measuring column.
SHRINK_W := 50000.0
LINK := 0x0000ee
INK := 0x000000
RULE := 0x9a9a9a

## `border` and `border-*` values: width (default 3px for a named style)
## and color.
fn border_part(v str, size float, ink int, under int)(float, int)
    mut w := 3.0
    mut c := ink
    mut shown := true
    for t in tokens(v)
        if t == "none" or t == "hidden"
            shown = false
        elif x := length(t, size, 0.0)
            w = x
        elif t == "thin"
            w = 1.0
        elif t == "medium"
            w = 3.0
        elif t == "thick"
            w = 5.0
        elif k := color_over(t, under)
            c = k
        elif t == "transparent"
            shown = false
    (if shown then w else 0.0, c)

## The font-size keywords and their sizes in pixels.
fn size_keyword(v str) float?
    match v
        "xx-small" => 9.0
        "x-small" => 10.0
        "small" | "smaller" => 13.0
        "medium" => 16.0
        "large" | "larger" => 18.0
        "x-large" => 24.0
        "xx-large" => 32.0
        _ => none

HEADING_SIZE := {"h1": 2.0, "h2": 1.5, "h3": 1.17, "h4": 1.0, "h5": 0.83, "h6": 0.67}

## The first color stop of a `linear-gradient(...)` in `v`.
fn gradient_first(v str) int?
    at := v.find("gradient(")?
    inner := v.slice(at, v.chars().len())
    if i := inner.find("#")
        for n in [7, 4]
            if k := color(inner.slice(i, i + n))
                return k
    if i := inner.find("rgb")
        close := inner.slice(i, inner.chars().len()).find(")")?
        return color(inner.slice(i, i + close + 1))
    none

## The style of text inside element `tag` with the cascaded values `cs`,
## given its parent's.
fn text_style(tag str, cs Map[str, str], parent St) St
    mut st := parent
    if m := HEADING_SIZE.get(tag)
        st.size = parent.size * m
        st.bold = true
    match tag
        "b" | "strong" | "th" => st.bold = true
        "i" | "em" | "cite" | "var" | "dfn" => st.italic = true
        "code" | "kbd" | "samp" | "tt" =>
            st.mono = true
            st.size = parent.size * 0.9
        "pre" =>
            st.mono = true
            st.pre = true
            st.size = parent.size * 0.9
        "small" | "sub" | "sup" => st.size = parent.size * 0.83
        "big" => st.size = parent.size * 1.17
        "a" =>
            if h := cs.get("href")
                st.href = h
                st.node = (cs.get("node") else "-1").to_int() else -1
            st.alt = cs.get("alt-label") else ""
        "u" | "ins" => st.underline = true
        "s" | "del" | "strike" => st.underline = st.underline
        _ => st.bold = st.bold
    if tag == "a"
        st.underline = true
        st.color = if st.color == 0xe8e8e8 then 0x9e9eff else LINK
    if fs := cs.get("font-size")
        if k := size_keyword(fs.trim())
            st.size = k
        elif x := length(fs, parent.size, parent.size)
            st.size = x
    if w := cs.get("font-weight")
        st.bold = w == "bold"
            or w == "bolder"
            or w == "600"
            or w == "700"
            or w == "800"
            or w == "900"
    if s := cs.get("font-style")
        st.italic = s == "italic" or s == "oblique"
    if c := cs.get("color")
        if c.trim() == "inherit"
            st.color = parent.color
        elif k := color_over(c, parent.under)
            st.color = k
    if fill := cs.get("-webkit-text-fill-color")
        if fill.trim() == "transparent"
            ## `background-clip: text` over a gradient: the first stop.
            if g := gradient_first(cs.get("background") else (cs.get("background-image") else ""))
                st.color = g
        elif k := color_over(fill, parent.under)
            st.color = k
    if td := cs.get("text-decoration")
        st.underline = td.contains("underline")
    if a := cs.get("text-align")
        st.align = a.trim()
    if l := cs.get("line-height")
        t := l.trim()
        if x := t.to_float()
            st.lh = x
        elif p := length(t, st.size, st.size)
            st.lh = p / st.size
    if ff := cs.get("font-family")
        low := ff.to_lower()
        if low.contains("mono") or low.contains("courier") or low.contains("consolas")
            st.mono = true
        else
            st.serif = first_family_is_serif(low)
    if tt := cs.get("text-transform")
        st.upper = tt == "uppercase"
    if ws := cs.get("white-space")
        st.pre = ws == "pre" or ws == "pre-wrap" or ws == "pre-line"
        st.nowrap = ws == "nowrap"
    st

## The box of element `id`, from its tag defaults and cascaded values.
fn box_of(tag str, cs Map[str, str], st St, avail float) Bx
    mut b := Bx(
        bg: none,
        mt: 0.0,
        mr: 0.0,
        mb: 0.0,
        ml: 0.0,
        pt: 0.0,
        pr: 0.0,
        pb: 0.0,
        pl: 0.0,
        bt: 0.0,
        br: 0.0,
        bb: 0.0,
        bl: 0.0,
        bcolor: st.color,
        width: none,
        max_width: none,
        height: none,
        radius: 0.0,
        pos: "",
        top: none,
        right: none,
        left: none,
        float_side: "",
        bottom: none,
        ml_auto: false,
        mr_auto: false,
    )
    size := st.size
    match tag
        "p" | "ul" | "ol" | "dl" | "pre" | "figure" =>
            b.mt = size
            b.mb = size
        "blockquote" =>
            b.mt = size
            b.mb = size
            b.ml = 40.0
            b.mr = 40.0
        "h1" =>
            b.mt = size * 0.67
            b.mb = size * 0.67
        "h2" =>
            b.mt = size * 0.83
            b.mb = size * 0.83
        "h3" | "h5" | "h6" =>
            b.mt = size
            b.mb = size
        "h4" =>
            b.mt = size * 1.33
            b.mb = size * 1.33
        "dd" => b.ml = 40.0
        "hr" =>
            b.mt = 8.0
            b.mb = 8.0
        "table" => b.mt = 0.0
        "td" | "th" =>
            b.pt = 1.0
            b.pb = 1.0
            b.pl = 1.0
            b.pr = 1.0
        _ => b.mt = 0.0
    if tag == "ul" or tag == "ol" or tag == "menu"
        b.pl = 40.0
    if tag == "body"
        b.mt = 8.0
        b.mb = 8.0
        b.ml = 8.0
        b.mr = 8.0
    if v := cs.get("margin")
        m := sides(v, size, avail)
        b.mt = m.0
        b.mr = m.1
        b.mb = m.2
        b.ml = m.3
        b.ml_auto = m.4
        b.mr_auto = m.5
    if v := cs.get("margin-top")
        b.mt = length(v, size, avail) else b.mt
    if v := cs.get("margin-bottom")
        b.mb = length(v, size, avail) else b.mb
    for name in ["margin-left", "margin-inline-start", "margin-inline"]
        if v := cs.get(name)
            if v.trim() == "auto"
                b.ml_auto = true
            else
                b.ml = length(v, size, avail) else b.ml
    for name in ["margin-right", "margin-inline-end", "margin-inline"]
        if v := cs.get(name)
            if v.trim() == "auto"
                b.mr_auto = true
            else
                b.mr = length(v, size, avail) else b.mr
    if v := cs.get("padding")
        p := sides(v, size, avail)
        b.pt = p.0
        b.pr = p.1
        b.pb = p.2
        b.pl = p.3
    if v := cs.get("padding-top")
        b.pt = length(v, size, avail) else b.pt
    if v := cs.get("padding-bottom")
        b.pb = length(v, size, avail) else b.pb
    for name in ["padding-left", "padding-inline-start", "padding-inline"]
        if v := cs.get(name)
            b.pl = length(v, size, avail) else b.pl
    for name in ["padding-right", "padding-inline-end", "padding-inline"]
        if v := cs.get(name)
            b.pr = length(v, size, avail) else b.pr
    if v := cs.get("border")
        p := border_part(v, size, st.color, st.under)
        b.bt = p.0
        b.br = p.0
        b.bb = p.0
        b.bl = p.0
        b.bcolor = p.1
    if v := cs.get("border-width")
        m := sides(v, size, avail)
        b.bt = m.0
        b.br = m.1
        b.bb = m.2
        b.bl = m.3
    if v := cs.get("border-color")
        b.bcolor = color_over(v, st.under) else b.bcolor
    if v := cs.get("border-top")
        p := border_part(v, size, st.color, st.under)
        b.bt = p.0
        b.bcolor = p.1
    if v := cs.get("border-bottom")
        p := border_part(v, size, st.color, st.under)
        b.bb = p.0
        b.bcolor = p.1
    if v := cs.get("border-left")
        p := border_part(v, size, st.color, st.under)
        b.bl = p.0
        b.bcolor = p.1
    if v := cs.get("border-right")
        p := border_part(v, size, st.color, st.under)
        b.br = p.0
        b.bcolor = p.1
    if v := cs.get("background-color")
        b.bg = color_over(v, st.under)
    if v := cs.get("background")
        for t in tokens(v)
            if k := color_over(t, st.under)
                b.bg = k
        if b.bg == none
            b.bg = gradient_first(v)
    clip := cs.get("background-clip") else (cs.get("-webkit-background-clip") else "")
    if clip.trim() == "text"
        b.bg = none
    ## Measuring (avail >= SHRINK_W): a percentage of the huge column means nothing.
    if v := cs.get("width")
        if not (avail >= SHRINK_W and v.trim().ends_with("%"))
            b.width = length(v, size, avail)
    if v := cs.get("max-width")
        if not (avail >= SHRINK_W and v.trim().ends_with("%"))
            b.max_width = length(v, size, avail)
    if v := cs.get("border-radius")
        ts := tokens(v)
        if ts.len() > 0
            if p := ts[0].strip_suffix("%")
                b.radius = 0.0 - (p.to_float() else 0.0)
            else
                b.radius = length(ts[0], size, avail) else 0.0
    if v := cs.get("position")
        b.pos = v.trim()
    if v := cs.get("top")
        b.top = length(v, size, avail)
    if v := cs.get("right")
        b.right = length(v, size, avail)
    if v := cs.get("left")
        b.left = length(v, size, avail)
    if v := cs.get("bottom")
        b.bottom = length(v, size, avail)
    if v := cs.get("float")
        b.float_side = v.trim()
    if v := cs.get("height")
        b.height = length(v, size, 0.0)
    if v := cs.get("min-height")
        if m := length(v, size, 0.0)
            b.height = m
    b

# ---- Layout ---------------------------------------------------------------

## `v` with each `var(--x)` and `var(--x, fallback)` replaced from `vars`.
fn subst(v str, vars Map[str, str]) str
    mut out := v
    mut guard := 0
    while guard < 16
        guard += 1
        at := out.find("var(") else break
        cs := out.chars()
        mut depth := 1
        mut k := at + 4
        mut comma := -1
        while k < cs.len() and depth > 0
            if cs[k] == '('
                depth += 1
            elif cs[k] == ')'
                depth -= 1
            elif cs[k] == ',' and depth == 1 and comma < 0
                comma = k
            k += 1
        if depth != 0
            break
        close := k - 1
        stop := if comma >= 0 then comma else close
        name := out.slice(at + 4, stop).trim()
        fallback := if comma >= 0 then out.slice(comma + 1, close).trim() else ""
        val := vars.get(name) else fallback
        out = "{out.slice(0, at)}{val}{out.slice(close + 1, cs.len())}"
    out

## `color` over the rounded rectangle (`x`, `y`, `w`, `h`) with corners of
## radius `r`: a few strips, since the host fills only rectangles.
fn rounded(x float, y float, w float, h float, r float, fill int) List[draw.Op]
    rr := fmin(r, fmin(w, h) / 2.0)
    if rr < 1.0
        return [draw.Op.Rect(x, y, w, h, fill)]
    step := if rr > 8.0 then 2.0 else 1.0
    mut out := List[draw.Op]()
    out.push(draw.Op.Rect(x: x, y: y + rr, w: w, h: h - 2.0 * rr, color: fill))
    mut i := 0.0
    while i < rr
        mid := rr - i - step / 2.0
        inset := rr - (rr * rr - mid * mid).pow(0.5)
        out.push(draw.Op.Rect(x: x + inset, y: y + i, w: w - 2.0 * inset, h: step, color: fill))
        out.push(draw.Op.Rect(
            x: x + inset,
            y: y + h - i - step,
            w: w - 2.0 * inset,
            h: step,
            color: fill,
        ))
        i += step
    out

## One piece of an inline run: a word, a space, a line break, an image or
## a form control.
struct Atom
    kind int
    text str
    w float
    h float
    size float
    st St
    src str
    ## The look of a control: fill, edge and text colors.
    fill int
    edge int
    ## The form control's node, -1 if none.
    node int

WORD := 0
SPACE := 1
BREAK := 2
IMAGE := 3
CONTROL := 4

## A float's box, which text beside it wraps around.
struct Float
    x float
    y float
    w float
    h float
    right bool

struct Ctx
    d html.Doc
    svgs Map[str, images.Bitmap]
    sheet css.Sheet
    url str
    ops List[draw.Op]
    hits List[Hit]
    atoms List[Atom]
    ## The next line starts here, and the margin still owed above it.
    y float
    pend float
    ## The list marker waiting for its first line, and its right edge.
    marker str
    marker_x float
    canvas int
    ## Cascaded styles, custom properties in scope and raw cascades by node.
    styles Map[int, Map[str, str]]
    scopes Map[int, Map[str, str]]
    cascades Map[int, Map[str, str]]
    ## Widest-line widths of nodes, by node.
    contents Map[int, float]
    ## The text field being typed into, drawn with a caret; -1 for none.
    editing int
    ## Each picture's `[width, height]` by address, once fetched.
    pics Map[str, List[int]]
    ## Widths the host measured, by `probe_key`, and the runs still estimated.
    meas Map[str, float]
    probes List[Probe]
    probed Set[str]
    ## Floats in force, the positioned ancestor's padding box, and the
    ## column being filled.
    floats List[Float]
    ax float
    ay float
    aw float
    page_w float
    col_x float
    col_w float

CONTROLS := {"button", "input", "select", "textarea"}
FLOW_FLEX := {"flex", "inline-flex"}

fn Ctx.visible(mut self, id int) bool
    n := d.nodes[id]
    n.kind == Element and not page.HIDDEN.contains(n.tag) and d.attr(id, "hidden") == none

fn Ctx.element_style(mut self, id int) Map[str, str]
    if d.nodes[id].tag == "#document"
        return Map[str, str]()
    if cached := styles.get(id)
        return cached
    r := self.cascaded(id)
    sc := self.scope(id)
    mut out := Map[str, str]()
    for k in r.keys()
        if not k.starts_with("--")
            out[k] = subst(r[k], sc)
    styles[id] = out
    out

fn Ctx.cascaded(mut self, id int) Map[str, str]
    if cached := cascades.get(id)
        return cached
    r := css.cascade(d, id, sheet)
    cascades[id] = r
    r

## The custom properties in scope at node `id`: its parent's, then its own.
fn Ctx.scope(mut self, id int) Map[str, str]
    if cached := scopes.get(id)
        return cached
    parent := d.nodes[id].parent
    mut m := Map[str, str]()
    if id != 0
        m = self.scope(parent)
    if d.nodes[id].kind == Element
        r := self.cascaded(id)
        for k in r.keys()
            if k.starts_with("--")
                m[k] = subst(r[k], m)
    scopes[id] = m
    m

fn Ctx.is_block(mut self, id int, cs Map[str, str]) bool
    tag := d.nodes[id].tag
    display := cs.get("display") else ""
    if display == "none"
        return false
    if display == ""
        return page.BLOCKS.contains(tag) or tag == "li" or tag == "tr" or tag == "td" or tag == "th"
    display.starts_with("inline") == false

## Moves the pending margin into the flow.
fn Ctx.settle(mut self)
    y += pend
    pend = 0.0

## `cs` plus what the attributes of `a` elements add: the resolved target
## and the label.
fn Ctx.with_attrs(mut self, id int, tag str, cs Map[str, str]) Map[str, str]
    mut out := cs
    if tag == "a"
        if h := d.attr(id, "href")
            out["href"] = page.resolve(url, h)
        out["node"] = "{id}"
        out["alt-label"] = d.attr(id, "aria-label") else (d.attr(id, "title") else "")
    out

fn Ctx.add_text(mut self, raw str, st St)
    mut text := raw
    if st.upper
        text = text.to_upper()
    if st.pre
        lines := text.replace("\r", "").split("\n")
        for k in 0..lines.len()
            if k > 0
                atoms.push(self.break_atom(st))
            if lines[k] != ""
                atoms.push(self.word_atom(lines[k], st))
        return
    mut cur := List[char]()
    mut gap := false
    for c in text.chars()
        if c == ' ' or c == '\n' or c == '\t' or c == '\r'
            if cur.len() > 0
                atoms.push(self.word_atom(cur.join(""), st))
                cur = []
            gap = true
            if atoms.len() == 0 or atoms[atoms.len() - 1].kind != SPACE
                atoms.push(self.space_atom(st))
        else
            cur.push(c)
    if cur.len() > 0
        atoms.push(self.word_atom(cur.join(""), st))

## The width of a run: the host's measure when there is one, else the
## estimate, which is then noted so the host can be asked.
fn Ctx.tw(mut self, text str, size float, bold bool, italic bool, font str) float
    key := probe_key(text, size, bold, italic, font)
    if w := meas.get(key)
        return w
    if text != "" and not probed.contains(key)
        probed.add(key)
        probes.push(Probe(text, size, bold, italic, font))
    text_width(text, size, bold, font == "mono")

fn Ctx.word_atom(mut self, text str, st St) Atom
    Atom(
        kind: WORD,
        text,
        w: tw(text, st.size, st.bold, st.italic, font_of(st)),
        h: st.size * st.lh,
        size: st.size,
        st,
        src: "",
        fill: 0,
        edge: 0,
        node: -1,
    )

fn Ctx.space_atom(mut self, st St) Atom
    Atom(
        kind: SPACE,
        text: " ",
        w: tw(" ", st.size, st.bold, st.italic, font_of(st)),
        h: st.size * st.lh,
        size: st.size,
        st,
        src: "",
        fill: 0,
        edge: 0,
        node: -1,
    )

fn Ctx.break_atom(mut self, st St) Atom
    Atom(
        kind: BREAK,
        text: "",
        w: 0.0,
        h: st.size * st.lh,
        size: st.size,
        st,
        src: "",
        fill: 0,
        edge: 0,
        node: -1,
    )

## Lays out the pending inline atoms as lines in the column from `x`, `w`
## wide.
fn Ctx.flush(mut self, x float, w float, align0 str)
    if atoms.len() == 0
        return
    ## In the very wide column `max_content` measures in, nothing is centred
    ## or pushed right: the extent would be the column's.
    align := if w >= SHRINK_W then "left" else align0
    mut line := List[Atom]()
    mut lw := 0.0
    mut lx := x
    mut room := w
    mut pending := atoms
    atoms = []
    for a in pending
        if a.kind == BREAK
            self.emit(line, lx, room, align, a.h)
            line = []
            lw = 0.0
        elif a.kind == SPACE
            if line.len() > 0 and line[line.len() - 1].kind != SPACE
                line.push(a)
                lw += a.w
        else
            if line.len() == 0
                beside := self.avail(x, w, y + pend, y + pend + a.h)
                lx = beside.0
                room = beside.1
            if lw + a.w > room + 0.5 and not a.st.nowrap and not a.st.pre
                if self.has_content(line)
                    self.emit(line, lx, room, align, 0.0)
                    line = []
                    lw = 0.0
                    beside := self.avail(x, w, y + pend, y + pend + a.h)
                    lx = beside.0
                    room = beside.1
            line.push(a)
            lw += a.w
    if self.has_content(line)
        self.emit(line, lx, room, align, 0.0)

## The part of the column from `x`, `w` wide that floats leave free between
## `top` and `bottom`, as (left edge, width).
fn Ctx.avail(self, x float, w float, top float, bottom float)(float, float)
    mut left := x
    mut right := x + w
    for f in floats
        if f.y < bottom and f.y + f.h > top
            if f.right
                right = fmin(right, f.x)
            else
                left = fmax(left, f.x + f.w)
    (left, fmax(right - left, 40.0))

## The host font family a style is drawn in.
fn font_of(st St) str
    if st.mono
        return "mono"
    if st.serif then "serif" else "sans"

## Faces and generics that decide a `font-family` list.
SANS_FACES := [
    "sans-serif",
    "system-ui",
    "-apple-system",
    "arial",
    "helvetica",
    "verdana",
    "tahoma",
    "roboto",
    "segoe ui",
    "inter",
]

SERIF_FACES := [
    "serif",
    "georgia",
    "times",
    "times new roman",
    "garamond",
    "palatino",
    "cambria",
    "book antiqua",
    "baskerville",
]

## Whether the first family in a lower-cased `font-family` list that names a
## known face or generic is a serif one (`Georgia, serif`, not `Arial, serif`).
fn first_family_is_serif(low str) bool
    for part in low.split(",")
        name := part.replace("'", "").replace("\"", "").trim()
        if SANS_FACES.contains(name)
            return false
        if SERIF_FACES.contains(name)
            return true
    false

fn same_look(a St, b St) bool
    a.color == b.color
        and a.bold == b.bold
        and a.italic == b.italic
        and a.underline == b.underline
        and a.mono == b.mono
        and a.serif == b.serif
        and a.href == b.href

fn Ctx.has_content(mut self, line List[Atom]) bool
    for a in line
        if a.kind != SPACE
            return true
    false

## How far atom `a` rises above its line's baseline: a picture sits on it,
## text and controls are centred on the text's middle.
fn atom_asc(a Atom) float
    if a.kind == IMAGE
        return a.h
    (a.h - a.size) / 2.0 + a.size * 0.9

## Draws one line of atoms at `y`; `empty` is the height of an empty
## line (a `<br>`).
fn Ctx.emit(mut self, atoms_in List[Atom], x float, w float, align str, empty float)
    mut line := atoms_in
    while line.len() > 0 and line[line.len() - 1].kind == SPACE
        line.pop()
    if line.len() == 0
        settle()
        y += empty
        return
    settle()
    mut total := 0.0
    mut asc := 0.0
    mut desc := 0.0
    for a in line
        total += a.w
        a_asc := atom_asc(a)
        asc = fmax(asc, a_asc)
        desc = fmax(desc, a.h - a_asc)
    mut cx := x
    if align == "center"
        cx = x + fmax((w - total) / 2.0, 0.0)
    elif align == "right" or align == "end"
        cx = x + fmax(w - total, 0.0)
    if marker != ""
        first := line[0]
        mw := tw(marker, first.size, false, false, "sans")
        ops.push(draw.Op.Str(
            x: marker_x - mw,
            y: y + asc - atom_asc(first),
            text: marker,
            font: "sans",
            size: first.size,
            fg: first.st.color,
            bold: false,
            italic: false,
            underline: false,
        ))
        marker = ""
    mut k := 0
    while k < line.len()
        a := line[k]
        a_asc := atom_asc(a)
        top := y + asc - a_asc
        ## Neighbouring words in one style are drawn as one string, so the
        ## host spaces them itself; only the estimate places the string.
        if a.kind == WORD or a.kind == SPACE
            mut text := a.text
            mut run_w := a.w
            mut j := k + 1
            while j < line.len() and (line[j].kind == WORD or line[j].kind == SPACE) and same_look(
                line[j].st,
                a.st,
            ) and line[j].size == a.size
                text = "{text}{line[j].text}"
                run_w += line[j].w
                j += 1
            if text.trim() != ""
                ops.push(draw.Op.Str(
                    x: cx,
                    y: top,
                    text: text.trim_end(),
                    font: font_of(a.st),
                    size: a.size,
                    fg: a.st.color,
                    bold: a.st.bold,
                    italic: a.st.italic,
                    underline: a.st.underline,
                ))
                if a.st.href != ""
                    hits.push(Hit(
                        x: cx,
                        y: top,
                        w: run_w,
                        h: a.h,
                        href: a.st.href,
                        node: -1,
                        anchor: a.st.node,
                    ))
            cx += run_w
            k = j
            continue
        elif a.kind == IMAGE
            ops.push(draw.Op.Pic(x: cx, y: y + asc - a.h, w: a.w, h: a.h, src: a.src))
            if a.st.href != ""
                hits.push(Hit(
                    x: cx,
                    y: y + asc - a.h,
                    w: a.w,
                    h: a.h,
                    href: a.st.href,
                    node: -1,
                    anchor: a.st.node,
                ))
        elif a.kind == CONTROL
            cy := y + asc - a.h * 0.8
            hits.push(Hit(x: cx, y: cy, w: a.w, h: a.h, href: "", node: a.node, anchor: -1))
            ops.push(draw.Op.Rect(x: cx, y: cy, w: a.w, h: a.h, color: a.edge))
            ops.push(draw.Op.Rect(
                x: cx + 1.0,
                y: cy + 1.0,
                w: a.w - 2.0,
                h: a.h - 2.0,
                color: a.fill,
            ))
            ops.push(draw.Op.Str(
                x: cx + 6.0,
                y: cy + (a.h - a.size) / 2.0 - 1.0,
                text: a.text,
                font: "sans",
                size: a.size,
                fg: a.st.color,
                bold: false,
                italic: false,
                underline: false,
            ))
        cx += a.w
        k += 1
    y += asc + desc
    pend = 0.0

fn Ctx.image_atom(mut self, id int, cs Map[str, str], st St, avail float) Atom?
    src := d.attr(id, "src")?
    mut w := (d.attr(id, "width") else "0").to_float() else 0.0
    mut h := (d.attr(id, "height") else "0").to_float() else 0.0
    if v := cs.get("width")
        w = length(v, st.size, avail) else w
    if v := cs.get("height")
        h = length(v, st.size, avail) else h
    ## A missing side comes from the picture's own size, keeping its shape.
    if w <= 0.0 or h <= 0.0
        nat := pics.get(page.resolve(url, src)) else [0, 0]
        if nat[0] <= 0 or nat[1] <= 0
            return none
        nw := nat[0].to_float()
        nh := nat[1].to_float()
        if w > 0.0
            h = w * nh / nw
        elif h > 0.0
            w = h * nw / nh
        else
            w = nw
            h = nh
    mut iw := w
    mut ih := h
    if iw > avail
        ih = ih * avail / iw
        iw = avail
    Atom(
        kind: IMAGE,
        text: "",
        w: iw,
        h: ih,
        size: st.size,
        st,
        src: page.resolve(url, src),
        fill: 0,
        edge: 0,
        node: -1,
    )

fn Ctx.control_atom(mut self, id int, st St) Atom?
    tag := d.nodes[id].tag
    kind := d.attr(id, "type") else "text"
    if tag == "input" and (kind == "hidden")
        return none
    mut label := ""
    mut w := 160.0
    mut fill := 0xffffff
    mut ink := st
    if tag == "button" or kind == "submit" or kind == "button" or kind == "reset"
        label = if tag
            == "button" then d.visible_text(id).trim() else (d.attr(id, "value") else "Submit")
        w = tw(label, st.size, false, false, "sans") + 20.0
        fill = 0xefefef
    elif tag == "input" and (kind == "checkbox" or kind == "radio")
        label = if d.attr(id, "checked") != none then "x" else ""
        w = st.size + 2.0
    elif tag == "select"
        label = ""
        mut chosen := false
        for o in d.all("option")
            if d.within(o, id) and (label == "" or (not chosen and d.attr(o, "selected") != none))
                label = d.text(o).trim()
                chosen = d.attr(o, "selected") != none
        w = fmax(tw(label, st.size, false, false, "sans") + 30.0, 80.0)
    else
        label = d.attr(id, "value") else ""
        if label == "" and tag == "textarea"
            label = d.text(id).trim()
        if label == ""
            label = d.attr(id, "placeholder") else ""
            ink.color = 0x8a8a8a
    mut edge := 0x767676
    if id == editing
        typed := d.attr(id, "value") else (if tag == "textarea" then d.text(id) else "")
        label = "{typed}|"
        ink.color = st.color
        edge = 0x0a84ff
    Atom(
        kind: CONTROL,
        text: label,
        w,
        h: st.size * 1.6,
        size: st.size,
        st: ink,
        src: "",
        fill,
        edge,
        node: id,
    )

## An inline `<svg>` as a picture atom: its size from `width`/`height` (the
## attribute or the style), else its `viewBox`, else 24 points; none when
## it draws nothing.
fn Ctx.svg_atom(mut self, id int, cs Map[str, str], st St, avail float) Atom?
    mut w := (d.attr(id, "width") else "0").replace("px", "").to_float() else 0.0
    mut h := (d.attr(id, "height") else "0").replace("px", "").to_float() else 0.0
    if v := cs.get("width")
        w = length(v, st.size, avail) else w
    if v := cs.get("height")
        h = length(v, st.size, avail) else h
    if w <= 0.0 or h <= 0.0
        vb := d.attr(id, "viewBox") else ""
        parts := [p for p in vb.replace(",", " ").split(" ") if p != ""]
        vw := if parts.len() == 4 then (parts[2].to_float() else 24.0) else 24.0
        vh := if parts.len() == 4 then (parts[3].to_float() else 24.0) else 24.0
        if w > 0.0
            h = w * vh / vw
        elif h > 0.0
            w = h * vw / vh
        else
            w = vw
            h = vh
    w = w.min(avail)
    key := "svg:{id}:{w.round().to_int()}x{h.round().to_int()}:{st.color.to_hex()}"
    if not svgs.contains(key)
        bm := svg.render(d, id, w.round().to_int().max(1), h.round().to_int().max(1), st.color) else
            return none
        svgs[key] = bm
    Atom(kind: IMAGE, text: "", w, h, size: st.size, st, src: key, fill: 0, edge: 0, node: -1)

## Adds element `id`'s inline content to the pending atoms.
fn Ctx.inline(mut self, id int, parent St, avail float)
    n := d.nodes[id]
    if n.kind == Text
        add_text(n.text, parent)
        return
    if n.kind != Element or not visible(id)
        return
    cs := element_style(id)
    if (cs.get("display") else "") == "none" or (cs.get("visibility") else "") == "hidden"
        return
    tag := n.tag
    ecs := self.with_attrs(id, tag, cs)
    st := text_style(tag, ecs, parent)
    if tag == "svg"
        if a := self.svg_atom(id, cs, st, avail)
            atoms.push(a)
        elif parent.alt != ""
            add_text(parent.alt, parent)
        return
    if tag == "br"
        atoms.push(self.break_atom(st))
        return
    if tag == "img"
        side := (cs.get("float") else (d.attr(id, "align") else "")).trim()
        if a := self.image_atom(id, cs, st, avail)
            if side == "left" or side == "right"
                flush(col_x, col_w, parent.align)
                settle()
                fx := if side == "right" then col_x + col_w - a.w else col_x
                ops.push(draw.Op.Pic(x: fx, y: y, w: a.w, h: a.h, src: a.src))
                if st.href != ""
                    hits.push(Hit(
                        x: fx,
                        y: y,
                        w: a.w,
                        h: a.h,
                        href: st.href,
                        node: -1,
                        anchor: st.node,
                    ))
                floats.push(Float(
                    x: if side == "right" then fx - 8.0 else fx,
                    y: y,
                    w: a.w + 8.0,
                    h: a.h + 4.0,
                    right: side == "right",
                ))
            else
                atoms.push(a)
        elif alt := d.attr(id, "alt")
            if alt != ""
                add_text(alt, text_style(tag, ecs, parent))
        return
    if CONTROLS.contains(tag)
        if a := self.control_atom(id, st)
            atoms.push(a)
        return
    bx := box_of(tag, cs, st, avail)
    if bx.ml > 0.0 and (cs.get("display") else "").starts_with("inline-")
        atoms.push(self.word_atom("", st))
    for c in n.children
        inline(c, st, avail)

## Lays out the children of element `id` (style `st`) in the column from
## `x`, `w` wide, flowing inline runs into lines.
fn Ctx.children(mut self, id int, st St, x float, w float)
    saved_x := col_x
    saved_w := col_w
    col_x = x
    col_w = w
    for c in d.nodes[id].children
        n := d.nodes[c]
        if n.kind == Text
            add_text(n.text, st)
        elif n.kind == Element and visible(c)
            cs := element_style(c)
            pos := (cs.get("position") else "").trim()
            side := (cs.get("float") else "").trim()
            if pos == "absolute" or pos == "fixed"
                continue
            clr := (cs.get("clear") else "").trim()
            if clr == "left" or clr == "right" or clr == "both"
                flush(x, w, st.align)
                settle()
                for f in floats
                    if clr == "both" or (clr == "right") == f.right
                        y = fmax(y, f.y + f.h)
            if (side == "left" or side == "right") and n.tag != "img"
                flush(x, w, st.align)
                self.place_float(c, st, x, w, side == "right")
            elif self.is_block(c, cs)
                flush(x, w, st.align)
                block(c, st, x, w)
            else
                inline(c, st, w)
    flush(x, w, st.align)
    col_x = saved_x
    col_w = saved_w

## Lays out box `id` as a float against the left or right edge of the
## column from `x`, `w` wide, at the current line; text then wraps around it.
fn Ctx.place_float(mut self, id int, st St, x float, w float, right bool)
    cs := element_style(id)
    fst := text_style(d.nodes[id].tag, self.with_attrs(id, d.nodes[id].tag, cs), st)
    bx := box_of(d.nodes[id].tag, cs, fst, w)
    settle()
    ## The measured extent already includes the left margin (the box is laid out from x = 0).
    wide := fmin((if bw := bx.width then bw + bx.ml else self.max_content(id, st)) + bx.mr, w)
    fx := if right then x + w - wide else x
    y0 := y
    p0 := pend
    pend = 0.0
    self.block(id, st, fx, wide)
    h := y + pend - y0
    y = y0
    pend = p0
    floats.push(Float(x: if right then fx - 8.0 else fx, y: y0, w: wide + 8.0, h: h + 4.0, right))

## Operation `op` moved down by `dy`.
fn lowered(op draw.Op, dy float) draw.Op
    match op
        Rect(x, y, w, h, c) => draw.Op.Rect(x, y: y + dy, w, h, color: c)
        Text(x, y, t, fg, bold, italic, underline) => draw.Op.Text(
            x,
            y: y + dy,
            text: t,
            fg,
            bold,
            italic,
            underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => draw.Op.Str(
            x,
            y: y + dy,
            text: t,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        )
        Pic(x, y, w, h, src) => draw.Op.Pic(x, y: y + dy, w, h, src)

## Moves the operations and hit boxes from `o0` and `h0` on down by `dy`.
fn Ctx.lower(mut self, o0 int, h0 int, dy float)
    for k in o0..ops.len()
        ops[k] = lowered(ops[k], dy)
    for k in h0..hits.len()
        h := hits[k]
        hits[k] = Hit(
            x: h.x,
            y: h.y + dy,
            w: h.w,
            h: h.h,
            href: h.href,
            node: h.node,
            anchor: h.anchor,
        )

## Lays out the absolutely positioned children of `id` against the
## positioned ancestor's box, out of the flow.
fn Ctx.absolutes(mut self, id int, st St, late bool, boxh float)
    for c in d.nodes[id].children
        if d.nodes[c].kind == Element and visible(c)
            cs := element_style(c)
            pos := (cs.get("position") else "").trim()
            if pos != "absolute" and pos != "fixed"
                continue
            tag := d.nodes[c].tag
            cst := text_style(tag, self.with_attrs(c, tag, cs), st)
            bx := box_of(tag, cs, cst, aw)
            anchored := bx.bottom != none and bx.top == none
            if anchored != late
                continue
            fixed := pos == "fixed"
            ox := if fixed then 0.0 else ax
            oy := if fixed then 0.0 else ay
            ow := if fixed then page_w else aw
            wide := fmin((bx.width else self.max_content(c, st)) + bx.ml + bx.mr, ow)
            mut at := ox
            if l := bx.left
                at = ox + l
            elif r := bx.right
                at = ox + ow - r - wide
            y0 := y
            p0 := pend
            settle()
            if t := bx.top
                y = oy + t
            elif late
                y = oy
            start := y
            o0 := ops.len()
            h0 := hits.len()
            pend = 0.0
            self.block(c, st, at, wide)
            if late
                bb := bx.bottom else 0.0
                delta := oy + boxh - bb - (y + pend - start) - start
                self.lower(o0, h0, delta)
            y = y0
            pend = p0

## The width node `id` takes when nothing makes it wrap: laid out once in a
## very wide column and measured, then taken back.
fn Ctx.max_content(mut self, id int, st St) float
    if cached := contents.get(id)
        return cached
    if d.nodes[id].kind == Text
        w := text_width(html.collapse(d.nodes[id].text).trim(), st.size, st.bold, st.mono)
        contents[id] = w
        return w
    o0 := ops.len()
    h0 := hits.len()
    y0 := y
    p0 := pend
    m0 := marker
    saved := atoms
    atoms = []
    self.block(id, st, 0.0, 2.0 * SHRINK_W)
    mut extent := 0.0
    for k in o0..ops.len()
        match ops[k]
            Rect(x, _, w, _, _) => extent = if x + w < SHRINK_W then fmax(extent, x + w) else extent
            Str(x, _, t, _, size, _, bold, _, _) => extent = fmax(extent, x + text_width(
                t,
                size,
                bold,
                st.mono,
            ))
            Pic(x, _, w, _, _) => extent = fmax(extent, x + w)
            Text(_, _, _, _, _, _, _) => extent = extent
    while ops.len() > o0
        ops.pop()
    while hits.len() > h0
        hits.pop()
    y = y0
    pend = p0
    marker = m0
    atoms = saved
    if extent > 50000.0
        extent = 0.0
    contents[id] = extent
    extent

## The width of the text in `id` on one line, for shrink-to-fit items.
fn Ctx.intrinsic(mut self, id int, st St) float
    text := d.visible_text(id).trim()
    tw(html.collapse(text), st.size, st.bold, st.italic, font_of(st))

## Lays out block `id` inside a column from `x`, `w` wide, with the
## parent's text style `parent`.
fn Ctx.block(mut self, id int, parent St, x float, w float)
    n := d.nodes[id]
    tag := n.tag
    cs := element_style(id)
    display := cs.get("display") else ""
    if display == "none" or (cs.get("visibility") else "") == "hidden"
        return
    if tag == "svg"
        ## An icon is drawn; one that draws nothing is stood for by its link's label.
        cs0 := element_style(id)
        st0 := text_style(tag, self.with_attrs(id, tag, cs0), parent)
        if a := self.svg_atom(id, cs0, st0, w)
            atoms.push(a)
            flush(x, w, parent.align)
        elif parent.alt != ""
            add_text(parent.alt, parent)
            flush(x, w, parent.align)
        return
    ecs := self.with_attrs(id, tag, cs)
    mut st := text_style(tag, ecs, parent)
    bx := box_of(tag, cs, st, w)
    if bg := bx.bg
        st.under = bg
    if tag == "hr"
        settle()
        y += bx.mt
        ops.push(draw.Op.Rect(x: x + bx.ml, y: y, w: w - bx.ml - bx.mr, h: 1.0, color: RULE))
        y += 1.0
        pend = bx.mb
        return
    mut inner_w := w - bx.ml - bx.mr
    mut left := x + bx.ml
    mut set_w := bx.width
    if m := bx.max_width
        if set_w == none
            if m < inner_w and w < SHRINK_W
                set_w = m
        elif m < (set_w else 0.0)
            set_w = m
    if sw := set_w
        if sw < inner_w
            free := inner_w - sw
            if w >= SHRINK_W
                left += 0.0
            elif bx.ml_auto and bx.mr_auto
                left += free / 2.0
            elif bx.ml_auto
                left += free
            inner_w = sw
    border_w := inner_w
    content_x := left + bx.bl + bx.pl
    content_w := fmax(border_w - bx.bl - bx.br - bx.pl - bx.pr, 1.0)
    pend = fmax(pend, bx.mt)
    mut slot := -1
    mut top := 0.0
    positioned := bx.pos == "relative" or bx.pos == "absolute" or bx.pos == "fixed"
    boxed := bx.boxed() or bx.padded() or bx.height != none or positioned
    if boxed
        settle()
        top = y
        if bx.bg != none or (bx.radius != 0.0 and bx.bt > 0.0)
            slot = ops.len()
            ops.push(draw.Op.Rect(x: left, y: top, w: border_w, h: 0.0, color: 0))
        y += bx.bt + bx.pt
    if tag == "li"
        li_marker(id, st, content_x)
    saved_ax := ax
    saved_ay := ay
    saved_aw := aw
    if positioned
        ax = left
        ay = top
        aw = border_w
    self.absolutes(id, st, false, 0.0)
    if tag == "table"
        self.table(id, st, content_x, content_w)
    elif FLOW_FLEX.contains(display) and (cs.get("flex-direction") else "row").starts_with("row")
        self.flex(
            id,
            st,
            cs,
            content_x,
            content_w,
            (bx.height else 0.0) - bx.pt - bx.pb - bx.bt - bx.bb,
        )
    elif display == "grid" or display == "inline-grid"
        self.grid(id, st, cs, content_x, content_w)
    else
        self.children(id, st, content_x, content_w)
    marker = ""
    ax = saved_ax
    ay = saved_ay
    aw = saved_aw
    if boxed
        settle()
        y += bx.pb + bx.bb
        if hh := bx.height
            y = fmax(y, top + hh)
        bottom := y
        if positioned
            ax = left
            ay = top
            aw = border_w
            self.absolutes(id, st, true, bottom - top)
            ax = saved_ax
            ay = saved_ay
            aw = saved_aw
        radius := if bx.radius < 0.0 then fmin(
            border_w,
            bottom - top,
        ) * (0.0 - bx.radius) / 100.0 else bx.radius
        uniform := bx.bt == bx.br and bx.br == bx.bb and bx.bb == bx.bl
        if radius >= 1.0 and uniform and (bx.bg != none or bx.bt > 0.0)
            ## Rounded corners: an outer shape in the border colour and an
            ## inner one in the fill, before the children.
            mut shape := List[draw.Op]()
            if bx.bt > 0.0
                shape.extend(rounded(left, top, border_w, bottom - top, radius, bx.bcolor))
                shape.extend(rounded(
                    left + bx.bl,
                    top + bx.bt,
                    border_w - bx.bl - bx.br,
                    bottom - top - bx.bt - bx.bb,
                    fmax(radius - bx.bt, 0.0),
                    bx.bg else st.under,
                ))
            else
                shape.extend(rounded(
                    left,
                    top,
                    border_w,
                    bottom - top,
                    radius,
                    bx.bg else st.under,
                ))
            ops[slot] = shape[0]
            for k in 1..shape.len()
                ops.insert(slot + k, shape[k])
            pend = bx.mb
            if tag == "body" or tag == "html"
                if bg := bx.bg
                    canvas = bg
            return
        if bg := bx.bg
            ops[slot] = draw.Op.Rect(x: left, y: top, w: border_w, h: bottom - top, color: bg)
        if bx.bt > 0.0
            ops.push(draw.Op.Rect(x: left, y: top, w: border_w, h: bx.bt, color: bx.bcolor))
        if bx.bb > 0.0
            ops.push(draw.Op.Rect(
                x: left,
                y: bottom - bx.bb,
                w: border_w,
                h: bx.bb,
                color: bx.bcolor,
            ))
        if bx.bl > 0.0
            ops.push(draw.Op.Rect(x: left, y: top, w: bx.bl, h: bottom - top, color: bx.bcolor))
        if bx.br > 0.0
            ops.push(draw.Op.Rect(
                x: left + border_w - bx.br,
                y: top,
                w: bx.br,
                h: bottom - top,
                color: bx.bcolor,
            ))
        pend = bx.mb
    else
        pend = fmax(pend, bx.mb)
    if tag == "body" or tag == "html"
        if bg := bx.bg
            canvas = bg

## The `list-style-type` or `list-style` in `cs` as `none` or its first
## token, or "" when neither is set.
fn list_kind(cs Map[str, str]) str
    if t := cs.get("list-style-type")
        return t.trim()
    if v := cs.get("list-style")
        parts := tokens(v)
        if parts.contains("none")
            return "none"
        if parts.len() > 0
            return parts[0]
    ""

## Sets the marker of list item `id` whose content starts at `x`.
fn Ctx.li_marker(mut self, id int, st St, x float)
    parent := d.nodes[id].parent
    ptag := d.nodes[parent].tag
    ## `list-style` inherits: the item's own value, then its list's, then
    ## the nearest ancestor's (`none` may be one token of the shorthand).
    mut kind := ""
    mut e := id
    while e > 0 and kind == ""
        kind = list_kind(self.element_style(e))
        e = d.nodes[e].parent
    if kind == "none"
        return
    marker_x = x - 6.0
    if ptag == "ol"
        mut k := (d.attr(parent, "start") else "1").to_int() else 1
        for c in d.nodes[parent].children
            if c == id
                break
            if d.nodes[c].tag == "li"
                k += 1
        marker = "{k}."
    else
        marker = "\u{2022}"
        marker_x = x - 8.0

## The child elements that take part in a row, column or grid layout.
fn Ctx.items(mut self, id int) List[int]
    mut out := List[int]()
    for c in d.nodes[id].children
        if d.nodes[c].kind == Text
            if html.collapse(d.nodes[c].text).trim() != ""
                out.push(c)
        elif visible(c)
            cs := element_style(c)
            pos := (cs.get("position") else "").trim()
            if (cs.get("display") else "") != "none" and pos != "absolute" and pos != "fixed"
                out.push(c)
    out

## Lays out `items` side by side in columns of `widths` starting at `x`
## and `gap` apart, from the current line; the row ends at the tallest.
fn Ctx.row(
    mut self,
    items List[int],
    parent St,
    x float,
    widths List[float],
    offsets List[float],
    center bool,
    min_h float,
)
    settle()
    y0 := y
    mut heights := List[float]()
    mut spans := List[(int, int, int, int)]()
    for k in 0..items.len()
        y = y0
        pend = 0.0
        o0 := ops.len()
        h0 := hits.len()
        if d.nodes[items[k]].kind == Text
            add_text(d.nodes[items[k]].text, parent)
            flush(x + offsets[k], widths[k], parent.align)
        else
            self.block(items[k], parent, x + offsets[k], widths[k])
        heights.push(y + pend - y0)
        spans.push((o0, ops.len(), h0, hits.len()))
    mut tall := min_h
    for h in heights
        tall = fmax(tall, h)
    if center
        for k in 0..items.len()
            dy := (tall - heights[k]) / 2.0
            if dy > 0.5
                for o in spans[k].0..spans[k].1
                    ops[o] = shifted(ops[o], dy)
                for h in spans[k].2..spans[k].3
                    hits[h] = Hit(
                        x: hits[h].x,
                        y: hits[h].y + dy,
                        w: hits[h].w,
                        h: hits[h].h,
                        href: hits[h].href,
                        node: hits[h].node,
                        anchor: hits[h].anchor,
                    )
    y = y0 + tall
    pend = 0.0

## `op` moved down by `dy`.
fn shifted(op draw.Op, dy float) draw.Op
    match op
        Rect(x, y, w, h, c) => draw.Op.Rect(x: x, y: y + dy, w: w, h: h, color: c)
        Text(x, y, t, fg, bold, italic, underline) => draw.Op.Text(
            x,
            y: y + dy,
            text: t,
            fg,
            bold,
            italic,
            underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => draw.Op.Str(
            x,
            y: y + dy,
            text: t,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        )
        Pic(x, y, w, h, src) => draw.Op.Pic(x, y: y + dy, w, h, src)

fn Ctx.flex(mut self, id int, st St, cs Map[str, str], x float, w float, min_h float)
    items := self.items(id)
    gap := length(cs.get("gap") else (cs.get("column-gap") else "0"), st.size, w) else 0.0
    justify := if w
        >= SHRINK_W then "flex-start" else (cs.get("justify-content") else "flex-start").trim()
    wrap := (cs.get("flex-wrap") else "nowrap").trim() == "wrap"
    mut sizes := List[float]()
    mut grows := List[float]()
    for it in items
        if d.nodes[it].kind == Text
            sizes.push(self.max_content(it, st) + 2.0)
            grows.push(0.0)
            continue
        ics := element_style(it)
        ist := text_style(d.nodes[it].tag, ics, st)
        ib := box_of(d.nodes[it].tag, ics, ist, w)
        extra := ib.ml + ib.mr + ib.bl + ib.br + ib.pl + ib.pr
        mut grow := (ics.get("flex-grow") else "0").to_float() else 0.0
        if f := ics.get("flex")
            ts := tokens(f)
            if ts.len() > 0
                grow = ts[0].to_float() else grow
        grows.push(grow)
        if basis := ics.get("flex-basis")
            sizes.push((length(basis, ist.size, w) else self.max_content(it, st)) + extra)
        elif bw := ib.width
            sizes.push(bw + extra)
        else
            sizes.push(self.max_content(it, st) + ib.pr + ib.br + ib.mr + 4.0)
    mut k := 0
    while k < items.len()
        mut end := k
        mut used := 0.0
        while end < items.len()
            need := sizes[end] + (if end > k then gap else 0.0)
            if wrap and end > k and used + need > w
                break
            used += need
            end += 1
        mut row_items := List[int]()
        mut widths := List[float]()
        mut total_grow := 0.0
        for j in k..end
            total_grow += grows[j]
        free := w - used
        scale := if free < 0.0 then w / used else 1.0
        for j in k..end
            row_items.push(items[j])
            mut cw := sizes[j] * scale
            if free > 0.0 and total_grow > 0.0
                cw += free * grows[j] / total_grow
            widths.push(cw)
        mut slack := fmax(
            w - (used * scale) - (if total_grow > 0.0 then fmax(free, 0.0) else 0.0),
            0.0,
        )
        mut start := 0.0
        mut between := gap
        count := (end - k).to_float()
        if justify == "center"
            start = slack / 2.0
        elif justify == "flex-end" or justify == "end"
            start = slack
        elif justify == "space-between" and end - k > 1
            between = gap + slack / (count - 1.0)
        elif justify == "space-around"
            between = gap + slack / count
            start = slack / count / 2.0
        mut offsets := List[float]()
        mut at := start
        for j in 0..widths.len()
            offsets.push(at)
            at += widths[j] + between
        self.row(
            row_items,
            st,
            x,
            widths,
            offsets,
            (cs.get("align-items") else "").trim() == "center",
            min_h,
        )
        y += 0.0
        if end < items.len()
            y += gap
        k = end

## One grid track: positive for `Nfr`, negative for a fixed length, none for
## `auto`, `min-content` and the like (sized by their content). `minmax(a, b)`
## takes `b`.
fn grid_track(t str, size float, w float) float?
    if t.starts_with("minmax(")
        parts := t.slice(7, t.chars().len() - 1).split(",")
        if parts.len() == 2
            if v := grid_track(parts[1].trim(), size, w)
                return v
            return grid_track(parts[0].trim(), size, w)
        return none
    if r := t.strip_suffix("fr")
        return r.to_float()
    v := length(t, size, w)?
    0.0 - v

## The rows of `grid-template-areas`, each a list of area names.
fn area_rows(spec str) List[List[str]]
    mut rows := List[List[str]]()
    for part in spec.replace("\"", "'").split("'")
        words := [t for t in part.split(" ") if t.trim() != ""]
        if words.len() > 0
            rows.push(words)
    rows

## The first and last row and column (0-based) `name` covers in `rows`, or [].
fn area_box(rows List[List[str]], name str) List[int]
    mut r0 := -1
    mut r1 := -1
    mut c0 := -1
    mut c1 := -1
    for r in 0..rows.len()
        for c in 0..rows[r].len()
            if rows[r][c] == name
                if r0 < 0
                    r0 = r
                r1 = r
                if c0 < 0 or c < c0
                    c0 = c
                if c > c1
                    c1 = c
    if r0 < 0
        return []
    [r0, r1, c0, c1]

fn Ctx.grid(mut self, id int, st St, cs Map[str, str], x float, w float)
    items := self.items(id)
    gap := length(cs.get("gap") else (cs.get("column-gap") else "0"), st.size, w) else 0.0
    mut spec := (cs.get("grid-template-columns") else "").trim()
    shorthand := cs.get("grid-template") else ""
    if spec == "" and shorthand.contains("/")
        spec = shorthand.slice((shorthand.find("/") else 0) + 1, shorthand.chars().len()).trim()
    areas := area_rows((cs.get("grid-template-areas") else "").trim())
    if areas.len() > 0
        self.grid_areas(items, st, x, w, gap, spec, areas)
        return
    mut cols := List[float]()
    if spec.starts_with("repeat(")
        inner := spec.slice(7, spec.chars().len() - 1)
        comma := inner.find(",") else 0
        count := inner.slice(0, comma).trim()
        track := inner.slice(comma + 1, inner.chars().len()).trim()
        mut n := count.to_int() else 0
        if n == 0
            mut min := 200.0
            if track.starts_with("minmax(")
                parts := track.slice(7, track.chars().len() - 1).split(",")
                min = length(parts[0], st.size, w) else 200.0
            n = ((w + gap) / (min + gap)).floor().to_int().max(1)
        for k in 0..n
            cols.push(1.0)
    else
        for t in tokens(spec)
            if r := t.strip_suffix("fr")
                cols.push(r.to_float() else 1.0)
            else
                cols.push(0.0 - (length(t, st.size, w) else 0.0))
    if cols.len() == 0
        cols.push(1.0)
    mut fixed := 0.0
    mut fr := 0.0
    for c in cols
        if c < 0.0
            fixed += 0.0 - c
        else
            fr += c
    avail := w - fixed - gap * (cols.len() - 1).to_float()
    mut widths := List[float]()
    mut offsets := List[float]()
    mut at := 0.0
    for c in cols
        cw := if c < 0.0 then 0.0 - c else avail * c / fr
        widths.push(fmax(cw, 1.0))
        offsets.push(at)
        at += fmax(cw, 1.0) + gap
    mut k := 0
    while k < items.len()
        end := (k + cols.len()).min(items.len())
        self.row(items[k..end], st, x, widths[0..end - k], offsets[0..end - k], false, 0.0)
        k = end
        if k < items.len()
            y += gap

## A grid with `grid-template-areas`: each item goes in the cells its
## `grid-area` names, a row at a time; items with no area follow, full width.
fn Ctx.grid_areas(
    mut self,
    items List[int],
    st St,
    x float,
    w float,
    gap float,
    spec str,
    areas List[List[str]],
)
    ncols := areas[0].len()
    mut cols := List[float]()
    mut autos := List[bool]()
    for t in tokens(spec)
        if cols.len() < ncols
            if v := grid_track(t, st.size, w)
                cols.push(v)
                autos.push(false)
            else
                cols.push(0.0)
                autos.push(true)
    while cols.len() < ncols
        cols.push(1.0)
        autos.push(false)
    ## Each item's box: [row0, row1, col0, col1]; unplaced ones get new rows.
    mut boxes := List[List[int]]()
    mut extra := areas.len()
    for it in items
        name := (self.element_style(it).get("grid-area") else "").trim()
        b := if d.nodes[it].kind == Element and name != "" then area_box(areas, name) else []
        if b.len() == 0
            boxes.push([extra, extra, 0, ncols - 1])
            extra += 1
        else
            boxes.push(b)
    ## Content-sized tracks take the widest item that sits in them alone.
    for k in 0..items.len()
        b := boxes[k]
        if b[2] == b[3] and autos[b[2]] and d.nodes[items[k]].kind == Element
            cs2 := self.element_style(items[k])
            cst := text_style(d.nodes[items[k]].tag, cs2, st)
            cols[b[2]] = fmax(cols[b[2]], self.intrinsic(items[k], cst))
    mut fixed := 0.0
    mut fr := 0.0
    for c in 0..cols.len()
        if autos[c]
            fixed += cols[c]
        elif cols[c] < 0.0
            fixed += 0.0 - cols[c]
        else
            fr += cols[c]
    avail := fmax(w - fixed - gap * (cols.len() - 1).to_float(), 0.0)
    mut widths := List[float]()
    mut offsets := List[float]()
    mut at := 0.0
    for c in 0..cols.len()
        mut cw := cols[c]
        if not autos[c]
            if cw < 0.0
                cw = 0.0 - cw
            elif fr > 0.0
                cw = avail * cw / fr
            else
                cw = 0.0
        widths.push(cw)
        offsets.push(at)
        at += cw + gap
    for r in 0..extra
        mut order := List[int]()
        for k in 0..items.len()
            if boxes[k][0] == r
                mut pos := 0
                while pos < order.len() and boxes[order[pos]][2] <= boxes[k][2]
                    pos += 1
                order.insert(pos, k)
        if order.len() > 0
            mut row := List[int]()
            mut ws := List[float]()
            mut os := List[float]()
            for k in order
                b := boxes[k]
                mut span := gap * (b[3] - b[2]).to_float()
                for c in b[2]..b[3] + 1
                    span += widths[c]
                row.push(items[k])
                ws.push(span)
                os.push(offsets[b[2]])
            self.row(row, st, x, ws, os, false, 0.0)
            y += gap

fn Ctx.table(mut self, id int, st St, x float, w float)
    mut rows := List[int]()
    self.collect_rows(id, mut rows)
    mut ncols := 0
    for r in rows
        ncols = ncols.max(self.items(r).len())
    if ncols == 0
        return
    mut natural := List[float]()
    for k in 0..ncols
        natural.push(20.0)
    for r in rows
        cells := self.items(r)
        for k in 0..cells.len()
            cs := element_style(cells[k])
            cst := text_style(d.nodes[cells[k]].tag, cs, st)
            natural[k] = fmax(natural[k], self.intrinsic(cells[k], cst) + 12.0)
    mut sum := 0.0
    for v in natural
        sum += v
    scale := if sum > w then w / sum else 1.0
    mut extra := if sum < w then (w - sum) / ncols.to_float() else 0.0
    mut widths := List[float]()
    mut offsets := List[float]()
    mut at := 0.0
    for v in natural
        cw := v * scale + extra
        widths.push(cw)
        offsets.push(at)
        at += cw
    for r in rows
        cells := self.items(r)
        self.row(cells, st, x, widths[0..cells.len()], offsets[0..cells.len()], false, 0.0)

fn Ctx.collect_rows(mut self, id int, mut out List[int])
    for c in d.nodes[id].children
        tag := d.nodes[c].tag
        if tag == "tr"
            out.push(c)
        elif tag == "thead" or tag == "tbody" or tag == "tfoot"
            self.collect_rows(c, mut out)

## Lays `d` out in a column `width` pixels wide with `sheet` (the linked
## style sheets) before the document's own.
pub fn layout(d html.Doc, url str, width float, sheet css.Sheet) Scene
    layout_with(d, url, width, sheet, Map[str, List[int]]())

## `layout` with the pictures' sizes (`images.prefetch`), so an `<img>`
## without `width` and `height` takes its own.
pub fn layout_with(
    d html.Doc,
    url str,
    width float,
    sheet css.Sheet,
    sizes Map[str, List[int]],
) Scene
    layout_measured(d, url, width, sheet, sizes, Map[str, float](), -1)

## `layout_with` using the run widths in `meas` (`probe_key`), drawing text
## field `editing` (a node, or -1) with a caret; the scene's `probes` are the
## runs that were estimated, for the host to measure.
pub fn layout_measured(
    d html.Doc,
    url str,
    width float,
    sheet css.Sheet,
    sizes Map[str, List[int]],
    meas Map[str, float],
    editing int,
) Scene
    all := css.for_width(css.concat(sheet, css.document_sheet(d)), width.to_int())
    ## `color-scheme: ... dark` on the root: the screen is dark, so the
    ## default text is light (CSS Color Adjust 1).
    mut ink := INK
    if root := d.first("html")
        if (css.cascade(d, root, all).get("color-scheme") else "").contains("dark")
            ink = 0xe8e8e8
    base := St(
        color: ink,
        size: 16.0,
        bold: false,
        italic: false,
        underline: false,
        mono: false,
        serif: false,
        pre: false,
        align: "left",
        lh: 1.3,
        href: "",
        node: -1,
        upper: false,
        nowrap: false,
        alt: "",
        under: 0xffffff,
    )
    mut c := Ctx(
        d,
        svgs: {},
        sheet: all,
        url: page.base_of(d, url),
        ops: [],
        hits: [],
        atoms: [],
        y: 0.0,
        pend: 0.0,
        marker: "",
        marker_x: 0.0,
        canvas: 0xffffff,
        styles: {},
        scopes: {},
        cascades: {},
        contents: {},
        editing: editing,
        pics: sizes,
        meas,
        probes: [],
        probed: {},
        floats: [],
        ax: 0.0,
        ay: 0.0,
        aw: width,
        page_w: width,
        col_x: 0.0,
        col_w: width,
    )
    c.block(0, base, 0.0, width)
    c.settle()
    Scene(ops: c.ops, hits: c.hits, height: c.y, bg: c.canvas, probes: c.probes, bits: c.svgs)

## The link or control under point (`x`, `y`) of the page, if any.
pub fn Scene.hit_at(self, x float, y float) Hit?
    mut k := hits.len()
    while k > 0
        k -= 1
        h := hits[k]
        if x >= h.x and x < h.x + h.w and y >= h.y and y < h.y + h.h
            return h
    none

## The link under point (`x`, `y`) of the page, if any.
pub fn Scene.link_at(self, x float, y float) str?
    h := hit_at(x, y)?
    if h.href == ""
        return none
    h.href

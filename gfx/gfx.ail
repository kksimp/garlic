## The width in pixels of `text` at `size`, in a proportional or (`mono`)
## fixed font.
pub fn text_width(text str, size float, bold bool, mono bool) float
    if mono
        return text.chars().len().to_float() * size * 0.6
    mut units := 0
    for c in text.chars()
        k := c.code()
        units += if k >= 32 and k <= 126 then WIDTHS[k - 32] else 600
    ## The host's sans font is wider than Helvetica, so estimates err a
    ## little wide; lines draw as whole strings, so only wrapping depends on it.
    scale := if bold then 1.1 else 1.06
    units.to_float() * size * scale / 1000.0

fn fmax(a float, b float) float
    if a > b then a else b

fn fmin(a float, b float) float
    if a < b then a else b

# ---- Values ---------------------------------------------------------------

## A CSS number as a float: `to_float` needs a digit before the point, CSS
## does not (`.45em`, `.5`, `+.5`, `-.5`; CSS Values 4 §4.2).
pub fn css_float(v str) float?
    t := v.trim()
    if t.starts_with(".")
        return "0{t}".to_float()
    if t.starts_with("+")
        return css_float(t.slice(1, t.chars().len()))
    if t.starts_with("-.")
        return "-0{t.slice(1, t.chars().len())}".to_float()
    t.to_float()

## A length in pixels: `px`, `em`, `rem`, `pt`, `pc`, `in`, `cm`, `mm`,
## `ex` (half an em), `ch` (the width of "0"), `%` (of `rel`) or `0`, plain
## or in `calc()`, `min()`, `max()` and `clamp()` (CSS Values 4 §5, §10).
## Viewport units are pixels by now (`viewport_px`). `none` for `auto`,
## keywords and anything else.
pub fn length(v str, size float, rel float) float?
    t := v.trim().to_lower()
    if inner := t.strip_prefix("calc(")
        return calc_sum(inner.slice(0, inner.chars().len() - 1), size, rel)
    if inner := t.strip_prefix("min(")
        return math_fn(inner, 0, size, rel)
    if inner := t.strip_prefix("max(")
        return math_fn(inner, 1, size, rel)
    if inner := t.strip_prefix("clamp(")
        return math_fn(inner, 2, size, rel)
    mut scale := 1.0
    mut num := t
    if r := t.strip_suffix("px")
        num = r
    elif r := t.strip_suffix("rem")
        scale = 16.0
        num = r
    elif r := t.strip_suffix("em")
        scale = size
        num = r
    elif r := t.strip_suffix("pt")
        scale = 4.0 / 3.0
        num = r
    elif r := t.strip_suffix("%")
        scale = rel / 100.0
        num = r
    elif r := t.strip_suffix("ex")
        scale = size * 0.5
        num = r
    elif r := t.strip_suffix("ch")
        scale = size * 0.6
        num = r
    elif r := t.strip_suffix("pc")
        scale = 16.0
        num = r
    elif r := t.strip_suffix("in")
        scale = 96.0
        num = r
    elif r := t.strip_suffix("cm")
        scale = 96.0 / 2.54
        num = r
    elif r := t.strip_suffix("mm")
        scale = 96.0 / 25.4
        num = r
    elif t != "0"
        return none
    x := css_float(num)?
    x * scale

## `min(a, b, ...)` (`kind` 0), `max(...)` (1) or `clamp(lo, v, hi)` (2) of
## the sums in `inner`, the text after the opening parenthesis (CSS Values 4
## §10.2). `none` when an argument is not a length.
fn math_fn(inner str, kind int, size float, rel float) float?
    if not inner.ends_with(")")
        return none
    args := top_commas(inner.slice(0, inner.chars().len() - 1))
    mut vals := List[float]()
    for a in args
        vals.push(calc_sum(a, size, rel)?)
    if vals.len() == 0
        return none
    if kind == 2
        if vals.len() != 3
            return none
        return fmax(vals[0], fmin(vals[1], vals[2]))
    mut best := vals[0]
    for x in vals
        best = if kind == 0 then fmin(best, x) else fmax(best, x)
    best

## Viewport-relative units and how many hundredths of the width (`w`), the
## height (`h`), the smaller (`min`) or the larger (`max`) side each is.
VIEW_UNITS := {
    "vw": "w",
    "svw": "w",
    "lvw": "w",
    "dvw": "w",
    "vi": "w",
    "svi": "w",
    "lvi": "w",
    "dvi": "w",
    "vh": "h",
    "svh": "h",
    "lvh": "h",
    "dvh": "h",
    "vb": "h",
    "svb": "h",
    "lvb": "h",
    "dvb": "h",
    "vmin": "min",
    "svmin": "min",
    "lvmin": "min",
    "dvmin": "min",
    "vmax": "max",
    "svmax": "max",
    "lvmax": "max",
    "dvmax": "max",
}

## `v` with every viewport-relative length (CSS Values 4 §6.1.2: `50vw`,
## `100dvh`, `2vmin`, ...) written as pixels of a window `vw` by `vh`, so
## `length` and the rest read them as plain lengths. The small, large and
## dynamic variants are the same here: the window has no browser bars that
## come and go.
pub fn viewport_px(v str, vw float, vh float) str
    if not (v.contains("vw") or v.contains("vh") or v.contains("vm") or v.contains("vi") or v.contains("vb"))
        return v
    cs := v.chars()
    n := cs.len()
    mut out := List[str]()
    mut i := 0
    while i < n
        c := cs[i]
        lead := c.is_digit() or (c == '.' and i + 1 < n and cs[i + 1].is_digit())
        glued := i > 0 and (cs[i - 1].is_alnum() or cs[i - 1] == '#' or cs[i - 1] == '_')
        if not lead or glued
            out.push([c].join(""))
            i += 1
            continue
        mut j := i
        while j < n and (cs[j].is_digit() or cs[j] == '.')
            j += 1
        mut k := j
        while k < n and cs[k].is_alpha()
            k += 1
        unit := cs[j..k].join("").to_lower()
        num := css_float(cs[i..j].join(""))
        side := VIEW_UNITS.get(unit) else ""
        if side != "" and num != none
            x := num else 0.0
            per := match side
                "w" => vw
                "h" => vh
                "min" => fmin(vw, vh)
                _ => fmax(vw, vh)
            out.push("{x * per / 100.0}px")
        else
            out.push(cs[i..k].join(""))
        i = k
    out.join("")

## A unitless number, plain or as a `calc()` of numbers only (CSS Values 4
## §10.9): `calc(1.5 / 1)`, a Tailwind line height, is the number 1.5 and not
## a length. `none` once a unit or `%` appears.
pub fn number(v str) float?
    t := v.trim()
    if x := css_float(t)
        return x
    inner := t.strip_prefix("calc(")?
    body := inner.slice(0, inner.chars().len() - 1)
    for ch in body.chars()
        if not (ch.is_digit() or " .()+-*/".chars().contains(ch))
            return none
    calc_sum(body, 0.0, 0.0)

## `a + b - c` of products, as in `calc()` (CSS Values 4): `+` and `-`
## need spaces around them.
fn calc_sum(s str, size float, rel float) float?
    cs := s.chars()
    mut depth := 0
    mut total := 0.0
    mut sign := 1.0
    mut cur := List[char]()
    for k in 0..cs.len()
        ch := cs[k]
        if ch == '('
            depth += 1
        elif ch == ')'
            depth -= 1
        spaced := k > 0 and k + 1 < cs.len() and cs[k - 1] == ' ' and cs[k + 1] == ' '
        if depth == 0 and spaced and (ch == '+' or ch == '-')
            total += sign * calc_prod(cur.join(""), size, rel)?
            sign = 1.0
            if ch == '-'
                sign = -1.0
            cur.clear()
        else
            cur.push(ch)
    total + sign * calc_prod(cur.join(""), size, rel)?

## `a * b / c` of atoms.
fn calc_prod(s str, size float, rel float) float?
    cs := s.chars()
    mut depth := 0
    mut acc := 1.0
    mut times := true
    mut cur := List[char]()
    for ch in cs
        if ch == '('
            depth += 1
        elif ch == ')'
            depth -= 1
        if depth == 0 and (ch == '*' or ch == '/')
            v := calc_atom(cur.join(""), size, rel)?
            acc = if times then acc * v else acc / v
            times = ch == '*'
            cur.clear()
        else
            cur.push(ch)
    v := calc_atom(cur.join(""), size, rel)?
    if times then acc * v else acc / v

## A length, a number or a parenthesised sum.
fn calc_atom(s str, size float, rel float) float?
    t := s.trim()
    if t.starts_with("(") and t.ends_with(")")
        return calc_sum(t.slice(1, t.chars().len() - 1), size, rel)
    if t.starts_with("calc(") and t.ends_with(")")
        return calc_sum(t.slice(5, t.chars().len() - 1), size, rel)
    if v := length(t, size, rel)
        return v
    css_float(t)

NAMED := {
    "black": 0x000000,
    "white": 0xffffff,
    "red": 0xff0000,
    "green": 0x008000,
    "blue": 0x0000ff,
    "gray": 0x808080,
    "grey": 0x808080,
    "silver": 0xc0c0c0,
    "yellow": 0xffff00,
    "orange": 0xffa500,
    "purple": 0x800080,
    "navy": 0x000080,
    "teal": 0x008080,
    "maroon": 0x800000,
    "lime": 0x00ff00,
    "aqua": 0x00ffff,
    "fuchsia": 0xff00ff,
    "olive": 0x808000,
    "pink": 0xffc0cb,
    "brown": 0xa52a2a,
    "gold": 0xffd700,
    "crimson": 0xdc143c,
    "lightgray": 0xd3d3d3,
    "lightgrey": 0xd3d3d3,
    "darkgray": 0xa9a9a9,
    "darkgrey": 0xa9a9a9,
    "whitesmoke": 0xf5f5f5,
    "dimgray": 0x696969,
    "darkblue": 0x00008b,
    "lightblue": 0xadd8e6,
    "skyblue": 0x87ceeb,
    "royalblue": 0x4169e1,
    "tomato": 0xff6347,
    "coral": 0xff7f50,
    "indigo": 0x4b0082,
    "violet": 0xee82ee,
}

fn hex_digit(c char) int?
    c.to_digit(16)

## A color: `#rgb`, `#rrggbb`, `rgb()`, `rgba()` or a name. `none` for
## `transparent`, a nearly invisible `rgba()` and anything unknown.
pub fn color(v str) int?
    color_over(v, 0xffffff)

## A color as `color` reads it, with `rgba()` and `#rrggbbaa` mixed into the
## `under` color it is drawn over.
pub fn color_over(v str, under int) int?
    t := v.trim().to_lower()
    if inner := t.strip_prefix("light-dark(")
        ## The screen is dark (CSS Color 5): take the second color.
        cs := inner.chars()
        mut depth := 0
        for k in 0..cs.len()
            if cs[k] == '('
                depth += 1
            elif cs[k] == ')'
                depth -= 1
            elif cs[k] == ',' and depth == 0
                last := inner.chars().len() - 1
                return color_over(inner.slice(k + 1, last), under)
        return none
    if t.starts_with("#")
        cs := t.chars()
        mut ds := List[int]()
        for k in 1..cs.len()
            ds.push(hex_digit(cs[k])?)
        if ds.len() == 3 or ds.len() == 4
            alpha := if ds.len() == 4 then ds[3].to_float() / 15.0 else 1.0
            return mix(ds[0] * 17, ds[1] * 17, ds[2] * 17, alpha, under)
        if ds.len() == 6 or ds.len() == 8
            alpha := if ds.len() == 8 then (ds[6] * 16 + ds[7]).to_float() / 255.0 else 1.0
            return mix(ds[0] * 16 + ds[1], ds[2] * 16 + ds[3], ds[4] * 16 + ds[5], alpha, under)
        return none
    if inner := t.strip_prefix("color-mix(")
        return color_mix(inner, under)
    if t.starts_with("rgb") or t.starts_with("hsl") or t.starts_with("ok") or t.starts_with("color(")
        open := t.find("(")?
        if not t.ends_with(")")
            return none
        args := color_args(t.slice(open + 1, t.chars().len() - 1))
        if args.len() < 3
            return none
        mut alpha := 1.0
        if args.len() > 3
            alpha = channel(args[3], 1.0)?
        fn_name := t.slice(0, open).trim()
        if fn_name == "rgb" or fn_name == "rgba"
            return mix(
                byte_of(channel(args[0], 255.0)?),
                byte_of(channel(args[1], 255.0)?),
                byte_of(channel(args[2], 255.0)?),
                alpha,
                under,
            )
        if fn_name == "hsl" or fn_name == "hsla"
            hs := hsl_rgb(hue(args[0])?, channel(args[1], 1.0)?, channel(args[2], 1.0)?)
            return mix(hs[0], hs[1], hs[2], alpha, under)
        if fn_name == "oklab"
            lab := oklab_rgb(channel(args[0], 1.0)?, channel(args[1], 0.4)?, channel(args[2], 0.4)?)
            return mix(lab[0], lab[1], lab[2], alpha, under)
        if fn_name == "oklch"
            chroma := channel(args[1], 0.4)?
            turn := hue(args[2])? * 3.141592653589793 / 180.0
            lch := oklab_rgb(channel(args[0], 1.0)?, chroma * turn.cos(), chroma * turn.sin())
            return mix(lch[0], lch[1], lch[2], alpha, under)
        if fn_name == "color" and args.len() >= 4 and (args[0] == "srgb" or args[0] == "display-p3")
            mut a2 := 1.0
            if args.len() > 4
                a2 = channel(args[4], 1.0)?
            return mix(
                byte_of(channel(args[1], 1.0)? * 255.0),
                byte_of(channel(args[2], 1.0)? * 255.0),
                byte_of(channel(args[3], 1.0)? * 255.0),
                a2,
                under,
            )
        return none
    NAMED.get(t)

## The arguments of a colour function, legacy (`rgb(1, 2, 3, .5)`) or modern
## (`rgb(1 2 3 / 50%)`): the words split at commas, spaces and `/`.
fn color_args(inner str) List[str]
    [p for p in inner.replace(",", " ").replace("/", " ").split(" ") if p.trim() != ""]

## A colour channel: a percentage of `full`, `none` as 0, else the number.
fn channel(v str, full float) float?
    t := v.trim()
    if t == "none"
        return 0.0
    if r := t.strip_suffix("%")
        return css_float(r)? * full / 100.0
    css_float(t)

## A hue in degrees: a number, or an angle in `deg`, `turn`, `rad` or `grad`.
fn hue(v str) float?
    t := v.trim()
    if t == "none"
        return 0.0
    if r := t.strip_suffix("deg")
        return css_float(r)
    if r := t.strip_suffix("grad")
        return css_float(r)? * 0.9
    if r := t.strip_suffix("rad")
        return css_float(r)? * 180.0 / 3.141592653589793
    if r := t.strip_suffix("turn")
        return css_float(r)? * 360.0
    css_float(t)

## A channel in 0 to 255 as an int, clamped.
fn byte_of(x float) int
    fmin(fmax(x, 0.0), 255.0).round().to_int()

## `hsl(h s l)` as [r, g, b] (CSS Color 4 §7.1): `s` and `l` from 0 to 1.
fn hsl_rgb(h0 float, s0 float, l0 float) List[int]
    h := h0 - (h0 / 360.0).floor() * 360.0
    s := fmin(fmax(s0, 0.0), 1.0)
    l := fmin(fmax(l0, 0.0), 1.0)
    a := s * fmin(l, 1.0 - l)
    mut out := List[int]()
    for n in [0.0, 8.0, 4.0]
        mut k := n + h / 30.0
        k = k - (k / 12.0).floor() * 12.0
        f := l - a * fmax(-1.0, fmin(fmin(k - 3.0, 9.0 - k), 1.0))
        out.push(byte_of(f * 255.0))
    out

## An Oklab colour (`l` 0 to 1) as sRGB [r, g, b] (CSS Color 4 §9.2 and
## the Oklab reference matrices), clamped into the gamut.
fn oklab_rgb(l0 float, a float, b float) List[int]
    l1 := l0 + 0.3963377774 * a + 0.2158037573 * b
    m1 := l0 - 0.1055613458 * a - 0.0638541728 * b
    s1 := l0 - 0.0894841775 * a - 1.291485548 * b
    l := l1 * l1 * l1
    m := m1 * m1 * m1
    s := s1 * s1 * s1
    r := 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
    g := 0.0 - 1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
    bl := 0.0 - 0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s
    [byte_of(gamma(r) * 255.0), byte_of(gamma(g) * 255.0), byte_of(gamma(bl) * 255.0)]

## A linear-light sRGB channel encoded with the sRGB transfer function.
fn gamma(x float) float
    if x <= 0.0
        return 0.0
    if x <= 0.0031308
        return 12.92 * x
    1.055 * x.pow(1.0 / 2.4) - 0.055

## `color-mix(in SPACE, a [p%], b [q%])` given the text after `color-mix(`,
## mixed in sRGB whatever the space (CSS Color 5 §2, simplified): a missing
## percentage is the rest of 100, and `transparent` gives the other colour
## at its share of opacity, over `under`.
fn color_mix(inner str, under int) int?
    if not inner.ends_with(")")
        return none
    parts := top_commas(inner.slice(0, inner.chars().len() - 1))
    if parts.len() != 3
        return none
    a := mix_part(parts[1])
    b := mix_part(parts[2])
    mut pa := a.1
    mut pb := b.1
    if pa < 0.0 and pb < 0.0
        pa = 50.0
        pb = 50.0
    elif pa < 0.0
        pa = 100.0 - pb
    elif pb < 0.0
        pb = 100.0 - pa
    total := pa + pb
    if total <= 0.0
        return none
    ca := color_over(a.0, under)
    cb := color_over(b.0, under)
    if x := ca
        if y := cb
            wa := pa / total
            r := (x / 65536).to_float() * wa + (y / 65536).to_float() * (1.0 - wa)
            g := (x / 256 % 256).to_float() * wa + (y / 256 % 256).to_float() * (1.0 - wa)
            bb := (x % 256).to_float() * wa + (y % 256).to_float() * (1.0 - wa)
            return mix(byte_of(r), byte_of(g), byte_of(bb), fmin(total, 100.0) / 100.0, under)
        return mix(x / 65536, x / 256 % 256, x % 256, pa / total * fmin(total, 100.0) / 100.0, under)
    if y := cb
        return mix(y / 65536, y / 256 % 256, y % 256, pb / total * fmin(total, 100.0) / 100.0, under)
    none

## One colour of `color-mix()` and its percentage (-1 when not given).
fn mix_part(s str)(str, float)
    ts := tokens(s.trim())
    mut color_text := List[str]()
    mut pct := -1.0
    for t in ts
        if r := t.strip_suffix("%")
            if x := css_float(r)
                pct = x
                continue
        color_text.push(t)
    (color_text.join(" "), pct)

## `v` with `currentcolor` (CSS Color 4 §6.4) written as the text colour `ink`.
fn with_current(v str, ink int) str
    if not v.contains("currentcolor")
        return v
    v.replace("currentcolor", hex_of(ink))

## `#rrggbb` for colour `c`.
fn hex_of(c int) str
    "#{c.to_hex().pad_left(6, '0')}"

## Channels `r`, `g`, `b` at opacity `alpha` over `under`; none when clear.
fn mix(r int, g int, b int, alpha float, under int) int?
    if alpha < 0.02
        return none
    a := fmin(alpha, 1.0)
    ur := under / 65536
    ug := under / 256 % 256
    ub := under % 256
    nr := (r.to_float() * a + ur.to_float() * (1.0 - a)).round().to_int()
    ng := (g.to_float() * a + ug.to_float() * (1.0 - a)).round().to_int()
    nb := (b.to_float() * a + ub.to_float() * (1.0 - a)).round().to_int()
    nr * 65536 + ng * 256 + nb

## Splits `v` at spaces that are not inside parentheses.
fn tokens(v str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    mut depth := 0
    for c in v.chars()
        if c == '('
            depth += 1
        elif c == ')'
            depth -= 1
        if c == ' ' and depth == 0
            if cur.len() > 0
                out.push(cur.join(""))
                cur = []
        else
            cur.push(c)
    if cur.len() > 0
        out.push(cur.join(""))
    out

## One to four lengths as (top, right, bottom, left), and whether the
## left and right are `auto`.
fn sides(v str, size float, rel float)(float, float, float, float, bool, bool)
    ts := tokens(v)
    mut vals := List[float]()
    mut autos := List[bool]()
    for t in ts
        autos.push(t == "auto")
        vals.push(length(t, size, rel) else 0.0)
    if vals.len() == 0
        return (0.0, 0.0, 0.0, 0.0, false, false)
    if vals.len() == 1
        return (vals[0], vals[0], vals[0], vals[0], autos[0], autos[0])
    if vals.len() == 2
        return (vals[0], vals[1], vals[0], vals[1], autos[1], autos[1])
    if vals.len() == 3
        return (vals[0], vals[1], vals[2], vals[1], autos[1], autos[1])
    (vals[0], vals[1], vals[2], vals[3], autos[3], autos[1])

# ---- Styles ---------------------------------------------------------------

## The inherited text style.
struct St
    color int
    size float
    bold bool
    italic bool
    underline bool
    mono bool
    serif bool
    pre bool
    align str
    lh float
    href str
    ## The node of the link this text is in, or -1.
    node int
    upper bool
    nowrap bool
    ## A link's `aria-label` or `title`: what its icon-only content says.
    alt str
    ## The background colour text and boxes are drawn over, for `rgba()`.
    under int
    ## `visibility: hidden` or `collapse` (CSS 2.1 §11.2): laid out, not
    ## painted; a descendant with `visibility: visible` paints again.
    ghost bool
    ## The product of the `opacity` of the element and its ancestors (CSS
    ## Color 4 §14.1); colours are mixed toward `under` by it, and nothing is
    ## painted below 0.02.
    fade float
    ## `color: transparent`: the text takes its room and is not drawn.
    clear bool

## A block's own box: margins, borders, padding, background and width.
struct Bx
    bg int?
    mt float
    mr float
    mb float
    ml float
    pt float
    pr float
    pb float
    pl float
    bt float
    br float
    bb float
    bl float
    bcolor int
    width float?
    max_width float?
    height float?
    ## `border-radius` in pixels (negative: a percentage of the smaller side).
    radius float
    ## `position` ("" for static), its offsets, and `float`.
    pos str
    top float?
    right float?
    left float?
    float_side str
    bottom float?
    ml_auto bool
    mr_auto bool
    ## `min-width`, `min-height` and `max-height` (border box, as `width`).
    min_width float?
    min_height float?
    max_height float?
    ## `aspect-ratio` as width over height, 0 when not set.
    aspect float
    ## `overflow` (or `-x`/`-y`) is `hidden`, `clip`, `auto` or `scroll`: the
    ## content is cut at the padding box (CSS Overflow 3 §3).
    clips bool

fn Bx.boxed(self) bool
    self.bg != none or self.bt > 0.0 or self.br > 0.0 or self.bb > 0.0 or self.bl > 0.0

fn Bx.padded(self) bool
    self.pt > 0.0 or self.pb > 0.0 or self.bt > 0.0 or self.bb > 0.0

## A column at least this wide is `max_content`'s measuring column.
SHRINK_W := 50000.0
LINK := 0x0000ee
INK := 0x000000
RULE := 0x9a9a9a

## `border` and `border-*` values: width (default 3px for a named style)
## and color.
fn border_part(v str, size float, ink int, under int)(float, int)
    mut w := 3.0
    mut c := ink
    mut shown := true
    for t in tokens(v)
        if t == "none" or t == "hidden"
            shown = false
        elif x := length(t, size, 0.0)
            w = x
        elif t == "thin"
            w = 1.0
        elif t == "medium"
            w = 3.0
        elif t == "thick"
            w = 5.0
        elif k := color_over(t, under)
            c = k
        elif t == "transparent"
            shown = false
    (if shown then w else 0.0, c)

## The font-size keywords and their sizes in pixels.
fn size_keyword(v str) float?
    match v
        "xx-small" => 9.0
        "x-small" => 10.0
        "small" | "smaller" => 13.0
        "medium" => 16.0
        "large" | "larger" => 18.0
        "x-large" => 24.0
        "xx-large" => 32.0
        _ => none

HEADING_SIZE := {"h1": 2.0, "h2": 1.5, "h3": 1.17, "h4": 1.0, "h5": 0.83, "h6": 0.67}

## The first color stop of a `linear-gradient(...)` in `v`.
fn gradient_first(v str) int?
    at := v.find("gradient(")?
    inner := v.slice(at, v.chars().len())
    if i := inner.find("#")
        for n in [7, 4]
            if k := color(inner.slice(i, i + n))
                return k
    if i := inner.find("rgb")
        close := inner.slice(i, inner.chars().len()).find(")")?
        return color(inner.slice(i, i + close + 1))
    none

## The style of text inside element `tag` with the cascaded values `cs`,
## given its parent's.
fn text_style(tag str, cs Map[str, str], parent St) St
    mut st := parent
    if m := HEADING_SIZE.get(tag)
        st.size = parent.size * m
        st.bold = true
    match tag
        "b" | "strong" | "th" => st.bold = true
        "i" | "em" | "cite" | "var" | "dfn" => st.italic = true
        "code" | "kbd" | "samp" | "tt" =>
            st.mono = true
            st.size = parent.size * 0.9
        "pre" =>
            st.mono = true
            st.pre = true
            st.size = parent.size * 0.9
        "small" | "sub" | "sup" => st.size = parent.size * 0.83
        "big" => st.size = parent.size * 1.17
        "a" =>
            if h := cs.get("href")
                st.href = h
                st.node = (cs.get("node") else "-1").to_int() else -1
            st.alt = cs.get("alt-label") else ""
        "u" | "ins" => st.underline = true
        "s" | "del" | "strike" => st.underline = st.underline
        _ => st.bold = st.bold
    if tag == "a"
        st.underline = true
        st.color = if st.color == 0xe8e8e8 then 0x9e9eff else LINK
    if fs := cs.get("font-size")
        if k := size_keyword(fs.trim())
            st.size = k
        elif x := length(fs, parent.size, parent.size)
            st.size = x
    if f := cs.get("font")
        shorthand := page.font_shorthand(f, st.italic, st.bold)
        st.italic = shorthand.0
        st.bold = shorthand.1
    if w := cs.get("font-weight")
        st.bold = page.font_bold(w, parent.bold)
    if s := cs.get("font-style")
        st.italic = page.font_italic(s, parent.italic)
    if c := cs.get("color")
        ct := c.trim()
        if ct == "inherit" or ct == "currentcolor"
            st.color = parent.color
        elif ct == "transparent"
            st.clear = true
        elif k := color_over(ct, parent.under)
            st.color = k
            st.clear = false
    if fill := cs.get("-webkit-text-fill-color")
        if fill.trim() == "transparent"
            ## `background-clip: text` over a gradient: the first stop.
            if g := gradient_first(cs.get("background") else (cs.get("background-image") else ""))
                st.color = g
                st.clear = false
        elif k := color_over(with_current(fill, st.color), parent.under)
            st.color = k
    if v := cs.get("visibility")
        vt := v.trim()
        if vt == "hidden" or vt == "collapse"
            st.ghost = true
        elif vt == "visible"
            st.ghost = false
    if v := cs.get("opacity")
        ot := v.trim()
        o := if ot.ends_with("%") then (css_float(ot.slice(0, ot.chars().len() - 1)) else 100.0) / 100.0 else (css_float(ot) else 1.0)
        st.fade = st.fade * fmin(fmax(o, 0.0), 1.0)
    if td := cs.get("text-decoration")
        st.underline = td.contains("underline")
    if a := cs.get("text-align")
        st.align = a.trim()
    if l := cs.get("line-height")
        t := l.trim()
        if x := number(t)
            st.lh = x
        elif p := length(t, st.size, st.size)
            st.lh = p / st.size
    if ff := cs.get("font-family")
        low := ff.to_lower()
        if low.contains("mono") or low.contains("courier") or low.contains("consolas")
            st.mono = true
        else
            st.serif = first_family_is_serif(low)
    if tt := cs.get("text-transform")
        st.upper = tt == "uppercase"
    if ws := cs.get("white-space")
        st.pre = ws == "pre" or ws == "pre-wrap" or ws == "pre-line"
        st.nowrap = ws == "nowrap"
    st

## The box of element `id`, from its tag defaults and cascaded values.
fn box_of(tag str, cs Map[str, str], st St, avail float) Bx
    mut b := Bx(
        bg: none,
        mt: 0.0,
        mr: 0.0,
        mb: 0.0,
        ml: 0.0,
        pt: 0.0,
        pr: 0.0,
        pb: 0.0,
        pl: 0.0,
        bt: 0.0,
        br: 0.0,
        bb: 0.0,
        bl: 0.0,
        bcolor: st.color,
        width: none,
        max_width: none,
        height: none,
        radius: 0.0,
        pos: "",
        top: none,
        right: none,
        left: none,
        float_side: "",
        bottom: none,
        ml_auto: false,
        mr_auto: false,
        min_width: none,
        min_height: none,
        max_height: none,
        aspect: 0.0,
        clips: overflow_clips(cs),
    )
    size := st.size
    match tag
        "p" | "ul" | "ol" | "dl" | "pre" | "figure" =>
            b.mt = size
            b.mb = size
        "blockquote" =>
            b.mt = size
            b.mb = size
            b.ml = 40.0
            b.mr = 40.0
        "h1" =>
            b.mt = size * 0.67
            b.mb = size * 0.67
        "h2" =>
            b.mt = size * 0.83
            b.mb = size * 0.83
        "h3" | "h5" | "h6" =>
            b.mt = size
            b.mb = size
        "h4" =>
            b.mt = size * 1.33
            b.mb = size * 1.33
        "dd" => b.ml = 40.0
        "hr" =>
            b.mt = 8.0
            b.mb = 8.0
        "table" => b.mt = 0.0
        "td" | "th" =>
            b.pt = 1.0
            b.pb = 1.0
            b.pl = 1.0
            b.pr = 1.0
        _ => b.mt = 0.0
    if tag == "ul" or tag == "ol" or tag == "menu"
        b.pl = 40.0
    if tag == "body"
        b.mt = 8.0
        b.mb = 8.0
        b.ml = 8.0
        b.mr = 8.0
    if v := cs.get("margin")
        m := sides(v, size, avail)
        b.mt = m.0
        b.mr = m.1
        b.mb = m.2
        b.ml = m.3
        b.ml_auto = m.4
        b.mr_auto = m.5
    for name in ["margin-top", "margin-block-start", "margin-block"]
        if v := cs.get(name)
            b.mt = length(v, size, avail) else b.mt
    for name in ["margin-bottom", "margin-block-end", "margin-block"]
        if v := cs.get(name)
            b.mb = length(v, size, avail) else b.mb
    for name in ["margin-left", "margin-inline-start", "margin-inline"]
        if v := cs.get(name)
            if v.trim() == "auto"
                b.ml_auto = true
            else
                b.ml = length(v, size, avail) else b.ml
    for name in ["margin-right", "margin-inline-end", "margin-inline"]
        if v := cs.get(name)
            if v.trim() == "auto"
                b.mr_auto = true
            else
                b.mr = length(v, size, avail) else b.mr
    if v := cs.get("padding")
        p := sides(v, size, avail)
        b.pt = p.0
        b.pr = p.1
        b.pb = p.2
        b.pl = p.3
    if v := cs.get("padding-top")
        b.pt = length(v, size, avail) else b.pt
    if v := cs.get("padding-bottom")
        b.pb = length(v, size, avail) else b.pb
    for name in ["padding-left", "padding-inline-start", "padding-inline"]
        if v := cs.get(name)
            b.pl = length(v, size, avail) else b.pl
    for name in ["padding-right", "padding-inline-end", "padding-inline"]
        if v := cs.get(name)
            b.pr = length(v, size, avail) else b.pr
    if v := cs.get("border")
        p := border_part(v, size, st.color, st.under)
        b.bt = p.0
        b.br = p.0
        b.bb = p.0
        b.bl = p.0
        b.bcolor = p.1
    if v := cs.get("border-width")
        m := sides(v, size, avail)
        b.bt = m.0
        b.br = m.1
        b.bb = m.2
        b.bl = m.3
    if v := cs.get("border-color")
        b.bcolor = color_over(with_current(v, st.color), st.under) else b.bcolor
    if v := cs.get("border-top")
        p := border_part(v, size, st.color, st.under)
        b.bt = p.0
        b.bcolor = p.1
    if v := cs.get("border-bottom")
        p := border_part(v, size, st.color, st.under)
        b.bb = p.0
        b.bcolor = p.1
    if v := cs.get("border-left")
        p := border_part(v, size, st.color, st.under)
        b.bl = p.0
        b.bcolor = p.1
    if v := cs.get("border-right")
        p := border_part(v, size, st.color, st.under)
        b.br = p.0
        b.bcolor = p.1
    if v := cs.get("background-color")
        b.bg = color_over(with_current(v, st.color), st.under)
    if v := cs.get("background")
        for t in tokens(with_current(v, st.color))
            if k := color_over(t, st.under)
                b.bg = k
        if b.bg == none
            b.bg = gradient_first(v)
        if v.trim() == "none" or v.trim() == "transparent"
            b.bg = none
    ## An icon cut out by a mask picture (`mask-image: url(...)`) is not
    ## drawn as the solid box under it (review W7) until masks are painted.
    for name in ["mask-image", "-webkit-mask-image", "mask", "-webkit-mask"]
        if (cs.get(name) else "").contains("url(")
            b.bg = none
    clip := cs.get("background-clip") else (cs.get("-webkit-background-clip") else "")
    if clip.trim() == "text"
        b.bg = none
    ## Measuring (avail >= SHRINK_W): a percentage of the huge column means nothing.
    if v := cs.get("width")
        if not (avail >= SHRINK_W and v.trim().ends_with("%"))
            b.width = length(v, size, avail)
    if v := cs.get("max-width")
        if not (avail >= SHRINK_W and v.trim().ends_with("%"))
            b.max_width = length(v, size, avail)
    if v := cs.get("border-radius")
        ts := tokens(v)
        if ts.len() > 0
            if p := ts[0].strip_suffix("%")
                b.radius = 0.0 - (p.to_float() else 0.0)
            else
                b.radius = length(ts[0], size, avail) else 0.0
    if v := cs.get("position")
        b.pos = v.trim()
    if v := cs.get("top")
        b.top = length(v, size, avail)
    if v := cs.get("right")
        b.right = length(v, size, avail)
    if v := cs.get("left")
        b.left = length(v, size, avail)
    if v := cs.get("bottom")
        b.bottom = length(v, size, avail)
    if v := cs.get("float")
        b.float_side = v.trim()
    if v := cs.get("height")
        b.height = length(v, size, 0.0)
    if v := cs.get("min-height")
        b.min_height = length(v, size, 0.0)
    if v := cs.get("max-height")
        b.max_height = length(v, size, 0.0)
    if v := cs.get("min-width")
        if not (avail >= SHRINK_W and v.trim().ends_with("%"))
            b.min_width = length(v, size, avail)
    if v := cs.get("aspect-ratio")
        b.aspect = ratio_of(v)
    if v := cs.get("inset")
        ts := tokens(v)
        n := ts.len()
        if n > 0
            ## Top, right, bottom and left as `margin` gives them; a side
            ## set on its own wins (CSS Positioned Layout 3 §3.1).
            mut four := [ts[0], ts[0], ts[0], ts[0]]
            if n == 2
                four = [ts[0], ts[1], ts[0], ts[1]]
            elif n == 3
                four = [ts[0], ts[1], ts[2], ts[1]]
            elif n >= 4
                four = [ts[0], ts[1], ts[2], ts[3]]
            if cs.get("top") == none
                b.top = length(four[0], size, avail)
            if cs.get("right") == none
                b.right = length(four[1], size, avail)
            if cs.get("bottom") == none
                b.bottom = length(four[2], size, avail)
            if cs.get("left") == none
                b.left = length(four[3], size, avail)
    b

## `aspect-ratio: w / h`, `w/h` or a number as width over height; 0 for
## `auto` and anything unreadable. `auto 16 / 9` takes the ratio.
fn ratio_of(v str) float
    t := v.replace("auto", "").trim()
    if t == ""
        return 0.0
    parts := t.split("/")
    a := css_float(parts[0]) else 0.0
    b := if parts.len() > 1 then (css_float(parts[1]) else 0.0) else 1.0
    if a <= 0.0 or b <= 0.0
        return 0.0
    a / b

## Whether `overflow`, `overflow-x` or `overflow-y` in `cs` cuts the content
## off at the padding box (`hidden`, `clip`, `auto`, `scroll`).
fn overflow_clips(cs Map[str, str]) bool
    for name in ["overflow", "overflow-x", "overflow-y"]
        if v := cs.get(name)
            for t in tokens(v.trim())
                if t == "hidden" or t == "clip" or t == "auto" or t == "scroll"
                    return true
    false

# ---- Layout ---------------------------------------------------------------

## `color` over the rounded rectangle (`x`, `y`, `w`, `h`) with corners of
## radius `r`: a few strips, since the host fills only rectangles.
fn rounded(x float, y float, w float, h float, r float, fill int) List[draw.Op]
    rr := fmin(r, fmin(w, h) / 2.0)
    if rr < 1.0
        return [draw.Op.Rect(x, y, w, h, fill)]
    step := if rr > 8.0 then 2.0 else 1.0
    mut out := List[draw.Op]()
    out.push(draw.Op.Rect(x: x, y: y + rr, w: w, h: h - 2.0 * rr, color: fill))
    mut i := 0.0
    while i < rr
        mid := rr - i - step / 2.0
        inset := rr - (rr * rr - mid * mid).pow(0.5)
        out.push(draw.Op.Rect(x: x + inset, y: y + i, w: w - 2.0 * inset, h: step, color: fill))
        out.push(draw.Op.Rect(
            x: x + inset,
            y: y + h - i - step,
            w: w - 2.0 * inset,
            h: step,
            color: fill,
        ))
        i += step
    out

## One piece of an inline run: a word, a space, a line break, an image or
## a form control.
struct Atom
    kind int
    text str
    w float
    h float
    size float
    st St
    src str
    ## The look of a control: fill, edge and text colors.
    fill int
    edge int
    ## The form control's node, -1 if none.
    node int
    ## A picture's drawn size inside its box (`object-fit`), else the box's.
    pw float
    ph float
    ## An inline box's (`BOX`) operations and hit boxes, laid out from
    ## (0, 0); `emit` moves them to where the line puts the box.
    sub List[draw.Op]
    sub_hits List[Hit]

WORD := 0
SPACE := 1
BREAK := 2
IMAGE := 3
CONTROL := 4
## An inline-level box laid out on its own (`inline-block`, `inline-flex`,
## a styled `button`): CSS 2.1 §9.2.2 atomic inline.
BOX := 5

## An atom of `kind` with the other fields empty.
fn atom_of(kind int, text str, w float, h float, st St) Atom
    Atom(
        kind,
        text,
        w,
        h,
        size: st.size,
        st,
        src: "",
        fill: 0,
        edge: 0,
        node: -1,
        pw: w,
        ph: h,
        sub: [],
        sub_hits: [],
    )

## A float's box, which text beside it wraps around.
struct Float
    x float
    y float
    w float
    h float
    right bool

struct Ctx
    d html.Doc
    svgs Map[str, images.Bitmap]
    sheet css.Sheet
    url str
    ops List[draw.Op]
    hits List[Hit]
    boxes List[Box]
    atoms List[Atom]
    ## The next line starts here, and the margin still owed above it.
    y float
    pend float
    ## The list marker waiting for its first line, and its right edge.
    marker str
    marker_x float
    canvas int
    ## Cascaded styles and raw cascades by node.
    styles Map[int, Map[str, str]]
    cascades Map[int, Map[str, str]]
    ## Custom properties: for each node the nearest element at or above it
    ## that declares any (-1 for none), and each such element's own resolved
    ## values by `var_key`. No node keeps a copy of all the names in scope.
    var_owner Map[int, int]
    var_vals Map[str, str]
    ## A height the next `block` call must take (a grown column flex item),
    ## or -1.
    force_h float
    ## Widest-line widths of nodes, by node.
    contents Map[int, float]
    ## The text field being typed into, drawn with a caret; -1 for none.
    editing int
    ## Each picture's `[width, height]` by address, once fetched.
    pics Map[str, List[int]]
    ## Widths the host measured, by `probe_key`, and the runs still estimated.
    meas Map[str, float]
    probes List[Probe]
    probed Set[str]
    ## Floats in force, the positioned ancestor's padding box, and the
    ## column being filled.
    floats List[Float]
    ax float
    ay float
    aw float
    page_w float
    col_x float
    col_w float
    ## The right edge of the shrink-wrapped floats placed while measuring, so
    ## their padding and border count even when nothing is drawn there.
    reach float
    ## The window, for viewport units (`viewport_px`).
    view_w float
    view_h float
    ## Whether each element is drawn at all (`Ctx.shows`), by node.
    shown Map[int, bool]

CONTROLS := {"button", "input", "select", "textarea"}
FLOW_FLEX := {"flex", "inline-flex"}

## Whether element `id` is drawn at all (cached per layout): see `Ctx.shows`.
fn Ctx.visible(mut self, id int) bool
    if self.d.nodes[id].kind != Element
        return false
    if cached := self.shown.get(id)
        return cached
    ok := self.shows(id)
    self.shown[id] = ok
    ok

## Whether element `id` is drawn: not metadata, not `hidden`, not a closed
## `dialog` or a `popover` (HTML §6.12, §15.3.3; a popover script opened is
## not known here), not the content of a closed `details` other than its
## first `summary` (HTML §4.11.1), and not hidden by its style (`hidden_box`).
fn Ctx.shows(mut self, id int) bool
    tag := self.d.nodes[id].tag
    if page.HIDDEN.contains(tag) or self.d.attr(id, "hidden") != none
        return false
    if tag == "dialog" and self.d.attr(id, "open") == none
        return false
    if self.d.attr(id, "popover") != none
        return false
    if page.closed_child(self.d, id)
        return false
    not hidden_box(self.element_style(id))

## Whether cascaded values `cs` hide the box and everything in it without
## `display: none`, by the patterns sites use to hide text from the eye
## (review W5, G3, X6): a `clip: rect()` of at most a pixel on an
## absolutely positioned box, `clip-path: inset(50%)` or more, an
## overflow-cutting box at most a pixel wide or high with no padding to show,
## a `scale(0)` transform, `content-visibility: hidden`, or an absolutely
## positioned box moved a thousand pixels or more off the page's top or left.
fn hidden_box(cs Map[str, str]) bool
    pos := (cs.get("position") else "").trim()
    if pos == "absolute" or pos == "fixed"
        if v := cs.get("clip")
            if tiny_rect(v)
                return true
        for side in ["left", "top", "right"]
            if v := cs.get(side)
                if (length(v, 16.0, 0.0) else 0.0) <= -999.0
                    return true
    if v := cs.get("clip-path")
        shape := v.trim().replace(" ", "")
        if shape.starts_with("inset(50%") or shape.starts_with("inset(100%") or shape.starts_with("circle(0")
            return true
    ## A flex item that grows (`flex: 1; width: 0; overflow: hidden`, the
    ## truncation idiom) is given its width by its container, not hidden.
    if overflow_clips(cs) and flex_of(cs).grow <= 0.0
        for name in ["width", "max-width"]
            if v := cs.get(name)
                if not v.contains("%") and (length(v, 16.0, 0.0) else 2.0) <= 1.0
                    if not padded_in(cs, ["padding", "padding-left", "padding-right", "padding-inline"])
                        return true
        for name in ["height", "max-height"]
            if v := cs.get(name)
                if not v.contains("%") and (length(v, 16.0, 0.0) else 2.0) <= 1.0
                    if not padded_in(cs, ["padding", "padding-top", "padding-bottom", "padding-block"])
                        return true
    if v := cs.get("transform")
        tf := v.replace(" ", "")
        if tf.contains("scale(0)") or tf.contains("scale(0,0)") or tf.contains("scalex(0)") or tf.contains("scaley(0)")
            return true
    (cs.get("content-visibility") else "").trim() == "hidden"

## Whether `clip: rect(top right bottom left)` leaves at most a pixel each way.
fn tiny_rect(v str) bool
    t := v.trim()
    inner := t.strip_prefix("rect(") else return false
    nums := color_args(inner.replace(")", ""))
    if nums.len() != 4
        return false
    mut vals := List[float]()
    for n in nums
        vals.push(length(n, 16.0, 0.0) else 0.0)
    vals[2] - vals[0] <= 1.0 and vals[1] - vals[3] <= 1.0

## Whether any of the padding properties `names` in `cs` is more than zero.
fn padded_in(cs Map[str, str], names List[str]) bool
    for name in names
        if v := cs.get(name)
            for t in tokens(v)
                if (length(t, 16.0, 100.0) else 0.0) > 0.0
                    return true
    false

## Properties whose value is inherited by default (CSS 2.1 property index),
## among those Garlic reads: for these `inherit` and `unset` are what the
## layout does with no value at all.
INHERITED := {
    "color",
    "font",
    "font-size",
    "font-weight",
    "font-style",
    "font-family",
    "line-height",
    "text-align",
    "text-transform",
    "white-space",
    "visibility",
    "list-style",
    "list-style-type",
    "color-scheme",
    "-webkit-text-fill-color",
    "overflow-wrap",
}

## Element `id`'s cascaded values with custom properties substituted,
## viewport units in pixels (`viewport_px`), and the CSS-wide keywords
## resolved (CSS Cascade 4 §7.3): `inherit` on a property that is not
## inherited takes the parent's value; `initial`, `unset`, `revert` and
## `revert-layer` drop the value so the tag's default applies, and so do
## `inherit` and `unset` on an inherited one (the text style already
## inherits). `display` keeps its keyword for `is_block`.
fn Ctx.element_style(mut self, id int) Map[str, str]
    if self.d.nodes[id].tag == "#document"
        return Map[str, str]()
    if cached := self.styles.get(id)
        return cached
    r := self.cascaded(id)
    owner := self.var_owner_of(id)
    none_own := Map[str, str]()
    mut out := Map[str, str]()
    for k in r.keys()
        if k.starts_with("--")
            continue
        v := viewport_px(self.subst_at(r[k], none_own, owner), self.view_w, self.view_h)
        t := v.trim()
        if k == "display"
            out[k] = v
        elif t == "inherit" and not INHERITED.contains(k)
            parent := self.d.nodes[id].parent
            if pv := self.element_style(parent).get(k)
                out[k] = pv
        elif t == "inherit" or t == "initial" or t == "unset" or t == "revert" or t == "revert-layer"
            continue
        else
            out[k] = v
    self.styles[id] = out
    out

fn Ctx.cascaded(mut self, id int) Map[str, str]
    if cached := self.cascades.get(id)
        return cached
    r := css.cascade(self.d, id, self.sheet)
    self.cascades[id] = r
    r

## The key of custom property `name` declared on element `owner` in `var_vals`.
fn var_key(owner int, name str) str
    "{owner}|{name}"

## The nearest element at or above node `id` that declares custom
## properties, or -1; on the way, each declaring element's own values are
## resolved into `var_vals`. A node that declares none points at its
## ancestor's, so nothing is copied per node (review-speed 3.4).
fn Ctx.var_owner_of(mut self, id int) int
    if cached := self.var_owner.get(id)
        return cached
    up := if id == 0 then -1 else self.var_owner_of(self.d.nodes[id].parent)
    mut owner := up
    if self.d.nodes[id].kind == Element
        r := self.cascaded(id)
        mut own := Map[str, str]()
        for k in r.keys()
            if k.starts_with("--")
                own[k] = self.subst_at(r[k], own, up)
        if own.len() > 0
            for k in own.keys()
                self.var_vals[var_key(id, k)] = own[k]
            owner = id
    self.var_owner[id] = owner
    owner

## Custom property `name` in the scope whose nearest declaring element is
## `owner`: that element's value, else its ancestors'.
fn Ctx.var_value(mut self, owner int, name str) str?
    mut o := owner
    mut guard := 0
    while o >= 0 and guard < 4096
        guard += 1
        if v := self.var_vals.get(var_key(o, name))
            return v
        o = if o == 0 then -1 else self.var_owner_of(self.d.nodes[o].parent)
    none

## `v` with each `var(--x)` and `var(--x, fallback)` replaced: from `own`
## first (the element's own earlier declarations), then from the scope of
## declaring element `owner`.
fn Ctx.subst_at(mut self, v str, own Map[str, str], owner int) str
    if not v.contains("var(")
        return v
    mut out := v
    mut guard := 0
    while guard < 16
        guard += 1
        at := out.find("var(") else break
        cs := out.chars()
        mut depth := 1
        mut k := at + 4
        mut comma := -1
        while k < cs.len() and depth > 0
            if cs[k] == '('
                depth += 1
            elif cs[k] == ')'
                depth -= 1
            elif cs[k] == ',' and depth == 1 and comma < 0
                comma = k
            k += 1
        if depth != 0
            break
        close := k - 1
        stop := if comma >= 0 then comma else close
        name := out.slice(at + 4, stop).trim()
        fallback := if comma >= 0 then out.slice(comma + 1, close).trim() else ""
        mut val := fallback
        if mine := own.get(name)
            val = mine
        elif found := self.var_value(owner, name)
            val = found
        out = "{out.slice(0, at)}{val}{out.slice(close + 1, cs.len())}"
    out

fn Ctx.is_block(mut self, id int, cs Map[str, str]) bool
    tag := self.d.nodes[id].tag
    display := cs.get("display") else ""
    if display == "none"
        return false
    if display == "" or display == "unset" or display == "revert" or display == "inherit"
        return page.BLOCKS.contains(tag) or tag == "li" or tag == "tr" or tag == "td" or tag == "th"
    ## The initial value of `display` is `inline` (CSS Display 3 §2).
    if display == "initial"
        return false
    display.starts_with("inline") == false

## Moves the pending margin into the flow.
fn Ctx.settle(mut self)
    self.y += self.pend
    self.pend = 0.0

## `cs` plus what the attributes of `a` elements add: the resolved target
## and the label.
fn Ctx.with_attrs(mut self, id int, tag str, cs Map[str, str]) Map[str, str]
    mut out := cs
    if tag == "a"
        if h := self.d.attr(id, "href")
            out["href"] = page.resolve(self.url, h)
        out["node"] = "{id}"
        out["alt-label"] = self.d.attr(id, "aria-label") else (self.d.attr(id, "title") else "")
    out

fn Ctx.add_text(mut self, raw str, st St)
    mut text := raw
    if st.upper
        text = text.to_upper()
    if st.pre
        lines := text.replace("\r", "").split("\n")
        for k in 0..lines.len()
            if k > 0
                self.atoms.push(self.break_atom(st))
            if lines[k] != ""
                self.atoms.push(self.word_atom(lines[k], st))
        return
    mut cur := List[char]()
    mut gap := false
    for c in text.chars()
        if c == ' ' or c == '\n' or c == '\t' or c == '\r'
            if cur.len() > 0
                self.atoms.push(self.word_atom(cur.join(""), st))
                cur = []
            gap = true
            if self.atoms.len() == 0 or self.atoms[self.atoms.len() - 1].kind != SPACE
                self.atoms.push(self.space_atom(st))
        elif breaks_anywhere(c)
            if cur.len() > 0
                self.atoms.push(self.word_atom(cur.join(""), st))
                cur = []
            self.atoms.push(self.word_atom([c].join(""), st))
        else
            cur.push(c)
    if cur.len() > 0
        self.atoms.push(self.word_atom(cur.join(""), st))

## Whether a line may break after `c` with no space: the ideographs, kana,
## Hangul syllables and full-width forms (UAX 14 classes ID and similar).
fn breaks_anywhere(c char) bool
    k := c.code()
    (k >= 0x3040 and k <= 0x30ff)
        or (k >= 0x3400 and k <= 0x4dbf)
        or (k >= 0x4e00 and k <= 0x9fff)
        or (k >= 0xac00 and k <= 0xd7af)
        or (k >= 0xff00 and k <= 0xffef)
        or (k >= 0x20000 and k <= 0x3ffff)

## The width of a run: the host's measure when there is one, else the
## estimate, which is then noted so the host can be asked.
fn Ctx.tw(mut self, text str, size float, bold bool, italic bool, font str) float
    key := probe_key(text, size, bold, italic, font)
    if w := self.meas.get(key)
        return w
    if text != "" and not self.probed.contains(key)
        self.probed.add(key)
        self.probes.push(Probe(text, size, bold, italic, font))
    text_width(text, size, bold, font == "mono")

fn Ctx.word_atom(mut self, text str, st St) Atom
    atom_of(WORD, text, self.tw(text, st.size, st.bold, st.italic, font_of(st)), st.size * st.lh, st)

fn Ctx.space_atom(mut self, st St) Atom
    atom_of(SPACE, " ", self.tw(" ", st.size, st.bold, st.italic, font_of(st)), st.size * st.lh, st)

fn Ctx.break_atom(mut self, st St) Atom
    atom_of(BREAK, "", 0.0, st.size * st.lh, st)

## Lays out the pending inline atoms as lines in the column from `x`, `w`
## wide.
fn Ctx.flush(mut self, x float, w float, align0 str)
    if self.atoms.len() == 0
        return
    ## In the very wide column `max_content` measures in, nothing is centred
    ## or pushed right: the extent would be the column's.
    align := if w >= SHRINK_W then "left" else align0
    mut line := List[Atom]()
    mut lw := 0.0
    mut lx := x
    mut room := w
    mut pending := self.atoms
    self.atoms = []
    for a in pending
        if a.kind == BREAK
            self.emit(line, lx, room, align, a.h)
            line = []
            lw = 0.0
        elif a.kind == SPACE
            if line.len() > 0 and line[line.len() - 1].kind != SPACE
                line.push(a)
                lw += a.w
        else
            if line.len() == 0
                beside := self.avail(x, w, self.y + self.pend, self.y + self.pend + a.h)
                lx = beside.0
                room = beside.1
            if lw + a.w > room + 0.5 and not a.st.nowrap and not a.st.pre
                if self.has_content(line)
                    self.emit(line, lx, room, align, 0.0)
                    line = []
                    lw = 0.0
                    beside := self.avail(x, w, self.y + self.pend, self.y + self.pend + a.h)
                    lx = beside.0
                    room = beside.1
            line.push(a)
            lw += a.w
    if self.has_content(line)
        self.emit(line, lx, room, align, 0.0)

## The part of the column from `x`, `w` wide that floats leave free between
## `top` and `bottom`, as (left edge, width).
fn Ctx.avail(self, x float, w float, top float, bottom float)(float, float)
    mut left := x
    mut right := x + w
    for f in self.floats
        if f.y < bottom and f.y + f.h > top
            if f.right
                right = fmin(right, f.x)
            else
                left = fmax(left, f.x + f.w)
    (left, fmax(right - left, 40.0))

## The host font family a style is drawn in.
fn font_of(st St) str
    if st.mono
        return "mono"
    if st.serif then "serif" else "sans"

## Faces and generics that decide a `font-family` list.
SANS_FACES := [
    "sans-serif",
    "system-ui",
    "-apple-system",
    "arial",
    "helvetica",
    "verdana",
    "tahoma",
    "roboto",
    "segoe ui",
    "inter",
]

SERIF_FACES := [
    "serif",
    "georgia",
    "times",
    "times new roman",
    "garamond",
    "palatino",
    "cambria",
    "book antiqua",
    "baskerville",
]

## Whether the first family in a lower-cased `font-family` list that names a
## known face or generic is a serif one (`Georgia, serif`, not `Arial, serif`).
fn first_family_is_serif(low str) bool
    for part in low.split(",")
        name := part.replace("'", "").replace("\"", "").trim()
        if SANS_FACES.contains(name)
            return false
        if SERIF_FACES.contains(name)
            return true
    false

fn same_look(a St, b St) bool
    a.color == b.color
        and a.bold == b.bold
        and a.italic == b.italic
        and a.underline == b.underline
        and a.mono == b.mono
        and a.serif == b.serif
        and a.href == b.href
        and a.ghost == b.ghost
        and a.fade == b.fade
        and a.clear == b.clear

fn Ctx.has_content(mut self, line List[Atom]) bool
    for a in line
        if a.kind != SPACE
            return true
    false

## How far atom `a` rises above its line's baseline: a picture sits on it,
## text and controls are centred on the text's middle.
fn atom_asc(a Atom) float
    if a.kind == IMAGE
        return a.h
    (a.h - a.size) / 2.0 + a.size * 0.9

## Draws one line of atoms at `y`; `empty` is the height of an empty
## line (a `<br>`).
fn Ctx.emit(mut self, atoms_in List[Atom], x float, w float, align str, empty float)
    mut line := atoms_in
    while line.len() > 0 and line[line.len() - 1].kind == SPACE
        line.pop()
    if line.len() == 0
        self.settle()
        self.y += empty
        return
    self.settle()
    mut total := 0.0
    mut asc := 0.0
    mut desc := 0.0
    for a in line
        total += a.w
        a_asc := atom_asc(a)
        asc = fmax(asc, a_asc)
        desc = fmax(desc, a.h - a_asc)
    mut cx := x
    if align == "center"
        cx = x + fmax((w - total) / 2.0, 0.0)
    elif align == "right" or align == "end"
        cx = x + fmax(w - total, 0.0)
    if self.marker != ""
        first := line[0]
        mw := self.tw(self.marker, first.size, false, false, "sans")
        if inked(first.st)
            self.ops.push(draw.Op.Str(
                x: self.marker_x - mw,
                y: self.y + asc - atom_asc(first),
                text: self.marker,
                font: "sans",
                size: first.size,
                fg: tint(first.st.color, first.st),
                bold: false,
                italic: false,
                underline: false,
            ))
        self.marker = ""
    mut k := 0
    while k < line.len()
        a := line[k]
        a_asc := atom_asc(a)
        top := self.y + asc - a_asc
        inks := inked(a.st)
        ## Neighbouring words in one style are drawn as one string, so the
        ## host spaces them itself; only the estimate places the string.
        if a.kind == WORD or a.kind == SPACE
            mut text := a.text
            mut run_w := a.w
            mut j := k + 1
            while j < line.len() and (line[j].kind == WORD or line[j].kind == SPACE) and same_look(
                line[j].st,
                a.st,
            ) and line[j].size == a.size
                text = "{text}{line[j].text}"
                run_w += line[j].w
                j += 1
            if text.trim() != "" and inks
                if not a.st.clear
                    self.ops.push(draw.Op.Str(
                        x: cx,
                        y: top,
                        text: text.trim_end(),
                        font: font_of(a.st),
                        size: a.size,
                        fg: tint(a.st.color, a.st),
                        bold: a.st.bold,
                        italic: a.st.italic,
                        underline: a.st.underline,
                    ))
                if a.st.href != ""
                    self.hits.push(Hit(
                        x: cx,
                        y: top,
                        w: run_w,
                        h: a.h,
                        href: a.st.href,
                        node: -1,
                        anchor: a.st.node,
                    ))
            cx += run_w
            k = j
            continue
        elif a.kind == IMAGE and inks
            py := self.y + asc - a.h
            if a.src != ""
                self.ops.push(draw.Op.Pic(
                    x: cx + (a.w - a.pw) / 2.0,
                    y: py + (a.h - a.ph) / 2.0,
                    w: a.pw,
                    h: a.ph,
                    src: a.src,
                ))
            elif a.text != ""
                self.alt_in_box(a, cx, py)
            if a.st.href != ""
                self.hits.push(Hit(
                    x: cx,
                    y: py,
                    w: a.w,
                    h: a.h,
                    href: a.st.href,
                    node: -1,
                    anchor: a.st.node,
                ))
        elif a.kind == BOX
            for op in a.sub
                self.ops.push(moved(op, cx, top))
            for hh in a.sub_hits
                self.hits.push(Hit(
                    x: hh.x + cx,
                    y: hh.y + top,
                    w: hh.w,
                    h: hh.h,
                    href: hh.href,
                    node: hh.node,
                    anchor: hh.anchor,
                ))
            if a.node >= 0 and inks
                self.hits.push(Hit(x: cx, y: top, w: a.w, h: a.h, href: "", node: a.node, anchor: -1))
        elif a.kind == CONTROL and inks
            cy := self.y + asc - a.h * 0.8
            self.hits.push(Hit(x: cx, y: cy, w: a.w, h: a.h, href: "", node: a.node, anchor: -1))
            self.ops.push(draw.Op.Rect(x: cx, y: cy, w: a.w, h: a.h, color: tint(a.edge, a.st)))
            self.ops.push(draw.Op.Rect(
                x: cx + 1.0,
                y: cy + 1.0,
                w: a.w - 2.0,
                h: a.h - 2.0,
                color: tint(a.fill, a.st),
            ))
            self.ops.push(draw.Op.Str(
                x: cx + 6.0,
                y: cy + (a.h - a.size) / 2.0 - 1.0,
                text: a.text,
                font: "sans",
                size: a.size,
                fg: tint(a.st.color, a.st),
                bold: false,
                italic: false,
                underline: false,
            ))
        cx += a.w
        k += 1
    self.y += asc + desc
    self.pend = 0.0

## The `alt` text of picture atom `a` that could not be drawn, inside its
## box at (`x`, `y`): wrapped to the box's width, and only the lines that
## fit its height (HTML §15.4.2 renders it in the picture's place).
fn Ctx.alt_in_box(mut self, a Atom, x float, y float)
    size := fmin(a.size, 13.0)
    line_h := size * 1.2
    room := a.w - 4.0
    if room < size or a.h < line_h
        return
    mut at := y + 2.0
    mut cur := List[str]()
    for word in a.text.split(" ")
        if word == ""
            continue
        cur.push(word)
        if cur.len() > 1 and text_width(cur.join(" "), size, false, false) > room
            cur.pop()
            if at + line_h > y + a.h
                return
            self.alt_line(cur.join(" "), x + 2.0, at, size, room, a.st)
            at += line_h
            cur = [word]
    if cur.len() > 0 and at + line_h <= y + a.h
        self.alt_line(cur.join(" "), x + 2.0, at, size, room, a.st)

## One line of `alt` text, cut to `room` pixels.
fn Ctx.alt_line(mut self, text str, x float, y float, size float, room float, st St)
    self.ops.push(draw.Op.Str(
        x,
        y,
        text: fit_text(text, size, false, room),
        font: "sans",
        size,
        fg: tint(st.color, st),
        bold: false,
        italic: false,
        underline: false,
    ))

## The longest start of `text` that is at most `room` pixels wide at `size`.
fn fit_text(text str, size float, bold bool, room float) str
    fit_text_in(text, size, bold, false, room)

## `fit_text` in a proportional or (`mono`) fixed font.
fn fit_text_in(text str, size float, bold bool, mono bool, room float) str
    if text_width(text, size, bold, mono) <= room
        return text
    cs := text.chars()
    mut used := 0.0
    mut n := 0
    for c in cs
        cw := text_width([c].join(""), size, bold, mono)
        if used + cw > room
            break
        used += cw
        n += 1
    cs[0..n].join("")

## A picture (`img`, or a `canvas` a script drew) as an atom: CSS 2.1
## §10.3.2 and §10.6.2 with CSS Sizing 4 §5 (`aspect-ratio`). A side CSS sets
## wins over the `width`/`height` attributes, which only count when CSS sets
## neither (HTML §15.4.1); a missing side follows the shape, from the
## picture itself, else the attributes, else `aspect-ratio`. `min-width`,
## `max-width` and `max-height` then hold it, keeping the shape, and it never
## overflows `avail`. `object-fit` places the picture in its box. A picture
## that was fetched and cannot be decoded keeps its box and shows its `alt`
## text inside it (review B6). `none` when nothing gives a size: the caller
## shows the `alt` text inline.
fn Ctx.image_atom(mut self, id int, cs Map[str, str], st St, avail float) Atom?
    # A `<canvas>` is a picture too: scripts publish its bitmap as a `data:`
    # address in `data-garlic-pixels` (js/vm/canvas2d.ail).
    pic_attr := if self.d.nodes[id].tag == "canvas" then "data-garlic-pixels" else "src"
    src := (if pic_attr == "src" then images.source_of(self.d, id) else self.d.attr(id, pic_attr))?
    at := page.resolve(self.url, src)
    nat := self.pics.get(at) else [0, 0]
    known := nat[0] > 0 and nat[1] > 0
    broken := self.pics.contains(at) and not known
    nw := nat[0].to_float()
    nh := nat[1].to_float()
    measuring := avail >= SHRINK_W
    aw := (self.d.attr(id, "width") else "0").replace("px", "").to_float() else 0.0
    ah := (self.d.attr(id, "height") else "0").replace("px", "").to_float() else 0.0
    mut ratio := 0.0
    if known
        ratio = nw / nh
    elif aw > 0.0 and ah > 0.0
        ratio = aw / ah
    ar := cs.get("aspect-ratio") else ""
    if ratio_of(ar) > 0.0 and not (known and ar.contains("auto"))
        ratio = ratio_of(ar)
    mut w := -1.0
    mut h := -1.0
    if v := cs.get("width")
        if not (measuring and v.contains("%"))
            w = length(v, st.size, avail) else -1.0
    if v := cs.get("height")
        if not v.contains("%")
            h = length(v, st.size, 0.0) else -1.0
    if w < 0.0 and h < 0.0
        if aw > 0.0
            w = aw
        if ah > 0.0
            h = ah
    if w < 0.0 and h < 0.0 and known
        w = nw
        h = nh
    if w >= 0.0 and h < 0.0
        if ratio > 0.0
            h = w / ratio
        elif known
            h = nh
    if h >= 0.0 and w < 0.0
        if ratio > 0.0
            w = h * ratio
        elif known
            w = nw
    if w < 0.0 or h < 0.0
        return none
    if v := cs.get("max-width")
        if not (measuring and v.contains("%"))
            if mw := length(v, st.size, avail)
                if w > mw
                    h = if ratio > 0.0 then mw / ratio else h
                    w = mw
    if v := cs.get("min-width")
        if not v.contains("%")
            if mn := length(v, st.size, avail)
                if w < mn
                    h = if ratio > 0.0 then mn / ratio else h
                    w = mn
    if v := cs.get("max-height")
        if not v.contains("%")
            if mh := length(v, st.size, 0.0)
                if h > mh
                    w = if ratio > 0.0 then mh * ratio else w
                    h = mh
    if w > avail
        h = h * avail / w
        w = avail
    mut a := atom_of(IMAGE, "", w, h, st)
    if broken
        ## Nothing to draw: the box keeps its place and says what it held.
        a.text = self.d.attr(id, "alt") else ""
        return a
    a.src = at
    if known and w > 0.0 and h > 0.0
        fit := (cs.get("object-fit") else "fill").trim()
        if fit == "contain" or fit == "scale-down" or fit == "none"
            mut k := fmin(w / nw, h / nh)
            if fit != "contain"
                k = fmin(k, 1.0)
            a.pw = nw * k
            a.ph = nh * k
    a

fn Ctx.control_atom(mut self, id int, st St) Atom?
    tag := self.d.nodes[id].tag
    kind := self.d.attr(id, "type") else "text"
    if tag == "input" and (kind == "hidden")
        return none
    mut label := ""
    mut w := 160.0
    mut fill := 0xffffff
    mut ink := st
    if tag == "button" or kind == "submit" or kind == "button" or kind == "reset"
        label = if tag
            == "button" then self.d.visible_text(id).trim() else (self.d.attr(id, "value") else "Submit")
        w = self.tw(label, st.size, false, false, "sans") + 20.0
        fill = 0xefefef
    elif tag == "input" and (kind == "checkbox" or kind == "radio")
        label = if self.d.attr(id, "checked") != none then "x" else ""
        w = st.size + 2.0
    elif tag == "select"
        label = ""
        mut chosen := false
        for o in self.d.all("option")
            if self.d.within(
                o,
                id,
            ) and (label == "" or (not chosen and self.d.attr(o, "selected") != none))
                label = self.d.text(o).trim()
                chosen = self.d.attr(o, "selected") != none
        w = fmax(self.tw(label, st.size, false, false, "sans") + 30.0, 80.0)
    else
        label = self.d.attr(id, "value") else ""
        if label == "" and tag == "textarea"
            label = self.d.text(id).trim()
        if label == ""
            label = self.d.attr(id, "placeholder") else ""
            ink.color = 0x8a8a8a
    mut edge := 0x767676
    if id == self.editing
        typed := self.d.attr(id, "value") else (if tag == "textarea" then self.d.text(id) else "")
        label = "{typed}|"
        ink.color = st.color
        edge = 0x0a84ff
    mut a := atom_of(CONTROL, label, w, st.size * 1.6, ink)
    a.fill = fill
    a.edge = edge
    a.node = id
    a

## An inline `<svg>` as a picture atom: its size from `width`/`height` (the
## attribute or the style), else its `viewBox`, else 24 points; none when
## it draws nothing.
fn Ctx.svg_atom(mut self, id int, cs Map[str, str], st St, avail float) Atom?
    mut w := (self.d.attr(id, "width") else "0").replace("px", "").to_float() else 0.0
    mut h := (self.d.attr(id, "height") else "0").replace("px", "").to_float() else 0.0
    if v := cs.get("width")
        w = length(v, st.size, avail) else w
    if v := cs.get("height")
        h = length(v, st.size, avail) else h
    if w <= 0.0 or h <= 0.0
        vb := self.d.attr(id, "viewBox") else ""
        parts := [p for p in vb.replace(",", " ").split(" ") if p != ""]
        vw := if parts.len() == 4 then (parts[2].to_float() else 24.0) else 24.0
        vh := if parts.len() == 4 then (parts[3].to_float() else 24.0) else 24.0
        if w > 0.0
            h = w * vh / vw
        elif h > 0.0
            w = h * vw / vh
        else
            w = vw
            h = vh
    w = w.min(avail)
    key := "svg:{id}:{w.round().to_int()}x{h.round().to_int()}:{st.color.to_hex()}"
    if not self.svgs.contains(key)
        bm := images.svg_render(
            self.d,
            id,
            w.round().to_int().max(1),
            h.round().to_int().max(1),
            st.color,
        ) else
            return none
        self.svgs[key] = bm
    mut a := atom_of(IMAGE, "", w, h, st)
    a.src = key
    a

## Adds element `id`'s inline content to the pending atoms.
fn Ctx.inline(mut self, id int, parent St, avail float)
    if self.d.nodes[id].kind == Text
        if not page.closed_child(self.d, id)
            self.add_text(self.d.nodes[id].text, parent)
        return
    if not self.visible(id)
        return
    cs := self.element_style(id)
    display := cs.get("display") else ""
    if display == "none"
        return
    tag := self.d.nodes[id].tag
    ecs := self.with_attrs(id, tag, cs)
    st := text_style(tag, ecs, parent)
    if tag == "svg"
        if a := self.svg_atom(id, cs, st, avail)
            self.atoms.push(a)
        elif parent.alt != ""
            self.add_text(parent.alt, parent)
        return
    if tag == "br"
        self.atoms.push(self.break_atom(st))
        return
    if tag == "img" or tag == "canvas"
        side := (cs.get("float") else (self.d.attr(id, "align") else "")).trim()
        if a := self.image_atom(id, cs, st, avail)
            if (side == "left" or side == "right") and a.src != ""
                self.flush(self.col_x, self.col_w, parent.align)
                self.settle()
                fx := if side == "right" then self.col_x + self.col_w - a.w else self.col_x
                if inked(st)
                    self.ops.push(draw.Op.Pic(
                        x: fx + (a.w - a.pw) / 2.0,
                        y: self.y + (a.h - a.ph) / 2.0,
                        w: a.pw,
                        h: a.ph,
                        src: a.src,
                    ))
                    if st.href != ""
                        self.hits.push(Hit(
                            x: fx,
                            y: self.y,
                            w: a.w,
                            h: a.h,
                            href: st.href,
                            node: -1,
                            anchor: st.node,
                        ))
                self.floats.push(Float(
                    x: if side == "right" then fx - 8.0 else fx,
                    y: self.y,
                    w: a.w + 8.0,
                    h: a.h + 4.0,
                    right: side == "right",
                ))
            else
                self.atoms.push(a)
        elif alt := self.d.attr(id, "alt")
            if alt != ""
                ## Inline `alt` text takes at least a normal line, even
                ## under `line-height: 0` (a picture wrapper's), so it does
                ## not pile onto its neighbours (review B6).
                mut ast := st
                ast.lh = fmax(ast.lh, 1.2)
                self.add_text(alt, ast)
        return
    if ATOMIC.contains(display) or (tag == "button" and styled_control(cs))
        self.atoms.push(self.box_atom(id, parent, cs, avail))
        return
    if CONTROLS.contains(tag)
        if a := self.control_atom(id, st)
            self.atoms.push(a)
        return
    bx := box_of(tag, cs, st, avail)
    if bx.ml > 0.0 and display.starts_with("inline-")
        self.atoms.push(self.word_atom("", st))
    for c in self.d.nodes[id].children
        self.inline(c, st, avail)

## The `display` values laid out as one box on a line (CSS Display 3 §2).
ATOMIC := {"inline-block", "inline-flex", "inline-grid", "inline-table", "inline flow-root", "inline flex", "inline grid"}

## Whether author styles give a `button` its own look (a background, a
## border or padding), so it is laid out as a box with its content rather
## than drawn as the default grey control (review X8).
fn styled_control(cs Map[str, str]) bool
    for name in ["background", "background-color", "border", "padding", "display", "border-radius"]
        if cs.contains(name)
            return true
    false

## Element `id` as one inline-level box (CSS 2.1 §10.3.9: shrink-to-fit
## width, at most `avail`): laid out on its own from (0, 0) as a block, with
## its background, border, padding and rounded corners, and carried as a
## `BOX` atom that `emit` moves onto the line. The content width is
## measured once per node (`max_content`).
fn Ctx.box_atom(mut self, id int, parent St, cs Map[str, str], avail float) Atom
    tag := self.d.nodes[id].tag
    st := text_style(tag, self.with_attrs(id, tag, cs), parent)
    bx := box_of(tag, cs, st, avail)
    mut wide := 0.0
    if bw := bx.width
        wide = fmax(bw, bx.min_width else 0.0) + bx.ml + bx.mr
    else
        wide = fmax(self.max_content(id, parent) + bx.pr + bx.br, (bx.min_width else 0.0) + bx.ml) + bx.mr
    wide = fmin(wide, avail)
    o0 := self.ops.len()
    h0 := self.hits.len()
    y0 := self.y
    p0 := self.pend
    m0 := self.marker
    f0 := self.floats.len()
    saved := self.atoms
    self.atoms = []
    self.y = 0.0
    self.pend = 0.0
    self.marker = ""
    self.block(id, parent, 0.0, wide)
    self.settle()
    h := self.y
    mut a := atom_of(BOX, "", wide, h, st)
    a.sub = self.ops[o0..self.ops.len()]
    a.sub_hits = self.hits[h0..self.hits.len()]
    if tag == "button"
        a.node = id
    self.drop_boxes(o0)
    while self.ops.len() > o0
        self.ops.pop()
    while self.hits.len() > h0
        self.hits.pop()
    while self.floats.len() > f0
        self.floats.pop()
    self.atoms = saved
    self.y = y0
    self.pend = p0
    self.marker = m0
    a

## Whether text and pictures in style `st` are painted: not hidden by
## `visibility` and not fully transparent.
fn inked(st St) bool
    not st.ghost and st.fade >= 0.02

## Colour `c` drawn at the opacity of style `st` over its background.
fn tint(c int, st St) int
    if st.fade >= 0.98
        return c
    mix(c / 65536, c / 256 % 256, c % 256, st.fade, st.under) else st.under

## Lays out the children of element `id` (style `st`) in the column from
## `x`, `w` wide, flowing inline runs into lines.
fn Ctx.children(mut self, id int, st St, x float, w float)
    saved_x := self.col_x
    saved_w := self.col_w
    self.col_x = x
    self.col_w = w
    for c in self.d.nodes[id].children
        self.flow_child(c, st, x, w)
    self.flush(x, w, st.align)
    self.col_x = saved_x
    self.col_w = saved_w

## Lays out child `c` of a flow in the column from `x`, `w` wide: text and
## inline elements join the pending line, blocks and floats are placed. The
## children of a `display: contents` element take its place (CSS Display 3 §2.5).
fn Ctx.flow_child(mut self, c int, st St, x float, w float)
    if self.d.nodes[c].kind == Text
        if not page.closed_child(self.d, c)
            self.add_text(self.d.nodes[c].text, st)
    elif self.d.nodes[c].kind == Element and self.visible(c)
        n := self.d.nodes[c]
        cs := self.element_style(c)
        if (cs.get("display") else "") == "contents"
            cst := text_style(n.tag, self.with_attrs(c, n.tag, cs), st)
            for g in n.children
                self.flow_child(g, cst, x, w)
            return
        pos := (cs.get("position") else "").trim()
        side := (cs.get("float") else "").trim()
        if pos == "absolute" or pos == "fixed"
            return
        clr := (cs.get("clear") else "").trim()
        if clr == "left" or clr == "right" or clr == "both"
            self.flush(x, w, st.align)
            self.settle()
            for f in self.floats
                if clr == "both" or (clr == "right") == f.right
                    self.y = fmax(self.y, f.y + f.h)
        if (side == "left" or side == "right") and n.tag != "img"
            self.flush(x, w, st.align)
            self.place_float(c, st, x, w, side == "right")
        elif self.is_block(c, cs)
            self.flush(x, w, st.align)
            self.block(c, st, x, w)
        else
            self.inline(c, st, w)

## Lays out box `id` as a float against the left or right edge of the
## column from `x`, `w` wide, at the current line; text then wraps around it.
fn Ctx.place_float(mut self, id int, st St, x float, w float, right bool)
    cs := self.element_style(id)
    fst := text_style(self.d.nodes[id].tag, self.with_attrs(id, self.d.nodes[id].tag, cs), st)
    bx := box_of(self.d.nodes[id].tag, cs, fst, w)
    self.settle()
    ## The measured extent already includes the left margin (the box is laid out from x = 0).
    wide := fmin(
        (if bw := bx.width then bw + bx.ml else self.max_content(id, st) + bx.pr + bx.br) + bx.mr,
        w,
    )
    fx := if right then x + w - wide else x
    y0 := self.y
    p0 := self.pend
    self.pend = 0.0
    if wide < SHRINK_W
        self.reach = fmax(self.reach, fx + wide)
    self.block(id, st, fx, wide)
    h := self.y + self.pend - y0
    self.y = y0
    self.pend = p0
    self.floats.push(Float(
        x: if right then fx - 8.0 else fx,
        y: y0,
        w: wide + 8.0,
        h: h + 4.0,
        right,
    ))

## Operation `op` moved down by `dy`.
fn lowered(op draw.Op, dy float) draw.Op
    match op
        Rect(x, y, w, h, c) => draw.Op.Rect(x, y: y + dy, w, h, color: c)
        Text(x, y, t, fg, bold, italic, underline) => draw.Op.Text(
            x,
            y: y + dy,
            text: t,
            fg,
            bold,
            italic,
            underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => draw.Op.Str(
            x,
            y: y + dy,
            text: t,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        )
        Pic(x, y, w, h, src) => draw.Op.Pic(x, y: y + dy, w, h, src)

## Operation `op` moved right by `dx` and down by `dy`.
fn moved(op draw.Op, dx float, dy float) draw.Op
    match op
        Rect(x, y, w, h, c) => draw.Op.Rect(x: x + dx, y: y + dy, w, h, color: c)
        Text(x, y, t, fg, bold, italic, underline) => draw.Op.Text(
            x: x + dx,
            y: y + dy,
            text: t,
            fg,
            bold,
            italic,
            underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => draw.Op.Str(
            x: x + dx,
            y: y + dy,
            text: t,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        )
        Pic(x, y, w, h, src) => draw.Op.Pic(x: x + dx, y: y + dy, w, h, src)

## The empty operation a clipped-away one is replaced by, so indexes into
## the list stay put: a rectangle of no size, which nothing draws.
fn no_op() draw.Op
    draw.Op.Rect(x: 0.0, y: 0.0, w: 0.0, h: 0.0, color: 0)

## Cuts the operations from `o0` and the hit boxes from `h0` on to the
## rectangle (`cx`, `cy`, `cw`, `ch`), the padding box of an element whose
## `overflow` hides what sticks out (CSS Overflow 3 §3). The display list
## has no clip operation that every consumer knows yet, so the cut is done
## here: rectangles are intersected, text whose line falls mostly outside is
## dropped and text running past the right edge is shortened, pictures
## mostly outside are dropped. A hit box outside goes, one across the edge is
## cut, so nothing hidden can be clicked.
fn Ctx.clip_from(mut self, o0 int, h0 int, cx float, cy float, cw float, ch float)
    x1 := cx + cw
    y1 := cy + ch
    for k in o0..self.ops.len()
        match self.ops[k]
            Rect(x, y, w, h, c) =>
                rl := fmax(x, cx)
                rt := fmax(y, cy)
                rr := fmin(x + w, x1)
                rb := fmin(y + h, y1)
                if rr <= rl or rb <= rt
                    if w > 0.0 or h > 0.0
                        self.ops[k] = no_op()
                elif rl != x or rt != y or rr != x + w or rb != y + h
                    self.ops[k] = draw.Op.Rect(x: rl, y: rt, w: rr - rl, h: rb - rt, color: c)
            Str(x, y, txt, font, size, fg, bold, italic, underline) =>
                txt_w := text_width(txt, size, bold, font == "mono")
                if y + size * 0.6 > y1 or y + size * 0.4 < cy or x >= x1 or x + txt_w <= cx
                    self.ops[k] = no_op()
                elif x + txt_w > x1 + 0.5
                    cut := fit_text_in(txt, size, bold, font == "mono", x1 - x)
                    self.ops[k] = if cut.trim() == "" then no_op() else draw.Op.Str(
                        x,
                        y,
                        text: cut,
                        font,
                        size,
                        fg,
                        bold,
                        italic,
                        underline,
                    )
            Pic(x, y, w, h, _) =>
                if x + w / 2.0 < cx or x + w / 2.0 > x1 or y + h / 2.0 < cy or y + h / 2.0 > y1
                    self.ops[k] = no_op()
            Text(_, _, _, _, _, _, _) => continue
    mut kept := List[Hit]()
    for k in h0..self.hits.len()
        hh := self.hits[k]
        hl := fmax(hh.x, cx)
        ht := fmax(hh.y, cy)
        hr := fmin(hh.x + hh.w, x1)
        hb := fmin(hh.y + hh.h, y1)
        if hr > hl and hb > ht
            kept.push(Hit(x: hl, y: ht, w: hr - hl, h: hb - ht, href: hh.href, node: hh.node, anchor: hh.anchor))
    while self.hits.len() > h0
        self.hits.pop()
    self.hits.extend(kept)

## Moves the element boxes recorded from operation `o0` on down by `dy`.
fn Ctx.shift_boxes(mut self, o0 int, dy float)
    for k in 0..self.boxes.len()
        b := self.boxes[k]
        if b.at >= o0
            self.boxes[k] = Box(node: b.node, x: b.x, y: b.y + dy, w: b.w, h: b.h, at: b.at)

## Drops the element boxes recorded from operation `o0` on.
fn Ctx.drop_boxes(mut self, o0 int)
    kept := [b for b in self.boxes if b.at < o0]
    self.boxes = kept

## Moves the operations and hit boxes from `o0` and `h0` on down by `dy`.
fn Ctx.lower(mut self, o0 int, h0 int, dy float)
    self.shift_boxes(o0, dy)
    for k in o0..self.ops.len()
        self.ops[k] = lowered(self.ops[k], dy)
    for k in h0..self.hits.len()
        h := self.hits[k]
        self.hits[k] = Hit(
            x: h.x,
            y: h.y + dy,
            w: h.w,
            h: h.h,
            href: h.href,
            node: h.node,
            anchor: h.anchor,
        )

## Lays out the absolutely positioned children of `id` against the
## positioned ancestor's box, out of the flow.
fn Ctx.absolutes(mut self, id int, st St, late bool, boxh float)
    for c in self.d.nodes[id].children
        if self.d.nodes[c].kind == Element and self.visible(c)
            cs := self.element_style(c)
            pos := (cs.get("position") else "").trim()
            if pos != "absolute" and pos != "fixed"
                continue
            tag := self.d.nodes[c].tag
            cst := text_style(tag, self.with_attrs(c, tag, cs), st)
            bx := box_of(tag, cs, cst, self.aw)
            anchored := bx.bottom != none and bx.top == none
            if anchored != late
                continue
            fixed := pos == "fixed"
            ox := if fixed then 0.0 else self.ax
            oy := if fixed then 0.0 else self.ay
            ow := if fixed then self.page_w else self.aw
            mut wide := fmin((bx.width else self.max_content(c, st)) + bx.ml + bx.mr, ow)
            ## Both `left` and `right` with no `width` stretch the box between
            ## them (CSS 2.1 §10.3.7).
            if bx.width == none
                if l := bx.left
                    if r := bx.right
                        wide = fmax(ow - l - r, 0.0)
            mut at := ox
            if l := bx.left
                at = ox + l
            elif r := bx.right
                at = ox + ow - r - wide
            y0 := self.y
            p0 := self.pend
            self.settle()
            if t := bx.top
                self.y = oy + t
            elif late
                self.y = oy
            start := self.y
            o0 := self.ops.len()
            h0 := self.hits.len()
            self.pend = 0.0
            self.block(c, st, at, wide)
            if late
                bb := bx.bottom else 0.0
                delta := oy + boxh - bb - (self.y + self.pend - start) - start
                self.lower(o0, h0, delta)
            self.y = y0
            self.pend = p0

## The width node `id` takes when nothing makes it wrap: laid out once in a
## very wide column and measured, then taken back.
fn Ctx.max_content(mut self, id int, st St) float
    if cached := self.contents.get(id)
        return cached
    if self.d.nodes[id].kind == Text
        w := text_width(html.collapse(self.d.nodes[id].text).trim(), st.size, st.bold, st.mono)
        self.contents[id] = w
        return w
    o0 := self.ops.len()
    h0 := self.hits.len()
    y0 := self.y
    p0 := self.pend
    m0 := self.marker
    saved := self.atoms
    self.atoms = []
    saved_reach := self.reach
    self.reach = 0.0
    f0 := self.floats.len()
    self.block(id, st, 0.0, 2.0 * SHRINK_W)
    while self.floats.len() > f0
        self.floats.pop()
    mut extent := self.reach
    self.reach = saved_reach
    for k in o0..self.ops.len()
        match self.ops[k]
            Rect(x, _, w, _, _) => extent = if x + w < SHRINK_W then fmax(extent, x + w) else extent
            Str(x, _, t, _, size, _, bold, _, _) => extent = fmax(extent, x + text_width(
                t,
                size,
                bold,
                st.mono,
            ))
            Pic(x, _, w, _, _) => extent = fmax(extent, x + w)
            Text(_, _, _, _, _, _, _) => extent = extent
    self.drop_boxes(o0)
    while self.ops.len() > o0
        self.ops.pop()
    while self.hits.len() > h0
        self.hits.pop()
    self.y = y0
    self.pend = p0
    self.marker = m0
    self.atoms = saved
    if extent > 50000.0
        extent = 0.0
    self.contents[id] = extent
    extent

## The width of the text in `id` on one line, for shrink-to-fit items.
fn Ctx.intrinsic(mut self, id int, st St) float
    text := self.d.visible_text(id).trim()
    self.tw(html.collapse(text), st.size, st.bold, st.italic, font_of(st))

## Lays out block `id` inside a column from `x`, `w` wide, with the
## parent's text style `parent`.
fn Ctx.block(mut self, id int, parent St, x float, w float)
    forced := self.force_h
    self.force_h = -1.0
    tag := self.d.nodes[id].tag
    cs := self.element_style(id)
    display := cs.get("display") else ""
    if display == "none"
        return
    if display == "contents"
        self.children(id, text_style(tag, self.with_attrs(id, tag, cs), parent), x, w)
        return
    if tag == "svg"
        ## An icon is drawn; one that draws nothing is stood for by its link's label.
        st0 := text_style(tag, self.with_attrs(id, tag, cs), parent)
        if a := self.svg_atom(id, cs, st0, w)
            self.atoms.push(a)
            self.flush(x, w, parent.align)
        elif parent.alt != ""
            self.add_text(parent.alt, parent)
            self.flush(x, w, parent.align)
        return
    ecs := self.with_attrs(id, tag, cs)
    mut st := text_style(tag, ecs, parent)
    mut bx := box_of(tag, cs, st, w)
    if forced >= 0.0
        bx.height = forced
    ## Painted at all: not `visibility: hidden` and not fully transparent.
    paints := inked(st)
    if bg := bx.bg
        ## What text and boxes inside are drawn over; also this box's fill.
        st.under = tint(bg, st)
    if tag == "hr"
        self.settle()
        self.y += bx.mt
        if paints
            self.ops.push(draw.Op.Rect(
                x: x + bx.ml,
                y: self.y,
                w: w - bx.ml - bx.mr,
                h: 1.0,
                color: tint(RULE, st),
            ))
        self.y += 1.0
        self.pend = bx.mb
        return
    measuring := w >= SHRINK_W
    mut inner_w := w - bx.ml - bx.mr
    mut left := x + bx.ml
    mut set_w := bx.width
    if m := bx.max_width
        if set_w == none
            if m < inner_w and not measuring
                set_w = m
        elif m < (set_w else 0.0)
            set_w = m
    if mw := bx.min_width
        if mw > (set_w else (if measuring then 0.0 else inner_w))
            set_w = mw
    if sw := set_w
        if sw < inner_w
            free := inner_w - sw
            if measuring
                left += 0.0
            elif bx.ml_auto and bx.mr_auto
                left += free / 2.0
            elif bx.ml_auto
                left += free
            inner_w = sw
        elif bx.min_width != none
            inner_w = sw
    border_w := inner_w
    ## `aspect-ratio` gives a box with no set height its height from its
    ## width (CSS Sizing 4 §5.1).
    if bx.aspect > 0.0 and bx.height == none and not measuring
        bx.height = border_w / bx.aspect
    content_x := left + bx.bl + bx.pl
    content_w := fmax(border_w - bx.bl - bx.br - bx.pl - bx.pr, 1.0)
    self.pend = fmax(self.pend, bx.mt)
    mut slot := -1
    mut top := self.y + self.pend
    positioned := bx.pos == "relative" or bx.pos == "absolute" or bx.pos == "fixed"
    boxed := bx.boxed() or bx.padded() or bx.height != none or bx.min_height != none or positioned or bx.clips
    if boxed
        self.settle()
        top = self.y
        if paints and (bx.bg != none or (bx.radius != 0.0 and bx.bt > 0.0))
            slot = self.ops.len()
            self.ops.push(draw.Op.Rect(x: left, y: top, w: border_w, h: 0.0, color: 0))
        self.y += bx.bt + bx.pt
    o_in := self.ops.len()
    h_in := self.hits.len()
    if tag == "li"
        self.li_marker(id, st, content_x)
    saved_ax := self.ax
    saved_ay := self.ay
    saved_aw := self.aw
    if positioned
        self.ax = left
        self.ay = top
        self.aw = border_w
    self.absolutes(id, st, false, 0.0)
    if tag == "img" or tag == "canvas"
        ## A picture made a block (`display: block`, a flex or grid item).
        if a := self.image_atom(id, cs, st, content_w)
            self.atoms.push(a)
            self.flush(content_x, content_w, st.align)
    elif tag == "table"
        self.table(id, st, content_x, content_w)
    elif FLOW_FLEX.contains(display)
        inner_h := (bx.height else 0.0) - bx.pt - bx.pb - bx.bt - bx.bb
        if flex_dir(cs).starts_with("row")
            self.flex(id, st, cs, content_x, content_w, inner_h)
        else
            self.flex_column(id, st, cs, content_x, content_w, inner_h)
    elif display == "grid" or display == "inline-grid"
        self.grid(id, st, cs, content_x, content_w)
    elif column_count(cs) > 1 and content_w < SHRINK_W
        self.columns(id, st, cs, content_x, content_w, column_count(cs))
    else
        self.children(id, st, content_x, content_w)
    self.marker = ""
    self.ax = saved_ax
    self.ay = saved_ay
    self.aw = saved_aw
    if boxed
        self.settle()
        self.y += bx.pb + bx.bb
        if hh := bx.height
            self.y = fmax(self.y, top + hh)
        if mh := bx.min_height
            self.y = fmax(self.y, top + mh)
        ## A box that cuts its overflow ends at its set height, and at most
        ## at its `max-height`; the rest is cut off below (CSS 2.1 §10.7).
        if bx.clips
            if hh := bx.height
                self.y = fmin(self.y, top + fmax(hh, bx.min_height else 0.0))
            if mh := bx.max_height
                self.y = fmin(self.y, top + fmax(mh, bx.min_height else 0.0))
        bottom := self.y
        if positioned
            self.ax = left
            self.ay = top
            self.aw = border_w
            self.absolutes(id, st, true, bottom - top)
            self.ax = saved_ax
            self.ay = saved_ay
            self.aw = saved_aw
        if bx.clips
            cw := if border_w >= SHRINK_W then 4.0 * SHRINK_W else border_w - bx.bl - bx.br
            self.clip_from(o_in, h_in, left + bx.bl, top + bx.bt, cw, fmax(bottom - top - bx.bt - bx.bb, 0.0))
        radius := if bx.radius < 0.0 then fmin(
            border_w,
            bottom - top,
        ) * (0.0 - bx.radius) / 100.0 else bx.radius
        uniform := bx.bt == bx.br and bx.br == bx.bb and bx.bb == bx.bl
        if radius >= 1.0 and uniform and slot >= 0
            ## Rounded corners: an outer shape in the border colour and an
            ## inner one in the fill, before the children.
            fill := st.under
            mut shape := List[draw.Op]()
            if bx.bt > 0.0
                shape.extend(rounded(left, top, border_w, bottom - top, radius, tint(bx.bcolor, st)))
                shape.extend(rounded(
                    left + bx.bl,
                    top + bx.bt,
                    border_w - bx.bl - bx.br,
                    bottom - top - bx.bt - bx.bb,
                    fmax(radius - bx.bt, 0.0),
                    fill,
                ))
            else
                shape.extend(rounded(left, top, border_w, bottom - top, radius, fill))
            self.ops[slot] = shape[0]
            for k in 1..shape.len()
                self.ops.insert(slot + k, shape[k])
        else
            if slot >= 0 and bx.bg != none
                self.ops[slot] = draw.Op.Rect(x: left, y: top, w: border_w, h: bottom - top, color: st.under)
            if paints
                ink := tint(bx.bcolor, st)
                if bx.bt > 0.0
                    self.ops.push(draw.Op.Rect(x: left, y: top, w: border_w, h: bx.bt, color: ink))
                if bx.bb > 0.0
                    self.ops.push(draw.Op.Rect(
                        x: left,
                        y: bottom - bx.bb,
                        w: border_w,
                        h: bx.bb,
                        color: ink,
                    ))
                if bx.bl > 0.0
                    self.ops.push(draw.Op.Rect(x: left, y: top, w: bx.bl, h: bottom - top, color: ink))
                if bx.br > 0.0
                    self.ops.push(draw.Op.Rect(
                        x: left + border_w - bx.br,
                        y: top,
                        w: bx.br,
                        h: bottom - top,
                        color: ink,
                    ))
        self.pend = bx.mb
    else
        self.pend = fmax(self.pend, bx.mb)
    self.boxes.push(Box(
        node: id,
        x: left,
        y: top,
        w: border_w,
        h: fmax(self.y - top, 0.0),
        at: self.ops.len(),
    ))
    if tag == "body" or tag == "html"
        if bg := bx.bg
            if paints
                self.canvas = bg

## The `list-style-type` or `list-style` in `cs` as `none` or its first
## token, or "" when neither is set.
fn list_kind(cs Map[str, str]) str
    if t := cs.get("list-style-type")
        return t.trim()
    if v := cs.get("list-style")
        parts := tokens(v)
        if parts.contains("none")
            return "none"
        if parts.len() > 0
            return parts[0]
    ""

## Sets the marker of list item `id` whose content starts at `x`.
fn Ctx.li_marker(mut self, id int, st St, x float)
    parent := self.d.nodes[id].parent
    ptag := self.d.nodes[parent].tag
    ## `list-style` inherits: the item's own value, then its list's, then
    ## the nearest ancestor's (`none` may be one token of the shorthand).
    mut kind := ""
    mut e := id
    while e > 0 and kind == ""
        kind = list_kind(self.element_style(e))
        e = self.d.nodes[e].parent
    if kind == "none"
        return
    self.marker_x = x - 6.0
    if ptag == "ol"
        mut k := (self.d.attr(parent, "start") else "1").to_int() else 1
        for c in self.d.nodes[parent].children
            if c == id
                break
            if self.d.nodes[c].tag == "li"
                k += 1
        self.marker = "{k}."
    else
        self.marker = "\u{2022}"
        self.marker_x = x - 8.0

## The child elements that take part in a row, column or grid layout.
fn Ctx.items(mut self, id int) List[int]
    mut out := List[int]()
    for c in self.d.nodes[id].children
        if self.d.nodes[c].kind == Text
            if html.collapse(self.d.nodes[c].text).trim() != "" and not page.closed_child(self.d, c)
                out.push(c)
        elif self.visible(c)
            cs := self.element_style(c)
            pos := (cs.get("position") else "").trim()
            display := cs.get("display") else ""
            if display == "contents"
                ## Its children are the container's items (CSS Display 3 §2.5).
                out.extend(self.items(c))
            elif display != "none" and pos != "absolute" and pos != "fixed"
                out.push(c)
    out

## Where an item shorter than its row sits: at the top, in the middle or at
## the bottom (`align-items`, `align-self`).
ALIGN_START := 0
ALIGN_CENTER := 1
ALIGN_END := 2
## Only for a column flex item: as wide as the column.
ALIGN_STRETCH := 3

## Lays out `items` side by side in columns of `widths` starting at `x`
## and `gap` apart, from the current line; the row ends at the tallest.
fn Ctx.row(
    mut self,
    items List[int],
    parent St,
    x float,
    widths List[float],
    offsets List[float],
    center bool,
    min_h float,
)
    mut aligns := List[int]()
    for k in 0..items.len()
        aligns.push(if center then ALIGN_CENTER else ALIGN_START)
    self.row_aligned(items, parent, x, widths, offsets, aligns, min_h)

## `Ctx.row` with each item's own vertical alignment (`ALIGN_*`).
fn Ctx.row_aligned(
    mut self,
    items List[int],
    parent St,
    x float,
    widths List[float],
    offsets List[float],
    aligns List[int],
    min_h float,
)
    self.settle()
    y0 := self.y
    mut heights := List[float]()
    mut spans := List[(int, int, int, int)]()
    for k in 0..items.len()
        self.y = y0
        self.pend = 0.0
        o0 := self.ops.len()
        h0 := self.hits.len()
        if self.d.nodes[items[k]].kind == Text
            self.add_text(self.d.nodes[items[k]].text, parent)
            self.flush(x + offsets[k], widths[k], parent.align)
        else
            self.block(items[k], parent, x + offsets[k], widths[k])
        heights.push(self.y + self.pend - y0)
        spans.push((o0, self.ops.len(), h0, self.hits.len()))
    mut tall := min_h
    for h in heights
        tall = fmax(tall, h)
    for k in 0..items.len()
        mut dy := 0.0
        if aligns[k] == ALIGN_CENTER
            dy = (tall - heights[k]) / 2.0
        elif aligns[k] == ALIGN_END
            dy = tall - heights[k]
        if dy > 0.5
            self.shift_boxes(spans[k].0, dy)
            for o in spans[k].0..spans[k].1
                self.ops[o] = shifted(self.ops[o], dy)
            for h in spans[k].2..spans[k].3
                self.hits[h] = Hit(
                    x: self.hits[h].x,
                    y: self.hits[h].y + dy,
                    w: self.hits[h].w,
                    h: self.hits[h].h,
                    href: self.hits[h].href,
                    node: self.hits[h].node,
                    anchor: self.hits[h].anchor,
                )
    self.y = y0 + tall
    self.pend = 0.0

## `column-count` (or the count in `columns`): 1 when absent or not a number.
fn column_count(cs Map[str, str]) int
    if v := cs.get("column-count")
        return v.trim().to_int() else 1
    if v := cs.get("columns")
        for t in tokens(v)
            if n := t.to_int()
                return n
    1

## Lays out the children of `id` in `n` balanced columns (css-multicol): each
## child goes whole into one column, columns are filled in order to about an
## equal height.
fn Ctx.columns(mut self, id int, st St, cs Map[str, str], x float, w float, n int)
    items := self.items(id)
    gap := length(cs.get("column-gap") else (cs.get("gap") else "1em"), st.size, w) else 16.0
    colw := (w - gap * (n - 1).to_float()) / n.to_float()
    self.settle()
    y0 := self.y
    mut heights := List[float]()
    mut total := 0.0
    for it in items
        o0 := self.ops.len()
        h0 := self.hits.len()
        saved := self.atoms
        self.atoms = []
        self.y = y0
        self.pend = 0.0
        self.lay_item(it, st, x, colw)
        heights.push(self.y + self.pend - y0)
        total += self.y + self.pend - y0
        self.drop_boxes(o0)
        while self.ops.len() > o0
            self.ops.pop()
        while self.hits.len() > h0
            self.hits.pop()
        self.atoms = saved
    target := total / n.to_float()
    mut col := 0
    mut cur := 0.0
    mut tall := 0.0
    self.y = y0
    self.pend = 0.0
    for k in 0..items.len()
        if col < n - 1 and cur > 0.0 and cur + heights[k] / 2.0 > target
            tall = fmax(tall, cur)
            col += 1
            cur = 0.0
            self.y = y0
            self.pend = 0.0
        self.lay_item(items[k], st, x + col.to_float() * (colw + gap), colw)
        cur = self.y + self.pend - y0
    tall = fmax(tall, cur)
    self.y = y0 + tall
    self.pend = 0.0

## One flow item of a multi-column or similar container, at `x`, `w` wide.
fn Ctx.lay_item(mut self, it int, st St, x float, w float)
    if self.d.nodes[it].kind == Text
        self.add_text(self.d.nodes[it].text, st)
        self.flush(x, w, st.align)
    else
        self.block(it, st, x, w)

## `op` moved down by `dy`.
fn shifted(op draw.Op, dy float) draw.Op
    match op
        Rect(x, y, w, h, c) => draw.Op.Rect(x: x, y: y + dy, w: w, h: h, color: c)
        Text(x, y, t, fg, bold, italic, underline) => draw.Op.Text(
            x,
            y: y + dy,
            text: t,
            fg,
            bold,
            italic,
            underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => draw.Op.Str(
            x,
            y: y + dy,
            text: t,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        )
        Pic(x, y, w, h, src) => draw.Op.Pic(x, y: y + dy, w, h, src)

## A flex item's `flex-grow`, `flex-shrink` and `flex-basis`.
struct FlexItem
    grow float
    shrink float
    basis str

## The flex factors of an item with cascaded values `cs`: the `flex`
## shorthand (CSS Flexbox 1 §7.1.1: `flex: 1` is `1 1 0%`, `auto` is
## `1 1 auto`, `none` is `0 0 auto`, a lone basis grows by 1), then the
## longhands.
fn flex_of(cs Map[str, str]) FlexItem
    mut f := FlexItem(grow: 0.0, shrink: 1.0, basis: "auto")
    if v := cs.get("flex")
        ts := tokens(v.trim())
        one := if ts.len() == 1 then ts[0] else ""
        if one == "none"
            f = FlexItem(grow: 0.0, shrink: 0.0, basis: "auto")
        elif one == "auto"
            f = FlexItem(grow: 1.0, shrink: 1.0, basis: "auto")
        elif one == "initial" or one == "unset" or one == "revert"
            f = FlexItem(grow: 0.0, shrink: 1.0, basis: "auto")
        elif ts.len() > 0
            mut nums := List[float]()
            mut basis := "0%"
            for t in ts
                if nums.len() < 2 and css_float(t) != none
                    nums.push(css_float(t) else 0.0)
                else
                    basis = t
            f = FlexItem(
                grow: if nums.len() > 0 then nums[0] else 1.0,
                shrink: if nums.len() > 1 then nums[1] else 1.0,
                basis: basis,
            )
    if v := cs.get("flex-grow")
        f.grow = css_float(v) else f.grow
    if v := cs.get("flex-shrink")
        f.shrink = css_float(v) else f.shrink
    if v := cs.get("flex-basis")
        f.basis = v.trim()
    f

## `flex-direction`, or the direction in `flex-flow`; `row` by default.
fn flex_dir(cs Map[str, str]) str
    if v := cs.get("flex-direction")
        return v.trim()
    for t in tokens(cs.get("flex-flow") else "")
        if t.starts_with("row") or t.starts_with("column")
            return t
    "row"

## Whether a flex container wraps its items (`flex-wrap`, or `flex-flow`).
fn flex_wraps(cs Map[str, str]) bool
    v := cs.get("flex-wrap") else (cs.get("flex-flow") else "")
    for t in tokens(v)
        if t == "wrap" or t == "wrap-reverse"
            return true
    false

## The `ALIGN_*` of an item from its `align-self` and its container's
## `align-items`; `stretch` (the default) is `ALIGN_STRETCH`.
fn align_of(self_v str, items_v str) int
    v := if self_v == "" or self_v == "auto" then items_v else self_v
    match v
        "center" | "safe center" | "unsafe center" => ALIGN_CENTER
        "flex-end" | "end" | "self-end" | "last baseline" => ALIGN_END
        "flex-start" | "start" | "self-start" | "baseline" | "first baseline" => ALIGN_START
        _ => ALIGN_STRETCH

## The row and column gaps of a grid or flex container: `gap` (one value
## for both, or the row gap then the column gap), then `row-gap` and
## `column-gap` and their old `grid-` names. `normal` is 0.
fn box_gaps(cs Map[str, str], size float, w float) List[float]
    mut rg := 0.0
    mut cg := 0.0
    ts := tokens(cs.get("gap") else (cs.get("grid-gap") else ""))
    if ts.len() > 0
        rg = gap_length(ts[0], size, w) else 0.0
        cg = rg
        if ts.len() > 1
            cg = gap_length(ts[1], size, w) else cg
    for name in ["row-gap", "grid-row-gap"]
        if v := cs.get(name)
            rg = gap_length(v, size, w) else rg
    for name in ["column-gap", "grid-column-gap"]
        if v := cs.get(name)
            cg = gap_length(v, size, w) else cg
    [rg, cg]

## A gap as `length` reads it; a percentage is 0 while measuring.
fn gap_length(v str, size float, w float) float?
    if w >= SHRINK_W and v.trim().ends_with("%")
        return 0.0
    length(v, size, w)

## `items` in the order of their `order` values, stable (CSS Flexbox 1 §5.4).
fn Ctx.flex_order(mut self, items List[int]) List[int]
    mut keys := List[int]()
    mut moved := false
    for it in items
        mut o := 0
        if self.d.nodes[it].kind == Element
            o = (self.element_style(it).get("order") else "0").trim().to_int() else 0
        if o != 0
            moved = true
        keys.push(o)
    if not moved
        return items
    mut out := List[int]()
    mut ks := List[int]()
    for k in 0..items.len()
        mut pos := out.len()
        while pos > 0 and ks[pos - 1] > keys[k]
            pos -= 1
        out.insert(pos, items[k])
        ks.insert(pos, keys[k])
    out

## The width item `it` of a grid or flex container takes when nothing wraps:
## its set width (a border box, as `block` reads it), else its laid-out
## content, with its margins. `max_content` caches the content per node, so
## nested containers measure each node once per layout.
fn Ctx.item_width(mut self, it int, st St, w float) float
    if self.d.nodes[it].kind == Text
        return self.max_content(it, st) + 2.0
    tag := self.d.nodes[it].tag
    ics := self.element_style(it)
    ib := box_of(tag, ics, text_style(tag, ics, st), w)
    if bw := ib.width
        return bw + ib.ml + ib.mr
    self.max_content(it, st) + ib.pr + ib.br + ib.mr

## A row flex container (CSS Flexbox 1 §9, one pass): each item's base size
## is its `flex-basis`, else its width, else its content; lines break when
## `flex-wrap` allows; free space goes to `flex-grow`, overflow is taken back
## by `flex-shrink` weighted by the base size; `justify-content` places the
## rest, `align-items` and `align-self` place items in the line.
fn Ctx.flex(mut self, id int, st St, cs Map[str, str], x float, w float, min_h float)
    mut items := self.flex_order(self.items(id))
    if flex_dir(cs) == "row-reverse"
        items = items.reversed()
    measuring := w >= SHRINK_W
    gaps := box_gaps(cs, st.size, w)
    gap := gaps[1]
    line_gap := gaps[0]
    justify := if measuring then "flex-start" else (cs.get("justify-content") else "flex-start").trim()
    wrap := flex_wraps(cs)
    align_items := (cs.get("align-items") else "").trim()
    mut sizes := List[float]()
    mut grows := List[float]()
    mut shrinks := List[float]()
    mut aligns := List[int]()
    for it in items
        if self.d.nodes[it].kind == Text
            sizes.push(self.max_content(it, st) + 2.0)
            grows.push(0.0)
            shrinks.push(1.0)
            aligns.push(align_of("", align_items))
            continue
        tag := self.d.nodes[it].tag
        ics := self.element_style(it)
        ist := text_style(tag, ics, st)
        ib := box_of(tag, ics, ist, w)
        extra := ib.ml + ib.mr + ib.bl + ib.br + ib.pl + ib.pr
        fx := flex_of(ics)
        ## While measuring there is no free space to share: an item takes at
        ## least its content (a `flex: 1` item's 0 basis would hide it).
        grows.push(if measuring then 0.0 else fx.grow)
        shrinks.push(fx.shrink)
        aligns.push(align_of((ics.get("align-self") else "").trim(), align_items))
        mut basis := none
        if fx.basis != "auto"
            and fx.basis != "content"
            and not (measuring and fx.basis.ends_with("%"))
            basis = length(fx.basis, ist.size, w)
        if b := basis
            if measuring
                sizes.push(fmax(b + extra, self.max_content(it, st) + ib.pr + ib.br + ib.mr + 4.0))
            else
                sizes.push(b + extra)
        elif bw := ib.width
            sizes.push(bw + extra)
        else
            sizes.push(self.max_content(it, st) + ib.pr + ib.br + ib.mr + 4.0)
    mut k := 0
    while k < items.len()
        mut end := k
        mut used := 0.0
        while end < items.len()
            need := sizes[end] + (if end > k then gap else 0.0)
            if wrap and end > k and used + need > w
                break
            used += need
            end += 1
        mut row_items := List[int]()
        mut row_aligns := List[int]()
        mut widths := List[float]()
        mut total_grow := 0.0
        mut weight := 0.0
        for j in k..end
            total_grow += grows[j]
            weight += shrinks[j] * sizes[j]
        free := w - used
        mut taken := 0.0
        for j in k..end
            row_items.push(items[j])
            row_aligns.push(if aligns[j] == ALIGN_STRETCH then ALIGN_START else aligns[j])
            mut cw := sizes[j]
            if free > 0.0 and total_grow > 0.0
                cw += free * grows[j] / fmax(total_grow, 1.0)
            elif free < 0.0 and weight > 0.0
                cw = fmax(cw + free * shrinks[j] * sizes[j] / weight, 0.0)
            widths.push(cw)
            taken += cw
        gaps_w := gap * (end - k - 1).to_float()
        slack := fmax(w - taken - gaps_w, 0.0)
        mut start := 0.0
        mut between := gap
        count := (end - k).to_float()
        if justify == "center"
            start = slack / 2.0
        elif justify == "flex-end" or justify == "end" or justify == "right"
            start = slack
        elif justify == "space-between" and end - k > 1
            between = gap + slack / (count - 1.0)
        elif justify == "space-around"
            between = gap + slack / count
            start = slack / count / 2.0
        elif justify == "space-evenly"
            between = gap + slack / (count + 1.0)
            start = slack / (count + 1.0)
        mut offsets := List[float]()
        mut at := start
        for j in 0..widths.len()
            offsets.push(at)
            at += widths[j] + between
        self.row_aligned(row_items, st, x, widths, offsets, row_aligns, min_h)
        if end < items.len()
            self.y += line_gap
        k = end

## Lays item `it` out at `x`, `w` wide, measures its height with its
## margins, and takes it all back.
fn Ctx.measure_h(mut self, it int, st St, x float, w float) float
    o0 := self.ops.len()
    h0 := self.hits.len()
    saved := self.atoms
    self.atoms = []
    y0 := self.y
    p0 := self.pend
    self.pend = 0.0
    self.lay_item(it, st, x, w)
    self.settle()
    h := self.y - y0
    self.drop_boxes(o0)
    while self.ops.len() > o0
        self.ops.pop()
    while self.hits.len() > h0
        self.hits.pop()
    self.atoms = saved
    self.y = y0
    self.pend = p0
    h

## A column flex container (CSS Flexbox 1 with `flex-direction: column`):
## each item is blockified and stacked, `gap` apart, with no margin
## collapsing; `align-items` and `align-self` place items narrower than the
## column (`stretch`, the default, makes them as wide). With a definite
## height (`min_h` > 0) `flex-grow` shares the free height and
## `justify-content` places the stack.
fn Ctx.flex_column(mut self, id int, st St, cs Map[str, str], x float, w float, min_h float)
    mut items := self.flex_order(self.items(id))
    if flex_dir(cs) == "column-reverse"
        items = items.reversed()
    gap := box_gaps(cs, st.size, w)[0]
    align_items := (cs.get("align-items") else "").trim()
    justify := (cs.get("justify-content") else "flex-start").trim()
    n := items.len()
    mut grows := List[float]()
    mut total_grow := 0.0
    for it in items
        mut g := 0.0
        if self.d.nodes[it].kind == Element
            g = flex_of(self.element_style(it)).grow
        grows.push(g)
        total_grow += g
    self.settle()
    y0 := self.y
    ## The border-box height each growing item is given, or -1.
    mut grown := List[float]()
    for k in 0..n
        grown.push(-1.0)
    if min_h > 0.0 and total_grow > 0.0 and w < SHRINK_W
        mut heights := List[float]()
        mut sum := fmax(gap * (n - 1).to_float(), 0.0)
        for it in items
            h := self.measure_h(it, st, x, w)
            heights.push(h)
            sum += h
        free := min_h - sum
        if free > 0.0
            for k in 0..n
                if grows[k] > 0.0
                    tag := self.d.nodes[items[k]].tag
                    ics := self.element_style(items[k])
                    ib := box_of(tag, ics, text_style(tag, ics, st), w)
                    share := free * grows[k] / fmax(total_grow, 1.0)
                    grown[k] = fmax(heights[k] - ib.mt - ib.mb + share, 0.0)
    mut o_starts := List[int]()
    mut h_starts := List[int]()
    for k in 0..n
        item := items[k]
        if k > 0
            self.y += gap
        o_starts.push(self.ops.len())
        h_starts.push(self.hits.len())
        if self.d.nodes[item].kind == Text
            self.add_text(self.d.nodes[item].text, st)
            self.flush(x, w, st.align)
        else
            ics := self.element_style(item)
            al := align_of((ics.get("align-self") else "").trim(), align_items)
            mut ix := x
            mut iw := w
            if al != ALIGN_STRETCH and w < SHRINK_W
                iw = fmin(self.item_width(item, st, w), w)
                if al == ALIGN_CENTER
                    ix = x + (w - iw) / 2.0
                elif al == ALIGN_END
                    ix = x + w - iw
            if grown[k] >= 0.0
                self.force_h = grown[k]
            self.block(item, st, ix, iw)
            self.force_h = -1.0
        self.settle()
    used := self.y - y0
    if n > 0 and min_h > used + 0.5 and w < SHRINK_W
        free := min_h - used
        if justify == "center"
            self.lower(o_starts[0], h_starts[0], free / 2.0)
            self.y += free / 2.0
        elif justify == "flex-end" or justify == "end"
            self.lower(o_starts[0], h_starts[0], free)
            self.y += free
        elif justify == "space-between" and n > 1
            for k in 1..n
                self.lower(o_starts[k], h_starts[k], free / (n - 1).to_float())
            self.y += free
        elif justify == "space-around"
            self.lower(o_starts[0], h_starts[0], free / n.to_float() / 2.0)
            for k in 1..n
                self.lower(o_starts[k], h_starts[k], free / n.to_float())
            self.y += free - free / n.to_float() / 2.0
    self.pend = 0.0

# ---- Grid (CSS Grid 1 §7 and §8, single pass) -------------------------------

TRACK_FIXED := 0
TRACK_FR := 1
TRACK_AUTO := 2
## The most tracks a `repeat()` makes, and the most rows an item spans.
MAX_TRACKS := 1000

## One column track of a grid template: a fixed width, a share of the free
## space (`fr`), or sized by its content (`auto`, `min-content`,
## `max-content`, `fit-content()`).
struct Track
    kind int
    ## Pixels for a fixed track, the factor for an `fr` one.
    size float
    ## The least width (`minmax(lo, ...)`), 0 if none.
    lo float
    ## The most width a content-sized track takes (`fit-content(hi)`), -1 if none.
    hi float

fn content_track() Track
    Track(kind: TRACK_AUTO, size: 0.0, lo: 0.0, hi: -1.0)

## The words of a track list: spaces inside parentheses do not split, and
## line names in brackets (`[full-start]`) are dropped.
fn track_words(spec str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    mut depth := 0
    mut named := false
    for c in spec.chars()
        if named
            if c == ']'
                named = false
        elif c == '[' and depth == 0
            named = true
            if cur.len() > 0
                out.push(cur.join(""))
                cur = []
        else
            if c == '('
                depth += 1
            elif c == ')'
                depth -= 1
            if (c == ' ' or c == '\n' or c == '\t') and depth == 0
                if cur.len() > 0
                    out.push(cur.join(""))
                    cur = []
            else
                cur.push(c)
    if cur.len() > 0
        out.push(cur.join(""))
    out

## `s` split at the commas that are not inside parentheses, each trimmed.
fn top_commas(s str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    mut depth := 0
    for c in s.chars()
        if c == '('
            depth += 1
        elif c == ')'
            depth -= 1
        if c == ',' and depth == 0
            out.push(cur.join("").trim())
            cur = []
        else
            cur.push(c)
    out.push(cur.join("").trim())
    out

## One track size (CSS Grid 1 §7.2.1). `minmax(a, b)` is fixed when `b` is
## a length, else takes `a` as its least width. While measuring (`w` at
## least `SHRINK_W`) a percentage means nothing, so it is content-sized.
fn one_track(t str, size float, w float) Track
    if w >= SHRINK_W and t.ends_with("%")
        return content_track()
    if t.starts_with("minmax(") and t.ends_with(")")
        parts := top_commas(t.slice(7, t.chars().len() - 1))
        if parts.len() != 2
            return content_track()
        lo := length(parts[0], size, w) else 0.0
        top := one_track(parts[1], size, w)
        if top.kind == TRACK_FIXED
            return Track(kind: TRACK_FIXED, size: fmax(top.size, lo), lo: 0.0, hi: -1.0)
        return Track(kind: top.kind, size: top.size, lo: fmax(lo, top.lo), hi: top.hi)
    if t.starts_with("fit-content(") and t.ends_with(")")
        cap := length(t.slice(12, t.chars().len() - 1), size, w) else -1.0
        return Track(kind: TRACK_AUTO, size: 0.0, lo: 0.0, hi: cap)
    if r := t.strip_suffix("fr")
        if f := css_float(r)
            return Track(kind: TRACK_FR, size: fmax(f, 0.0), lo: 0.0, hi: -1.0)
    if v := length(t, size, w)
        return Track(kind: TRACK_FIXED, size: fmax(v, 0.0), lo: 0.0, hi: -1.0)
    content_track()

## The least width a track can take: its size if fixed, else its `lo`.
fn track_min(t Track) float
    if t.kind == TRACK_FIXED then t.size else t.lo

## The tracks of `spec` (`grid-template-columns` or `-rows`) for a grid `w`
## wide with `gap` between tracks, holding `count` items: `repeat(n, ...)`
## anywhere in the list, `repeat(auto-fill, ...)` as many as fit and
## `repeat(auto-fit, ...)` no more than there are items (CSS Grid 1 §7.2.3).
fn grid_tracks(spec str, size float, w float, gap float, count int) List[Track]
    words := track_words(spec)
    mut fixed := 0.0
    mut n_fixed := 0
    for t in words
        if not t.starts_with("repeat(")
            fixed += track_min(one_track(t, size, w))
            n_fixed += 1
    mut out := List[Track]()
    for t in words
        if t.starts_with("repeat(") and t.ends_with(")")
            parts := top_commas(t.slice(7, t.chars().len() - 1))
            if parts.len() != 2
                continue
            mut unit := List[Track]()
            for u in track_words(parts[1])
                unit.push(one_track(u, size, w))
            if unit.len() == 0
                continue
            mut n := parts[0].to_int() else 0
            if n <= 0
                mut each := 0.0
                for u in unit
                    each += track_min(u)
                if each < 1.0
                    each = 200.0
                room := w - fixed - gap * n_fixed.to_float()
                per := each + gap * unit.len().to_float()
                n = ((room + gap) / per).floor().to_int().max(1)
                if parts[0] == "auto-fit" or w >= SHRINK_W
                    n = n.min(count.max(1))
            n = n.min(MAX_TRACKS)
            for k in 0..n
                out.extend(unit)
        else
            out.push(one_track(t, size, w))
    out

## Whether track `t` is sized by what it holds; every `fr` track is while
## measuring.
fn by_content(t Track, measuring bool) bool
    t.kind == TRACK_AUTO or (measuring and t.kind == TRACK_FR)

## The widths of `tracks` in a grid `w` wide with `gap` between them, given
## the widest content each holds (`content`, from `Ctx.track_content`), as
## CSS Grid 1 §11 does it in one pass: fixed tracks take their size,
## content-sized ones their content, `fr` tracks share what is left. With no
## `fr` track the content-sized ones stretch to fill the grid
## (`justify-content: normal`); when they do not fit they shrink in
## proportion.
fn track_sizes(tracks List[Track], content List[float], w float, gap float) List[float]
    measuring := w >= SHRINK_W
    n := tracks.len()
    mut out := List[float]()
    mut fixed := 0.0
    mut autos := 0.0
    mut stretchy := 0
    mut frs := 0.0
    for k in 0..n
        t := tracks[k]
        if by_content(t, measuring)
            mut c := fmax(content[k], t.lo)
            if t.hi >= 0.0
                c = fmax(fmin(c, t.hi), t.lo)
            else
                stretchy += 1
            out.push(c)
            autos += c
        elif t.kind == TRACK_FR
            out.push(0.0)
            frs += t.size
        else
            out.push(t.size)
            fixed += t.size
    room := w - fixed - gap * (n - 1).max(0).to_float()
    if measuring
        return out
    mut squeeze := 1.0
    mut stretch := 0.0
    if room < autos and autos > 0.0
        squeeze = fmax(room, 0.0) / autos
    elif frs == 0.0 and stretchy > 0
        stretch = (room - autos) / stretchy.to_float()
    left := fmax(room - autos, 0.0)
    for k in 0..n
        t := tracks[k]
        if by_content(t, measuring)
            out[k] = out[k] * squeeze + (if t.hi < 0.0 then stretch else 0.0)
        elif t.kind == TRACK_FR and frs > 0.0
            ## Factors summing below 1 take only that part (CSS Grid 1 §11.7.1).
            out[k] = fmax(left * t.size / fmax(frs, 1.0), t.lo)
    out

## The widest content each track holds alone (`item_width`), then for each
## item spanning several content-sized tracks, what it needs beyond them
## spread evenly over them. `cells` are the items' [row0, row1, col0, col1].
fn Ctx.track_content(
    mut self,
    items List[int],
    cells List[List[int]],
    tracks List[Track],
    st St,
    w float,
) List[float]
    measuring := w >= SHRINK_W
    mut content := List[float]()
    for t in tracks
        content.push(0.0)
    for k in 0..items.len()
        c0 := cells[k][2]
        if c0 == cells[k][3] and by_content(tracks[c0], measuring)
            content[c0] = fmax(content[c0], self.item_width(items[k], st, w))
    for k in 0..items.len()
        c0 := cells[k][2]
        c1 := cells[k][3]
        if c0 < c1
            mut sized := true
            mut have := 0.0
            for c in c0..c1 + 1
                if not by_content(tracks[c], measuring)
                    sized = false
                have += content[c]
            if sized
                need := self.item_width(items[k], st, w)
                if need > have
                    more := (need - have) / (c1 - c0 + 1).to_float()
                    for c in c0..c1 + 1
                        content[c] = content[c] + more
    content

## A placement word of `grid-column-start` and the like as [line, span]:
## [N, 0] for line N (negative counts from the end), [0, N] for `span N`,
## [0, 0] for `auto` and for a line name (named lines are not supported).
fn grid_line(v str) List[int]
    words := [t for t in v.trim().split(" ") if t != ""]
    if words.len() == 0
        return [0, 0]
    if words[0] == "span"
        mut n := 1
        for t in words
            if k := t.to_int()
                n = k
        return [0, n.max(1)]
    for t in words
        if k := t.to_int()
            return [k, 0]
    [0, 0]

## An item's placement on `axis` (`column` or `row`) as [start line, start
## span, end line, end span] (`grid_line`), from `grid-area` (`r0 / c0 /
## r1 / c1`), then `grid-column` or `grid-row` (`a / b`), then the
## `-start` and `-end` longhands.
fn grid_lines(cs Map[str, str], axis str) List[int]
    mut s := "auto"
    mut e := "auto"
    if v := cs.get("grid-area")
        parts := v.split("/")
        first := if axis == "row" then 0 else 1
        if parts.len() > first and v.contains("/")
            s = parts[first]
            if parts.len() > first + 2
                e = parts[first + 2]
    if v := cs.get("grid-{axis}")
        parts := v.split("/")
        s = parts[0]
        e = if parts.len() > 1 then parts[1] else "auto"
    s = cs.get("grid-{axis}-start") else s
    e = cs.get("grid-{axis}-end") else e
    a := grid_line(s)
    b := grid_line(e)
    [a[0], a[1], b[0], b[1]]

## Line `line` (from 1, or negative from the end) of a grid with `n`
## explicit tracks as a 0-based track index.
fn line_index(line int, n int) int
    if line > 0
        return line - 1
    (n + 1 + line).max(0)

## The tracks an item covers from its `grid_lines` `l` in a grid of `n`
## explicit tracks: [first track (0-based, -1 when placed automatically),
## span]. Columns stay inside the explicit grid (no implicit columns);
## rows (`grow`) may go past it.
fn grid_range(l List[int], n int, grow bool) List[int]
    mut a := -1
    mut span := 1
    if l[0] != 0
        a = line_index(l[0], n)
        if l[2] != 0
            b := line_index(l[2], n)
            if b < a
                span = a - b
                a = b
            else
                span = (b - a).max(1)
        elif l[3] > 0
            span = l[3]
    elif l[2] != 0
        b := line_index(l[2], n)
        a = (b - l[1].max(1)).max(0)
        span = (b - a).max(1)
    else
        span = l[1].max(l[3]).max(1)
    if grow
        return [a, span.min(MAX_TRACKS)]
    span = span.min(n)
    if a >= n
        a = n - 1
    if a >= 0
        span = span.min(n - a)
    [a, span.max(1)]

## Whether cells rows `r` to `r + rs` and columns `c` to `c + cs` are all free
## in `occ`, a row-major grid of `ncols` columns.
fn grid_free(occ List[bool], ncols int, r int, rs int, c int, cs int) bool
    for rr in r..r + rs
        for cc in c..c + cs
            at := rr * ncols + cc
            if at < occ.len() and occ[at]
                return false
    true

## Marks cells as `grid_free` reads them as taken.
fn grid_take(mut occ List[bool], ncols int, r int, rs int, c int, cs int)
    while occ.len() < (r + rs) * ncols
        occ.push(false)
    for rr in r..r + rs
        for cc in c..c + cs
            occ[rr * ncols + cc] = true

## Places the items of a grid of `ncols` columns (CSS Grid 1 §8.5, sparse
## row flow): `cols` and `rows` are each item's [first, span] from
## `grid_range`. Items fixed in both axes go first, then those fixed to a
## row, then the rest in order behind a cursor. Returns each item's
## [row0, row1, col0, col1], inclusive.
fn grid_place(cols List[List[int]], rows List[List[int]], ncols int) List[List[int]]
    mut occ := List[bool]()
    mut out := List[List[int]]()
    for k in 0..cols.len()
        out.push([0, 0, 0, 0])
    for k in 0..cols.len()
        if cols[k][0] >= 0 and rows[k][0] >= 0
            r := rows[k][0]
            c := cols[k][0]
            grid_take(mut occ, ncols, r, rows[k][1], c, cols[k][1])
            out[k] = [r, r + rows[k][1] - 1, c, c + cols[k][1] - 1]
    for k in 0..cols.len()
        if cols[k][0] < 0 and rows[k][0] >= 0
            r := rows[k][0]
            span := cols[k][1]
            mut at := 0
            mut c := 0
            while c + span <= ncols
                if grid_free(occ, ncols, r, rows[k][1], c, span)
                    at = c
                    break
                c += 1
            grid_take(mut occ, ncols, r, rows[k][1], at, span)
            out[k] = [r, r + rows[k][1] - 1, at, at + span - 1]
    mut cr := 0
    mut cc := 0
    for k in 0..cols.len()
        if rows[k][0] >= 0
            continue
        span := cols[k][1]
        rs := rows[k][1]
        if cols[k][0] >= 0
            c := cols[k][0]
            if c < cc
                cr += 1
            while not grid_free(occ, ncols, cr, rs, c, span)
                cr += 1
            cc = c
        else
            while true
                if cc + span > ncols
                    cr += 1
                    cc = 0
                elif grid_free(occ, ncols, cr, rs, cc, span)
                    break
                else
                    cc += 1
        grid_take(mut occ, ncols, cr, rs, cc, span)
        out[k] = [cr, cr + rs - 1, cc, cc + span - 1]
        cc += span
    out

## The rows of `grid-template-areas` (or of the strings in a
## `grid-template` shorthand), each a list of area names in lower case: the
## quoted strings only, so `none` and the track sizes between the strings of
## the shorthand are not rows (CSS Grid 1 §7.3, §7.4). Names compare without
## case because the style sheet lower-cases `grid-area` values but not
## strings (Wikipedia's `columnStart`, review task B1).
fn area_rows(spec str) List[List[str]]
    mut rows := List[List[str]]()
    parts := spec.replace("\"", "'").split("'")
    for k in 0..parts.len()
        if k % 2 == 1
            words := [t.to_lower() for t in parts[k].replace("\t", " ").replace("\n", " ").split(" ") if t.trim() != ""]
            if words.len() > 0
                rows.push(words)
    rows

## The first and last row and column (0-based) `name` covers in `rows`, or [].
fn area_box(rows List[List[str]], name str) List[int]
    mut r0 := -1
    mut r1 := -1
    mut c0 := -1
    mut c1 := -1
    for r in 0..rows.len()
        for c in 0..rows[r].len()
            if rows[r][c] == name
                if r0 < 0
                    r0 = r
                r1 = r
                if c0 < 0 or c < c0
                    c0 = c
                if c > c1
                    c1 = c
    if r0 < 0
        return []
    [r0, r1, c0, c1]

## Whether a grid centres its items in their rows (`align-items` or
## `place-items`).
fn grid_centred(cs Map[str, str]) bool
    (cs.get("align-items") else "").trim() == "center"
        or (cs.get("place-items") else "").trim().starts_with("center")

fn Ctx.grid(mut self, id int, st St, cs Map[str, str], x float, w float)
    items := self.items(id)
    gaps := box_gaps(cs, st.size, w)
    mut spec := (cs.get("grid-template-columns") else "").trim()
    shorthand := cs.get("grid-template") else ""
    if spec == "" and shorthand.contains("/")
        spec = shorthand.slice((shorthand.find("/") else 0) + 1, shorthand.chars().len()).trim()
    mut areas := area_rows((cs.get("grid-template-areas") else "").trim())
    if areas.len() == 0 and shorthand.contains("'")
        areas = area_rows(shorthand)
    if areas.len() > 0
        self.grid_areas(items, st, cs, x, w, spec, areas)
        return
    mut tracks := grid_tracks(spec, st.size, w, gaps[1], items.len())
    if tracks.len() == 0
        tracks.push(Track(kind: TRACK_FR, size: 1.0, lo: 0.0, hi: -1.0))
    ncols := tracks.len()
    n_rows := track_words((cs.get("grid-template-rows") else "").trim()).len()
    mut cols := List[List[int]]()
    mut rows := List[List[int]]()
    for it in items
        if self.d.nodes[it].kind == Element
            ics := self.element_style(it)
            cols.push(grid_range(grid_lines(ics, "column"), ncols, false))
            rows.push(grid_range(grid_lines(ics, "row"), n_rows, true))
        else
            cols.push([-1, 1])
            rows.push([-1, 1])
    cells := grid_place(cols, rows, ncols)
    self.grid_rows(items, cells, tracks, st, x, w, gaps, grid_centred(cs))

## Lays out placed grid items a row at a time: column widths from
## `track_sizes`, each item as wide as the tracks and gaps it spans. An item
## spanning several rows is laid out in its first row, whose height it then
## sets alone (row heights are not shared out yet).
fn Ctx.grid_rows(
    mut self,
    items List[int],
    cells List[List[int]],
    tracks List[Track],
    st St,
    x float,
    w float,
    gaps List[float],
    center bool,
)
    gap := gaps[1]
    content := self.track_content(items, cells, tracks, st, w)
    widths := track_sizes(tracks, content, w, gap)
    mut offsets := List[float]()
    mut at := 0.0
    for cw in widths
        offsets.push(at)
        at += cw + gap
    mut last := -1
    for b in cells
        last = last.max(b[1])
    ## Where each item spanning several rows ends, and the row it ends in:
    ## the rows it spans are laid out without it, then the grid grows to
    ## hold it if it is taller than they are together.
    mut tall_end := List[float]()
    mut tall_row := List[int]()
    mut first := true
    for r in 0..last + 1
        mut row := List[int]()
        mut ws := List[float]()
        mut os := List[float]()
        mut tall := List[int]()
        for k in 0..items.len()
            b := cells[k]
            if b[0] == r
                mut span := gap * (b[3] - b[2]).to_float()
                for c in b[2]..b[3] + 1
                    span += widths[c]
                if b[1] > b[0]
                    tall.push(k)
                else
                    row.push(items[k])
                    ws.push(span)
                    os.push(offsets[b[2]])
        if row.len() > 0 or tall.len() > 0
            if not first
                self.y += gaps[0]
            first = false
            self.settle()
            y_row := self.y
            self.row(row, st, x, ws, os, center, 0.0)
            after := self.y
            for k in tall
                tb := cells[k]
                mut tspan := gap * (tb[3] - tb[2]).to_float()
                for c in tb[2]..tb[3] + 1
                    tspan += widths[c]
                self.y = y_row
                self.pend = 0.0
                self.lay_item(items[k], st, x + offsets[tb[2]], tspan)
                self.settle()
                tall_end.push(self.y)
                tall_row.push(tb[1])
            self.y = after
            self.pend = 0.0
        for k in 0..tall_row.len()
            if tall_row[k] == r
                self.y = fmax(self.y, tall_end[k])

## A grid with `grid-template-areas`: each item goes in the cells its
## `grid-area` names; items with no area follow, full width, a row each.
fn Ctx.grid_areas(
    mut self,
    items List[int],
    st St,
    cs Map[str, str],
    x float,
    w float,
    spec str,
    areas List[List[str]],
)
    gaps := box_gaps(cs, st.size, w)
    ncols := areas[0].len()
    mut tracks := grid_tracks(spec, st.size, w, gaps[1], items.len())
    while tracks.len() > ncols
        tracks.pop()
    while tracks.len() < ncols
        tracks.push(Track(kind: TRACK_FR, size: 1.0, lo: 0.0, hi: -1.0))
    ## Each item's box: [row0, row1, col0, col1]; unplaced ones get new rows.
    mut cells := List[List[int]]()
    mut extra := areas.len()
    for it in items
        mut name := ""
        if self.d.nodes[it].kind == Element
            name = (self.element_style(it).get("grid-area") else "").trim().to_lower()
            if name == ""
                ## `grid-row-start: name` and the like name an area too.
                name = (self.element_style(it).get("grid-row-start") else "").trim().to_lower()
        b := if name != "" and not name.contains("/") then area_box(areas, name) else []
        if b.len() == 0
            cells.push([extra, extra, 0, ncols - 1])
            extra += 1
        else
            cells.push(b)
    self.grid_rows(items, cells, tracks, st, x, w, gaps, grid_centred(cs))

fn Ctx.table(mut self, id int, st St, x float, w float)
    mut rows := List[int]()
    self.collect_rows(id, mut rows)
    mut ncols := 0
    for r in rows
        ncols = ncols.max(self.items(r).len())
    if ncols == 0
        return
    mut natural := List[float]()
    for k in 0..ncols
        natural.push(20.0)
    for r in rows
        cells := self.items(r)
        for k in 0..cells.len()
            cs := self.element_style(cells[k])
            cst := text_style(self.d.nodes[cells[k]].tag, cs, st)
            natural[k] = fmax(natural[k], self.intrinsic(cells[k], cst) + 12.0)
    mut sum := 0.0
    for v in natural
        sum += v
    scale := if sum > w then w / sum else 1.0
    mut extra := if sum < w then (w - sum) / ncols.to_float() else 0.0
    mut widths := List[float]()
    mut offsets := List[float]()
    mut at := 0.0
    for v in natural
        cw := v * scale + extra
        widths.push(cw)
        offsets.push(at)
        at += cw
    for r in rows
        cells := self.items(r)
        self.row(cells, st, x, widths[0..cells.len()], offsets[0..cells.len()], false, 0.0)

fn Ctx.collect_rows(mut self, id int, mut out List[int])
    for c in self.d.nodes[id].children
        tag := self.d.nodes[c].tag
        if tag == "tr"
            out.push(c)
        elif tag == "thead" or tag == "tbody" or tag == "tfoot"
            self.collect_rows(c, mut out)

## Lays `d` out in a column `width` pixels wide with `sheet` (the linked
## style sheets) before the document's own.
pub fn layout(d html.Doc, url str, width float, sheet css.Sheet) Scene
    layout_with(d, url, width, sheet, Map[str, List[int]]())

## `layout` with the pictures' sizes (`images.prefetch`), so an `<img>`
## without `width` and `height` takes its own.
pub fn layout_with(
    d html.Doc,
    url str,
    width float,
    sheet css.Sheet,
    sizes Map[str, List[int]],
) Scene
    layout_measured(d, url, width, sheet, sizes, Map[str, float](), -1)

## `layout_with` using the run widths in `meas` (`probe_key`), drawing text
## field `editing` (a node, or -1) with a caret; the scene's `probes` are the
## runs that were estimated, for the host to measure. The window is taken to
## be 16:10 and dark; `layout_env` takes the real one.
pub fn layout_measured(
    d html.Doc,
    url str,
    width float,
    sheet css.Sheet,
    sizes Map[str, List[int]],
    meas Map[str, float],
    editing int,
) Scene
    height := fmax(width * 5.0 / 8.0, 1.0)
    layout_env(d, url, width, height, page_sheet(d, sheet, width, height, true), sizes, meas, editing)

## The style sheet a layout of `d` uses in a window `width` by `height` CSS
## pixels: the linked sheets in `sheet`, then the document's `<style>`
## elements, keeping the rules whose media queries match. Building it parses
## every `<style>` element and indexes every rule, so a caller that lays the
## same document out again (measured text widths, a caret, a scroll that
## re-lays) keeps it and passes it to `layout_env` (review-speed 3.6).
pub fn page_sheet(d html.Doc, sheet css.Sheet, width float, height float, dark bool) css.Sheet
    css.for_size(
        css.concat(sheet, css.document_sheet(d)),
        width.to_int().max(1),
        height.to_int().max(1),
        dark,
    )

## Lays `d` out `width` pixels wide in a window `height` pixels high (for
## viewport units) with `all`, the sheet `page_sheet` built for that window;
## the rest as `layout_measured`.
pub fn layout_env(
    d html.Doc,
    url str,
    width float,
    height float,
    all css.Sheet,
    sizes Map[str, List[int]],
    meas Map[str, float],
    editing int,
) Scene
    base := St(
        color: INK,
        size: 16.0,
        bold: false,
        italic: false,
        underline: false,
        mono: false,
        serif: false,
        pre: false,
        align: "left",
        lh: 1.3,
        href: "",
        node: -1,
        upper: false,
        nowrap: false,
        alt: "",
        under: 0xffffff,
        ghost: false,
        fade: 1.0,
        clear: false,
    )
    mut c := Ctx(
        d,
        svgs: {},
        sheet: all,
        url: page.base_of(d, url),
        ops: [],
        hits: [],
        boxes: [],
        atoms: [],
        y: 0.0,
        pend: 0.0,
        marker: "",
        marker_x: 0.0,
        canvas: 0xffffff,
        styles: {},
        cascades: {},
        var_owner: {},
        var_vals: {},
        force_h: -1.0,
        contents: {},
        editing: editing,
        pics: sizes,
        meas,
        probes: [],
        probed: {},
        floats: [],
        ax: 0.0,
        ay: 0.0,
        aw: width,
        page_w: width,
        col_x: 0.0,
        col_w: width,
        reach: 0.0,
        view_w: width,
        view_h: height,
        shown: {},
    )
    ## `color-scheme: ... dark` on the root: the screen is dark, so the
    ## default text is light (CSS Color Adjust 1). The root's cascade is kept
    ## for the layout that follows.
    mut st := base
    if root := d.first("html")
        if (c.cascaded(root).get("color-scheme") else "").contains("dark")
            st.color = 0xe8e8e8
    c.block(0, st, 0.0, width)
    c.settle()
    Scene(
        ops: c.ops,
        hits: c.hits,
        boxes: c.boxes,
        height: c.y,
        bg: c.canvas,
        probes: c.probes,
        bits: c.svgs,
    )

## The link or control under point (`x`, `y`) of the page, if any.
pub fn Scene.hit_at(self, x float, y float) Hit?
    mut k := self.hits.len()
    while k > 0
        k -= 1
        h := self.hits[k]
        if x >= h.x and x < h.x + h.w and y >= h.y and y < h.y + h.h
            return h
    none

## The link under point (`x`, `y`) of the page, if any.
pub fn Scene.link_at(self, x float, y float) str?
    h := self.hit_at(x, y)?
    if h.href == ""
        return none
    h.href

# ---- Tests ----------------------------------------------------------------

## `src` laid out `width` wide with no linked sheet.
fn test_scene(src str, width float) Scene
    layout(html.parse(src), "file:///t.html", width, css.parse("", 0))

## The first rectangle drawn in `color` as [x, y, w, h], or [].
fn rect_in(s Scene, want int) List[float]
    for op in s.ops
        match op
            Rect(x, y, w, h, c) =>
                if c == want
                    return [x, y, w, h]
            Text | Str | Pic => continue
    []

## The first string drawn that starts with `word` as [x, y], or [].
fn text_at(s Scene, word str) List[float]
    for op in s.ops
        match op
            Str(x, y, t, _, _, _, _, _, _) =>
                if t.starts_with(word)
                    return [x, y]
            Rect | Text | Pic => continue
    []

## The first string drawn that contains `word`, or "".
fn run_with(s Scene, word str) str
    for op in s.ops
        match op
            Str(_, _, t, _, _, _, _, _, _) =>
                if t.contains(word)
                    return t
            Rect | Text | Pic => continue
    ""

## BBC News: a 24-column page grid whose items each span 12 columns.
@test fn grid_items_span_the_columns_their_lines_name()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: repeat(24, 1fr) } .a \{ grid-column: 1/span 12; background: #ff0000 } .b \{ grid-column: 13/span 12; background: #00ff00 }</style>
        <div class=g><div class=a>one</div><div class=b>two</div></div>
        """
    s := test_scene(src, 1000.0)
    a := rect_in(s, 0xff0000)
    b := rect_in(s, 0x00ff00)
    assert_eq(a.len(), 4)
    assert_eq(b.len(), 4)
    assert_near(a[0], 0.0, 0.5)
    assert_near(a[2], 500.0, 1.0)
    assert_near(b[0], 500.0, 1.0)
    assert_near(b[2], 500.0, 1.0)
    assert_near(a[1], b[1], 0.5)

@test fn auto_placement_honours_spans_and_wraps_to_the_next_row()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px 0 } .w \{ grid-column: span 2 } .e \{ grid-column: -2 / -1 }</style>
        <div class=g><div class=w>wide</div><div>next</div><div>third</div><div class=e>last</div></div>
        """
    s := test_scene(src, 300.0)
    wide := text_at(s, "wide")
    nx := text_at(s, "next")
    third := text_at(s, "third")
    last := text_at(s, "last")
    assert_near(nx[0], 200.0, 1.0)
    assert_near(nx[1], wide[1], 0.5)
    assert_near(third[0], 0.0, 0.5)
    assert(third[1] > wide[1] + 10.0)
    assert_near(last[0], 200.0, 1.0)
    assert_near(last[1], third[1], 0.5)

@test fn auto_tracks_take_their_content_and_fr_tracks_the_rest()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: 1fr auto } .a \{ background: #ff0000 } .b \{ background: #00ff00 }</style>
        <div class=g><div class=a>main</div><div class=b>ok</div></div>
        """
    s := test_scene(src, 600.0)
    a := rect_in(s, 0xff0000)
    b := rect_in(s, 0x00ff00)
    assert(b[2] > 5.0 and b[2] < 100.0)
    assert_near(a[2] + b[2], 600.0, 1.0)
    assert_near(b[0], a[2], 1.0)
    only := test_scene(
        "<style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: auto auto }</style><div class=g><div>one</div><div>two</div></div>",
        600.0,
    )
    ## Both stretch by the same amount, so the second starts near the middle.
    assert_near(text_at(only, "two")[0], 300.0, 3.0)

@test fn repeat_mixes_with_other_tracks_and_minmax_keeps_its_floor()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: [full-start] repeat(2, 1fr) 100px [full-end] } .h \{ display: grid; grid-template-columns: minmax(300px, 1fr) 1fr }</style>
        <div class=g><div>aa</div><div>bb</div><div>cc</div></div>
        <div class=h><div>dd</div><div>ee</div></div>
        """
    s := test_scene(src, 500.0)
    assert_near(text_at(s, "aa")[0], 0.0, 0.5)
    assert_near(text_at(s, "bb")[0], 200.0, 1.0)
    assert_near(text_at(s, "cc")[0], 400.0, 1.0)
    assert_near(text_at(s, "ee")[0], 300.0, 1.0)
    fill := test_scene(
        "<style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)) }</style><div class=g><div>p</div><div>q</div><div>r</div><div>s</div><div>t</div></div>",
        450.0,
    )
    assert_near(text_at(fill, "q")[0], 112.5, 1.0)
    assert(text_at(fill, "t")[1] > text_at(fill, "p")[1])

@test fn display_contents_hands_its_children_to_the_grid_and_the_flow()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: 1fr 1fr } .c \{ display: contents }</style>
        <div class=g><div class=c><div>left</div><div>right</div></div></div>
        <p>before <span class=c>inside</span> after</p>
        """
    s := test_scene(src, 400.0)
    l := text_at(s, "left")
    r := text_at(s, "right")
    assert_near(r[0], 200.0, 1.0)
    assert_near(r[1], l[1], 0.5)
    assert_eq(run_with(s, "before"), "before inside after")

@test fn flex_one_shares_the_row_equally_whatever_the_content()
    src := """
        <style>body \{ margin: 0 } .f \{ display: flex } .a \{ flex: 1; background: #ff0000 } .b \{ flex: 1; background: #00ff00 } .c \{ flex: 1; background: #0000ff }</style>
        <div class=f><div class=a>a</div><div class=b>a much longer label</div><div class=c>cc</div></div>
        """
    s := test_scene(src, 600.0)
    a := rect_in(s, 0xff0000)
    b := rect_in(s, 0x00ff00)
    c := rect_in(s, 0x0000ff)
    assert_near(a[2], 200.0, 1.0)
    assert_near(b[2], 200.0, 1.0)
    assert_near(c[2], 200.0, 1.0)
    assert_near(c[0], 400.0, 1.0)

@test fn flex_none_keeps_its_width_and_shrink_takes_the_overflow()
    src := """
        <style>body \{ margin: 0 } .f \{ display: flex } .a \{ flex: 0 0 auto; width: 300px; background: #ff0000 } .b \{ flex: 1 1 400px; background: #00ff00 }</style>
        <div class=f><div class=a>fixed</div><div class=b>shrinks</div></div>
        """
    s := test_scene(src, 500.0)
    a := rect_in(s, 0xff0000)
    b := rect_in(s, 0x00ff00)
    assert_near(a[2], 300.0, 1.0)
    assert_near(b[0], 300.0, 1.0)
    assert_near(b[2], 200.0, 1.0)

@test fn flex_columns_stack_blockified_items_with_gaps_and_alignment()
    src := """
        <style>body \{ margin: 0 } .f \{ display: flex; flex-direction: column; gap: 20px; align-items: center } .a \{ width: 100px; background: #ff0000 }</style>
        <div class=f><span>one</span><span>two</span><div class=a>box</div></div>
        """
    s := test_scene(src, 400.0)
    one := text_at(s, "one")
    two := text_at(s, "two")
    assert(two[1] > one[1] + 20.0)
    assert(one[0] > 150.0)
    a := rect_in(s, 0xff0000)
    assert_near(a[0], 150.0, 1.0)
    grow := test_scene(
        "<style>body \{ margin: 0 } .f \{ display: flex; flex-direction: column; height: 300px } .g \{ flex-grow: 1; background: #00ff00 }</style><div class=f><div>top</div><div class=g>fill</div></div>",
        400.0,
    )
    g := rect_in(grow, 0x00ff00)
    assert(g[3] > 250.0)

@test fn flex_wrap_breaks_lines_with_the_row_gap()
    src := """
        <style>body \{ margin: 0 } .f \{ display: flex; flex-flow: row wrap; gap: 30px 10px } .i \{ width: 150px }</style>
        <div class=f><div class=i>one</div><div class=i>two</div><div class=i>three</div></div>
        """
    s := test_scene(src, 400.0)
    assert_near(text_at(s, "two")[0], 160.0, 1.0)
    assert(text_at(s, "three")[1] > text_at(s, "one")[1] + 30.0)
    assert_near(text_at(s, "three")[0], 0.0, 0.5)

@test fn custom_properties_resolve_through_ancestors_that_declare_none()
    src := """
        <style>:root \{ --ink: #ff0000; --pad: 8px } .mid \{ --ink: #00ff00 } .box \{ background: var(--ink); padding: var(--pad) } .far \{ background: var(--gone, #0000ff) }</style>
        <div><div class=box>red</div><div class=mid><div><div class=box>green</div></div></div><div class=far>blue</div></div>
        """
    s := test_scene(src, 400.0)
    assert_eq(rect_in(s, 0xff0000).len(), 4)
    assert_eq(rect_in(s, 0x00ff00).len(), 4)
    assert_eq(rect_in(s, 0x0000ff).len(), 4)

## The colour of the first string drawn that starts with `word`, or -1.
fn ink_of(s Scene, word str) int
    for op in s.ops
        match op
            Str(_, _, t, _, _, fg, _, _, _) =>
                if t.starts_with(word)
                    return fg
            Rect | Text | Pic => continue
    -1

## Every picture drawn as [x, y, w, h].
fn pics_in(s Scene) List[List[float]]
    mut out := List[List[float]]()
    for op in s.ops
        match op
            Pic(x, y, w, h, _) => out.push([x, y, w, h])
            Rect | Text | Str => continue
    out

@test fn viewport_units_take_the_window_size()
    s := test_scene(
        "<style>body \{ margin: 0 } .a \{ width: 50vw; height: 10vh; background: #ff0000 } .b \{ width: 20vmin; height: 1px; background: #00ff00 }</style><div class=a></div><div class=b></div>",
        1000.0,
    )
    a := rect_in(s, 0xff0000)
    assert_near(a[2], 500.0, 0.5)
    ## The window is taken as 16:10 when only the width is known.
    assert_near(a[3], 62.5, 0.5)
    assert_near(rect_in(s, 0x00ff00)[2], 125.0, 0.5)
    assert_near(length(viewport_px("calc(100dvh - 2vw)", 1000.0, 800.0), 16.0, 0.0) else 0.0, 780.0, 0.01)
    assert_eq(viewport_px("1px solid", 1000.0, 800.0), "1px solid")

@test fn min_max_and_clamp_work_in_lengths()
    assert_near(length("min(calc(100% - 32px), 722px)", 16.0, 1000.0) else 0.0, 722.0, 0.01)
    assert_near(length("min(calc(100% - 32px), 722px)", 16.0, 500.0) else 0.0, 468.0, 0.01)
    assert_near(length("clamp(100px, 50%, 300px)", 16.0, 1000.0) else 0.0, 300.0, 0.01)
    assert_near(length("max(2em, 10px)", 16.0, 0.0) else 0.0, 32.0, 0.01)
    assert_near(length("calc(10px + min(5px, 1em))", 16.0, 0.0) else 0.0, 15.0, 0.01)
    s := test_scene(
        "<style>body \{ margin: 0 } .w \{ max-width: min(calc(100% - 32px), 722px); background: #ff0000 }</style><div class=w>text</div>",
        1000.0,
    )
    assert_near(rect_in(s, 0xff0000)[2], 722.0, 0.5)

@test fn colour_functions_read_as_their_colours()
    assert_eq(color("hsl(120 100% 25%)") else -1, 0x008000)
    assert_eq(color("hsla(0, 100%, 50%, 1)") else -1, 0xff0000)
    assert_eq(color("oklch(1 0 0)") else -1, 0xffffff)
    assert_eq(color("oklab(0 0 0)") else -1, 0x000000)
    assert_eq(color("rgb(255 0 0 / 50%)") else -1, 0xff8080)
    assert_eq(color("rgba(0, 0, 255, .5)") else -1, 0x8080ff)
    assert_eq(color("color-mix(in srgb, #ff0000 50%, #0000ff)") else -1, 0x800080)
    assert_eq(color("color-mix(in oklab, #000000 50%, transparent)") else -1, 0x808080)
    assert(color("transparent") == none)
    s := test_scene(
        "<style>.c \{ color: #00ff00; background: currentColor } .t \{ color: transparent }</style><div class=c>cur</div><p class=t>gone</p><p>kept</p>",
        400.0,
    )
    assert_eq(rect_in(s, 0x00ff00).len(), 4)
    assert_eq(text_at(s, "gone").len(), 0)
    assert_eq(text_at(s, "kept").len(), 2)

@test fn visually_hidden_patterns_draw_nothing_and_take_no_room()
    src := """
        <style>body \{ margin: 0 } p \{ margin: 0 } .sr \{ position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0) } .vh \{ width: 1px; height: 1px; overflow: hidden; margin: -1px } .cp \{ position: absolute; clip-path: inset(50%) } .off \{ position: absolute; left: -9999px } .z \{ transform: scale(0) }</style>
        <p>top</p><div class=sr>Skip one</div><div class=vh>Skip two</div><div class=cp>Skip three</div><div class=off>Skip four</div><div class=z>Skip five</div><p>next</p>
        """
    s := test_scene(src, 400.0)
    assert_eq(run_with(s, "Skip"), "")
    plain := test_scene("<style>body \{ margin: 0 } p \{ margin: 0 }</style><p>top</p><p>next</p>", 400.0)
    assert_near(text_at(s, "next")[1], text_at(plain, "next")[1], 0.5)

@test fn overflow_hidden_cuts_the_content_at_the_box()
    src := """
        <style>body \{ margin: 0 } p \{ margin: 0; line-height: 20px } .box \{ height: 40px; overflow: hidden } .shut \{ height: 0; overflow: hidden }</style>
        <div class=box><p>one</p><p>two</p><p>three</p><p>four</p></div><p>after</p><div class=shut><p>folded</p></div>
        """
    s := test_scene(src, 400.0)
    assert_eq(text_at(s, "one").len(), 2)
    assert_eq(text_at(s, "two").len(), 2)
    assert_eq(text_at(s, "three").len(), 0)
    assert_eq(text_at(s, "four").len(), 0)
    assert_near(text_at(s, "after")[1], 40.0, 1.0)
    assert_eq(text_at(s, "folded").len(), 0)
    wide := test_scene(
        "<style>body \{ margin: 0 } .n \{ width: 60px; overflow: hidden; white-space: nowrap }</style><div class=n>abcdefghijklmnopqrstuvwxyz</div>",
        400.0,
    )
    cut := run_with(wide, "abc")
    assert(cut.len() > 2 and cut.len() < 26)

@test fn visibility_hidden_keeps_its_room_and_opacity_fades()
    src := """
        <style>body \{ margin: 0 } p \{ margin: 0 } .h \{ visibility: hidden } .v \{ visibility: visible } .o \{ opacity: 0 } .half \{ opacity: .5; color: #000000 }</style>
        <p class=h>ghost <span class=v>shown</span></p><p>below</p><p class=o>clear</p><p class=half>grey</p>
        """
    s := test_scene(src, 400.0)
    assert_eq(text_at(s, "ghost").len(), 0)
    assert_eq(text_at(s, "shown").len(), 2)
    assert(text_at(s, "below")[1] > 10.0)
    assert_eq(text_at(s, "clear").len(), 0)
    assert_eq(ink_of(s, "grey"), 0x808080)

@test fn closed_dialogs_details_and_hidden_are_not_drawn()
    src := """
        <dialog>modal</dialog><dialog open>shown dialog</dialog><p hidden>hid</p><div popover>pop</div>
        <details><summary>More</summary><p>secret</p> loose</details><details open><summary>Open</summary><p>visible</p></details>
        """
    s := test_scene(src, 400.0)
    assert_eq(run_with(s, "modal"), "")
    assert(run_with(s, "shown dialog") != "")
    assert_eq(run_with(s, "hid"), "")
    assert_eq(run_with(s, "pop"), "")
    assert(run_with(s, "More") != "")
    assert_eq(run_with(s, "secret"), "")
    assert_eq(run_with(s, "loose"), "")
    assert(run_with(s, "visible") != "")

@test fn pictures_follow_css_sizes_their_shape_and_object_fit()
    sizes := {"https://x.test/a.png": [2000, 1000], "https://x.test/b.webp": [0, 0]}
    src := """
        <style>body \{ margin: 0 } img \{ max-width: 100%; height: auto } .f \{ width: 200px; height: 200px; object-fit: contain } p \{ margin: 0 }</style>
        <p><img src="https://x.test/a.png" width="2000" height="1000"></p><p><img class=f src="https://x.test/a.png"></p>
        """
    s := layout_with(html.parse(src), "https://x.test/", 400.0, css.parse("", 0), sizes)
    ps := pics_in(s)
    assert_eq(ps.len(), 2)
    assert_near(ps[0][2], 400.0, 0.5)
    assert_near(ps[0][3], 200.0, 0.5)
    assert_near(ps[1][2], 200.0, 0.5)
    assert_near(ps[1][3], 100.0, 0.5)
    ## Contained: centred in the 200 by 200 box.
    assert_near(ps[1][1] - ps[0][3], 50.0, 1.5)
    ## A picture that cannot be decoded keeps its box and shows its alt text in it.
    broken := layout_with(
        html.parse("<style>body \{ margin: 0 } p \{ margin: 0 }</style><p><img src=\"https://x.test/b.webp\" width=120 height=60 alt=\"A long description of the picture\"></p><p>after</p>"),
        "https://x.test/",
        400.0,
        css.parse("", 0),
        sizes,
    )
    assert_eq(pics_in(broken).len(), 0)
    alt := text_at(broken, "A long")
    assert_eq(alt.len(), 2)
    assert(text_at(broken, "after")[1] >= 59.0)
    assert(run_with(broken, "picture") == "" or text_at(broken, "picture")[1] < 60.0)

@test fn alt_text_takes_a_line_even_under_line_height_zero()
    src := "<style>p \{ margin: 0 } .w \{ line-height: 0 }</style><div class=w><img src=\"https://x.test/none.webp\" alt=\"first picture\"></div><p>next</p>"
    s := test_scene(src, 400.0)
    assert(text_at(s, "next")[1] >= text_at(s, "first")[1] + 15.0)

@test fn inline_blocks_and_styled_buttons_draw_their_boxes_on_the_line()
    src := """
        <style>body \{ margin: 0 } p \{ margin: 0 } .b \{ display: inline-block; padding: 4px 8px; background: #ff0000; border-radius: 4px } .f \{ background: #00ff00; padding: 2px 6px; border: 0 }</style>
        <p>Go <span class=b>Join</span> now <button class=f>Follow</button></p>
        """
    s := test_scene(src, 400.0)
    box := rect_in(s, 0xff0000)
    assert_eq(box.len(), 4)
    go := text_at(s, "Go")
    join := text_at(s, "Join")
    now := text_at(s, "now")
    assert(box[0] > go[0])
    assert_near(join[0], box[0] + 8.0, 1.0)
    assert(now[0] >= box[0] + box[2] - 0.5)
    assert(box[1] <= join[1])
    assert_eq(rect_in(s, 0x00ff00).len(), 4)
    assert(run_with(s, "Follow") != "")
    hit := s.hit_at(text_at(s, "Follow")[0] + 2.0, text_at(s, "Follow")[1] + 4.0) else Hit(x: 0.0, y: 0.0, w: 0.0, h: 0.0, href: "", node: -1, anchor: -1)
    assert(hit.node >= 0)

@test fn named_grid_areas_place_items_whatever_the_case_of_their_names()
    src := """
        <style>body \{ margin: 0 } .g \{ display: grid; grid-template-columns: 200px 1fr; grid-template-areas: 'siteNotice siteNotice' 'columnStart pageContent' 'footer footer' } .n \{ grid-area: siteNotice } .s \{ grid-area: columnStart } .c \{ grid-area: pageContent } .f \{ grid-area: footer }</style>
        <div class=g><div class=n>notice</div><div class=s>contents</div><div class=c>article</div><div class=f>foot</div></div>
        """
    s := test_scene(src, 1000.0)
    assert_near(text_at(s, "contents")[0], 0.0, 0.5)
    assert_near(text_at(s, "article")[0], 200.0, 1.0)
    assert_near(text_at(s, "article")[1], text_at(s, "contents")[1], 0.5)
    assert(text_at(s, "contents")[1] > text_at(s, "notice")[1])
    assert(text_at(s, "foot")[1] > text_at(s, "article")[1])
    ## An area over several rows does not push the rows it spans apart.
    span := test_scene(
        "<style>body \{ margin: 0 } .g \{ display: grid; grid-template: 'a e' 'b e' 'c e' / 1fr 100px } .a \{ grid-area: a } .b \{ grid-area: b } .c \{ grid-area: c } .e \{ grid-area: e; height: 300px }</style><div class=g><div class=a>aa</div><div class=b>bb</div><div class=c>cc</div><div class=e>ee</div></div><p>end</p>",
        600.0,
    )
    assert(text_at(span, "bb")[1] < 100.0)
    assert(text_at(span, "end")[1] >= 300.0)

@test fn css_wide_keywords_resolve_for_box_properties()
    src := """
        <style>body \{ margin: 0 } .p \{ background: #ff0000; margin-left: 30px } .k \{ background: inherit; margin-left: inherit } .i \{ margin-left: initial }</style>
        <div class=p><div class=k>kid</div></div><div class=p><div class=i>reset</div></div>
        """
    s := test_scene(src, 400.0)
    assert_near(text_at(s, "kid")[0], 60.0, 0.5)
    assert_near(text_at(s, "reset")[0], 30.0, 0.5)

@test fn aspect_ratio_min_width_and_max_height_size_boxes()
    src := """
        <style>body \{ margin: 0 } .a \{ width: 200px; aspect-ratio: 2 / 1; background: #ff0000 } .b \{ width: 100px; min-width: 300px; height: 5px; background: #00ff00 } .c \{ max-height: 30px; overflow: auto; background: #0000ff } p \{ margin: 0; line-height: 20px }</style>
        <div class=a></div><div class=b></div><div class=c><p>l1</p><p>l2</p><p>l3</p></div>
        """
    s := test_scene(src, 600.0)
    assert_near(rect_in(s, 0xff0000)[3], 100.0, 0.5)
    assert_near(rect_in(s, 0x00ff00)[2], 300.0, 0.5)
    assert_near(rect_in(s, 0x0000ff)[3], 30.0, 0.5)
    assert_eq(text_at(s, "l3").len(), 0)

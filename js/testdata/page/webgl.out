<script>
const log=(...a)=>console.log(a.map(x=>typeof x==='object'&&x?JSON.stringify(x):String(x)).join(' '));
const c=document.createElement('canvas');
const gl=c.getContext('webgl');
log('ctx',!!gl, c.getContext('2d'), c.getContext('webgl')===gl, gl.canvas===c, gl.drawingBufferWidth,gl.drawingBufferHeight);
log('attrs',gl.getContextAttributes());
log('exts',gl.getSupportedExtensions().length);
for (const k of ['MAX_TEXTURE_SIZE_X','VERSION','SHADING_LANGUAGE_VERSION','VENDOR','RENDERER','MAX_VERTEX_ATTRIBS','MAX_VARYING_VECTORS','VIEWPORT','COLOR_CLEAR_VALUE','DEPTH_BITS','STENCIL_BITS','BLEND_SRC_RGB','ALIASED_LINE_WIDTH_RANGE','COLOR_WRITEMASK','UNPACK_COLORSPACE_CONVERSION_WEBGL'].filter(k=>k in gl)) log(k, gl.getParameter(gl[k]));
log('err',gl.getError());
log('bad param',gl.getParameter(0x1234), gl.getError(), gl.getError());
log('dbg before', gl.getParameter(37445), gl.getError());
const vs=gl.createShader(gl.VERTEX_SHADER), fs=gl.createShader(gl.FRAGMENT_SHADER);
gl.shaderSource(vs,'attribute vec2 pos; uniform mat4 m; uniform float f[3]; varying vec2 v; void main(){ v=pos; gl_Position=m*vec4(pos,f[0],1.0);}');
gl.shaderSource(fs,'precision mediump float; varying vec2 v; uniform sampler2D t; void main(){ gl_FragColor=texture2D(t,v);}');
gl.compileShader(vs);gl.compileShader(fs);
log('compile',gl.getShaderParameter(vs,gl.COMPILE_STATUS),gl.getShaderParameter(fs,gl.COMPILE_STATUS),JSON.stringify(gl.getShaderInfoLog(vs)));
const p=gl.createProgram();gl.attachShader(p,vs);gl.attachShader(p,fs);gl.linkProgram(p);
log('link',gl.getProgramParameter(p,gl.LINK_STATUS),gl.getProgramParameter(p,gl.ACTIVE_ATTRIBUTES),gl.getProgramParameter(p,gl.ACTIVE_UNIFORMS),gl.getAttribLocation(p,'pos'),gl.getAttribLocation(p,'nope'));
for(let i=0;i<gl.getProgramParameter(p,gl.ACTIVE_UNIFORMS);i++){const a=gl.getActiveUniform(p,i);log('u',a.name,a.type,a.size)}
const a=gl.getActiveAttrib(p,0);log('a',a.name,a.type,a.size);
log('loc',gl.getUniformLocation(p,'m')!==null,gl.getUniformLocation(p,'zz'),gl.getUniformLocation(p,'f[2]')!==null,gl.getUniformLocation(p,'f[3]'));
gl.useProgram(p);
gl.uniform1f(gl.getUniformLocation(p,'f'),2);gl.uniformMatrix4fv(gl.getUniformLocation(p,'m'),false,new Float32Array(16));
log('uerr',gl.getError());
gl.uniform1i(gl.getUniformLocation(p,'m'),1);log('uerr2',gl.getError());
const b=gl.createBuffer();log('isbuf',gl.isBuffer(b));gl.bindBuffer(gl.ARRAY_BUFFER,b);log('isbuf',gl.isBuffer(b));
gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([0,0,1,0,0,1]),gl.STATIC_DRAW);
log('bsize',gl.getBufferParameter(gl.ARRAY_BUFFER,gl.BUFFER_SIZE),gl.getBufferParameter(gl.ARRAY_BUFFER,gl.BUFFER_USAGE));
gl.bufferData(gl.ARRAY_BUFFER,-1,gl.STATIC_DRAW);log('neg',gl.getError());
gl.bufferData(99,1,gl.STATIC_DRAW);log('badtarget',gl.getError());
gl.bindBuffer(gl.ARRAY_BUFFER,b);
gl.enableVertexAttribArray(0);gl.vertexAttribPointer(0,2,gl.FLOAT,false,0,0);
log('va',gl.getVertexAttrib(0,gl.VERTEX_ATTRIB_ARRAY_ENABLED),gl.getVertexAttrib(0,gl.VERTEX_ATTRIB_ARRAY_SIZE),gl.getVertexAttrib(0,gl.CURRENT_VERTEX_ATTRIB),gl.getError());
gl.vertexAttribPointer(99,2,gl.FLOAT,false,0,0);log('va99',gl.getError());
gl.drawArrays(gl.TRIANGLES,0,3);log('draw',gl.getError());
gl.drawArrays(gl.TRIANGLES,0,-3);log('drawneg',gl.getError());
gl.useProgram(null);gl.drawArrays(gl.TRIANGLES,0,3);log('noprog',gl.getError());
const t=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,t);
gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,2,2,0,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array(16));log('tex',gl.getError());
log('tp',gl.getTexParameter(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER),gl.getTexParameter(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S));
gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,5);log('tpe',gl.getError(),gl.getTexParameter(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER));
gl.generateMipmap(gl.TEXTURE_2D);log('mm',gl.getError());
const f=gl.createFramebuffer();gl.bindFramebuffer(gl.FRAMEBUFFER,f);log('fbs',gl.checkFramebufferStatus(gl.FRAMEBUFFER));
gl.framebufferTexture2D(gl.FRAMEBUFFER,gl.COLOR_ATTACHMENT0,gl.TEXTURE_2D,t,0);log('fbs2',gl.checkFramebufferStatus(gl.FRAMEBUFFER),gl.getError());
gl.bindFramebuffer(gl.FRAMEBUFFER,null);
gl.clearColor(1,0.5,0,1);gl.clear(gl.COLOR_BUFFER_BIT);
const px=new Uint8Array(8);gl.readPixels(10,10,2,1,gl.RGBA,gl.UNSIGNED_BYTE,px);log('px',Array.from(px),gl.getError());
gl.readPixels(0,0,1,1,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array(2));log('pxbad',gl.getError());
log('ext',gl.getExtension('WEBGL_debug_renderer_info')!==null,gl.getExtension('nope'),gl.getExtension('webgl_lose_context')!==null);
log('toString',Object.prototype.toString.call(gl),Object.prototype.toString.call(b),Object.prototype.toString.call(p));
const vao=gl.getExtension('OES_vertex_array_object');const v=vao.createVertexArrayOES();vao.bindVertexArrayOES(v);log('vao',vao.isVertexArrayOES(v),gl.getParameter(vao.VERTEX_ARRAY_BINDING_OES)===v);
gl.disable(gl.DEPTH_TEST);gl.enable(gl.DEPTH_TEST);log('en',gl.isEnabled(gl.DEPTH_TEST),gl.isEnabled(gl.BLEND));gl.enable(1);log('enerr',gl.getError());
log('lost',gl.isContextLost());
const f1=gl.getShaderPrecisionFormat(gl.FRAGMENT_SHADER,gl.HIGH_FLOAT);log('prec',f1.rangeMin,f1.rangeMax,f1.precision);
const bad=gl.createShader(gl.FRAGMENT_SHADER);gl.shaderSource(bad,'void main(){ float x=1.0; }');gl.compileShader(bad);log('badc',gl.getShaderParameter(bad,gl.COMPILE_STATUS));

</script>


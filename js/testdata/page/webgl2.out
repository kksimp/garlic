<script>
const log=(...a)=>console.log(a.map(x=>typeof x==='object'&&x?JSON.stringify(x):String(x)).join(' '));
const c=document.createElement('canvas');
const gl=c.getContext('webgl2');
log('ctx',!!gl,c.getContext('webgl'),c.getContext('2d'),c.getContext('webgl2')===gl,Object.prototype.toString.call(gl));
log('ver',gl.getParameter(gl.VERSION),gl.getParameter(gl.SHADING_LANGUAGE_VERSION),gl.getParameter(gl.VENDOR));
log('exts',gl.getSupportedExtensions().join(','));
for (const k of ['MAX_3D_TEXTURE_SIZE','MAX_DRAW_BUFFERS','MAX_COLOR_ATTACHMENTS','MAX_SAMPLES','MAX_UNIFORM_BUFFER_BINDINGS','UNIFORM_BUFFER_OFFSET_ALIGNMENT','MAX_VERTEX_UNIFORM_BLOCKS','MAX_ARRAY_TEXTURE_LAYERS','MIN_PROGRAM_TEXEL_OFFSET','READ_BUFFER','DRAW_BUFFER0','DRAW_BUFFER1','RASTERIZER_DISCARD','MAX_ELEMENT_INDEX','MAX_VARYING_COMPONENTS','TEXTURE_BINDING_3D','VERTEX_ARRAY_BINDING','UNPACK_ROW_LENGTH','TRANSFORM_FEEDBACK_BINDING','SAMPLER_BINDING','MAX_TEXTURE_LOD_BIAS']) log(k,gl.getParameter(gl[k]));
log('err',gl.getError());
const vs=gl.createShader(gl.VERTEX_SHADER),fs=gl.createShader(gl.FRAGMENT_SHADER);
gl.shaderSource(vs,'#version 300 es\nlayout(location=1) in vec3 pos; in vec2 uv; out vec2 vuv; uniform mat4 m; uniform Block { vec4 a; vec4 b; } blk; flat out int id; void main(){ vuv=uv; id=gl_VertexID; gl_Position=m*vec4(pos,1.0)+blk.a; }');
gl.shaderSource(fs,'#version 300 es\nprecision highp float; in vec2 vuv; flat in int id; uniform sampler2D tex; uniform uvec2 u2; layout(location=0) out vec4 color; void main(){ color=texture(tex,vuv)+vec4(float(u2.x)+float(id)); }');
gl.compileShader(vs);gl.compileShader(fs);
log('compile',gl.getShaderParameter(vs,gl.COMPILE_STATUS),gl.getShaderParameter(fs,gl.COMPILE_STATUS),JSON.stringify(gl.getShaderInfoLog(vs)),JSON.stringify(gl.getShaderInfoLog(fs)));
const p=gl.createProgram();gl.attachShader(p,vs);gl.attachShader(p,fs);gl.linkProgram(p);
log('link',gl.getProgramParameter(p,gl.LINK_STATUS),gl.getProgramParameter(p,gl.ACTIVE_ATTRIBUTES),gl.getProgramParameter(p,gl.ACTIVE_UNIFORMS),gl.getProgramParameter(p,gl.ACTIVE_UNIFORM_BLOCKS),gl.getAttribLocation(p,'pos'),gl.getAttribLocation(p,'uv'),gl.getFragDataLocation(p,'color'));
const ul=[];for(let i=0;i<gl.getProgramParameter(p,gl.ACTIVE_UNIFORMS);i++){const a=gl.getActiveUniform(p,i);ul.push(['u',a.name,a.type,a.size].join(' '))}ul.sort().forEach(x=>log(x));
log('blk',gl.getUniformBlockIndex(p,'Block'),gl.getUniformBlockIndex(p,'zz'),gl.getActiveUniformBlockName(p,0),gl.getActiveUniformBlockParameter(p,0,gl.UNIFORM_BLOCK_BINDING));
gl.uniformBlockBinding(p,0,3);log('blk2',gl.getActiveUniformBlockParameter(p,0,gl.UNIFORM_BLOCK_BINDING),gl.getError());
gl.useProgram(p);gl.uniform2ui(gl.getUniformLocation(p,'u2'),1,2);log('uni',gl.getUniform(p,gl.getUniformLocation(p,'u2')),gl.getError());
gl.uniform1ui(gl.getUniformLocation(p,'u2'),1);log('uniwrong',gl.getError());
const v1=gl.createShader(gl.VERTEX_SHADER);gl.shaderSource(v1,'attribute vec2 p; void main(){gl_Position=vec4(p,0.,1.);}');gl.compileShader(v1);log('v1ok',gl.getShaderParameter(v1,gl.COMPILE_STATUS));
const vao=gl.createVertexArray();log('vao',gl.isVertexArray(vao));gl.bindVertexArray(vao);log('vao2',gl.isVertexArray(vao),gl.getParameter(gl.VERTEX_ARRAY_BINDING)===vao);
const b=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array(12),gl.STATIC_DRAW);
gl.vertexAttribIPointer(0,2,gl.INT,0,0);log('ip',gl.getVertexAttrib(0,gl.VERTEX_ATTRIB_ARRAY_INTEGER),gl.getError());
gl.vertexAttribDivisor(0,1);log('div',gl.getVertexAttrib(0,gl.VERTEX_ATTRIB_ARRAY_DIVISOR));
const ub=gl.createBuffer();gl.bindBufferBase(gl.UNIFORM_BUFFER,0,ub);log('ub',gl.getIndexedParameter(gl.UNIFORM_BUFFER_BINDING,0)===ub,gl.getParameter(gl.UNIFORM_BUFFER_BINDING)===ub,gl.getError());
gl.bindBufferBase(gl.UNIFORM_BUFFER,99,ub);log('ub99',gl.getError());
gl.bindBuffer(gl.COPY_READ_BUFFER,b);const b2=gl.createBuffer();gl.bindBuffer(gl.COPY_WRITE_BUFFER,b2);gl.bufferData(gl.COPY_WRITE_BUFFER,48,gl.STATIC_COPY);gl.copyBufferSubData(gl.COPY_READ_BUFFER,gl.COPY_WRITE_BUFFER,0,0,48);log('copy',gl.getError());gl.copyBufferSubData(gl.COPY_READ_BUFFER,gl.COPY_WRITE_BUFFER,0,0,480);log('copybad',gl.getError());
const dst=new Float32Array(12);gl.getBufferSubData(gl.COPY_READ_BUFFER,0,dst);log('gbs',gl.getError());
const t=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,t);gl.texStorage2D(gl.TEXTURE_2D,4,gl.RGBA8,8,8);log('ts',gl.getError(),gl.getTexParameter(gl.TEXTURE_2D,gl.TEXTURE_IMMUTABLE_FORMAT));
gl.texImage2D(gl.TEXTURE_2D,0,gl.RGBA,8,8,0,gl.RGBA,gl.UNSIGNED_BYTE,null);log('imm',gl.getError());
gl.texSubImage2D(gl.TEXTURE_2D,0,0,0,2,2,gl.RGBA,gl.UNSIGNED_BYTE,new Uint8Array(16));log('sub',gl.getError());
const t3=gl.createTexture();gl.bindTexture(gl.TEXTURE_3D,t3);gl.texImage3D(gl.TEXTURE_3D,0,gl.R8,4,4,4,0,gl.RED,gl.UNSIGNED_BYTE,null);log('t3',gl.getError(),gl.getParameter(gl.TEXTURE_BINDING_3D)===t3);
const t4=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D_ARRAY,t4);gl.texImage3D(gl.TEXTURE_2D_ARRAY,0,gl.RGBA32F,4,4,3,0,gl.RGBA,gl.FLOAT,null);log('t4',gl.getError());
gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_COMPARE_MODE,gl.COMPARE_REF_TO_TEXTURE);log('cmp',gl.getError(),gl.getTexParameter(gl.TEXTURE_2D,gl.TEXTURE_COMPARE_MODE));
const sm=gl.createSampler();log('smp',gl.isSampler(sm));gl.bindSampler(0,sm);log('smp2',gl.isSampler(sm),gl.getParameter(gl.SAMPLER_BINDING)===sm);gl.samplerParameteri(sm,gl.TEXTURE_MIN_FILTER,gl.LINEAR);log('smp3',gl.getSamplerParameter(sm,gl.TEXTURE_MIN_FILTER),gl.getError());
const q=gl.createQuery();gl.beginQuery(gl.ANY_SAMPLES_PASSED,q);log('q',gl.getQuery(gl.ANY_SAMPLES_PASSED,gl.CURRENT_QUERY)===q);gl.endQuery(gl.ANY_SAMPLES_PASSED);log('qe',gl.getError(),gl.getQueryParameter(q,gl.QUERY_RESULT_AVAILABLE));
const sy=gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE,0);log('sync',gl.isSync(sy),gl.getSyncParameter(sy,gl.OBJECT_TYPE),gl.getError());
const tf=gl.createTransformFeedback();gl.bindTransformFeedback(gl.TRANSFORM_FEEDBACK,tf);log('tf',gl.isTransformFeedback(tf),gl.getParameter(gl.TRANSFORM_FEEDBACK_BINDING)===tf);
const fb=gl.createFramebuffer();gl.bindFramebuffer(gl.DRAW_FRAMEBUFFER,fb);log('fb',gl.getParameter(gl.DRAW_FRAMEBUFFER_BINDING)===fb,gl.getParameter(gl.READ_FRAMEBUFFER_BINDING));
gl.bindFramebuffer(gl.READ_FRAMEBUFFER,fb);gl.framebufferTexture2D(gl.READ_FRAMEBUFFER,gl.COLOR_ATTACHMENT1,gl.TEXTURE_2D,t,0);log('fba',gl.getError(),gl.checkFramebufferStatus(gl.READ_FRAMEBUFFER));
gl.framebufferTextureLayer(gl.FRAMEBUFFER,gl.COLOR_ATTACHMENT0,t4,0,1);log('fbl',gl.getError());
gl.drawBuffers([gl.COLOR_ATTACHMENT0,gl.COLOR_ATTACHMENT1]);log('db',gl.getError(),gl.getParameter(gl.DRAW_BUFFER1));
gl.bindFramebuffer(gl.FRAMEBUFFER,null);gl.drawBuffers([gl.COLOR_ATTACHMENT0]);log('dbbad',gl.getError());
const rb=gl.createRenderbuffer();gl.bindRenderbuffer(gl.RENDERBUFFER,rb);gl.renderbufferStorageMultisample(gl.RENDERBUFFER,4,gl.RGBA8,16,16);log('rbm',gl.getError(),gl.getRenderbufferParameter(gl.RENDERBUFFER,gl.RENDERBUFFER_WIDTH));
log('ifp',gl.getInternalformatParameter(gl.RENDERBUFFER,gl.RGBA8,gl.SAMPLES),gl.getError());
gl.clearColor(0,1,0,1);gl.clearBufferfv(gl.COLOR,0,[1,0,0,1]);const px=new Uint8Array(4);gl.readPixels(1,1,1,1,gl.RGBA,gl.UNSIGNED_BYTE,px);log('cb',Array.from(px),gl.getError());
gl.drawArraysInstanced(gl.TRIANGLES,0,3,2);log('dai',gl.getError());
gl.useProgram(p);gl.drawArraysInstanced(gl.TRIANGLES,0,3,-1);log('daineg',gl.getError());
gl.enable(gl.RASTERIZER_DISCARD);log('rd',gl.isEnabled(gl.RASTERIZER_DISCARD),gl.getError());
log('blit',(gl.blitFramebuffer(0,0,1,1,0,0,1,1,gl.COLOR_BUFFER_BIT,gl.NEAREST),gl.getError()));
const c1=document.createElement('canvas');const g1=c1.getContext('webgl');log('v1',g1.getExtension('OES_vertex_array_object')!==null,typeof g1.createVertexArray,typeof g1.texImage3D,g1.getParameter(g1.VERSION));
g1.createShader(g1.VERTEX_SHADER);const s3=g1.createShader(g1.VERTEX_SHADER);g1.shaderSource(s3,'#version 300 es\nvoid main(){}');g1.compileShader(s3);log('v1rejects300',g1.getShaderParameter(s3,g1.COMPILE_STATUS));
g1.bindTexture(32879,null);log('v1t3d',g1.getError());
</script>


<div id="out">DONE!</div>
<script>
console.log("classic 1", document.readyState);
document.addEventListener("DOMContentLoaded", () => console.log("DOMContentLoaded", document.readyState));
document.addEventListener("readystatechange", () => console.log("readystatechange", document.readyState));
window.addEventListener("load", () => console.log("load"));

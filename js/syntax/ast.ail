## The syntax tree of a JavaScript script. Its shape follows ESTree, the
## tree most JavaScript tools share, and `dump.ail` prints it as ESTree
## JSON. Node names keep ECMA-262's grammar names where ESTree has none.

## Where a node starts: line and column, from 1.
pub struct Pos
    pub line int
    pub col int

pub struct Program
    pub body List[Stmt]
    ## The script starts with a "use strict" directive (§11.2.2).
    pub strict bool

pub enum Stmt
    Exp(expr Expr, pos Pos)
    Var(decl VarDecl)
    FuncDecl(f Func)
    ClassDecl(c Class)
    Return(value Expr?, pos Pos)
    If(test Expr, yes Stmt, no Stmt?, pos Pos)
    Block(body List[Stmt], pos Pos)
    Empty(pos Pos)
    For(init ForInit?, test Expr?, update Expr?, body Stmt, pos Pos)
    ## `for (left in right)`, or with `of`: `for (left of right)`.
    ForIn(left ForLeft, right Expr, body Stmt, of bool, pos Pos)
    While(test Expr, body Stmt, pos Pos)
    DoWhile(body Stmt, test Expr, pos Pos)
    Break(label str?, pos Pos)
    Continue(label str?, pos Pos)
    Throw(value Expr, pos Pos)
    ## A `catch` without `finally` has `handler`; `catch {}` has no `param`.
    Try(block List[Stmt], param Pat?, handler List[Stmt]?, finalizer List[Stmt]?, pos Pos)
    Switch(disc Expr, cases List[Case], pos Pos)
    Labeled(label str, body Stmt, pos Pos)
    With(object Expr, body Stmt, pos Pos)
    Debugger(pos Pos)

## `var`, `let` or `const` and its declarators.
pub struct VarDecl
    pub kind str
    pub decls List[Declarator]
    pub pos Pos

pub struct Declarator
    pub target Pat
    pub init Expr?

pub enum ForInit
    InitDecl(decl VarDecl)
    InitExpr(expr Expr)

pub enum ForLeft
    LeftDecl(decl VarDecl)
    LeftPat(target Pat)

pub struct Case
    ## None for `default:`.
    pub test Expr?
    pub body List[Stmt]
    pub pos Pos

pub enum Expr
    Num(value float, pos Pos)
    Str(value str, pos Pos)
    Template(quasis List[Quasi], exprs List[Expr], pos Pos)
    Tagged(tag Expr, quasis List[Quasi], exprs List[Expr], pos Pos)
    Regex(pattern str, flags str, pos Pos)
    Bool(value bool, pos Pos)
    Null(pos Pos)
    Ident(name str, pos Pos)
    This(pos Pos)
    Super(pos Pos)
    ## `new.target` (§13.3.12).
    NewTarget(pos Pos)
    ## `none` is a hole: `[1, , 2]`. `comma_after_spread`: `[...a,]`, which
    ## can't become a pattern.
    Array(items List[Expr?], comma_after_spread bool, pos Pos)
    Object(props List[Prop], pos Pos)
    Function(f Func)
    Arrow(f Func)
    ClassExpr(c Class)
    Unary(op str, arg Expr, pos Pos)
    Update(op str, prefix bool, arg Expr, pos Pos)
    Binary(op str, left Expr, right Expr, pos Pos)
    Logical(op str, left Expr, right Expr, pos Pos)
    Assign(op str, target Pat, value Expr, pos Pos)
    Cond(test Expr, yes Expr, no Expr, pos Pos)
    Call(callee Expr, args List[Expr], optional bool, pos Pos)
    New(callee Expr, args List[Expr], pos Pos)
    ## `a.b` has `prop` an `Ident`, `a.#b` a `PrivName`; `a[b]` is `computed`.
    Member(object Expr, prop Expr, computed bool, optional bool, pos Pos)
    Seq(items List[Expr], pos Pos)
    Spread(arg Expr, pos Pos)
    ## The whole of an optional chain `a?.b.c` (ESTree ChainExpression).
    Chain(expr Expr, pos Pos)
    PrivName(name str, pos Pos)
    ## Parentheses, kept so `(a) = 1` and `({a}) = 1` can be told apart (§13.15.1).
    Paren(expr Expr, pos Pos)
    ## `yield`, `yield x` and `yield* x` in a generator (§15.5).
    Yield(arg Expr?, delegate bool, pos Pos)
    ## `await x` in an async function (§15.8).
    Await(arg Expr, pos Pos)

## One literal piece of a template; `cooked` is none for an invalid escape
## in a tagged template (§13.2.8.2).
pub struct Quasi
    pub cooked str?
    pub raw str

pub enum Prop
    Init(key Key, value Expr, shorthand bool, pos Pos)
    ## A method, getter (`kind` "get") or setter ("set"); "init" otherwise.
    Method(key Key, kind str, f Func, pos Pos)
    PropSpread(arg Expr, pos Pos)
    ## `{a = 1}`: valid only where the object becomes a pattern
    ## (§13.2.5.1, CoverInitializedName).
    CoverInit(name str, value Expr, pos Pos)

## A property name (§13.2.5 PropertyName).
pub enum Key
    KeyName(name str, pos Pos)
    KeyStr(value str, pos Pos)
    KeyNum(value float, pos Pos)
    Computed(expr Expr, pos Pos)
    KeyPriv(name str, pos Pos)

## A binding or assignment target (§8.6.2, §13.15.5).
pub enum Pat
    PatId(name str, pos Pos)
    ## A member expression, only in assignments.
    PatTarget(expr Expr)
    PatObj(props List[PatProp], rest Pat?, pos Pos)
    ## `none` is an elision: `[, b] = x`.
    PatArr(items List[Pat?], rest Pat?, pos Pos)
    PatDefault(target Pat, value Expr, pos Pos)

pub struct PatProp
    pub key Key
    pub value Pat
    pub shorthand bool

## A function, method, arrow or getter. An arrow with an expression body
## has `expr`, and `body` is empty.
pub struct Func
    pub name str?
    pub params List[Pat]
    ## `...rest`, the last parameter.
    pub rest Pat?
    pub body List[Stmt]
    pub expr Expr?
    pub is_arrow bool
    pub is_async bool
    pub is_gen bool
    ## Strict mode code (§11.2.2): inherited, or a "use strict" directive.
    pub strict bool
    pub pos Pos

pub struct Class
    pub name str?
    pub superclass Expr?
    pub members List[ClassMember]
    pub pos Pos

## A class element (§15.7). `kind` is "constructor", "method", "get",
## "set", "field" or "static-block". Methods and blocks have `f`, a field
## has its initialiser in `value`.
pub struct ClassMember
    pub kind str
    pub key Key?
    pub is_static bool
    pub f Func?
    pub value Expr?
    pub pos Pos

pub fn expr_pos(e Expr) Pos
    match e
        Num(_, p) => p
        Str(_, p) => p
        Template(_, _, p) => p
        Tagged(_, _, _, p) => p
        Regex(_, _, p) => p
        Bool(_, p) => p
        Null(p) => p
        Ident(_, p) => p
        This(p) => p
        Super(p) => p
        NewTarget(p) => p
        Array(_, _, p) => p
        Object(_, p) => p
        Unary(_, _, p) => p
        Update(_, _, _, p) => p
        Binary(_, _, _, p) => p
        Logical(_, _, _, p) => p
        Assign(_, _, _, p) => p
        Cond(_, _, _, p) => p
        Call(_, _, _, p) => p
        New(_, _, p) => p
        Member(_, _, _, _, p) => p
        Seq(_, p) => p
        Spread(_, p) => p
        Chain(_, p) => p
        PrivName(_, p) => p
        Paren(_, p) => p
        Yield(_, _, p) => p
        Await(_, p) => p
        Function(f) => f.pos
        Arrow(f) => f.pos
        ClassExpr(c) => c.pos

pub fn pat_pos(p Pat) Pos
    match p
        PatId(_, at) => at
        PatObj(_, _, at) => at
        PatArr(_, _, at) => at
        PatDefault(_, _, at) => at
        PatTarget(e) => expr_pos(e)

## The variant's name, to test a node's kind in one line.
pub fn expr_kind(e Expr) str
    match e
        Num => "Num"
        Str => "Str"
        Template => "Template"
        Tagged => "Tagged"
        Regex => "Regex"
        Bool => "Bool"
        Null => "Null"
        Ident => "Ident"
        This => "This"
        Super => "Super"
        NewTarget => "NewTarget"
        Array => "Array"
        Object => "Object"
        Function => "Function"
        Arrow => "Arrow"
        ClassExpr => "ClassExpr"
        Unary => "Unary"
        Update => "Update"
        Binary => "Binary"
        Logical => "Logical"
        Assign => "Assign"
        Cond => "Cond"
        Call => "Call"
        New => "New"
        Member => "Member"
        Seq => "Seq"
        Spread => "Spread"
        Chain => "Chain"
        PrivName => "PrivName"
        Paren => "Paren"
        Yield => "Yield"
        Await => "Await"

pub fn pat_kind(p Pat) str
    match p
        PatId => "PatId"
        PatTarget => "PatTarget"
        PatObj => "PatObj"
        PatArr => "PatArr"
        PatDefault => "PatDefault"

## Whether `yield` or `await` occurs in an expression, outside nested
## functions and classes (whose own code they belong to). A computed class
## key or `extends` runs in the enclosing code, so it counts.
pub fn expr_suspends(e Expr) bool
    match e
        Yield | Await => true
        Num | Str | Regex | Bool | Null | Ident | This | Super | NewTarget | PrivName | Function | Arrow => false
        Template(_, exprs, _) => any_suspends(exprs)
        Tagged(tag, _, exprs, _) => expr_suspends(tag) or any_suspends(exprs)
        Array(items, _, _) =>
            for item in items
                if x := item
                    if expr_suspends(x)
                        return true
            false
        Object(props, _) =>
            for p in props
                if prop_suspends(p)
                    return true
            false
        ClassExpr(c) => class_suspends(c)
        Unary(_, arg, _) => expr_suspends(arg)
        Update(_, _, arg, _) => expr_suspends(arg)
        Binary(_, l, r, _) => expr_suspends(l) or expr_suspends(r)
        Logical(_, l, r, _) => expr_suspends(l) or expr_suspends(r)
        Assign(_, target, value, _) => pat_suspends(target) or expr_suspends(value)
        Cond(t, y, n, _) => expr_suspends(t) or expr_suspends(y) or expr_suspends(n)
        Call(callee, args, _, _) => expr_suspends(callee) or any_suspends(args)
        New(callee, args, _) => expr_suspends(callee) or any_suspends(args)
        Member(object, prop, _, _, _) => expr_suspends(object) or expr_suspends(prop)
        Seq(items, _) => any_suspends(items)
        Spread(arg, _) => expr_suspends(arg)
        Chain(inner, _) => expr_suspends(inner)
        Paren(inner, _) => expr_suspends(inner)

pub fn any_suspends(es List[Expr]) bool
    for e in es
        if expr_suspends(e)
            return true
    false

fn key_suspends(k Key) bool
    match k
        Computed(e, _) => expr_suspends(e)
        KeyName | KeyStr | KeyNum | KeyPriv => false

fn prop_suspends(p Prop) bool
    match p
        Init(key, value, _, _) => key_suspends(key) or expr_suspends(value)
        Method(key, _, _, _) => key_suspends(key)
        PropSpread(arg, _) => expr_suspends(arg)
        CoverInit(_, value, _) => expr_suspends(value)

fn class_suspends(c Class) bool
    if s := c.superclass
        if expr_suspends(s)
            return true
    for m in c.members
        if k := m.key
            if key_suspends(k)
                return true
    false

pub fn pat_suspends(p Pat) bool
    match p
        PatId => false
        PatTarget(e) => expr_suspends(e)
        PatObj(props, rest, _) =>
            for pp in props
                if key_suspends(pp.key) or pat_suspends(pp.value)
                    return true
            if r := rest
                return pat_suspends(r)
            false
        PatArr(items, rest, _) =>
            for item in items
                if it := item
                    if pat_suspends(it)
                        return true
            if r := rest
                return pat_suspends(r)
            false
        PatDefault(target, value, _) => pat_suspends(target) or expr_suspends(value)

## Whether a statement may suspend: `yield` or `await` in it, outside
## nested functions.
pub fn stmt_suspends(s Stmt) bool
    match s
        Exp(e, _) => expr_suspends(e)
        Var(d) => decl_suspends(d)
        FuncDecl | Empty | Break | Continue | Debugger => false
        ClassDecl(c) => class_suspends(c)
        Return(value, _) => if v := value then expr_suspends(v) else false
        If(test, yes, no, _) =>
            expr_suspends(test)
                or stmt_suspends(yes)
                or (if n := no then stmt_suspends(n) else false)
        Block(body, _) => block_suspends(body)
        For(init, test, update, body, _) =>
            mut r := stmt_suspends(body)
            if i := init
                head := match i
                    InitDecl(d) => decl_suspends(d)
                    InitExpr(e) => expr_suspends(e)
                r = r or head
            if t := test
                r = r or expr_suspends(t)
            if u := update
                r = r or expr_suspends(u)
            r
        ForIn(left, right, body, _, _) =>
            l := match left
                LeftDecl(d) => decl_suspends(d)
                LeftPat(p) => pat_suspends(p)
            l or expr_suspends(right) or stmt_suspends(body)
        While(test, body, _) => expr_suspends(test) or stmt_suspends(body)
        DoWhile(body, test, _) => expr_suspends(test) or stmt_suspends(body)
        Throw(value, _) => expr_suspends(value)
        Try(block, param, handler, finalizer, _) =>
            mut r := block_suspends(block)
            if p := param
                r = r or pat_suspends(p)
            if h := handler
                r = r or block_suspends(h)
            if f := finalizer
                r = r or block_suspends(f)
            r
        Switch(disc, cases, _) =>
            if expr_suspends(disc)
                return true
            for c in cases
                if t := c.test
                    if expr_suspends(t)
                        return true
                if block_suspends(c.body)
                    return true
            false
        Labeled(_, body, _) => stmt_suspends(body)
        With(object, body, _) => expr_suspends(object) or stmt_suspends(body)

pub fn block_suspends(body List[Stmt]) bool
    for s in body
        if stmt_suspends(s)
            return true
    false

fn decl_suspends(d VarDecl) bool
    for x in d.decls
        if pat_suspends(x.target)
            return true
        if i := x.init
            if expr_suspends(i)
                return true
    false

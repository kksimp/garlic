# Garlic's JavaScript engine, run on its own (docs/design/garlic-js.md):
#   ail run js --tokens FILE...      one token per line: LINE:COL KIND TEXT
#   ail run js --ast [--loc] FILE... the syntax tree as ESTree JSON, one line
#   ail run js --check FILE...       "ok", or the SyntaxError
#   ail run js --test DIR            each DIR/NAME.js against NAME.ast or NAME.err
# A file named NAME.mjs is an ES module (the Module goal); --run and --test-run
# load what it imports from disk and run it as Node runs `node NAME.mjs`.
#   ail run js --test262 DIR [--bless]  the packed test262 parser tests (suite.ail)
#   ail run js --run [--max-steps N] FILE...  run scripts; console.log to stdout
#   ail run js --test-run DIR        each DIR/NAME.js's output against NAME.out
#   ail run js --page FILE.html      load a page: its console, then the body's HTML
#   ail run js --test-page DIR       each DIR/NAME.html's output against NAME.out
# With several files, each output starts with a line `== PATH`. Exit 1 on
# any SyntaxError (or failed test).
use syntax
use vm

fn main() !
    mut args := env.args()
    if args.len() < 2
        usage()
    mode := args.remove_at(0)
    mut loc := false
    if args.len() > 0 and args[0] == "--loc"
        loc = true
        args.remove_at(0)
    mut max_steps := 0
    if args.len() > 1 and args[0] == "--max-steps"
        max_steps = args[1].to_int()? "--max-steps {args[1]}"
        args.remove_at(0)
        args.remove_at(0)
    mut failed := false
    match mode
        "--tokens" | "--ast" | "--check" =>
            for path in args
                if args.len() > 1
                    print("== {path}")
                out := run(mode, fs.read_text(path)?, loc, path.ends_with(".mjs")) else err
                    print(err)
                    failed = true
                    continue
                print(out)
        "--test" => failed = not test_dir(args[0])?
        "--test262" => failed = not run_suite(args[0], args.len() > 1 and args[1] == "--bless")?
        "--run" =>
            for path in args
                if args.len() > 1
                    print("== {path}")
                out := if path.ends_with(".mjs") then run_module_file(path, max_steps, true) else run_script(
                    fs.read_text(path)?,
                    max_steps,
                    true,
                )
                if out.failed
                    io.eprint(out.message)
                    failed = true
        "--test-run" => failed = not test_runs(args[0])?
        "--page" =>
            # `--url URL` loads it at that address and lists every request
            # and cookie too.
            mut url := ""
            if args.len() > 1 and args[0] == "--url"
                url = args[1]
                args.remove_at(0)
                args.remove_at(0)
            for path in args
                print(run_page_at(fs.read_text(path)?, max_steps, url).join("\n"))
        "--test-page" => failed = not test_pages(args[0])?
        _ => usage()
    if failed
        io.exit(1)

fn usage()
    io.eprint("usage: ail run js (--tokens | --ast [--loc] | --check | --run [--max-steps N]) FILE... | --test DIR | --test262 DIR | --test-run DIR | --page FILE | --test-page DIR")
    io.exit(2)

## One file's output for `mode`.
fn run(mode str, source str, loc bool, module bool) str ! syntax.JsError
    match mode
        "--tokens" => [syntax.token_line(t) for t in syntax.tokenize(source)?].join("\n")
        "--ast" => syntax.program_json(parse_goal(source, module)?, loc)
        _ =>
            parse_goal(source, module)?
            "ok"

fn parse_goal(source str, module bool) syntax.Program ! syntax.JsError
    if module
        return syntax.parse_module(source)
    syntax.parse(source)

## Run every `NAME.js` in `dir`: its tree must equal `NAME.ast`, or its
## SyntaxError `NAME.err`. Prints each mismatch; true if there were none.
fn test_dir(dir str) !bool
    mut passed := 0
    mut failures := 0
    for name in fs.list_dir(dir)?
        is_module := name.ends_with(".mjs")
        if not name.ends_with(".js") and not is_module
            continue
        file := path.join(dir, name)
        stem := name.slice(0, name.chars().len() - (if is_module then 4 else 3))
        source := fs.read_text(file)?
        actual := run("--ast", source, false, is_module) else err
            "{err}"
        ast_path := path.join(dir, "{stem}.ast")
        err_path := path.join(dir, "{stem}.err")
        expected := if fs.exists(ast_path)
            fs.read_text(ast_path)?.trim()
        elif fs.exists(err_path)
            fs.read_text(err_path)?.trim()
        else
            print("{file}: no {stem}.ast or {stem}.err")
            failures += 1
            continue
        if actual == expected
            passed += 1
        else
            print("FAIL {file}\n  expected: {expected}\n  actual:   {actual}")
            failures += 1
    print("{passed} passed, {failures} failed")
    failures == 0

## What running a script did.
struct RunResult
    ## console.log's lines, when not echoed.
    lines List[str]
    failed bool
    ## "Uncaught TypeError: ...", or the SyntaxError.
    message str

## Parse and run one script in a new interpreter.
fn run_script(source str, max_steps int, echo bool) RunResult
    prog := syntax.parse(source) else err
        return RunResult(lines: [], failed: true, message: "{err}")
    mut machine := vm.new_vm()
    machine.echo = echo
    machine.step_limit = max_steps
    if result := machine.run_program(prog)
        result
    else err
        return RunResult(
            lines: machine.console_out,
            failed: true,
            message: machine.uncaught_text(err),
        )
    # Then jobs and timers, as Node runs them after the script.
    machine.run_event_loop(1.0e300, 1000000)
    RunResult(lines: machine.console_out, failed: false, message: "")

## `file` as a `file://` address: absolute, with `.` and `..` resolved.
fn file_url(file str) str
    mut p := file
    if not p.starts_with("/")
        p = "{env.cwd()}/{p}"
    mut parts := List[str]()
    for seg in p.split("/")
        if seg == "" or seg == "."
            continue
        if seg == ".."
            if parts.len() > 0
                parts.pop()
            continue
        parts.push(seg)
    "file:///{parts.join("/")}"

## The disk path of a `file://` address.
fn file_path_of(url str) str
    rest := url.strip_prefix("file://") else url
    rest.split("?")[0].split("#")[0]

## Read `url` and what it imports, breadth first, into the machine's script
## store. A file that can't be read is left out: the import then fails.
fn preload_modules(mut machine vm.Vm, url str)
    mut queue := [url]
    mut i := 0
    while i < queue.len() and i < 2000
        u := queue[i]
        i += 1
        if machine.external_scripts.contains(u)
            continue
        file := file_path_of(u)
        if not fs.exists(file)
            continue
        text := fs.read_text(file) else err
            continue
        machine.external_scripts[u] = text
        for dep in vm.module_dep_urls(text, u)
            if not queue.contains(dep)
                queue.push(dep)

## Run the pending event loop, answering `import()` requests for files not
## read ahead, until the page has nothing more to ask.
fn pump_modules(mut machine vm.Vm)
    mut served := Set[str]()
    for _ in 0..1000
        machine.run_event_loop(1.0e300, 1000000)
        mut again := false
        asked := machine.host_requests
        for r in asked
            if r.kind != "fetch-module" or not served.add(r.url)
                continue
            again = true
            file := file_path_of(r.url)
            text := fs.read_text(file) else err
                machine.module_arrived(r.url, "", false)
                continue
            machine.module_arrived(r.url, text, true)
        if not again
            break

## Run the module file `file` and what it imports, as `node FILE.mjs` does:
## console output, then timers and promise jobs until the program is idle.
fn run_module_file(file str, max_steps int, echo bool) RunResult
    url := file_url(file)
    mut machine := vm.new_vm()
    machine.echo = echo
    machine.step_limit = max_steps
    machine.location_href = url
    preload_modules(mut machine, url)
    done := machine.mod_start(url, "", true)
    pump_modules(mut machine)
    RunResult(lines: machine.console_out, failed: vm.promise_failed(done), message: "")

## Run every `NAME.js` in `dir` and compare what it printed with `NAME.out`
## (written by Node; an uncaught error is the last line). True if all match.
fn test_runs(dir str) !bool
    mut passed := 0
    mut failures := 0
    for name in fs.list_dir(dir)?
        is_module := name.ends_with(".mjs")
        if not name.ends_with(".js") and not is_module
            continue
        file := path.join(dir, name)
        stem := name.slice(0, name.chars().len() - (if is_module then 4 else 3))
        out := if is_module then run_module_file(file, 10000000, false) else run_script(
            fs.read_text(file)?,
            10000000,
            false,
        )
        mut lines := out.lines
        if out.failed
            lines.push(out.message)
        actual := lines.join("\n").trim()
        expected := fs.read_text(path.join(dir, "{stem}.out"))?.trim()
        if actual == expected
            passed += 1
        else
            print("FAIL {file}")
            exp_lines := expected.lines()
            act_lines := actual.lines()
            for i in 0..exp_lines.len().max(act_lines.len())
                e := if i < exp_lines.len() then exp_lines[i] else "<none>"
                a := if i < act_lines.len() then act_lines[i] else "<none>"
                if e != a
                    print("  line {i + 1}\n    expected: {e}\n    actual:   {a}")
                    break
            failures += 1
    print("{passed} passed, {failures} failed")
    failures == 0

## The address test pages load at.
PAGE_URL := "https://example.test/dir/page.html"

## Load a page and run its scripts, then a second of virtual time: what the
## console printed, the body's HTML, and what the page asked the browser for.
fn run_page_at(html str, max_steps int, url str) List[str]
    run_page_with(html, max_steps, url, {})

## Answer the page's `import()` requests from `files` (a missing file fails
## to load, as a 404 does), letting the page run on after each answer.
fn serve_page_modules(mut machine vm.Vm, files Map[str, str])
    mut served := Set[str]()
    for _ in 0..100
        mut again := false
        asked := machine.host_requests
        for r in asked
            if r.kind != "fetch-module" or not served.add(r.url)
                continue
            again = true
            if text := files.get(r.url)
                machine.module_arrived(r.url, text, true)
            else
                machine.module_arrived(r.url, "", false)
        machine.run_event_loop(machine.clock_ms + 1000.0, 10000)
        if not again
            break

## `run_page_at` with the files beside the page (modules and scripts) by
## address.
fn run_page_with(html str, max_steps int, url str, files Map[str, str]) List[str]
    mut machine := vm.new_vm()
    machine.step_limit = max_steps
    machine.external_scripts = files
    machine.dom_setup()
    machine.parse_into(0, html)
    machine.load_page(if url == "" then PAGE_URL else url, 1000.0)
    serve_page_modules(mut machine, files)
    mut lines := machine.console_out
    bodies := machine.descendants_by_tag(0, "body")
    lines.push("== body")
    lines.push(if bodies.len() > 0 then machine.inner_html(bodies[0]) else "")
    for r in machine.host_requests
        body := if r.text == "" then "" else " {r.text}"
        if r.kind == "navigate"
            lines.push("== navigate {r.method} {r.url}{body}")
        elif url != ""
            lines.push("== {r.kind} {r.method} {r.url}{body}")
    if url != ""
        for k in machine.cookies.keys()
            lines.push("== cookie {k}={machine.cookies[k]}")
    lines

## The scripts and modules in `dir`, at the addresses a page there sees.
fn page_files(dir str) !Map[str, str]
    mut files := Map[str, str]()
    for name in fs.list_dir(dir)?
        if name.ends_with(".js") or name.ends_with(".mjs") or name.ends_with(".json")
            files["https://example.test/dir/{name}"] = fs.read_text(path.join(dir, name))?
    files

## Run every `NAME.html` in `dir` against `NAME.out` (written by Chromium).
fn test_pages(dir str) !bool
    mut passed := 0
    mut failures := 0
    for name in fs.list_dir(dir)?
        if not name.ends_with(".html")
            continue
        file := path.join(dir, name)
        stem := name.slice(0, name.chars().len() - 5)
        actual := run_page_with(fs.read_text(file)?, 10000000, "", page_files(dir)?)
            .join("\n")
            .trim()
        expected := fs.read_text(path.join(dir, "{stem}.out"))?.trim()
        if actual == expected
            passed += 1
        else
            print("FAIL {file}")
            exp_lines := expected.lines()
            act_lines := actual.lines()
            for i in 0..exp_lines.len().max(act_lines.len())
                e := if i < exp_lines.len() then exp_lines[i] else "<none>"
                a := if i < act_lines.len() then act_lines[i] else "<none>"
                if e != a
                    print("  line {i + 1}\n    expected: {e}\n    actual:   {a}")
                    break
            failures += 1
    print("{passed} passed, {failures} failed")
    failures == 0

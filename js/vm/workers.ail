"""

## JavaScript string literal text for `s`, without the quotes.
fn js_lit(s str) str
    s
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\u{2028}", "\\u2028")
        .replace("\u{2029}", "\\u2029")

## Defines `Worker` on the page's window (after `net_setup`).
pub fn Vm.worker_setup(mut self)
    run_script_text(CLONE_PRELUDE)
    run_script_text(CHANNEL_PRELUDE)
    run_script_text(WORKER_PRELUDE)

## Makes this engine a dedicated worker's: `net_setup` and `dom_setup` must
## have run. `name` is the `Worker` option, `url` the script's address.
pub fn Vm.worker_scope_setup(mut self, name str)
    run_script_text(CLONE_PRELUDE)
    run_script_text(CHANNEL_PRELUDE)
    run_script_text(SCOPE_PRELUDE)
    run_script_text("__workerBoot(\"{js_lit(name)}\")")

## A message the page posted (encoded by the page's clone code), run through
## the worker's `message` handlers.
pub fn Vm.worker_deliver(mut self, payload str)
    run_script_text("__workerDeliver(\"{js_lit(payload)}\")")

## An event for the page's `Worker` number `id`: "message" (`payload` the
## encoded data), "error" (`payload` the text) or "closed".
pub fn Vm.worker_event(mut self, id int, kind str, payload str)
    run_script_text("__workerEvent({id}, \"{kind}\", \"{js_lit(payload)}\")")

## A `fetch` that worker `id` made, made by the page for it: request `rid`
## with `packed` (content type, a newline, the body). The answer goes back
## as a "net" worker request.
pub fn Vm.worker_fetch(mut self, id int, rid int, method str, url str, packed str)
    at := packed.find("\n") else -1
    kind := if at < 0 then packed else packed.slice(0, at)
    body := if at < 0 then "" else packed.slice(at + 1, packed.chars().len())
    run_script_text("__workerFetch({id}, {rid}, \"{js_lit(method)}\", \"{js_lit(url)}\", \"{js_lit(kind)}\", \"{js_lit(body)}\")")

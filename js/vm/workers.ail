      var t = g.__imports ? g.__imports[u] : undefined;
      if (t === undefined) throw new DOMException("Failed to execute 'importScripts' on 'WorkerGlobalScope': The script at '" + u + "' failed to load.", "NetworkError");
      (0, eval)(t);
    }
  };
  var ports = {};
  g.onconnect = null;
  g.skipWaiting = function () { return Promise.resolve(); };
  g.clients = { claim: function () { return Promise.resolve(); }, matchAll: function () { return Promise.resolve([]); }, get: function () { return Promise.resolve(undefined); }, openWindow: function () { return Promise.reject(new TypeError("Failed to open a window.")); } };
  g.addEventListener = function (t, f) { if (typeof f !== "function") return; var a = listeners[t] = listeners[t] || []; if (a.indexOf(f) < 0) a.push(f); };
  g.removeEventListener = function (t, f) { var a = listeners[t]; if (a) { var i = a.indexOf(f); if (i >= 0) a.splice(i, 1); } };

## Web Workers (HTML §10.2), the page's side and the worker's side, written
## in JavaScript over one native hook, `__hostWorker(op, id, text)`, which
## turns into a "worker" host request. The browser (jsdom/workers.ail) runs
## each worker in its own engine on its own thread; the two sides only swap
## strings, so a message is encoded here (the structured clone, §2.7) and
## decoded by the engine that receives it.
##
## On the page: `new Worker(url, options)` gets the script (a blob: or data:
## address from memory, any other through `fetch`, same origin only), then
## asks the browser to start it ("start"); `postMessage` ("post") and
## `terminate` ("stop") follow. The browser answers through `__workerEvent`.
## In the worker: `postMessage` ("out") and `close` ("close"); the browser
## hands what the page posted to `__workerDeliver`, and what a `fetch` in the
## worker got to `net_deliver`. The worker's `fetch` goes through the page's.
##
## Not yet: module workers, `importScripts`, shared and service workers,
## transfer of buffers (they are copied), nested workers and `MessageChannel`.

## The structured clone: `__sc.encode(value)` is a JSON string, `__sc.decode`
## the value again. Cycles and shared references survive; functions, symbols
## and DOM nodes throw a DataCloneError.
CLONE_PRELUDE := r"""
(function (g) {
  var TYPED = { Int8Array: 1, Uint8Array: 1, Uint8ClampedArray: 1, Int16Array: 1, Uint16Array: 1, Int32Array: 1, Uint32Array: 1, Float32Array: 1, Float64Array: 1, BigInt64Array: 1, BigUint64Array: 1, DataView: 1 };
  function b64(buf) { var u = new Uint8Array(buf), s = ""; for (var i = 0; i < u.length; i++) s += String.fromCharCode(u[i]); return btoa(s); }
  function unb64(t) { var s = atob(t), u = new Uint8Array(s.length); for (var i = 0; i < s.length; i++) u[i] = s.charCodeAt(i); return u.buffer; }
  function cannot(v) { return new DOMException((typeof v === "function" ? String(v) : "#<Object>") + " could not be cloned.", "DataCloneError"); }
  function encode(value) {
    var nodes = [], seen = new Map();
    function ref(v) {
      switch (typeof v) {
        case "undefined": return { u: 1 };
        case "boolean": case "string": return v;
        case "number":
          if (v !== v) return { n: "NaN" };
          if (v === Infinity) return { n: "Inf" };
          if (v === -Infinity) return { n: "-Inf" };
          if (v === 0 && 1 / v < 0) return { n: "-0" };
          return v;
        case "bigint": return { b: String(v) };
        case "symbol": throw new DOMException("Symbol() could not be cloned.", "DataCloneError");
        case "function": throw cannot(v);
      }
      if (v === null) return null;
      return { o: node(v) };
    }
    function pairs(v, n) {
      var keys = Object.keys(v);
      for (var i = 0; i < keys.length; i++) n.p.push([keys[i], ref(v[keys[i]])]);
    }
    function node(v) {
      if (seen.has(v)) return seen.get(v);
      var i = nodes.length, n;
      seen.set(v, i);
      nodes.push(null);
      var tag = Object.prototype.toString.call(v);
      if (g.Node && v instanceof g.Node) throw cannot(v);
      if (Array.isArray(v)) { n = { k: "a", l: v.length, p: [] }; nodes[i] = n; pairs(v, n); }
      else if (v instanceof Date) { n = { k: "d", t: v.getTime() }; nodes[i] = n; }
      else if (v instanceof RegExp) { n = { k: "r", s: v.source, f: v.flags }; nodes[i] = n; }
      else if (v instanceof Map) { n = { k: "m", e: [] }; nodes[i] = n; v.forEach(function (val, key) { n.e.push([ref(key), ref(val)]); }); }
      else if (v instanceof Set) { n = { k: "s", e: [] }; nodes[i] = n; v.forEach(function (val) { n.e.push(ref(val)); }); }
      else if (v instanceof Error) { n = { k: "e", n: v.name, m: v.message, s: v.stack === undefined ? "" : String(v.stack) }; nodes[i] = n; }
      else if (v instanceof ArrayBuffer) { n = { k: "ab", d: b64(v) }; nodes[i] = n; }
      else if (ArrayBuffer.isView(v)) {
        var t = tag.slice(8, -1);
        n = { k: "ta", t: TYPED[t] ? t : "Uint8Array", b: 0, o: v.byteOffset, l: t === "DataView" ? v.byteLength : v.length };
        nodes[i] = n;
        n.b = node(v.buffer);
      }
      else if (g.Blob && v instanceof g.Blob) {
        n = { k: "bl", x: v._text, t: v.type };
        if (g.File && v instanceof g.File) { n.name = v.name; n.lm = v.lastModified; }
        nodes[i] = n;
      }
      else if (tag === "[object Promise]" || tag === "[object WeakMap]" || tag === "[object WeakSet]" || tag === "[object WeakRef]") throw cannot(v);
      else { n = { k: "o", p: [] }; nodes[i] = n; pairs(v, n); }
      return i;
    }
    var top = ref(value);
    return JSON.stringify({ r: top, n: nodes });
  }
  function decode(text) {
    var d = JSON.parse(text), made = [];
    function val(r) {
      if (r === null || typeof r !== "object") return r;
      if ("o" in r) return obj(r.o);
      if ("u" in r) return undefined;
      if ("b" in r) return BigInt(r.b);
      return r.n === "NaN" ? NaN : (r.n === "Inf" ? Infinity : (r.n === "-Inf" ? -Infinity : -0));
    }
    function fill(o, n) { for (var j = 0; j < n.p.length; j++) o[n.p[j][0]] = val(n.p[j][1]); }
    function obj(i) {
      if (made[i] !== undefined) return made[i];
      var n = d.n[i], o;
      switch (n.k) {
        case "a": o = new Array(n.l); made[i] = o; fill(o, n); break;
        case "o": o = {}; made[i] = o; fill(o, n); break;
        case "d": o = new Date(n.t); made[i] = o; break;
        case "r": o = new RegExp(n.s, n.f); made[i] = o; break;
        case "m": o = new Map(); made[i] = o; for (var a = 0; a < n.e.length; a++) o.set(val(n.e[a][0]), val(n.e[a][1])); break;
        case "s": o = new Set(); made[i] = o; for (var b = 0; b < n.e.length; b++) o.add(val(n.e[b])); break;
        case "e":
          var C = (typeof g[n.n] === "function" && /Error$/.test(n.n)) ? g[n.n] : Error;
          o = new C(n.m); made[i] = o;
          try { Object.defineProperty(o, "stack", { value: n.s, writable: true, configurable: true, enumerable: false }); } catch (e) {}
          break;
        case "ab": o = unb64(n.d); made[i] = o; break;
        case "ta": o = n.t === "DataView" ? new DataView(obj(n.b), n.o, n.l) : new g[n.t](obj(n.b), n.o, n.l); made[i] = o; break;
        case "bl": o = n.name !== undefined ? new g.File([n.x], n.name, { type: n.t, lastModified: n.lm }) : new g.Blob([n.x], { type: n.t }); made[i] = o; break;
      }
      return o;
    }
    return val(d.r);
  }

  g.onmessage = null; g.onmessageerror = null; g.onerror = null;
  g.postMessage = function (message, transfer) {
    if (arguments.length < 1) throw new TypeError("Failed to execute 'postMessage' on 'DedicatedWorkerGlobalScope': 1 argument required, but only 0 present.");
    var data = sc.encode(message);
    if (!closing) hook("out", 0, data);
  };
  g.close = function () { if (!closing) { closing = true; hook("close", 0, ""); } };
  g.importScripts = function () {
    if (arguments.length === 0) return;
    throw new DOMException("Failed to execute 'importScripts' on 'WorkerGlobalScope': importScripts is not supported yet.", "NetworkError");
  };
  g.addEventListener = function (t, f) { if (typeof f !== "function") return; var a = listeners[t] = listeners[t] || []; if (a.indexOf(f) < 0) a.push(f); };
  g.removeEventListener = function (t, f) { var a = listeners[t]; if (a) { var i = a.indexOf(f); if (i >= 0) a.splice(i, 1); } };
  function fire(type, ev) {
    var h = g["on" + type];
    if (typeof h === "function") h.call(g, ev);
    var list = (listeners[type] || []).slice();
    for (var i = 0; i < list.length; i++) list[i].call(g, ev);
  }
  g.dispatchEvent = function (ev) { fire(ev.type, ev); return true; };
  function WorkerGlobalScope() { throw new TypeError("Illegal constructor"); }
  function DedicatedWorkerGlobalScope() { throw new TypeError("Illegal constructor"); }
  DedicatedWorkerGlobalScope.prototype = Object.create(WorkerGlobalScope.prototype);
  g.WorkerGlobalScope = WorkerGlobalScope;
  g.DedicatedWorkerGlobalScope = DedicatedWorkerGlobalScope;
  Object.defineProperty(g, "__workerDeliver", { value: function (data) {
    if (closing) return;
    var ev = { type: "message", target: g, currentTarget: g, origin: "", lastEventId: "", source: null, ports: [], defaultPrevented: false,
      preventDefault: function () {}, stopPropagation: function () {}, stopImmediatePropagation: function () {} };
    try { ev.data = sc.decode(data); } catch (e) { ev.type = "messageerror"; ev.data = null; }
    fire(ev.type, ev);
  }, enumerable: false });
  Object.defineProperty(g, "__workerBoot", { value: function (name) {
    try { Object.defineProperty(g, "name", { value: name, writable: true, configurable: true, enumerable: true }); } catch (e) { try { g.name = name; } catch (e2) {} }
  }, enumerable: false });
})(this);
"""

## JavaScript string literal text for `s`, without the quotes.
fn js_lit(s str) str
    s
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\u{2028}", "\\u2028")
        .replace("\u{2029}", "\\u2029")

## Defines `Worker` on the page's window (after `net_setup`).
pub fn Vm.worker_setup(mut self)
    run_script_text(CLONE_PRELUDE)
    run_script_text(WORKER_PRELUDE)

## Makes this engine a dedicated worker's: `net_setup` and `dom_setup` must
## have run. `name` is the `Worker` option, `url` the script's address.
pub fn Vm.worker_scope_setup(mut self, name str)
    run_script_text(CLONE_PRELUDE)
    run_script_text(SCOPE_PRELUDE)
    run_script_text("__workerBoot(\"{js_lit(name)}\")")

## A message the page posted (encoded by the page's clone code), run through
## the worker's `message` handlers.
pub fn Vm.worker_deliver(mut self, payload str)
    run_script_text("__workerDeliver(\"{js_lit(payload)}\")")

## An event for the page's `Worker` number `id`: "message" (`payload` the
## encoded data), "error" (`payload` the text) or "closed".
pub fn Vm.worker_event(mut self, id int, kind str, payload str)
    run_script_text("__workerEvent({id}, \"{kind}\", \"{js_lit(payload)}\")")

## A `fetch` that worker `id` made, made by the page for it: request `rid`
## with `packed` (content type, a newline, the body). The answer goes back
## as a "net" worker request.
pub fn Vm.worker_fetch(mut self, id int, rid int, method str, url str, packed str)
    at := packed.find("\n") else -1
    kind := if at < 0 then packed else packed.slice(0, at)
    body := if at < 0 then "" else packed.slice(at + 1, packed.chars().len())
    run_script_text("__workerFetch({id}, {rid}, \"{js_lit(method)}\", \"{js_lit(url)}\", \"{js_lit(kind)}\", \"{js_lit(body)}\")")

  var hook = g.__hostWorker;
  try { delete g.__hostWorker; } catch (e) {}
  var sc = g.__sc;
  ["window", "top", "parent", "frames", "opener", "localStorage", "sessionStorage", "alert", "confirm", "prompt", "open", "focus", "blur",
   "getComputedStyle", "matchMedia", "scrollTo", "scrollBy", "scroll", "requestIdleCallback", "XMLHttpRequest", "Worker", "WebSocket"].forEach(function (k) {
    try { delete g[k]; } catch (e) {}
  });
  var listeners = {}, closing = false;

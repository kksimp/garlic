      self._started = true;
      for (var i = 0; i < self._q.length; i++) hook("post", self._id, self._q[i]);
      self._q = [];
    }
    function fail(msg) {
      setTimeout(function () { if (!self._dead) { self._dead = true; delete workers[self._id]; fire(self, "error", { message: msg, filename: abs, lineno: 0, colno: 0, error: null }); } }, 0);

## The page's `Worker`.
WORKER_PRELUDE := r"""
(function (g) {
  var hook = g.__hostWorker;
  try { delete g.__hostWorker; } catch (e) {}
  var sc = g.__sc;
  var workers = {}, seq = 0;
  function event(type, target, props) {
    var ev = { type: type, target: target, currentTarget: target, defaultPrevented: false, bubbles: false, cancelable: false, timeStamp: Date.now(),
      preventDefault: function () {}, stopPropagation: function () {}, stopImmediatePropagation: function () {} };
    for (var k in props) ev[k] = props[k];
    return ev;
  }
  function fire(w, type, props) {
    var ev = event(type, w, props);
    var h = w["on" + type];
    if (typeof h === "function") { try { h.call(w, ev); } catch (e) { console.error("Uncaught " + e); } }
    var list = (w._l[type] || []).slice();
    for (var i = 0; i < list.length; i++) { try { list[i].call(w, ev); } catch (e) { console.error("Uncaught " + e); } }
  }
  function dataUrlText(u) {
    var comma = u.indexOf(",");
    if (comma < 0) return null;
    var head = u.slice(5, comma), body = u.slice(comma + 1);
    if (/;base64$/i.test(head)) {

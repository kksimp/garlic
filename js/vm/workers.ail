"""

## The worker's global scope, run in a fresh engine after the clone code,
## `net_setup` and the DOM setup (whose page-only globals it hides).
## `__workerBoot(name, url)` runs once the scope is ready.
SCOPE_PRELUDE := r"""
(function (g) {
  var hook = g.__hostWorker;
  try { delete g.__hostWorker; } catch (e) {}
  var sc = g.__sc;
  ["window", "top", "parent", "frames", "opener", "localStorage", "sessionStorage", "alert", "confirm", "prompt", "open", "focus", "blur",

## A WebSocket event for socket `id`: "open" (`data` the protocol), "message"
## (`data`), "error" or "close" (`data` the reason, with `code`).
pub fn Vm.ws_event(mut self, id int, kind str, payload str, code int)
    lit := payload
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
    run_script_text("__wsEvent({id}, \"{kind}\", \"{lit}\", {code})")

## The browser's JSON answer to request `id`, given to the page's callback.
pub fn Vm.net_deliver(mut self, id int, json str)
    lit := json
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
    run_script_text("__netDeliver({id}, \"{lit}\")")

## Defines `fetch`, `Headers`, `Response` and `XMLHttpRequest` on the
## window, then the web APIs of webapi.ail and the media APIs of mediaapi.ail,
## which build on them.
pub fn Vm.net_setup(mut self)
    run_script_text(NET_PRELUDE)
    web_setup()
    media_setup()

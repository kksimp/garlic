## `fetch` and XMLHttpRequest, written in JavaScript over one native hook,
## `__hostFetch(method, url, "TYPE\nBODY")`, which returns the browser's JSON
## reply for that request or null (and asks the browser for it, which fetches
## it and runs the page again with the reply in `fetch_replies`). Replies are
## delivered from a timer, so callers see them asynchronously as in a browser.
## A request the browser could not make fails as a network error
## (TypeError "Failed to fetch"; XHR `onerror`).

NET_PRELUDE := r"""
(function (g) {
  var hook = g.__hostFetch;
  try { delete g.__hostFetch; } catch (e) {}
  function lower(s) { return String(s).toLowerCase(); }
  function Headers(init) {
    this._h = {};
    if (init instanceof Headers) { var self = this; init.forEach(function (v, k) { self.append(k, v); }); }
    else if (Array.isArray(init)) { for (var i = 0; i < init.length; i++) this.append(init[i][0], init[i][1]); }
    else if (init && typeof init === "object") { for (var k in init) this.append(k, init[k]); }
  }
  Headers.prototype.append = function (k, v) { k = lower(k); this._h[k] = k in this._h ? this._h[k] + ", " + v : String(v); };
  Headers.prototype.set = function (k, v) { this._h[lower(k)] = String(v); };
  Headers.prototype.get = function (k) { k = lower(k); return k in this._h ? this._h[k] : null; };
  Headers.prototype.has = function (k) { return lower(k) in this._h; };
  Headers.prototype["delete"] = function (k) { delete this._h[lower(k)]; };
  Headers.prototype.forEach = function (f, t) { var ks = Object.keys(this._h).sort(); for (var i = 0; i < ks.length; i++) f.call(t, this._h[ks[i]], ks[i], this); };
  Headers.prototype.keys = function () { return Object.keys(this._h).sort()[Symbol.iterator](); };
  Headers.prototype.values = function () { var h = this._h; return Object.keys(h).sort().map(function (k) { return h[k]; })[Symbol.iterator](); };
  Headers.prototype.entries = function () { var h = this._h; return Object.keys(h).sort().map(function (k) { return [k, h[k]]; })[Symbol.iterator](); };
  Headers.prototype[Symbol.iterator] = Headers.prototype.entries;

  function Response(body, init) {
    init = init || {};
    this._body = body == null ? "" : String(body);
    this.status = init.status === undefined ? 200 : init.status;
    this.statusText = init.statusText || "";
    this.ok = this.status >= 200 && this.status < 300;
    this.headers = new Headers(init.headers);
    this.url = init.url || "";
    this.redirected = !!init.redirected;
    this.type = "basic";
    this.bodyUsed = false;
  }
  Response.prototype.text = function () { var s = this._body; this.bodyUsed = true; return Promise.resolve(s); };
  Response.prototype.json = function () { var s = this._body; this.bodyUsed = true; try { return Promise.resolve(JSON.parse(s)); } catch (e) { return Promise.reject(e); } };
  Response.prototype.clone = function () { return new Response(this._body, { status: this.status, statusText: this.statusText, headers: this.headers, url: this.url }); };

  function ask(method, url, type, body) {
    var r = hook(method, url, type + "\n" + body);
    return r === null ? null : JSON.parse(r);
  }
  function bodyText(b) { return b == null ? "" : (typeof b === "string" ? b : String(b)); }

  g.fetch = function (input, init) {
    init = init || {};
    var url = typeof input === "string" ? input : (input && input.url) || String(input);
    var method = String(init.method || (input && input.method) || "GET").toUpperCase();
    var headers = new Headers(init.headers);
    var body = method === "GET" || method === "HEAD" ? "" : bodyText(init.body);
    var type = headers.get("content-type") || (init.body && typeof init.body === "object" && "append" in init.body && "toString" in init.body ? "application/x-www-form-urlencoded;charset=UTF-8" : (body ? "text/plain;charset=UTF-8" : ""));
    return new Promise(function (resolve, reject) {
      setTimeout(function () {
        var r = ask(method, url, type, body);
        if (r === null || r.error) { reject(new TypeError("Failed to fetch")); return; }
        resolve(new Response(r.body, { status: r.status, statusText: r.statusText, headers: r.headers, url: r.url, redirected: r.url !== url }));
      }, 0);
    });
  };
  g.Headers = Headers;
  g.Response = Response;

  function XHR() {
    this.readyState = 0; this.status = 0; this.statusText = ""; this.responseText = ""; this.response = "";
    this.responseURL = ""; this.responseType = ""; this.timeout = 0; this.withCredentials = false;
    this._l = {}; this._req = {}; this._rh = {}; this._h = null; this._aborted = false;
    this.onreadystatechange = null; this.onload = null; this.onerror = null; this.onloadend = null; this.onabort = null;
  }
  XHR.UNSENT = 0; XHR.OPENED = 1; XHR.HEADERS_RECEIVED = 2; XHR.LOADING = 3; XHR.DONE = 4;
  XHR.prototype.UNSENT = 0; XHR.prototype.OPENED = 1; XHR.prototype.HEADERS_RECEIVED = 2; XHR.prototype.LOADING = 3; XHR.prototype.DONE = 4;
  XHR.prototype.addEventListener = function (t, f) { (this._l[t] = this._l[t] || []).push(f); };
  XHR.prototype.removeEventListener = function (t, f) { var a = this._l[t] || []; var i = a.indexOf(f); if (i >= 0) a.splice(i, 1); };
  XHR.prototype._fire = function (t) {
    var ev = { type: t, target: this, currentTarget: this };
    var h = this["on" + t]; if (typeof h === "function") h.call(this, ev);
    var a = (this._l[t] || []).slice(); for (var i = 0; i < a.length; i++) a[i].call(this, ev);
  };
  XHR.prototype.open = function (method, url) { this._req = { method: String(method).toUpperCase(), url: String(url), headers: new Headers() }; this.readyState = 1; this._fire("readystatechange"); };
  XHR.prototype.setRequestHeader = function (k, v) { this._req.headers.append(k, v); };
  XHR.prototype.getResponseHeader = function (k) { return this._h ? this._h.get(k) : null; };
  XHR.prototype.getAllResponseHeaders = function () { var o = ""; if (this._h) this._h.forEach(function (v, k) { o += k + ": " + v + "\r\n"; }); return o; };
  XHR.prototype.overrideMimeType = function () {};
  XHR.prototype.abort = function () { this._aborted = true; this.readyState = 0; this._fire("abort"); };
  XHR.prototype.send = function (body) {
    var self = this, rq = this._req;
    var b = rq.method === "GET" || rq.method === "HEAD" ? "" : bodyText(body);
    var type = rq.headers.get("content-type") || (b ? "text/plain;charset=UTF-8" : "");
    setTimeout(function () {
      if (self._aborted) return;
      var r = ask(rq.method, rq.url, type, b);
      if (r === null || r.error) { self.readyState = 4; self._fire("readystatechange"); self._fire("error"); self._fire("loadend"); return; }
      self.status = r.status; self.statusText = r.statusText || ""; self.responseURL = r.url; self._h = new Headers(r.headers);
      self.readyState = 2; self._fire("readystatechange");
      self.readyState = 3; self._fire("readystatechange");
      self.responseText = r.body;
      if (self.responseType === "json") { try { self.response = JSON.parse(r.body); } catch (e) { self.response = null; } }
      else self.response = r.body;
      self.readyState = 4; self._fire("readystatechange");
      self._fire("load"); self._fire("loadend");
    }, 0);
  };
  g.XMLHttpRequest = XHR;
})(this);
"""

## Defines `fetch`, `Headers`, `Response` and `XMLHttpRequest` on the window.
pub fn Vm.net_setup(mut self)
    run_script_text(NET_PRELUDE)

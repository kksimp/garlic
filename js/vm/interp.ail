## The tree-walking interpreter: scopes (ECMA-262 §9.1), statements (§14),
## expressions (§13), functions (§10.2, §15.2) and classes (§15.7).
use syntax
use std.bigint

pub struct Vm
    pub global_obj ref JsObject
    pub global_env ref Env
    ## The built-in prototypes and constructors by name: "Object",
    ## "Array", "TypeError", ...
    pub protos Map[str, Value]
    pub ctors Map[str, Value]
    ## What `console.log` wrote, one entry per call, when `echo` is off.
    pub console_out List[str]
    pub echo bool
    ## Name errors' positions ("url:line:col" in `stack`), for diagnosis.
    pub trace bool
    ## The script or module running, and its latest statement (when `trace`).
    pub cur_url str
    pub cur_stmt syntax.Stmt
    pub step_count int
    ## 0 for no limit.
    pub step_limit int
    pub next_id int
    pub call_depth int
    ## Set when `?.` meets null or undefined, until its chain ends (§13.3.9).
    pub chain_shorted bool
    pub rand_state int
    ## Objects being printed, joined or turned into JSON, to catch cycles.
    pub busy Set[int]
    ## What Date.now() reads, in milliseconds since 1970: fixed, so runs repeat.
    pub clock_ms float
    ## The local time zone of `Date` and `Intl`: "UTC" or an IANA name (date.ail).
    pub zone str
    ## The page (dom.ail): its nodes by id, the log of changes scripts made,
    ## and whether changes are logged yet.
    pub dom List[DomNode]
    ## Border boxes of elements from the browser's last layout, by node:
    ## x, y, width, height in page pixels (dom.ail, `measure`).
    pub rects Map[int, List[float]]
    ## How far the page is scrolled, for viewport-relative rectangles.
    pub scroll_y float
    ## The browser window's page area in CSS pixels, set by `viewport`
    ## (dom.ail); `view_set` stays false for a headless run, which keeps
    ## 1280x800.
    pub view_w float
    pub view_h float
    pub view_dpr float
    pub page_h float
    pub view_set bool
    pub mutations List[Mutation]
    pub recording bool
    pub node_objs Map[int, Value]
    pub style_objs Map[int, Value]
    ## Form fields' current values ("on"/"off" for checkboxes).
    pub field_values Map[int, str]
    pub listeners List[Listener]
    pub observers List[Observer]
    ## The element with focus, -1 for none.
    pub active int
    ## While set, inserted nodes gather in `mo_held` for one record.
    pub mo_hold bool
    pub mo_held List[int]
    ## Template element id -> its content fragment.
    pub template_frags Map[int, int]
    pub timers List[Timer]
    pub timer_seq int
    pub timer_level int
    ## The element a selector's `:scope` means while one runs.
    pub scope_id int
    ## Set while an `error` event runs, so a failing handler can't recurse.
    pub in_error bool
    pub microtasks List[Value]
    ## The next microtask to run: the queue is consumed from here and
    ## compacted when a run ends, so a job is not a shift of the whole list.
    pub micro_head int
    ## Bumped by every tree change and `id` attribute change, for the
    ## `getElementById` index (`id_index`, valid while `id_gen` matches).
    pub dom_gen int
    pub id_index Map[str, int]
    pub id_gen int
    pub id_len int
    ## Parsed selectors by their text, for querySelector and friends.
    pub sel_cache Map[str, List[List[Compound]]]
    pub started_scripts Set[int]
    ## The classic script element running now, for `document.currentScript`;
    ## -1 in modules, callbacks and between scripts.
    pub cur_script int
    ## Custom elements (customelements.ail): the nodes whose upgrade is
    ## constructing them now, innermost last, and the nodes upgraded so far.
    pub ce_upgrading List[int]
    pub ce_upgraded Set[int]
    ## Requests for the browser: navigations, script fetches, dialogs.
    pub host_requests List[HostRequest]
    ## Sources of external scripts the browser already fetched, by URL.
    pub external_scripts Map[str, str]
    pub cookies Map[str, str]
    pub location_href str
    pub page_start_ms float
    pub ready_state str
    ## Set when a run limit stops the page's scripts.
    pub stopped bool
    ## Promises rejected with no handler yet.
    pub unhandled List[Value]
    ## Generators and async functions stopped part way (gen.ail), by id, and
    ## the compiled bodies they run.
    pub frames Map[int, Frame]
    pub codes List[Code]
    pub frame_seq int
    ## Generators running now, to catch one that resumes itself.
    pub running Set[int]
    ## Requests waiting for each async generator, by frame id.
    pub agen_queues Map[int, List[AgenRequest]]
    ## Module records and the loads in flight (modules.ail).
    pub modules ref ModState
    ## The 2D canvases' bitmaps (canvas2d.ail).
    pub cvs ref CanvasState

## How a statement ended (§6.2.4 Completion Records); a throw is the `Thrown` error.
pub enum Flow
    Normal
    Ret(value Value)
    ## "" for a `break` or `continue` without a label.
    Brk(label str)
    Cont(label str)

## A function to call and the `this` it gets.
struct Callee
    f Value
    this_val Value

MAX_DEPTH := 350

## The key prefix of private names (`#x`): no script can write a NUL then a
## `#` by accident, and keys with it are left out of every key list.
pub PRIVATE := "\u{0}#"

## Count a step, failing past the run limit.
pub fn Vm.tick(mut self) ! Thrown
    self.step_count += 1
    if self.step_limit > 0 and self.step_count > self.step_limit
        return Thrown(value: Undef, text: "step limit of {self.step_limit} reached", limit: true)

# ---------------------------------------------------------------- errors

## Where an error is made: "url:line:col" when tracing, else "<anonymous>".
pub fn Vm.at_text(self) str
    if self.trace
        p := stmt_pos(self.cur_stmt)
        if p.line > 0
            return "{self.cur_url}:{p.line}:{p.col}"
    "<anonymous>"

## A new error object of a built-in kind ("TypeError", ...).
pub fn Vm.make_error(mut self, kind str, msg str) Value
    o := object("Error", proto_of(kind))
    o.props["message"] = hidden(Str(msg))
    o.props["stack"] = hidden(Str("{kind}: {msg}\n    at {self.at_text()}"))
    Obj(o)

pub fn Vm.throw_error(mut self, kind str, msg str) Thrown
    Thrown(value: self.make_error(kind, msg), text: "{kind}: {msg}", limit: false)

pub fn Vm.type_error(mut self, msg str) Thrown
    self.throw_error("TypeError", msg)

pub fn Vm.range_error(mut self, msg str) Thrown
    self.throw_error("RangeError", msg)

pub fn Vm.reference_error(mut self, msg str) Thrown
    self.throw_error("ReferenceError", msg)

## A thrown value as `throw` makes it, with the text an uncaught throw shows.
pub fn Vm.thrown(self, v Value) Thrown
    Thrown(value: v, text: "", limit: false)

## What an uncaught throw shows: "Uncaught TypeError: x is not a function".
pub fn Vm.uncaught_text(self, err Thrown) str
    if err.limit
        return err.text
    "Uncaught {self.error_text(err.value)}{self.error_where(err.value)}"

## " (at url:line:col)" for an error made while tracing.
pub fn Vm.error_where(self, v Value) str
    if not self.trace
        return ""
    o := obj_of(v) else return ""
    if o.class != "Error"
        return ""
    stack := self.plain_string(o, "stack") else return ""
    parts := stack.split("\n    at ")
    if parts.len() < 2 or parts[1] == "<anonymous>"
        return ""
    " (at {parts[1]})"

## "TypeError: x is not a function" for an error, the value otherwise; reads
## data properties only, so it can't run code.
pub fn Vm.error_text(self, v Value) str
    match v
        Obj(o) =>
            if o.class == "Error"
                name := self.plain_string(o, "name") else "Error"
                msg := self.plain_string(o, "message") else ""
                if msg == ""
                    return name
                return "{name}: {msg}"
            inspect_nested(v)
        Undef | Null | Bool | Num | Str | Big | Sym => inspect_nested(v)

fn Vm.plain_string(self, start ref JsObject, key str) str?
    mut o := start
    while true
        if p := own(o, key)
            return match p.value
                Str(s) => s
                Undef | Null | Bool | Num | Big | Sym | Obj => none
        match o.proto
            Obj(next) => o = next
            Undef | Null | Bool | Num | Str | Big | Sym => return none
    none

# ----------------------------------------------------------- conversions

## ToPrimitive (§7.1.1); `hint` is "number", "string" or "default".
pub fn Vm.to_primitive(mut self, v Value, hint str) Value ! Thrown
    o := match v
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return v
    as_string := hint == "string" or (hint == "default" and o.class == "Date")
    order := if as_string then ["toString", "valueOf"] else ["valueOf", "toString"]
    for name in order
        method := get(v, name)?
        if is_callable(method)
            r := self.call(method, v, [])?
            if not is_obj(r)
                return r
    return self.type_error("Cannot convert object to primitive value")

## ToNumber (§7.1.4).
pub fn Vm.to_number(mut self, v Value) float ! Thrown
    match v
        Undef => nan()
        Null => 0.0
        Bool(b) => if b then 1.0 else 0.0
        Num(n) => n
        Str(s) => string_to_number(s)
        Big => self.type_error("Cannot convert a BigInt value to a number")
        Sym => self.type_error("Cannot convert a Symbol value to a number")
        Obj => self.to_number(self.to_primitive(v, "number")?)

## ToString (§7.1.17).
pub fn Vm.to_string(mut self, v Value) str ! Thrown
    match v
        Undef => "undefined"
        Null => "null"
        Bool(b) => if b then "true" else "false"
        Num(n) => syntax.number_to_string(n)
        Str(s) => s
        Big(b) => b.to_text()
        Sym => self.type_error("Cannot convert a Symbol value to a string")
        Obj => self.to_string(self.to_primitive(v, "string")?)

## ToPropertyKey (§7.1.19): a symbol is its own key.
pub fn Vm.to_key(mut self, v Value) str ! Thrown
    match v
        Str(s) => string_key(s)
        Sym(k) => k
        Num(n) => syntax.number_to_string(n)
        Undef | Null | Bool | Big => self.to_string(v)
        Obj => self.to_key(self.to_primitive(v, "string")?)

## ToObject (§7.1.18): a primitive's wrapper.
pub fn Vm.to_object(mut self, v Value) ref JsObject ! Thrown
    match v
        Obj(o) => o
        Undef | Null => return self.type_error("Cannot convert undefined or null to object")
        Bool => self.wrap("Boolean", v)
        Num => self.wrap("Number", v)
        Str => self.wrap("String", v)
        Big => self.wrap("BigInt", v)
        Sym => self.wrap("Symbol", v)

pub fn Vm.wrap(mut self, class str, v Value) ref JsObject
    o := object(class, proto_of(class))
    o.prim = v
    o

## IsLooselyEqual (§7.2.14): `==`.
pub fn Vm.loose_eq(mut self, a Value, b Value) bool ! Thrown
    if type_of(a) == type_of(b) and is_obj(a) == is_obj(b)
        return a == b
    if is_nullish(a) or is_nullish(b)
        return is_nullish(a) and is_nullish(b)
    if type_of(a) == "boolean"
        return self.loose_eq(Num(self.to_number(a)?), b)
    if type_of(b) == "boolean"
        return self.loose_eq(a, Num(self.to_number(b)?))
    if is_obj(a) and not is_obj(b)
        return self.loose_eq(self.to_primitive(a, "default")?, b)
    if is_obj(b) and not is_obj(a)
        return self.loose_eq(a, self.to_primitive(b, "default")?)
    if is_obj(a) or is_obj(b)
        return a == b
    if type_of(a) == "symbol" or type_of(b) == "symbol"
        return false
    self.to_number(a)? == self.to_number(b)?

## SameValueZero (§7.2.11): `===` except that NaN equals NaN.
pub fn same_value_zero(a Value, b Value) bool
    match a
        Num(x) =>
            match b
                Num(y) => x == y or (is_nan(x) and is_nan(y))
                Undef | Null | Bool | Str | Big | Sym | Obj => false
        Undef | Null | Bool | Str | Big | Sym | Obj => a == b

## IsLessThan (§7.2.13): none when either side is NaN.
pub fn Vm.less_than(mut self, a Value, b Value, left_first bool) bool? ! Thrown
    mut pa := Value.Undef
    mut pb := Value.Undef
    if left_first
        pa = self.to_primitive(a, "number")?
        pb = self.to_primitive(b, "number")?
    else
        pb = self.to_primitive(b, "number")?
        pa = self.to_primitive(a, "number")?
    if x := str_of(pa)
        if y := str_of(pb)
            return x < y
    nx := self.to_number(pa)?
    ny := self.to_number(pb)?
    if is_nan(nx) or is_nan(ny)
        return none
    nx < ny

# ---------------------------------------------------------------- scopes

## The nearest scope that declares `var`s (§9.1.1.4 VarScope).
fn var_scope(env ref Env) ref Env
    mut e := env
    while not e.is_function
        e = e.parent else return e
    e

## The nearest scope with a `this` (not an arrow function's or a block's).
fn this_scope(env ref Env) ref Env
    mut e := env
    while not e.has_this
        e = e.parent else return e
    e

## Declare a `var`: on the global object at the top level (§9.1.1.4.17).
pub fn Vm.declare_var(mut self, env ref Env, name str)
    scope := var_scope(env)
    if scope == self.global_env
        if self.global_obj.props.get(name) == none
            self.global_obj.props[name] = Prop(
                value: Undef,
                get: Undef,
                set: Undef,
                accessor: false,
                enumerable: true,
                writable: true,
                configurable: false,
            )
        return
    if scope.vars.get(name) == none
        scope.vars[name] = Binding(value: Undef, mutable: true, ready: true)

## Give `name` its value in `env` itself (`let`, `const`, parameters).
pub fn init_binding(env ref Env, name str, v Value, mutable bool)
    env.vars[name] = Binding(value: v, mutable: mutable, ready: true)

## The value of a name (§9.1.2.1 ResolveBinding, then GetValue).
pub fn Vm.lookup(mut self, name str, env ref Env) Value ! Thrown
    mut e := env
    while true
        if b := e.vars.get(name)
            if not b.ready
                return self.reference_error("Cannot access '{name}' before initialization")
            return b.value
        if name == "arguments" and e.has_this and e.is_function and e != self.global_env
            if is_obj(e.func)
                args := self.make_arguments(e.args)
                e.vars["arguments"] = Binding(value: args, mutable: true, ready: true)
                return args
        if o := obj_of(e.object)
            if has_property(o, name)
                return get_from(o, name, e.object)
        e = e.parent else break
    return self.reference_error("{name} is not defined")

## `typeof name`: "undefined" for a name that isn't declared (§13.5.3.1).
pub fn Vm.is_declared(self, name str, env ref Env) bool
    mut e := env
    while true
        if e.vars.get(name) != none
            return true
        if o := obj_of(e.object)
            if has_property(o, name)
                return true
        e = e.parent else return false
    false

## Assign to a name (§9.1.1.1.5 SetMutableBinding).
pub fn Vm.assign_name(mut self, name str, v Value, env ref Env) ! Thrown
    mut e := env
    while true
        if b := e.vars.get(name)
            if not b.ready
                return self.reference_error("Cannot access '{name}' before initialization")
            if not b.mutable
                return self.type_error("Assignment to constant variable.")
            e.vars[name] = Binding(value: v, mutable: true, ready: true)
            return
        if o := obj_of(e.object)
            if has_property(o, name) or e.parent == none
                if e.parent == none and not has_property(o, name) and env.strict
                    return self.reference_error("{name} is not defined")
                put_obj(o, name, v, e.object)?
                return
        e = e.parent else break
    put_obj(self.global_obj, name, v, Obj(global_obj))?

pub fn copy_env(e ref Env) ref Env
    ref Env(
        vars: e.vars,
        parent: e.parent,
        is_function: e.is_function,
        has_this: e.has_this,
        strict: e.strict,
        object: e.object,
        this_val: e.this_val,
        this_ready: e.this_ready,
        new_target: e.new_target,
        home: e.home,
        func: e.func,
        args: e.args,
    )

pub fn Vm.make_arguments(mut self, args List[Value]) Value
    o := object("Arguments", proto_of("Object"))
    o.elems = args
    Obj(o)

## The names a pattern binds (§8.2.1 BoundNames).
pub fn pattern_names(p syntax.Pat) List[str]
    mut out := List[str]()
    collect_names(p, mut out)
    out

fn collect_names(p syntax.Pat, mut out List[str])
    match p
        PatId(name, _) => out.push(name)
        PatTarget => return
        PatObj(props, rest, _) =>
            for prop in props
                collect_names(prop.value, mut out)
            if r := rest
                collect_names(r, mut out)
        PatArr(items, rest, _) =>
            for item in items
                if it := item
                    collect_names(it, mut out)
            if r := rest
                collect_names(r, mut out)
        PatDefault(target, _, _) => collect_names(target, mut out)

## Declare the `var`s of a function body or script (§10.2.11 step 27,
## §16.1.7), without entering nested functions. Sloppy-mode functions in
## blocks also get a `var` (Annex B.3.2).
pub fn Vm.hoist_vars(mut self, body List[syntax.Stmt], env ref Env, top bool)
    for s in body
        self.hoist_stmt(s, env, top)

fn Vm.hoist_stmt(mut self, s syntax.Stmt, env ref Env, top bool)
    match s
        Var(d) =>
            if d.kind == "var"
                for decl in d.decls
                    for name in pattern_names(decl.target)
                        self.declare_var(env, name)
        FuncDecl(f) =>
            if not top and not env.strict
                if name := f.name
                    self.declare_var(env, name)
        If(_, yes, no, _) =>
            self.hoist_stmt(yes, env, false)
            if n := no
                self.hoist_stmt(n, env, false)
        Block(b, _) => self.hoist_vars(b, env, false)
        For(init, _, _, b, _) =>
            self.hoist_stmt(b, env, false)
            if i := init
                match i
                    InitDecl(d) => self.hoist_stmt(syntax.Stmt.Var(d), env, false)
                    InitExpr => return
        ForIn(left, _, b, _, _, _) =>
            if d := left_decl(left)
                self.hoist_stmt(syntax.Stmt.Var(d), env, false)
            self.hoist_stmt(b, env, false)
        While(_, b, _) => self.hoist_stmt(b, env, false)
        DoWhile(b, _, _) => self.hoist_stmt(b, env, false)
        Try(block, _, handler, finalizer, _) =>
            self.hoist_vars(block, env, false)
            if h := handler
                self.hoist_vars(h, env, false)
            if f := finalizer
                self.hoist_vars(f, env, false)
        Switch(_, cases, _) =>
            for c in cases
                self.hoist_vars(c.body, env, false)
        Labeled(_, b, _) => self.hoist_stmt(b, env, top)
        With(_, b, _) => self.hoist_stmt(b, env, false)
        Exp | ClassDecl | Return | Empty | Break | Continue | Throw | Debugger | Module => return

## Declare a block's `let`, `const`, `class` and functions (§14.2.3
## BlockDeclarationInstantiation): bindings in the dead zone, functions made.
pub fn Vm.declare_block(mut self, body List[syntax.Stmt], env ref Env) ! Thrown
    for s in body
        self.declare_lexical(s, env)?

fn Vm.declare_lexical(mut self, s syntax.Stmt, env ref Env) ! Thrown
    match s
        Var(d) =>
            if d.kind != "var"
                for decl in d.decls
                    for name in pattern_names(decl.target)
                        env.vars[name] = Binding(
                            value: Undef,
                            mutable: d.kind != "const",
                            ready: false,
                        )
        ClassDecl(c) =>
            if name := c.name
                env.vars[name] = Binding(value: Undef, mutable: true, ready: false)
        FuncDecl(f) =>
            fv := self.make_function(f, env, Undef, "normal")
            name := f.name else ""
            if env == self.global_env
                put_obj(self.global_obj, name, fv, Obj(global_obj))?
            else
                init_binding(env, name, fv, true)
        Labeled(_, b, _) => self.declare_lexical(b, env)?
        Exp | Return | If | Block | Empty | For | ForIn | While | DoWhile | Break | Continue | Throw | Try | Switch | With | Debugger | Module => return

# ------------------------------------------------------------- statements

## Run a script (§16.1.6 ScriptEvaluation).
pub fn Vm.run_program(mut self, prog syntax.Program) Value ! Thrown
    self.global_env.strict = prog.strict
    self.hoist_vars(prog.body, self.global_env, true)
    self.declare_block(prog.body, self.global_env)?
    mut last := Value.Undef
    for s in prog.body
        f := self.exec(s, self.global_env)?
        if v := returned(f)
            last = v
    last

## Whether a block declares anything of its own (`let`, `const`, `class`,
## functions), so that it needs a scope.
fn needs_scope(body List[syntax.Stmt]) bool
    for st in body
        match st
            Var(d) =>
                if d.kind != "var"
                    return true
            FuncDecl | ClassDecl | Labeled => return true
            Exp | Return | If | Block | Empty | For | ForIn | While | DoWhile | Break | Continue | Throw | Try | Switch | With | Debugger | Module =>
                continue
    false

## The statements of a block, in `env` (made by the caller).
pub fn Vm.exec_block(mut self, body List[syntax.Stmt], env ref Env) Flow ! Thrown
    self.declare_block(body, env)?
    for s in body
        f := self.exec(s, env)?
        if f != Normal
            return f
    Normal

pub fn Vm.exec(mut self, s syntax.Stmt, env ref Env) Flow ! Thrown
    self.exec_in(s, env, none)

## What a loop does with its body's completion: "next", "break", or "out"
## (leave the loop with it) (§14.7.1.1 LoopContinues).
fn loop_action(f Flow, labels List[str]?) str
    match f
        Normal => "next"
        Cont(l) => if l == "" or has_label(labels, l) then "next" else "out"
        Brk(l) => if l == "" or has_label(labels, l) then "break" else "out"
        Ret => "out"

## Whether `l` is one of a loop's labels (none: an unlabelled statement).
fn has_label(labels List[str]?, l str) bool
    if ls := labels
        return ls.contains(l)
    false

## A statement with the labels in front of it (§14.13); none when it has
## none, so a plain statement allocates no list.
fn Vm.exec_in(mut self, s syntax.Stmt, env ref Env, labels List[str]?) Flow ! Thrown
    self.tick()?
    if self.trace
        # The statement itself (shared, not copied); `at_text` finds its
        # position only when an error is made.
        self.cur_stmt = s
    match s
        Exp(e, _) =>
            self.eval(e, env)?
            Normal
        Var(d) =>
            self.var_decl(d, env)?
            Normal
        FuncDecl(f) =>
            # Annex B.3.2.1: a sloppy block function is also copied to its `var`.
            if not env.is_function and not env.strict
                if name := f.name
                    v := self.lookup(name, env)?
                    scope := var_scope(env)
                    if scope == self.global_env
                        put_obj(self.global_obj, name, v, Obj(global_obj))?
                    else
                        init_binding(scope, name, v, true)
            Normal
        ClassDecl(c) =>
            v := self.make_class(c, env)?
            init_binding(env, c.name else "", v, true)
            Normal
        Return(value, _) =>
            if v := value
                return Ret(self.eval(v, env)?)
            Ret(Undef)
        If(test, yes, no, _) =>
            if truthy(self.eval(test, env)?)
                return self.exec(yes, env)
            if n := no
                return self.exec(n, env)
            Normal
        Block(body, _) =>
            if needs_scope(body)
                return self.exec_block(body, new_env(env, false))
            for st in body
                f := self.exec(st, env)?
                if f != Normal
                    return f
            Normal
        Empty => Normal
        Debugger | Module => Normal
        For(init, test, update, body, _) => self.for_loop(init, test, update, body, env, labels)
        ForIn(left, right, body, of, _, _) => self.for_in(left, right, body, of, env, labels)
        While(test, body, _) =>
            while truthy(self.eval(test, env)?)
                f := self.exec(body, env)?
                act := loop_action(f, labels)
                if act == "break"
                    break
                if act == "out"
                    return f
            Normal
        DoWhile(body, test, _) =>
            while true
                f := self.exec(body, env)?
                act := loop_action(f, labels)
                if act == "break"
                    break
                if act == "out"
                    return f
                if not truthy(self.eval(test, env)?)
                    break
            Normal
        Break(label, _) => Brk(label else "")
        Continue(label, _) => Cont(label else "")
        Throw(value, _) => return self.thrown(self.eval(value, env)?)
        Try(block, param, handler, finalizer, _) => self.try_statement(
            block,
            param,
            handler,
            finalizer,
            env,
        )
        Switch(disc, cases, _) => self.switch_statement(disc, cases, env)
        Labeled(label, body, _) =>
            mut inner := labels else List[str]()
            inner.push(label)
            f := self.exec_in(body, env, inner)?
            match f
                Brk(l) =>
                    if l == label
                        return Normal
                    f
                Normal | Ret | Cont => f
        With(object, body, _) =>
            o := self.to_object(self.eval(object, env)?)?
            w := new_env(env, false)
            w.object = Obj(o)
            self.exec(body, w)

## `var`, `let` and `const` declarations (§14.3.1.2, §14.3.2.1).
fn Vm.var_decl(mut self, d syntax.VarDecl, env ref Env) ! Thrown
    for decl in d.decls
        if init := decl.init
            v := self.eval_named(init, single_name(decl.target), env)?
            self.bind_pattern(decl.target, v, env, d.kind)?
        elif d.kind != "var"
            self.bind_pattern(decl.target, Undef, env, d.kind)?

fn single_name(p syntax.Pat) str
    match p
        PatId(name, _) => name
        PatTarget | PatObj | PatArr | PatDefault => ""

fn Vm.for_loop(
    mut self,
    init syntax.ForInit?,
    test syntax.Expr?,
    update syntax.Expr?,
    body syntax.Stmt,
    env ref Env,
    labels List[str]?,
) Flow ! Thrown
    loop_env := new_env(env, false)
    mut per_iteration := false
    if i := init
        match i
            InitDecl(d) =>
                if d.kind != "var"
                    self.declare_lexical(syntax.Stmt.Var(d), loop_env)?
                    per_iteration = d.kind == "let"
                self.var_decl(d, loop_env)?
            InitExpr(e) => self.eval(e, loop_env)?
    # §14.7.4.4 CreatePerIterationEnvironment: closures see each turn's `let`.
    mut iter_env := if per_iteration then copy_env(loop_env) else loop_env
    while true
        if t := test
            if not truthy(self.eval(t, iter_env)?)
                break
        f := self.exec(body, iter_env)?
        act := loop_action(f, labels)
        if act == "break"
            break
        if act == "out"
            return f
        if per_iteration
            iter_env = copy_env(iter_env)
        if u := update
            self.eval(u, iter_env)?
    Normal

## `for-in` and `for-of` (§14.7.5).
fn Vm.for_in(
    mut self,
    left syntax.ForLeft,
    right syntax.Expr,
    body syntax.Stmt,
    of bool,
    env ref Env,
    labels List[str]?,
) Flow ! Thrown
    mut head_env := env
    if d := left_decl(left)
        if d.kind != "var"
            head_env = new_env(env, false)
            self.declare_lexical(syntax.Stmt.Var(d), head_env)?
        elif decl_init(d) != none
            # Annex B.3.5: `for (var x = 1 in o)` assigns first.
            self.var_decl(d, env)?
    subject := self.eval(right, head_env)?
    mut items := List[Value]()
    if of
        if o := obj_of(subject)
            eager := is_array_like(o)
                or o.class == "Set"
                or o.class == "Map"
                or o.class == "Iterator" and o.props.get(ITERATOR) == none
            if not eager
                it := open_iterator(subject)?
                return self.for_of_lazy(left, it, body, env, labels)
        items = iterate(subject)?
    else
        match subject
            Undef | Null => return Normal
            Bool | Num | Str | Big | Sym | Obj =>
                for k in for_in_keys(self.to_object(subject)?)
                    items.push(Str(k))
    for item in items
        f := self.loop_turn(left, item, body, env)?
        act := loop_action(f, labels)
        if act == "break"
            break
        if act == "out"
            return f
    Normal

## One turn of a `for-in` or `for-of` body with `item` bound.
fn Vm.loop_turn(
    mut self,
    left syntax.ForLeft,
    item Value,
    body syntax.Stmt,
    env ref Env,
) Flow ! Thrown
    iter_env := new_env(env, false)
    match left
        LeftDecl(d) => self.bind_pattern(d.decls[0].target, item, iter_env, d.kind)?
        LeftPat(p) => self.bind_pattern(p, item, iter_env, "assign")?
    self.exec(body, iter_env)

## `for-of` over an iterator that is stepped as the loop goes, so it may be
## endless; leaving early closes it (§7.4.11 IteratorClose).
fn Vm.for_of_lazy(
    mut self,
    left syntax.ForLeft,
    it Value,
    body syntax.Stmt,
    env ref Env,
    labels List[str]?,
) Flow ! Thrown
    next := get(it, "next")?
    while true
        r := self.call(next, it, [])?
        if not is_obj(r)
            return self.type_error("Iterator result {describe(r)} is not an object")
        if truthy(get(r, "done")?)
            break
        item := get(r, "value")?
        f := self.loop_turn(left, item, body, env) else err
            if not err.limit
                self.close_iterator(it) else ignored
                    return err
            return err
        act := loop_action(f, labels)
        if act == "break"
            self.close_iterator(it)?
            break
        if act == "out"
            self.close_iterator(it)?
            return f
    Normal

## Call an iterator's `return`, if it has one.
pub fn Vm.close_iterator(mut self, it Value) ! Thrown
    m := get(it, "return")?
    if is_nullish(m)
        return
    r := self.call(m, it, [])?
    if not is_obj(r)
        return self.type_error("Iterator result {describe(r)} is not an object")

fn decl_init(d syntax.VarDecl) syntax.Expr?
    if d.decls.len() == 0
        return none
    d.decls[0].init

## `try` (§14.15.3): a run limit passes every `catch` and `finally`.
fn Vm.try_statement(
    mut self,
    block List[syntax.Stmt],
    param syntax.Pat?,
    handler List[syntax.Stmt]?,
    finalizer List[syntax.Stmt]?,
    env ref Env,
) Flow ! Thrown
    mut flow := Flow.Normal
    mut failed := none
    if f := self.exec_block(block, new_env(env, false))
        flow = f
    else err
        if err.limit or handler == none
            failed = err
        elif h := handler
            catch_env := new_env(env, false)
            if p := param
                for name in pattern_names(p)
                    catch_env.vars[name] = Binding(value: Undef, mutable: true, ready: true)
                self.bind_pattern(p, err.value, catch_env, "let")?
            if f2 := self.exec_block(h, new_env(catch_env, false))
                flow = f2
            else err2
                failed = err2
    if fin := finalizer
        if e := failed
            if e.limit
                return e
        f3 := self.exec_block(fin, new_env(env, false))?
        if f3 != Normal
            return f3
    if e := failed
        return e
    flow

## `switch` (§14.12.4): cases share one scope and fall through.
fn Vm.switch_statement(
    mut self,
    disc syntax.Expr,
    cases List[syntax.Case],
    env ref Env,
) Flow ! Thrown
    v := self.eval(disc, env)?
    block := new_env(env, false)
    for c in cases
        self.declare_block(c.body, block)?
    mut start := -1
    for i in 0..cases.len()
        if t := cases[i].test
            if self.eval(t, block)? == v
                start = i
                break
    if start < 0
        for i in 0..cases.len()
            if cases[i].test == none
                start = i
    if start < 0
        return Normal
    for i in start..cases.len()
        for s in cases[i].body
            f := self.exec(s, block)?
            if f == Brk("")
                return Normal
            if f != Normal
                return f
    Normal

# ------------------------------------------------------------- patterns

## Bind a pattern to a value (§8.6.2 BindingInitialization, §13.15.5
## DestructuringAssignmentEvaluation). `mode` is "var", "let", "const",
## "param" or "assign".
pub fn Vm.bind_pattern(mut self, p syntax.Pat, v Value, env ref Env, mode str) ! Thrown
    match p
        PatId(name, _) =>
            if mode == "let" or mode == "const" or mode == "param"
                init_binding(env, name, v, mode != "const")
            else
                self.assign_name(name, v, env)?
        PatTarget(e) => self.assign_to(e, v, env)?
        PatDefault(target, value, _) =>
            mut actual := v
            if v == Undef
                actual = self.eval_named(value, single_name(target), env)?
            self.bind_pattern(target, actual, env, mode)?
        PatArr(items, rest, _) =>
            if is_nullish(v)
                return self.type_error("{describe(v)} is not iterable")
            xs := iterate(v)?
            for i in 0..items.len()
                if item := items[i]
                    x := if i < xs.len() then xs[i] else Undef
                    self.bind_pattern(item, x, env, mode)?
            if r := rest
                tail := if items.len() < xs.len() then xs[items.len()..] else List[Value]()
                self.bind_pattern(r, array(tail), env, mode)?
        PatObj(props, rest, _) =>
            if is_nullish(v)
                return self.type_error("Cannot destructure '{describe(v)}' as it is {describe(v)}.")
            mut used := List[str]()
            for prop in props
                key := self.prop_key(prop.key, env)?
                used.push(key)
                self.bind_pattern(prop.value, get(v, key)?, env, mode)?
            if r := rest
                copy := plain()
                src := self.to_object(v)?
                for k in enum_keys(src)
                    if not used.contains(k)
                        copy.props[k] = data(get(v, k)?)
                self.bind_pattern(r, Obj(copy), env, mode)?

## Assign to an assignment target expression: a name or a property.
fn Vm.assign_to(mut self, target syntax.Expr, v Value, env ref Env) ! Thrown
    match target
        Ident(name, _) => self.assign_name(name, v, env)?
        Paren(inner, _) => self.assign_to(inner, v, env)?
        Member(object, prop, computed, _, _) =>
            base := self.member_base(object, env)?
            if computed and is_array_value(base)
                kv := self.eval(prop, env)?
                if not array_fast_set(base, kv, v)
                    put(base, self.to_key(kv)?, v)?
                return
            key := self.member_key(prop, computed, env)?
            put(base, key, v)?
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | Chain | PrivName | Yield | Await =>
            return self.syntax_error("Invalid left-hand side in assignment")

pub fn Vm.syntax_error(mut self, msg str) Thrown
    self.throw_error("SyntaxError", msg)

## A property name: `a`, `"a"`, `1`, `[expr]` or `#a`.
fn Vm.prop_key(mut self, k syntax.Key, env ref Env) str ! Thrown
    match k
        KeyName(name, _) => name
        KeyStr(value, _) => value
        KeyNum(value, _) => syntax.number_to_string(value)
        Computed(e, _) => self.to_key(self.eval(e, env)?)?
        KeyPriv(name, _) => "{PRIVATE}{name}"

# ----------------------------------------------------------- expressions

## An expression that names an anonymous function after its target
## (§8.4.5 NamedEvaluation): `var f = function () {}` makes `f.name` "f".
fn Vm.eval_named(mut self, e syntax.Expr, name str, env ref Env) Value ! Thrown
    v := self.eval(e, env)?
    if name != "" and is_anonymous_fn(e)
        set_fn_name(v, name)
    v

fn is_anonymous_fn(e syntax.Expr) bool
    match e
        Function(f) => f.name == none
        Arrow => true
        ClassExpr(c) => c.name == none
        Paren | Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Super | NewTarget | Import | Array | Object | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Member | Seq | Spread | Chain | PrivName | Yield | Await =>
            false

fn set_fn_name(v Value, name str)
    match v
        Obj(o) =>
            if p := o.props.get("name")
                if p.value == Str("")
                    o.props["name"] = Prop(
                        value: Str(name),
                        get: Undef,
                        set: Undef,
                        accessor: false,
                        enumerable: false,
                        writable: false,
                        configurable: true,
                    )
        Undef | Null | Bool | Num | Str | Big | Sym => return

pub fn Vm.eval(mut self, e syntax.Expr, env ref Env) Value ! Thrown
    match e
        Num(value, _) => Value.Num(value)
        Str(value, _) => Value.Str(value)
        Big(digits, _) =>
            b := bigint.parse(digits) else err
                return self.syntax_error("Invalid BigInt literal")
            Value.Big(b)
        Bool(value, _) => Value.Bool(value)
        Null => Value.Null
        Ident(name, _) =>
            if name == "undefined"
                return Undef
            self.lookup(name, env)
        This => self.this_value(env)
        Template(quasis, exprs, _) =>
            mut out := quasis[0].cooked else ""
            for i in 0..exprs.len()
                part := self.to_string(self.eval(exprs[i], env)?)?
                rest := quasis[i + 1].cooked else ""
                out = "{out}{part}{rest}"
            Value.Str(out)
        Tagged(tag, quasis, exprs, _) =>
            target := self.callee_of(tag, env)?
            if self.chain_shorted
                return Undef
            mut cooked := List[Value]()
            mut raws := List[Value]()
            for q in quasis
                cooked.push(if c := q.cooked then Value.Str(c) else Undef)
                raws.push(Value.Str(q.raw))
            strings := array(cooked)
            if so := obj_of(strings)
                so.props["raw"] = hidden(array(raws))
            mut args := [strings]
            for x in exprs
                args.push(self.eval(x, env)?)
            self.call_named(target.f, target.this_val, args, tag)
        Regex(pattern, flags, _) => self.make_regexp(pattern, flags)
        Array(items, _, _) =>
            mut out := List[Value]()
            for item in items
                if x := item
                    if operand := spread_of(x)
                        out.extend(iterate(self.eval(operand, env)?)?)
                    else
                        out.push(self.eval(x, env)?)
                else
                    out.push(Undef)
            array(out)
        Object(props, _) => self.object_literal(props, env)
        Function(f) =>
            if name := f.name
                # A named function expression sees its own name (§15.2.5).
                inner := new_env(env, false)
                fv := self.make_function(f, inner, Undef, "normal")
                init_binding(inner, name, fv, false)
                return fv
            self.make_function(f, env, Undef, "normal")
        Arrow(f) => self.make_function(f, env, Undef, "arrow")
        ClassExpr(c) => self.make_class(c, env)
        Unary(op, operand, _) => self.unary(op, operand, env)
        Update(op, prefix, operand, _) =>
            cur := self.eval(operand, env)?
            if is_big_val(cur)
                stepped := big_step(cur, op)
                self.assign_to(operand, stepped, env)?
                return if prefix then stepped else cur
            old := self.to_number(cur)?
            v := if op == "++" then old + 1.0 else old - 1.0
            self.assign_to(operand, Num(v), env)?
            Value.Num(if prefix then v else old)
        Binary(op, left, right, _) =>
            a := self.eval(left, env)?
            b := self.eval(right, env)?
            self.binary(op, a, b)
        Logical(op, left, right, _) =>
            a := self.eval(left, env)?
            if op == "&&"
                return if truthy(a) then self.eval(right, env)? else a
            if op == "||"
                return if truthy(a) then a else self.eval(right, env)?
            if is_nullish(a) then self.eval(right, env)? else a
        Assign(op, target, value, _) => self.assignment(op, target, value, env)
        Cond(test, yes, no, _) =>
            if truthy(self.eval(test, env)?)
                return self.eval(yes, env)
            self.eval(no, env)
        Call(callee, args, optional, _) =>
            if is_super(callee)
                return self.super_call(args, env)
            target := self.callee_of(callee, env)?
            if self.chain_shorted
                return Undef
            if optional and is_nullish(target.f)
                self.chain_shorted = true
                return Undef
            xs := self.eval_args(args, env)?
            if is_direct_eval(callee, target.f)
                return direct_eval(arg_at(xs, 0), env)
            self.call_named(target.f, target.this_val, xs, callee)
        New(callee, args, _) =>
            f := self.eval(callee, env)?
            xs := self.eval_args(args, env)?
            if not self.is_constructor(f)
                return self.type_error("{expr_text(callee)} is not a constructor")
            self.construct(f, xs, f)
        Member(object, prop, computed, optional, _) =>
            base := self.member_base(object, env)?
            if self.chain_shorted
                return Undef
            if optional and is_nullish(base)
                self.chain_shorted = true
                return Undef
            if computed and is_indexed_value(base) and not is_super(object)
                kv := self.eval(prop, env)?
                if fast := array_fast_get(base, kv)
                    return fast
                return get(base, self.to_key(kv)?)
            key := self.member_key(prop, computed, env)?
            if is_super(object)
                return self.get_super(key, env)
            get(base, key)
        Seq(items, _) =>
            mut last := Value.Undef
            for x in items
                last = self.eval(x, env)?
            last
        Chain(inner, _) =>
            v := self.eval(inner, env)?
            self.chain_shorted = false
            v
        Paren(inner, _) => self.eval(inner, env)
        NewTarget => this_scope(env).new_target
        Super => return self.syntax_error("'super' keyword unexpected here")
        Spread => return self.syntax_error("Unexpected token '...'")
        PrivName(name, _) => Value.Str("{PRIVATE}{name}")
        Yield | Await => return self.syntax_error("yield and await run only in compiled code")
        Import(arg, opts, _) => import_expr(arg, opts, env)

## The object a member expression reads from; `super.x` reads from the
## home object's prototype (§13.3.7.1).
fn Vm.member_base(mut self, object syntax.Expr, env ref Env) Value ! Thrown
    if is_super(object)
        return self.this_value(env)
    self.eval(object, env)

fn Vm.member_key(mut self, prop syntax.Expr, computed bool, env ref Env) str ! Thrown
    if computed
        return self.to_key(self.eval(prop, env)?)
    match prop
        Ident(name, _) => name
        PrivName(name, _) => "{PRIVATE}{name}"
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Member | Seq | Spread | Chain | Paren | Yield | Await =>
            self.to_key(self.eval(prop, env)?)

## Whether an expression is `super` (no text made, unlike `expr_kind`).
fn is_super(e syntax.Expr) bool
    match e
        Super => true
        Paren | Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Member | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | Chain | PrivName | Yield | Await =>
            false

## Whether `v` is an array or `arguments` object, whose index properties
## are the elements themselves (§10.4.2, §10.4.4).
fn is_array_value(v Value) bool
    match v
        Obj(o) => o.class == "Array" or o.class == "Arguments"
        Undef | Null | Bool | Num | Str | Big | Sym => false

## Whether `a[i]` on `v` may take `array_fast_get`: an array, `arguments`
## or ASCII text.
fn is_indexed_value(v Value) bool
    match v
        Obj(o) => o.class == "Array" or o.class == "Arguments"
        Str(s) => is_ascii_text(s)
        Undef | Null | Bool | Num | Big | Sym => false

## `a[i]` for an array `a` and a number `i` that is an index inside it: the
## element, without making the key "i" and parsing it back. On ASCII text,
## the character at `i` (one UTF-16 unit, §10.4.3.5).
fn array_fast_get(base Value, kv Value) Value?
    n := num_of(kv) else return none
    i := as_index(n) else return none
    match base
        Obj(o) =>
            if i < o.elems.len()
                return o.elems[i]
            none
        Str(s) =>
            if i < s.len() and is_ascii_text(s)
                return Value.Str(s.slice(i, i + 1))
            none
        Undef | Null | Bool | Num | Big | Sym => none

## `a[i] = v` for an index inside an unfrozen array: the element is an own
## writable data property, so no setter on the prototype chain can apply.
fn array_fast_set(base Value, kv Value, v Value) bool
    o := obj_of(base) else return false
    if o.frozen
        return false
    n := num_of(kv) else return false
    i := as_index(n) else return false
    if i >= o.elems.len()
        return false
    o.elems[i] = v
    true

## `super[key]` with the current `this` as the receiver.
fn Vm.get_super(mut self, key str, env ref Env) Value ! Thrown
    home := this_scope(env).home
    match home
        Obj(h) =>
            match h.proto
                Obj(p) => get_from(p, key, self.this_value(env)?)
                Undef | Null | Bool | Num | Str | Big | Sym => Undef
        Undef | Null | Bool | Num | Str | Big | Sym => return self.syntax_error("'super' keyword unexpected here")

## `this` (§9.4.4 ResolveThisBinding).
fn Vm.this_value(mut self, env ref Env) Value ! Thrown
    scope := this_scope(env)
    if not scope.this_ready
        return self.reference_error("Must call super constructor in derived class before accessing 'this' or returning from derived constructor")
    scope.this_val

## The function a call calls, and its `this`: `a.b()` calls with `a`.
fn Vm.callee_of(mut self, callee syntax.Expr, env ref Env) Callee ! Thrown
    match callee
        Member(object, prop, computed, optional, _) =>
            base := self.member_base(object, env)?
            if self.chain_shorted
                return Callee(f: Undef, this_val: Undef)
            if optional and is_nullish(base)
                self.chain_shorted = true
                return Callee(f: Undef, this_val: Undef)
            if computed and is_array_value(base) and not is_super(object)
                kv := self.eval(prop, env)?
                if fast := array_fast_get(base, kv)
                    return Callee(f: fast, this_val: base)
                return Callee(f: get(base, self.to_key(kv)?)?, this_val: base)
            key := self.member_key(prop, computed, env)?
            if is_super(object)
                return Callee(f: self.get_super(key, env)?, this_val: base)
            Callee(f: get(base, key)?, this_val: base)
        Paren(inner, _) =>
            if syntax.expr_kind(inner) == "Member"
                return self.callee_of(inner, env)
            Callee(f: self.eval(inner, env)?, this_val: Undef)
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | Chain | PrivName | Yield | Await =>
            Callee(f: self.eval(callee, env)?, this_val: Undef)

## Call, naming the callee in the error when it isn't a function.
fn Vm.call_named(
    mut self,
    f Value,
    this_val Value,
    args List[Value],
    callee syntax.Expr,
) Value ! Thrown
    if not is_callable(f)
        return self.type_error("{expr_text(callee)} is not a function")
    self.call(f, this_val, args)

## Arguments, with spreads expanded.
fn Vm.eval_args(mut self, args List[syntax.Expr], env ref Env) List[Value] ! Thrown
    mut out := List[Value]()
    for a in args
        if operand := spread_of(a)
            out.extend(iterate(self.eval(operand, env)?)?)
        else
            out.push(self.eval(a, env)?)
    out

## Source-like text of an expression for error messages, as V8 writes it.
pub fn expr_text(e syntax.Expr) str
    match e
        Ident(name, _) => name
        This => "this"
        Super => "super"
        Member(object, prop, computed, _, _) =>
            if computed
                return "{expr_text(object)}[...]"
            "{expr_text(object)}.{expr_text(prop)}"
        PrivName(name, _) => "#{name}"
        Paren(inner, _) => expr_text(inner)
        Call(callee, _, _, _) => "{expr_text(callee)}(...)"
        Chain(inner, _) => expr_text(inner)
        Str(value, _) => "\"{value}\""
        Num(value, _) => syntax.number_to_string(value)
        Big(value, _) => "{value}n"
        Object(props, _) => if props.len() == 0 then "\{}" else "(intermediate value)"
        Template | Tagged | Regex | Bool | Null | NewTarget | Import | Array | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | New | Seq | Spread | Yield | Await =>
            "(intermediate value)"

fn Vm.unary(mut self, op str, operand syntax.Expr, env ref Env) Value ! Thrown
    if op == "typeof"
        if name := ident_name(operand)
            if not self.is_declared(name, env)
                return Value.Str("undefined")
        return Value.Str(type_of(self.eval(operand, env)?))
    if op == "delete"
        return Value.Bool(self.delete_expr(operand, env)?)
    v := self.eval(operand, env)?
    if is_big_val(v) and (op == "-" or op == "~" or op == "+")
        return big_unary(op, v)
    match op
        "!" => Value.Bool(not truthy(v))
        "-" => Value.Num(-self.to_number(v)?)
        "+" => Value.Num(self.to_number(v)?)
        "~" => Value.Num(to_int32(self.to_number(v)?).bit_not().to_float())
        "void" => Undef
        _ => return self.syntax_error("Unknown operator {op}")

fn ident_name(e syntax.Expr) str?
    match e
        Ident(name, _) => name
        Paren(inner, _) => ident_name(inner)
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Member | Seq | Spread | Chain | PrivName | Yield | Await =>
            none

## `delete` (§13.5.1.2).
fn Vm.delete_expr(mut self, operand syntax.Expr, env ref Env) bool ! Thrown
    match operand
        Member(object, prop, computed, _, _) =>
            base := self.eval(object, env)?
            key := self.member_key(prop, computed, env)?
            o := self.to_object(base)?
            ok := if o.class == "Proxy" then proxy_delete(o, key)? else delete(o, key)
            if not ok and env.strict
                return self.type_error("Cannot delete property '{key}' of {describe(base)}")
            ok
        Paren(inner, _) => self.delete_expr(inner, env)
        Chain(inner, _) =>
            r := self.delete_expr(inner, env)?
            self.chain_shorted = false
            r
        Ident => false
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | PrivName | Yield | Await =>
            self.eval(operand, env)?
            true

## Binary operators (§13.6-§13.12).
pub fn Vm.binary(mut self, op str, a Value, b Value) Value ! Thrown
    # Two numbers need no conversions: the common case, done first.
    match a
        Num(x) =>
            match b
                Num(y) =>
                    match op
                        "+" => return Value.Num(x + y)
                        "-" => return Value.Num(x - y)
                        "*" => return Value.Num(x * y)
                        "<" => return Value.Bool(x < y)
                        ">" => return Value.Bool(x > y)
                        "<=" => return Value.Bool(x <= y)
                        ">=" => return Value.Bool(x >= y)
                        "===" | "==" => return Value.Bool(x == y)
                        "!==" | "!=" => return Value.Bool(x != y)
                        "%" =>
                            if x >= 0.0
                                and y > 0.0
                                and x < 9007199254740992.0
                                and y < 9007199254740992.0
                                and x.floor() == x
                                and y.floor() == y
                                return Value.Num((x.to_int() % y.to_int()).to_float())
                            return Value.Num(fmod(x, y))
                        _ => return self.binary_slow(op, a, b)
                Str(y) =>
                    if op == "+"
                        return Value.Str("{syntax.number_to_string(x)}{y}")
                    return self.binary_slow(op, a, b)
                Undef | Null | Bool | Big | Sym | Obj => return self.binary_slow(op, a, b)
        # Strings: concatenation and comparison need no ToPrimitive either.
        Str(x) =>
            match b
                Str(y) =>
                    match op
                        "+" => return Value.Str("{x}{y}")
                        "===" | "==" => return Value.Bool(x == y)
                        "!==" | "!=" => return Value.Bool(x != y)
                        "<" => return Value.Bool(x < y)
                        ">" => return Value.Bool(y < x)
                        "<=" => return Value.Bool(not (y < x))
                        ">=" => return Value.Bool(not (x < y))
                        _ => return self.binary_slow(op, a, b)
                Num(y) =>
                    if op == "+"
                        return Value.Str("{x}{syntax.number_to_string(y)}")
                    return self.binary_slow(op, a, b)
                Undef | Null | Bool | Big | Sym | Obj => return self.binary_slow(op, a, b)
        Undef | Null | Bool | Big | Sym | Obj => return self.binary_slow(op, a, b)

fn Vm.binary_slow(mut self, op str, a Value, b Value) Value ! Thrown
    if (is_big_val(a) or is_big_val(b)) and big_op(op)
        return big_binary(op, a, b)
    match op
        "+" =>
            pa := self.to_primitive(a, "default")?
            pb := self.to_primitive(b, "default")?
            if type_of(pa) == "string" or type_of(pb) == "string"
                return Value.Str("{self.to_string(pa)?}{self.to_string(pb)?}")
            Value.Num(self.to_number(pa)? + self.to_number(pb)?)
        "-" => Value.Num(self.to_number(a)? - self.to_number(b)?)
        "*" => Value.Num(self.to_number(a)? * self.to_number(b)?)
        "/" => Value.Num(self.to_number(a)? / self.to_number(b)?)
        "%" => Value.Num(fmod(self.to_number(a)?, self.to_number(b)?))
        "**" => Value.Num(pow(self.to_number(a)?, self.to_number(b)?))
        "==" => Value.Bool(self.loose_eq(a, b)?)
        "!=" => Value.Bool(not self.loose_eq(a, b)?)
        "===" => Value.Bool(a == b)
        "!==" => Value.Bool(a != b)
        "<" => Value.Bool(self.less_than(a, b, true)? else false)
        ">" => Value.Bool(self.less_than(b, a, false)? else false)
        "<=" =>
            r := self.less_than(b, a, false)?
            Value.Bool(r == false)
        ">=" =>
            r := self.less_than(a, b, true)?
            Value.Bool(r == false)
        "&" => Value.Num(to_int32(self.to_number(a)?).bit_and(to_int32(self.to_number(b)?)).to_float())
        "|" => Value.Num(to_int32(self.to_number(a)?).bit_or(to_int32(self.to_number(b)?)).to_float())
        "^" => Value.Num(to_int32(self.to_number(a)?).bit_xor(to_int32(self.to_number(b)?)).to_float())
        "<<" =>
            x := to_int32(self.to_number(a)?)
            k := to_uint32(self.to_number(b)?).bit_and(31)
            Value.Num(to_int32(x.shl(k).bit_and(0xFFFFFFFF).to_float()).to_float())
        ">>" =>
            x := to_int32(self.to_number(a)?)
            k := to_uint32(self.to_number(b)?).bit_and(31)
            Value.Num(x.shr(k).to_float())
        ">>>" =>
            x := to_uint32(self.to_number(a)?)
            k := to_uint32(self.to_number(b)?).bit_and(31)
            Value.Num(x.shr(k).to_float())
        "instanceof" => Value.Bool(self.instance_of(a, b)?)
        "in" =>
            match b
                Obj(o) =>
                    key := self.to_key(a)?
                    if o.class == "Proxy"
                        return Value.Bool(proxy_has(o, key)?)
                    Value.Bool(has_property(o, key))
                Undef | Null | Bool | Num | Str | Big | Sym =>
                    return self.type_error("Cannot use 'in' operator to search for '{self.to_string(a)?}' in {self.to_string(b)?}")
        _ => return self.syntax_error("Unknown operator {op}")

## InstanceofOperator (§13.10.2).
pub fn Vm.instance_of(mut self, v Value, target Value) bool ! Thrown
    if not is_obj(target)
        return self.type_error("Right-hand side of 'instanceof' is not an object")
    if not is_callable(target)
        return self.type_error("Right-hand side of 'instanceof' is not callable")
    t := match target
        Obj(o) => o
        Undef | Null | Bool | Num | Str | Big | Sym => return false
    if c := t.call
        if inner := bound_target(c)
            return self.instance_of(v, inner)
    o := match v
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return false
    proto := get(target, "prototype")?
    if not is_obj(proto)
        return self.type_error("Function has non-object prototype '{describe(proto)}' in instanceof check")
    mut p := o.proto
    while is_obj(p)
        if p == proto
            return true
        p = match p
            Obj(x) => x.proto
            Undef | Null | Bool | Num | Str | Big | Sym => Null
    false

## `=`, `+=`, `&&=` and the rest (§13.15.2).
fn Vm.assignment(mut self, op str, target syntax.Pat, value syntax.Expr, env ref Env) Value ! Thrown
    if it := index_target(target)
        if op == "="
            return self.assign_index(it.object, it.prop, value, env)
        return self.compound_index(op, it.object, it.prop, value, env)
    if op == "="
        # A property's object and key come before the value (§13.15.2).
        if r := self.member_target(target, env)?
            v := self.eval(value, env)?
            put(r.f, r.key, v)?
            return v
        v := self.eval_named(value, single_name(target), env)?
        self.bind_pattern(target, v, env, "assign")?
        return v
    # Compound: the target is a name or a property, read once.
    t := match target
        PatId(name, p) => syntax.Expr.Ident(name: name, pos: p)
        PatTarget(e) => e
        PatObj | PatArr | PatDefault => return self.syntax_error("Invalid left-hand side in assignment")
    mut base := Value.Undef
    mut key := ""
    is_member := syntax.expr_kind(t) == "Member"
    if r := self.member_ref(t, env)?
        base = r.f
        key = r.key
    old := if is_member then get(base, key)? else self.eval(t, env)?
    mut result := old
    if op == "&&=" or op == "||=" or op == "??="
        keep := match op
            "&&=" => not truthy(old)
            "||=" => truthy(old)
            _ => not is_nullish(old)
        if keep
            return old
        result = self.eval_named(value, single_name(target), env)?
    else
        result = self.binary(op.slice(0, op.len() - 1), old, self.eval(value, env)?)?
    if is_member
        put(base, key, result)?
    else
        self.assign_to(t, result, env)?
    result

## The object and key expressions of a computed member target `o[k]`
## (not `super[k]`), for the index fast paths of `assignment`.
struct IndexTarget
    object syntax.Expr
    prop syntax.Expr

fn index_target(target syntax.Pat) IndexTarget?
    match target
        PatTarget(t) =>
            match t
                Member(object, prop, computed, _, _) =>
                    if computed and not is_super(object)
                        return IndexTarget(object: object, prop: prop)
                    none
                Paren | Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | Chain | PrivName | Yield | Await =>
                    none
        PatId | PatObj | PatArr | PatDefault => none

## `o[k] = value` (§13.15.2): the object, the key, then the value. A number
## key needs no conversion that could run code, so on an array it is used
## as the index itself, with no key text made and parsed back.
fn Vm.assign_index(
    mut self,
    object syntax.Expr,
    prop syntax.Expr,
    value syntax.Expr,
    env ref Env,
) Value ! Thrown
    base := self.eval(object, env)?
    kv := self.eval(prop, env)?
    if is_array_value(base) and num_of(kv) != none
        x := self.eval(value, env)?
        if not array_fast_set(base, kv, x)
            self.put(base, self.to_key(kv)?, x)?
        return x
    key := self.to_key(kv)?
    v := self.eval(value, env)?
    self.put(base, key, v)?
    v

## `o[k] op= value`, as `assignment` does it for any member, with the
## element read and written directly when `o` is an array and `k` an index
## inside it.
fn Vm.compound_index(
    mut self,
    op str,
    object syntax.Expr,
    prop syntax.Expr,
    value syntax.Expr,
    env ref Env,
) Value ! Thrown
    base := self.eval(object, env)?
    kv := self.eval(prop, env)?
    mut direct := false
    mut key := ""
    mut old := Value.Undef
    if is_array_value(base)
        if hit := array_fast_get(base, kv)
            direct = true
            old = hit
    if not direct
        key = self.to_key(kv)?
        old = self.get(base, key)?
    mut result := old
    if op == "&&=" or op == "||=" or op == "??="
        keep := match op
            "&&=" => not truthy(old)
            "||=" => truthy(old)
            _ => not is_nullish(old)
        if keep
            return old
        result = self.eval(value, env)?
    else
        result = self.binary(op.slice(0, op.len() - 1), old, self.eval(value, env)?)?
    if direct
        if array_fast_set(base, kv, result)
            return result
        key = self.to_key(kv)?
    self.put(base, key, result)?
    result

## The object and key of an assignment to a property, or none.
fn Vm.member_target(mut self, target syntax.Pat, env ref Env) MemberRef? ! Thrown
    match target
        PatTarget(e) =>
            if syntax.expr_kind(e) == "Member"
                return self.member_ref(e, env)
            none
        PatId | PatObj | PatArr | PatDefault => none

## An object literal (§13.2.5.4).
fn Vm.object_literal(mut self, props List[syntax.Prop], env ref Env) Value ! Thrown
    o := plain()
    for p in props
        self.literal_prop(o, p, env)?
    Obj(o)

## Add one property of an object literal to `o`.
pub fn Vm.literal_prop(mut self, o ref JsObject, p syntax.Prop, env ref Env) ! Thrown
    match p
        Init(key, value, _, _) =>
            k := self.prop_key(key, env)?
            if k == "__proto__" and not is_computed(key)
                v := self.eval(value, env)?
                if is_obj(v) or v == Null
                    o.proto = v
                return
            v := self.eval_named(value, k, env)?
            define(o, k, data(v))?
        Method(key, kind, f, _) =>
            k := self.prop_key(key, env)?
            fv := self.make_function(f, env, Obj(o), "method")
            if kind == "get" or kind == "set"
                set_fn_name(fv, "{kind} {k}")
                mut acc := o.props.get(k) else Prop(
                    value: Undef,
                    get: Undef,
                    set: Undef,
                    accessor: true,
                    enumerable: true,
                    writable: true,
                    configurable: true,
                )
                if not acc.accessor
                    acc = Prop(
                        value: Undef,
                        get: Undef,
                        set: Undef,
                        accessor: true,
                        enumerable: true,
                        writable: true,
                        configurable: true,
                    )
                if kind == "get"
                    acc.get = fv
                else
                    acc.set = fv
                o.props[k] = acc
            else
                set_fn_name(fv, k)
                define(o, k, data(fv))?
        PropSpread(operand, _) =>
            v := self.eval(operand, env)?
            if not is_nullish(v)
                src := self.to_object(v)?
                for k in enum_keys(src)
                    define(o, k, data(get(v, k)?))?
        CoverInit(_, _, _) => return self.syntax_error("Invalid shorthand property initializer")

fn is_computed(k syntax.Key) bool
    match k
        Computed => true
        KeyName | KeyStr | KeyNum | KeyPriv => false

# ------------------------------------------------------------- functions

## A function object (§10.2.3 OrdinaryFunctionCreate). `kind` is "normal"
## (has a `prototype` and can be `new`ed), "arrow" or "method".
pub fn Vm.make_function(mut self, f syntax.Func, env ref Env, home Value, kind str) Value
    o := object("Function", proto_of("Function"))
    is_ctor := kind == "normal" and not f.is_gen and not f.is_async
    o.call = Closure(f: f, env: env, home: home, is_ctor: is_ctor, class_info: none)
    o.props["length"] = Prop(
        value: Num(param_count(f).to_float()),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )
    o.props["name"] = Prop(
        value: Str(f.name else ""),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )
    if is_ctor
        proto := plain()
        proto.props["constructor"] = hidden(Obj(o))
        o.props["prototype"] = Prop(
            value: Obj(proto),
            get: Undef,
            set: Undef,
            accessor: false,
            enumerable: false,
            writable: true,
            configurable: false,
        )
    elif f.is_gen
        # Each generator function has its own prototype for the generators
        # it makes (§27.3.4.3, §27.4.4.3), with no `constructor`.
        o.props["prototype"] = Prop(
            value: Obj(object(
                "Object",
                proto_of(if f.is_async then "AsyncGenerator" else "Generator"),
            )),
            get: Undef,
            set: Undef,
            accessor: false,
            enumerable: false,
            writable: true,
            configurable: false,
        )
    Obj(o)

## The number of parameters before the first default or rest (§15.1.5).
fn param_count(f syntax.Func) int
    mut n := 0
    for p in f.params
        if syntax.pat_kind(p) == "PatDefault"
            break
        n += 1
    n

pub fn Vm.is_constructor(self, v Value) bool
    match v
        Obj(o) =>
            if c := o.call
                return match c
                    Closure(_, _, _, is_ctor, _) => is_ctor
                    Native(name) => native_is_ctor(name)
                    Bound(target, _, _) => self.is_constructor(target)
            false
        Undef | Null | Bool | Num | Str | Big | Sym => false

## [[Call]] (§10.2.1).
pub fn Vm.call(mut self, f Value, this_val Value, args List[Value]) Value ! Thrown
    o := match f
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return self.type_error("{describe(f)} is not a function")
    c := o.call else return self.type_error("{describe(f)} is not a function")
    match c
        Native(name) => native(name, o, this_val, args, Undef)
        Bound(target, bound_this, bound_args) =>
            mut all := bound_args
            all.extend(args)
            self.call(target, bound_this, all)
        Closure(fun, scope, home, _, info) =>
            if info != none
                name := fun.name else "anonymous"
                return self.type_error("Class constructor {name} cannot be invoked without 'new'")
            env := self.function_env(o, fun, scope, home, this_val, Undef)
            if fun.is_gen or fun.is_async
                return start_resumable(o, fun, env, args)
            self.run_body(fun, env, args)

## A function's scope for one call (§10.2.1.1 PrepareForOrdinaryCall,
## §10.2.1.2 OrdinaryCallBindThis).
fn Vm.function_env(
    mut self,
    fobj ref JsObject,
    fun syntax.Func,
    scope ref Env,
    home Value,
    this_val Value,
    new_target Value,
) ref Env
    env := new_env(scope, true)
    env.strict = fun.strict
    env.func = Obj(fobj)
    if not fun.is_arrow
        env.has_this = true
        env.home = home
        env.new_target = new_target
        if fun.strict
            env.this_val = this_val
        else
            env.this_val = match this_val
                Undef | Null => Obj(global_obj)
                Bool | Num | Str | Big | Sym | Obj => this_val
    env

## Bind the parameters and run the body (§10.2.11 FunctionDeclarationInstantiation).
fn Vm.run_body(mut self, fun syntax.Func, env ref Env, args List[Value]) Value ! Thrown
    saved := self.call_depth
    if self.call_depth >= MAX_DEPTH
        return self.range_error("Maximum call stack size exceeded")
    self.call_depth += 1
    if v := self.run_params_and_body(fun, env, args)
        self.call_depth = saved
        return v
    else err
        self.call_depth = saved
        return err

fn Vm.run_params_and_body(mut self, fun syntax.Func, env ref Env, args List[Value]) Value ! Thrown
    env.args = args
    for i in 0..fun.params.len()
        v := if i < args.len() then args[i] else Undef
        self.bind_pattern(fun.params[i], v, env, "param")?
    if r := fun.rest
        tail := if fun.params.len() < args.len() then args[fun.params.len()..] else List[Value]()
        self.bind_pattern(r, array(tail), env, "param")?
    if body := fun.expr
        return self.eval(body, env)
    self.hoist_vars(fun.body, env, true)
    f := self.exec_block(fun.body, env)?
    match f
        Ret(v) => v
        Normal | Brk | Cont => Undef

## [[Construct]] (§10.2.2): `new f(...args)`.
pub fn Vm.construct(mut self, f Value, args List[Value], new_target Value) Value ! Thrown
    o := match f
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return self.type_error("{describe(f)} is not a constructor")
    c := o.call else return self.type_error("{describe(f)} is not a constructor")
    match c
        Native(name) => native(name, o, Undef, args, new_target)
        Bound(target, _, bound_args) =>
            mut all := bound_args
            all.extend(args)
            nt := if new_target == f then target else new_target
            self.construct(target, all, nt)
        Closure(fun, scope, home, is_ctor, info) =>
            if not is_ctor
                return self.type_error("{fun.name else "anonymous"} is not a constructor")
            derived := if i := info then i.derived else false
            mut this_obj := Value.Undef
            if not derived
                proto := get(new_target, "prototype")?
                obj := object("Object", if is_obj(proto) then proto else proto_of("Object"))
                this_obj = Value.Obj(obj)
                if i := info
                    self.init_fields(this_obj, i)?
            env := self.function_env(o, fun, scope, home, this_obj, new_target)
            env.this_ready = not derived
            mut result := Value.Undef
            if derived and info_implicit(info)
                result = self.super_construct(env, args)?
            else
                result = self.run_body(fun, env, args)?
            if is_obj(result)
                return result
            if derived and result != Value.Undef
                return self.type_error("Derived constructors may only return object or undefined")
            if not env.this_ready
                return self.reference_error("Must call super constructor in derived class before accessing 'this' or returning from derived constructor")
            env.this_val

fn info_implicit(info ClassInfo?) bool
    if i := info
        return i.implicit
    false

## `super(...args)` in a derived constructor (§13.3.7.1).
fn Vm.super_call(mut self, args List[syntax.Expr], env ref Env) Value ! Thrown
    xs := self.eval_args(args, env)?
    self.super_construct(this_scope(env), xs)

fn Vm.super_construct(mut self, fenv ref Env, args List[Value]) Value ! Thrown
    f := match fenv.func
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return self.syntax_error("'super' keyword unexpected here")
    parent := f.proto
    if not self.is_constructor(parent)
        return self.type_error("Super constructor {describe(parent)} of anonymous class is not a constructor")
    result := self.construct(parent, args, fenv.new_target)?
    if fenv.this_ready
        return self.reference_error("Super constructor may only be called once")
    fenv.this_val = result
    fenv.this_ready = true
    if c := f.call
        if i := class_info_of(c)
            self.init_fields(result, i)?
    result

## Run a class's instance field initialisers on a new object (§7.3.34).
fn Vm.init_fields(mut self, obj Value, info ClassInfo) ! Thrown
    o := match obj
        Obj(x) => x
        Undef | Null | Bool | Num | Str | Big | Sym => return
    env := new_env(info.scope, true)
    env.has_this = true
    env.this_val = obj
    env.home = info.home
    env.strict = true
    for i in 0..info.fields.len()
        m := info.fields[i]
        key := info.field_keys[i]
        mut v := Value.Undef
        if value := m.value
            v = self.eval_named(value, key, env)?
        define(o, key, if key.starts_with(PRIVATE) then hidden(v) else data(v))?

# --------------------------------------------------------------- classes

## A class (§15.7.14 ClassDefinitionEvaluation).
fn Vm.make_class(mut self, c syntax.Class, env ref Env) Value ! Thrown
    class_env := new_env(env, false)
    class_env.strict = true
    name := c.name else ""
    if name != ""
        class_env.vars[name] = Binding(value: Undef, mutable: false, ready: false)
    mut proto_parent := proto_of("Object")
    mut ctor_parent := proto_of("Function")
    derived := c.superclass != none
    if sup := c.superclass
        sv := self.eval(sup, class_env)?
        if sv == Null
            proto_parent = Null
        elif self.is_constructor(sv)
            ctor_parent = sv
            proto_parent = get(sv, "prototype")?
            if not is_obj(proto_parent) and proto_parent != Null
                return self.type_error("Class extends value does not have valid prototype property {describe(proto_parent)}")
        else
            return self.type_error("Class extends value {describe(sv)} is not a constructor or null")
    proto := object("Object", proto_parent)
    mut ctor_fn := syntax.Func(
        name: c.name,
        params: [],
        rest: none,
        body: [],
        expr: none,
        is_arrow: false,
        is_async: false,
        is_gen: false,
        strict: true,
        pos: c.pos,
        text: c.text,
    )
    mut implicit := true
    for m in c.members
        if m.kind == "constructor"
            if f := m.f
                ctor_fn = f
                ctor_fn.text = c.text
                ctor_fn.name = c.name
                implicit = false
    # Instance fields: their keys are computed now, their values per `new`.
    mut fields := List[syntax.ClassMember]()
    mut field_keys := List[str]()
    for m in c.members
        if m.kind == "field" and not m.is_static
            fields.push(m)
            field_keys.push(if k := m.key then self.prop_key(k, class_env)? else "")
    ctor := object("Function", ctor_parent)
    ctor.call = Closure(
        f: ctor_fn,
        env: class_env,
        home: Obj(proto),
        is_ctor: true,
        class_info: ClassInfo(
            fields: fields,
            field_keys: field_keys,
            derived: derived,
            implicit: implicit,
            home: Obj(proto),
            scope: class_env,
        ),
    )
    ctor.props["length"] = Prop(
        value: Num(param_count(ctor_fn).to_float()),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )
    ctor.props["name"] = Prop(
        value: Str(name),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )
    ctor.props["prototype"] = Prop(
        value: Obj(proto),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: false,
    )
    proto.props["constructor"] = hidden(Obj(ctor))
    for m in c.members
        if m.kind == "method" or m.kind == "get" or m.kind == "set"
            target := if m.is_static then ctor else proto
            key := if k := m.key then self.prop_key(k, class_env)? else ""
            f := m.f else continue
            fv := self.make_function(f, class_env, Obj(target), "method")
            if m.kind == "method"
                set_fn_name(fv, key)
                target.props[key] = hidden(fv)
            else
                set_fn_name(fv, "{m.kind} {key}")
                mut acc := target.props.get(key) else Prop(
                    value: Undef,
                    get: Undef,
                    set: Undef,
                    accessor: true,
                    enumerable: false,
                    writable: true,
                    configurable: true,
                )
                if not acc.accessor
                    acc = Prop(
                        value: Undef,
                        get: Undef,
                        set: Undef,
                        accessor: true,
                        enumerable: false,
                        writable: true,
                        configurable: true,
                    )
                if m.kind == "get"
                    acc.get = fv
                else
                    acc.set = fv
                target.props[key] = acc
    if name != ""
        init_binding(class_env, name, Obj(ctor), false)
    # Static fields and blocks run in order, with `this` the class.
    static_env := new_env(class_env, true)
    static_env.has_this = true
    static_env.this_val = Obj(ctor)
    static_env.home = Obj(ctor)
    static_env.strict = true
    for m in c.members
        if m.is_static and m.kind == "field"
            key := if k := m.key then self.prop_key(k, static_env)? else ""
            mut v := Value.Undef
            if value := m.value
                v = self.eval_named(value, key, static_env)?
            define(ctor, key, data(v))?
        elif m.kind == "static-block"
            if f := m.f
                block_env := new_env(static_env, true)
                self.hoist_vars(f.body, block_env, true)
                self.exec_block(f.body, block_env)?
    Obj(ctor)

## A regular expression literal: an object with `source` and `flags` until
## the regex engine arrives.
fn Vm.make_regexp(mut self, pattern str, flags str) Value
    o := object("RegExp", proto_of("RegExp"))
    o.props["source"] = hidden(Str(pattern))
    o.props["flags"] = hidden(Str(flags))
    o.props["global"] = hidden(Bool(flags.contains("g")))
    o.props["lastIndex"] = Prop(
        value: Num(0.0),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: true,
        configurable: false,
    )
    Obj(o)

# --------------------------------------------------------------- helpers

pub fn obj_of(v Value) ref JsObject?
    match v
        Obj(o) => o
        Undef | Null | Bool | Num | Str | Big | Sym => none

pub fn str_of(v Value) str?
    match v
        Str(x) => x
        Undef | Null | Bool | Num | Big | Sym | Obj => none

fn returned(f Flow) Value?
    match f
        Ret(v) => v
        Normal | Brk | Cont => none

fn left_decl(left syntax.ForLeft) syntax.VarDecl?
    match left
        LeftDecl(d) => d
        LeftPat => none

fn spread_of(e syntax.Expr) syntax.Expr?
    match e
        Spread(operand, _) => operand
        Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Member | Seq | Chain | PrivName | Paren | Yield | Await =>
            none

fn bound_target(c Callable) Value?
    match c
        Bound(target, _, _) => target
        Closure | Native => none

fn class_info_of(c Callable) ClassInfo?
    match c
        Closure(_, _, _, _, info) => info
        Native | Bound => none

## A property reference: the base value (in `f`) and the key.
struct MemberRef
    f Value
    key str

fn Vm.member_ref(mut self, t syntax.Expr, env ref Env) MemberRef? ! Thrown
    match t
        Member(object, prop, computed, _, _) =>
            base := self.member_base(object, env)?
            MemberRef(f: base, key: self.member_key(prop, computed, env)?)
        Paren | Num | Str | Big | Template | Tagged | Regex | Bool | Null | Ident | This | Super | NewTarget | Import | Array | Object | Function | Arrow | ClassExpr | Unary | Update | Binary | Logical | Assign | Cond | Call | New | Seq | Spread | Chain | PrivName | Yield | Await =>
            none

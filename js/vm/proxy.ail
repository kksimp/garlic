## Proxy (ECMA-262 §10.5) and Reflect (§28.1). A proxy forwards to its
## target unless the handler has the trap. Done: get, set, has,
## deleteProperty, apply, construct; own keys, descriptors and the
## prototype read through to the target without calling a trap.

## `new Proxy(target, handler)`.
fn Vm.proxy_new(mut self, args List[Value], new_target Value) Value ! Thrown
    if new_target == Value.Undef
        return type_error("Constructor Proxy requires 'new'")
    target := arg_at(args, 0)
    handler := arg_at(args, 1)
    if not is_obj(target) or not is_obj(handler)
        return type_error("Cannot create proxy with a non-object as target or handler")
    o := object("Proxy", Value.Null)
    o.prim = target
    o.props["{PRIVATE}handler"] = hidden(handler)
    if t := obj_of(target)
        if t.call != none
            o.call = Native("proxy")
    Value.Obj(o)

fn Vm.proxy_target(self, o ref JsObject) Value
    o.prim

fn Vm.proxy_trap(mut self, o ref JsObject, name str) Value ! Thrown
    handler := o.props["{PRIVATE}handler"].value
    trap := get(handler, name)?
    if is_nullish(trap)
        return Value.Undef
    if not is_callable(trap)
        return type_error("proxy trap '{name}' is not a function")
    trap

pub fn Vm.proxy_get(mut self, o ref JsObject, key str, receiver Value) Value ! Thrown
    trap := proxy_trap(o, "get")?
    target := proxy_target(o)
    if trap == Value.Undef
        return get_from(obj_of(target) else o, key, receiver)
    call(trap, o.props["{PRIVATE}handler"].value, [target, Value.Str(key), receiver])

pub fn Vm.proxy_set(mut self, o ref JsObject, key str, v Value, receiver Value) ! Thrown
    trap := proxy_trap(o, "set")?
    target := proxy_target(o)
    if trap == Value.Undef
        put_obj(obj_of(target) else o, key, v, receiver)?
        return
    call(trap, o.props["{PRIVATE}handler"].value, [target, Value.Str(key), v, receiver])?

pub fn Vm.proxy_has(mut self, o ref JsObject, key str) bool ! Thrown
    trap := proxy_trap(o, "has")?
    target := proxy_target(o)
    if trap == Value.Undef
        t := obj_of(target) else return false
        if t.class == "Proxy"
            return proxy_has(t, key)
        return has_property(t, key)
    truthy(call(trap, o.props["{PRIVATE}handler"].value, [target, Value.Str(key)])?)

pub fn Vm.proxy_delete(mut self, o ref JsObject, key str) bool ! Thrown
    trap := proxy_trap(o, "deleteProperty")?
    target := proxy_target(o)
    if trap == Value.Undef
        t := obj_of(target) else return false
        return delete(t, key)
    truthy(call(trap, o.props["{PRIVATE}handler"].value, [target, Value.Str(key)])?)

## The proxy being called or constructed (`native("proxy", f, ...)`).
fn Vm.proxy_call(
    mut self,
    o ref JsObject,
    this_val Value,
    args List[Value],
    new_target Value,
) Value ! Thrown
    target := proxy_target(o)
    handler := o.props["{PRIVATE}handler"].value
    list := array(args)
    if new_target == Value.Undef
        trap := proxy_trap(o, "apply")?
        if trap == Value.Undef
            return call(target, this_val, args)
        return call(trap, handler, [target, this_val, list])
    trap := proxy_trap(o, "construct")?
    if trap == Value.Undef
        return construct(target, args, if new_target == Value.Obj(o) then target else new_target)
    r := call(trap, handler, [target, list, new_target])?
    if not is_obj(r)
        return type_error("proxy [[Construct]] must return an object")
    r

fn Vm.reflect_setup(mut self)
    r := plain()
    global_obj.props["Reflect"] = hidden(Value.Obj(r))
    methods(
        r,
        "Reflect",
        "apply:3 construct:2 defineProperty:3 deleteProperty:2 get:2 set:3 has:2 ownKeys:1 getPrototypeOf:1 setPrototypeOf:2 getOwnPropertyDescriptor:2 isExtensible:1 preventExtensions:1",
    )
    r.props[well_known("toStringTag")] = Prop(
        value: Str("Reflect"),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )
    c := constructor("Proxy", 2)
    c.props["length"] = hidden(Num(2.0))

fn Vm.reflect_function(mut self, m str, args List[Value]) Value ! Thrown
    a0 := arg_at(args, 0)
    a1 := arg_at(args, 1)
    a2 := arg_at(args, 2)
    if m == "apply"
        return call(a0, a1, iterate(a2)?)
    if m == "construct"
        return construct(a0, iterate(a1)?, if args.len() > 2 then a2 else a0)
    o := obj_of(a0) else return type_error("Reflect.{m} called on non-object")
    match m
        "defineProperty" =>
            if r := object_function("defineProperty", args)
                r
                Value.Bool(true)
            else err
                Value.Bool(false)
        "deleteProperty" =>
            key := to_key(a1)?
            if o.class == "Proxy"
                return Value.Bool(proxy_delete(o, key)?)
            Value.Bool(delete(o, key))
        "get" => get_from(o, to_key(a1)?, if args.len() > 2 then a2 else a0)
        "set" =>
            put_obj(o, to_key(a1)?, a2, if args.len() > 3 then args[3] else a0)?
            Value.Bool(true)
        "has" =>
            key := to_key(a1)?
            if o.class == "Proxy"
                return Value.Bool(proxy_has(o, key)?)
            Value.Bool(has_property(o, key))
        "ownKeys" =>
            names := object_function("getOwnPropertyNames", [a0])?
            mut out := iterate(names)?
            for s in own_symbols(obj_of(proxy_unwrap(a0)) else o)
                out.push(Value.Str(s))
            array(out)
        "getPrototypeOf" => object_function("getPrototypeOf", [a0])?
        "setPrototypeOf" =>
            if r := object_function("setPrototypeOf", [a0, a1])
                r
                Value.Bool(true)
            else err
                Value.Bool(false)
        "getOwnPropertyDescriptor" => object_function("getOwnPropertyDescriptor", [a0, a1])?
        "isExtensible" => Value.Bool(o.extensible)
        _ =>
            o.extensible = false
            Value.Bool(true)

fn Vm.proxy_unwrap(self, v Value) Value
    mut cur := v
    while true
        o := obj_of(cur) else return cur
        if o.class != "Proxy"
            return cur
        cur = o.prim
    cur

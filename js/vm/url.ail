## `URL` and `URLSearchParams` (WHATWG URL §6, §6.2), for the common cases:
## a URL object keeps its address in `prim`; a URLSearchParams keeps its
## pairs in `elems` as name, value, name, value.

## A URL with an empty path written with "/", and a lower-case host.
pub fn normalize_url(href str) str
    scheme_end := href.find("://") else return href
    rest := href.slice(scheme_end + 3, href.chars().len())
    cut := first_of(rest, "/?#")
    host := rest.slice(0, cut).to_lower()
    tail := rest.slice(cut, rest.chars().len())
    path := if tail.starts_with("/") then tail else "/{tail}"
    "{href.slice(0, scheme_end).to_lower()}://{host}{path}"

pub fn Vm.url_setup(mut self)
    object_proto := proto_of("Object")
    url_proto := object("Object", object_proto)
    protos["URL"] = Obj(url_proto)
    for name in [
        "href",
        "protocol",
        "host",
        "hostname",
        "port",
        "pathname",
        "search",
        "hash",
        "origin",
        "searchParams",
    ]
        getter(url_proto, name, "dom.url.get.{name}")
    methods(url_proto, "dom.url", "toString:0 toJSON:0")
    params_proto := object("Object", object_proto)
    protos["URLSearchParams"] = Obj(params_proto)
    methods(
        params_proto,
        "dom.params",
        "get:1 getAll:1 set:2 append:2 has:1 delete:1 toString:0 forEach:1 keys:0 values:0 entries:0 sort:0",
    )
    getter(params_proto, "size", "dom.params.size")
    for name in ["URL", "URLSearchParams"]
        c := obj_of(native_fn("dom.{name}", name, 1)) else continue
        p := obj_of(proto_of(name)) else continue
        c.props["prototype"] = Prop(
            value: Obj(p),
            get: Undef,
            set: Undef,
            accessor: false,
            enumerable: false,
            writable: false,
            configurable: false,
        )
        p.props["constructor"] = hidden(Obj(c))
        global_obj.props[name] = hidden(Obj(c))

## `new URL(url, base)`.
fn Vm.make_url(mut self, args List[Value], new_target Value) Value ! Thrown
    if new_target == Undef
        return type_error("Failed to construct 'URL': Please use the 'new' operator, this DOM object constructor cannot be called as a function.")
    if args.len() == 0
        return type_error("Failed to construct 'URL': 1 argument required, but only 0 present.")
    u := to_string(args[0])?
    mut href := u.trim()
    if not href.contains("://")
        and not href.starts_with("data:")
        and not href.starts_with("about:")
        and not href.starts_with("mailto:")
        and not href.starts_with("javascript:")
        base := arg_at(args, 1)
        if base == Undef
            return type_error("Failed to construct 'URL': Invalid URL")
        b := to_string(base)?
        if not b.contains("://")
            return type_error("Failed to construct 'URL': Invalid base URL")
        href = resolve_against(normalize_url(b), href)
    o := object("URL", proto_of("URL"))
    o.prim = Str(normalize_url(href))
    Value.Obj(o)

fn Vm.url_method(mut self, m str, this_val Value) Value ! Thrown
    o := obj_of(this_val) else return type_error("Illegal invocation")
    href := str_of(o.prim) else return type_error("Illegal invocation")
    if p := m.strip_prefix("get.")
        if p == "searchParams"
            if q := o.props.get("{PRIVATE}params")
                return q.value
            sp := self.params_from(url_part(href, "search"))
            o.props["{PRIVATE}params"] = hidden(sp)
            return sp
        return Value.Str(url_part(href, p))
    Value.Str(href)

fn Vm.params_from(mut self, text str) Value
    o := object("URLSearchParams", proto_of("URLSearchParams"))
    q := if text.starts_with("?") then text.slice(1, text.chars().len()) else text
    for part in q.split("&")
        if part == ""
            continue
        eq := part.find("=") else part.chars().len()
        o.elems.push(Str(form_decode(part.slice(0, eq))))
        o.elems.push(Str(
            if eq < part.chars().len() then form_decode(part.slice(
                eq + 1,
                part.chars().len(),
            )) else "",
        ))
    Value.Obj(o)

## application/x-www-form-urlencoded parsing (URL §5.1): "+" is a space and
## bad percent escapes stay as they are.
pub fn form_decode(s str) str
    cs := s.chars()
    mut bytes_out := List[u8]()
    mut i := 0
    while i < cs.len()
        c := cs[i]
        if c == '+'
            bytes_out.push(32.to_u8())
            i += 1
            continue
        if c == '%' and i + 2 < cs.len()
            hi := cs[i + 1].to_digit(16) else -1
            lo := cs[i + 2].to_digit(16) else -1
            if hi >= 0 and lo >= 0
                bytes_out.push((hi * 16 + lo).to_u8())
                i += 3
                continue
        for b in "{c}".to_bytes()
            bytes_out.push(b)
        i += 1
    bytes.from_list(bytes_out).text()

## `new URLSearchParams(init)`: a query string, pairs, or a record.
fn Vm.make_params(mut self, args List[Value]) Value ! Thrown
    init := arg_at(args, 0)
    if init == Undef or init == Null
        return self.params_from("")
    io := obj_of(init) else return self.params_from(to_string(init)?)
    if io.class == "URLSearchParams"
        mut copy := self.params_from("")
        if c := obj_of(copy)
            c.elems = io.elems
        return copy
    out := self.params_from("")
    oo := obj_of(out) else return out
    if io.class == "Array"
        for pair in io.elems
            oo.elems.push(Str(to_string(get(pair, "0")?)?))
            oo.elems.push(Str(to_string(get(pair, "1")?)?))
        return out
    for k in own_keys(io)
        oo.elems.push(Str(k))
        oo.elems.push(Str(to_string(get(init, k)?)?))
    out

fn Vm.params_method(mut self, m str, this_val Value, args List[Value]) Value ! Thrown
    o := obj_of(this_val) else return type_error("Illegal invocation")
    if o.class != "URLSearchParams"
        return type_error("Illegal invocation")
    name := to_string(arg_at(args, 0))?
    n := o.elems.len() / 2
    match m
        "size" => Value.Num(n.to_float())
        "get" =>
            for i in 0..n
                if o.elems[2 * i] == Value.Str(name)
                    return o.elems[2 * i + 1]
            Null
        "getAll" => array([o.elems[2 * i + 1] for i in 0..n if o.elems[2 * i] == Value.Str(name)])
        "has" => Value.Bool([i for i in 0..n if o.elems[2 * i] == Value.Str(name)].len() > 0)
        "append" =>
            o.elems.push(Str(name))
            o.elems.push(Str(to_string(arg_at(args, 1))?))
            Undef
        "set" | "delete" =>
            mut kept := List[Value]()
            mut placed := false
            value := if m == "set" then to_string(arg_at(args, 1))? else ""
            for i in 0..n
                if o.elems[2 * i] == Value.Str(name)
                    if m == "set" and not placed
                        kept.push(Str(name))
                        kept.push(Str(value))
                        placed = true
                    continue
                kept.push(o.elems[2 * i])
                kept.push(o.elems[2 * i + 1])
            if m == "set" and not placed
                kept.push(Str(name))
                kept.push(Str(value))
            o.elems = kept
            Undef
        "sort" =>
            mut pairs := [i for i in 0..n]
            pairs.sort(by: |i| str_of(o.elems[2 * i]) else "")
            o.elems = [o.elems[2 * pairs[k / 2] + k % 2] for k in 0..2 * n]
            Undef
        "forEach" =>
            ## The callback may delete entries: the list is read live.
            mut i := 0
            while 2 * i + 1 < o.elems.len()
                call(arg_at(args, 0), arg_at(args, 1), [
                    o.elems[2 * i + 1],
                    o.elems[2 * i],
                    this_val,
                ])?
                i += 1
            Undef
        "keys" => array([o.elems[2 * i] for i in 0..n])
        "values" => array([o.elems[2 * i + 1] for i in 0..n])
        "entries" => array([array([o.elems[2 * i], o.elems[2 * i + 1]]) for i in 0..n])
        _ => Value.Str(params_text(o))

fn params_text(o ref JsObject) str
    n := o.elems.len() / 2
    [
        "{form_encode(str_of(o.elems[2 * i]) else "")}={form_encode(str_of(o.elems[2 * i + 1]) else "")}"
        for i in 0..n
    ].join("&")

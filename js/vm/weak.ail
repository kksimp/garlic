## WeakMap, WeakSet, WeakRef and FinalizationRegistry (ECMA-262 §24.3,
## §24.4, §26.1, §26.2). Objects here are never collected while a script
## can run, so a weak collection is a Map or Set that only takes objects,
## a `WeakRef` always derefs, and a registry never calls back.

fn Vm.weak_setup(mut self)
    weak_map := constructor("WeakMap", 0)
    methods(
        obj_of(proto_of("WeakMap")) else weak_map,
        "WeakMap.prototype",
        "get:1 set:2 has:1 delete:1",
    )
    weak_set := constructor("WeakSet", 0)
    methods(obj_of(proto_of("WeakSet")) else weak_set, "WeakSet.prototype", "add:1 has:1 delete:1")
    constructor("WeakRef", 1)
    methods(obj_of(proto_of("WeakRef")) else weak_map, "WeakRef.prototype", "deref:0")
    constructor("FinalizationRegistry", 1)
    methods(
        obj_of(proto_of("FinalizationRegistry")) else weak_map,
        "FinalizationRegistry.prototype",
        "register:2 unregister:1",
    )
    for name in ["WeakMap", "WeakSet", "WeakRef", "FinalizationRegistry"]
        self.weak_tag(name)
    # Garlic draws no scroll or resize a page can see, so these observers
    # report each target once, a frame after `observe` (observer_method).
    for name in ["IntersectionObserver", "ResizeObserver"]
        constructor(name, 1)
        methods(
            obj_of(proto_of(name)) else weak_map,
            "{name}.prototype",
            if name
                == "ResizeObserver" then "observe:1 unobserve:1 disconnect:0" else "observe:1 unobserve:1 disconnect:0 takeRecords:0",
        )
        self.weak_tag(name)
    # Garlic records no performance entries: an observer takes its callback
    # and sees nothing, and it supports no entry types.
    constructor("PerformanceObserver", 1)
    methods(
        obj_of(proto_of("PerformanceObserver")) else weak_map,
        "PerformanceObserver.prototype",
        "observe:1 disconnect:0 takeRecords:0",
    )
    self.weak_tag("PerformanceObserver")
    if c := obj_of((global_obj.props.get("PerformanceObserver") else hidden(Undef)).value)
        c.props["supportedEntryTypes"] = data(array([]))

fn Vm.weak_tag(mut self, name str)
    p := obj_of(proto_of(name)) else return
    p.props[well_known("toStringTag")] = Prop(
        value: Str(name),
        get: Undef,
        set: Undef,
        accessor: false,
        enumerable: false,
        writable: false,
        configurable: true,
    )

## `new WeakMap(iterable)` and friends.
fn Vm.weak_new(mut self, name str, args List[Value], new_target Value) Value ! Thrown
    if new_target == Value.Undef
        return type_error("Constructor {name} requires 'new'")
    proto := get(new_target, "prototype")?
    o := object(name, if is_obj(proto) then proto else proto_of(name))
    a0 := arg_at(args, 0)
    match name
        "WeakMap" | "WeakSet" =>
            if not is_nullish(a0)
                for item in iterate(a0)?
                    if name == "WeakMap"
                        if not is_obj(item)
                            return type_error("Iterator value {describe(item)} is not an entry object")
                        k := get(item, "0")?
                        if not is_obj(k)
                            return type_error("Invalid value used as weak map key")
                        map_set(o, k, get(item, "1")?)
                    else
                        if not is_obj(item)
                            return type_error("Invalid value used in weak set")
                        set_add(o, item)
        "WeakRef" =>
            if not is_obj(a0)
                return type_error("WeakRef: invalid target")
            o.prim = a0
        _ =>
            if not is_callable(a0)
                return type_error("FinalizationRegistry: cleanup must be callable")
    Value.Obj(o)

fn Vm.observer_stub_new(mut self, name str, args List[Value], new_target Value) Value ! Thrown
    if new_target == Value.Undef
        return type_error("Constructor {name} requires 'new'")
    if not is_callable(arg_at(args, 0))
        return type_error("Failed to construct '{name}': The callback provided as parameter 1 is not a function.")
    proto := get(new_target, "prototype")?
    o := object(name, if is_obj(proto) then proto else proto_of(name))
    o.props["{PRIVATE}cb"] = hidden(arg_at(args, 0))
    Value.Obj(o)

## IntersectionObserver and ResizeObserver methods. Each reports every
## target once (Intersection Observer §3.2.8 "initial notification",
## Resize Observer §3.4.3): a frame (16 ms) after `observe`, the targets
## not yet reported reach the callback, intersecting and at their laid-out
## boxes, so lazy pictures load. Nothing changes after that, since Garlic
## has no scrolling or resizing a page can see. The targets waiting for
## their report are the observer's `elems`.
fn Vm.observer_method(mut self, name str, m str, this_val Value, args List[Value]) Value ! Thrown
    if m == "deliver"
        return self.observer_deliver(name, arg_at(args, 0))
    o := this_class(this_val, name, m)?
    a0 := arg_at(args, 0)
    match m
        "observe" =>
            if node_id(a0) == none
                return type_error("Failed to execute 'observe' on '{name}': parameter 1 is not of type 'Element'.")
            if not o.elems.contains(a0)
                o.elems.push(a0)
            if not o.props.contains("{PRIVATE}due")
                o.props["{PRIVATE}due"] = hidden(Value.Bool(true))
                timer_seq += 1
                timers.push(Timer(
                    id: timer_seq,
                    # Resize observations broadcast in the frame; the
                    # intersection report is a task queued after it.
                    due: clock_ms + (if name == "ResizeObserver" then 16.0 else 17.0),
                    seq: timer_seq,
                    callback: native_fn("{name}.prototype.deliver", "deliver", 1),
                    args: [this_val],
                    every: 0.0,
                    level: timer_level + 1,
                ))
            Undef
        "unobserve" =>
            o.elems = [t for t in o.elems if t != a0]
            Undef
        "disconnect" =>
            o.elems = []
            Undef
        _ => array([])

## Report the waiting targets of observer `ov` to its callback.
fn Vm.observer_deliver(mut self, name str, ov Value) Value ! Thrown
    o := obj_of(ov) else return Undef
    o.props.remove("{PRIVATE}due")
    targets := o.elems
    o.elems = []
    if targets.len() == 0
        return Undef
    cb := o.props.get("{PRIVATE}cb") else return Undef
    mut entries := List[Value]()
    for t in targets
        id := node_id(t) else continue
        e := plain()
        r := self.rect_value(id)
        if name == "ResizeObserver"
            box := self.rect_of(id)
            size := plain()
            size.props["inlineSize"] = data(Value.Num(box[2]))
            size.props["blockSize"] = data(Value.Num(box[3]))
            sizes := array([Value.Obj(size)])
            e.props["target"] = data(t)
            e.props["contentRect"] = data(r)
            e.props["borderBoxSize"] = data(sizes)
            e.props["contentBoxSize"] = data(sizes)
            e.props["devicePixelContentBoxSize"] = data(sizes)
        else
            e.props["time"] = data(Value.Num(clock_ms - page_start_ms))
            e.props["rootBounds"] = data(Null)
            e.props["boundingClientRect"] = data(r)
            e.props["intersectionRect"] = data(r)
            e.props["isIntersecting"] = data(Value.Bool(true))
            e.props["intersectionRatio"] = data(Value.Num(1.0))
            e.props["target"] = data(t)
        entries.push(Value.Obj(e))
    call(cb.value, ov, [array(entries), ov])?
    Undef

fn Vm.weak_method(mut self, name str, m str, this_val Value, args List[Value]) Value ! Thrown
    o := this_class(this_val, name, m)?
    a0 := arg_at(args, 0)
    match name
        "WeakMap" =>
            if m == "set" and not is_obj(a0)
                return type_error("Invalid value used as weak map key")
            match m
                "get" =>
                    i := map_index(o, a0) else return Value.Undef
                    o.elems[i + 1]
                "set" =>
                    map_set(o, a0, arg_at(args, 1))
                    this_val
                "has" => Value.Bool(map_index(o, a0) != none)
                _ =>
                    i := map_index(o, a0) else return Value.Bool(false)
                    o.elems.remove_at(i)
                    o.elems.remove_at(i)
                    Value.Bool(true)
        "WeakSet" =>
            match m
                "add" =>
                    if not is_obj(a0)
                        return type_error("Invalid value used in weak set")
                    set_add(o, a0)
                    this_val
                "has" =>
                    for x in o.elems
                        if same_value_zero(x, a0)
                            return Value.Bool(true)
                    Value.Bool(false)
                _ =>
                    for i in 0..o.elems.len()
                        if same_value_zero(o.elems[i], a0)
                            o.elems.remove_at(i)
                            return Value.Bool(true)
                    Value.Bool(false)
        "WeakRef" => o.prim
        _ => if m == "unregister" then Value.Bool(false) else Value.Undef

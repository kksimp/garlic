## `Intl` (ECMA-402) for the en-US locale, which is the only one the
## browser reports: DateTimeFormat, NumberFormat, Collator, PluralRules,
## RelativeTimeFormat, ListFormat and DisplayNames, each with
## `resolvedOptions` and `supportedLocalesOf`, plus `getCanonicalLocales`
## and `supportedValuesOf`. Times format in the browser's zone (`Vm.zone`,
## date.ail) or the `timeZone` option, an IANA name whose offsets come from
## std.tz. Date.prototype.toLocale*String format through the same code
## (§21.4.4.38-41).
use std.tz

LOCALE := "en-US"

INTL_KINDS := [
    "DateTimeFormat",
    "NumberFormat",
    "Collator",
    "PluralRules",
    "RelativeTimeFormat",
    "ListFormat",
    "DisplayNames",
    "Segmenter",
]

WEEKDAYS := ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

MONTH_NAMES := [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
]

## What a date format shows. Each field is "" for absent, else the option's
## value ("numeric", "2-digit", "long", "short", "narrow").
pub struct DateFmt
    ## The `timeZone` option: "" for the browser's zone (`Vm.zone`).
    pub zone str
    pub weekday str
    pub year str
    pub month str
    pub day str
    pub hour str
    pub minute str
    pub second str
    pub hour12 bool
    pub time_zone_name str
    pub date_style str
    pub time_style str

fn empty_fmt() DateFmt
    DateFmt(
        zone: "",
        weekday: "",
        year: "",
        month: "",
        day: "",
        hour: "",
        minute: "",
        second: "",
        hour12: true,
        time_zone_name: "",
        date_style: "",
        time_style: "",
    )

fn has_date(f DateFmt) bool
    f.weekday != "" or f.year != "" or f.month != "" or f.day != "" or f.date_style != ""

fn has_time(f DateFmt) bool
    f.hour != "" or f.minute != "" or f.second != "" or f.time_style != ""

## The string option `key` of `options`, "" when absent.
fn Vm.str_option(mut self, options Value, key str) str ! Thrown
    if not is_obj(options)
        return ""
    v := get(options, key)?
    if v == Undef
        return ""
    to_string(v)?

## The format for a Date.prototype.toLocale*String call (`m`) or an
## Intl.DateTimeFormat (`m` = "format") with `options`: the defaults
## (ToDateTimeOptions, §11.1.2 of ECMA-402) fill in when the options name
## no field.
pub fn Vm.date_format_options(mut self, m str, options Value) DateFmt ! Thrown
    mut f := empty_fmt()
    f.weekday = self.str_option(options, "weekday")?
    f.year = self.str_option(options, "year")?
    f.month = self.str_option(options, "month")?
    f.day = self.str_option(options, "day")?
    f.hour = self.str_option(options, "hour")?
    f.minute = self.str_option(options, "minute")?
    f.second = self.str_option(options, "second")?
    f.time_zone_name = self.str_option(options, "timeZoneName")?
    f.zone = self.str_option(options, "timeZone")?
    if f.zone != ""
        if f.zone.to_upper() == "UTC"
            or f.zone.to_upper() == "GMT"
            or f.zone.to_upper() == "ETC/UTC"
            f.zone = "UTC"
        elif tz.offset(f.zone, 0) == none
            return range_error("Invalid time zone specified: {f.zone}")
    f.date_style = self.str_option(options, "dateStyle")?
    f.time_style = self.str_option(options, "timeStyle")?
    if is_obj(options)
        h12 := get(options, "hour12")?
        if h12 != Undef
            f.hour12 = truthy(h12)
        cycle := self.str_option(options, "hourCycle")?
        if cycle == "h23" or cycle == "h24"
            f.hour12 = false
    want_date := m != "toLocaleTimeString"
    want_time := m != "toLocaleDateString" and m != "format"
    if not has_date(f) and not has_time(f)
        if want_date
            f.year = "numeric"
            f.month = "numeric"
            f.day = "numeric"
        if want_time
            f.hour = "numeric"
            f.minute = "numeric"
            f.second = "numeric"
    f

fn two_digits(n int) str
    "{n}".pad_left(2, '0')

fn num_field(n int, style str) str
    if style == "2-digit" then two_digits(n % 100) else "{n}"

## The date part of a formatted date, "" when the format shows none.
fn date_part(p DateParts, f DateFmt) str
    if f.date_style != ""
        return match f.date_style
            "full" => "{WEEKDAYS[p.weekday]}, {MONTH_NAMES[p.month]} {p.date}, {p.year}"
            "long" => "{MONTH_NAMES[p.month]} {p.date}, {p.year}"
            "medium" => "{MONTH_NAMES[p.month].slice(0, 3)} {p.date}, {p.year}"
            _ => "{p.month + 1}/{p.date}/{two_digits(p.year % 100)}"
    if not has_date(f)
        return ""
    mut weekday := ""
    if f.weekday == "long"
        weekday = WEEKDAYS[p.weekday]
    elif f.weekday == "short"
        weekday = WEEKDAYS[p.weekday].slice(0, 3)
    elif f.weekday == "narrow"
        weekday = WEEKDAYS[p.weekday].slice(0, 1)
    textual := f.month == "long" or f.month == "short" or f.month == "narrow"
    mut out := ""
    if textual
        month := match f.month
            "long" => MONTH_NAMES[p.month]
            "short" => MONTH_NAMES[p.month].slice(0, 3)
            _ => MONTH_NAMES[p.month].slice(0, 1)
        out = month
        if f.day != ""
            out = "{out} {num_field(p.date, f.day)}"
        if f.year != ""
            out = if f.day
                != "" then "{out}, {num_field(p.year, f.year)}" else "{out} {num_field(p.year, f.year)}"
    else
        mut parts := List[str]()
        if f.month != ""
            parts.push(num_field(p.month + 1, f.month))
        if f.day != ""
            parts.push(num_field(p.date, f.day))
        if f.year != ""
            parts.push(num_field(p.year, f.year))
        out = parts.join("/")
    if weekday != ""
        out = if out == "" then weekday else "{weekday}, {out}"
    out

## The time part, "" when the format shows none.
## `name` is the zone the parts are in and `off` its offset in ms.
fn time_part(p DateParts, f DateFmt, name str, off float) str
    mut hour := f.hour
    mut minute := f.minute
    mut second := f.second
    mut zone := f.time_zone_name
    if f.time_style != ""
        hour = "numeric"
        minute = "numeric"
        second = if f.time_style == "short" then "" else "numeric"
        if f.time_style == "full"
            zone = "long"
        elif f.time_style == "long"
            zone = "short"
    if hour == "" and minute == "" and second == ""
        return ""
    mut out := ""
    mut suffix := ""
    if hour != ""
        mut h := p.hours
        if f.hour12
            suffix = if h < 12 then " AM" else " PM"
            h = h % 12
            if h == 0
                h = 12
        out = if hour == "2-digit" or not f.hour12 then two_digits(h) else "{h}"
    if minute != ""
        out = if out == "" then two_digits(p.minutes) else "{out}:{two_digits(p.minutes)}"
    if second != ""
        out = if out == "" then two_digits(p.seconds) else "{out}:{two_digits(p.seconds)}"
    out = "{out}{suffix}"
    if zone == "long"
        out = "{out} {if name == "UTC" then "Coordinated Universal Time" else name}"
    elif zone != ""
        out = "{out} {if name == "UTC" then "UTC" else short_zone(off)}"
    out

## "GMT-5" or "GMT+5:30": the short zone name of a zone without one.
fn short_zone(off_ms float) str
    off := (off_ms / 60000.0).to_int()
    a := off.abs()
    sign := if off < 0 then "-" else "+"
    if a % 60 == 0 then "GMT{sign}{a / 60}" else "GMT{sign}{a / 60}:{two_digits(a % 60)}"

## A time value as en-US writes it with format `f`, in the format's zone or
## the browser's.
pub fn Vm.format_date(self, t float, f DateFmt) str
    name := if f.zone != "" then f.zone else (if zone == "" then "UTC" else zone)
    off := zone_offset_ms(name, t)
    p := parts_of(t + off)
    d := date_part(p, f)
    tm := time_part(p, f, name, off)
    if d == ""
        return tm
    if tm == ""
        return d
    textual := f.month == "long"
        or f.month == "short"
        or f.date_style == "full"
        or f.date_style == "long"
    if textual then "{d} at {tm}" else "{d}, {tm}"

# ------------------------------------------------------------- numbers

## Number formatting options.
struct NumFmt
    style str
    currency str
    min_frac int
    max_frac int
    grouping bool

fn Vm.int_option(mut self, options Value, key str, fallback int) int ! Thrown
    if not is_obj(options)
        return fallback
    v := get(options, key)?
    if v == Undef
        return fallback
    n := to_number(v)?
    if not is_finite(n) or n < 0.0 or n > 100.0
        return range_error("{key} value is out of range.")
    n.to_int()

fn Vm.num_format_options(mut self, options Value) NumFmt ! Thrown
    mut style := self.str_option(options, "style")?
    if style == ""
        style = "decimal"
    currency := self.str_option(options, "currency")?.to_upper()
    if style == "currency" and currency == ""
        return type_error("Currency code is required with currency style.")
    default_min := if style == "currency" then 2 else 0
    mut default_max := 3
    if style == "currency"
        default_max = 2
    elif style == "percent"
        default_max = 0
    min_frac := self.int_option(options, "minimumFractionDigits", default_min)?
    mut max_frac := self.int_option(options, "maximumFractionDigits", default_max.max(min_frac))?
    if max_frac < min_frac
        return range_error("maximumFractionDigits value is out of range.")
    mut grouping := true
    if is_obj(options)
        g := get(options, "useGrouping")?
        if g != Undef
            grouping = truthy(g) or (str_of(g) else "") != ""
    NumFmt(
        style: style,
        currency: currency,
        min_frac: min_frac,
        max_frac: max_frac,
        grouping: grouping,
    )

## Digits with en-US grouping.
fn grouped(digits str, on bool) str
    if not on
        return digits
    cs := digits.chars()
    mut out := List[char]()
    for i in 0..cs.len()
        if i > 0 and (cs.len() - i) % 3 == 0
            out.push(',')
        out.push(cs[i])
    out.join("")

fn currency_symbol(code str) str
    match code
        "USD" => "$"
        "EUR" => "€"
        "GBP" => "£"
        "JPY" => "¥"
        "INR" => "₹"
        "CNY" => "CN¥"
        "KRW" => "₩"
        "CAD" => "CA$"
        "AUD" => "A$"
        _ => "{code} "

## A number as the format writes it.
fn format_number(x0 float, f NumFmt) str
    if is_nan(x0)
        return "NaN"
    mut x := x0
    if f.style == "percent"
        x = x * 100.0
    if not is_finite(x)
        return if x > 0.0 then "∞" else "-∞"
    negative := x < 0.0
    t := to_fixed(x.abs(), f.max_frac)
    parts := t.split(".")
    mut frac := if parts.len() > 1 then parts[1] else ""
    while frac.chars().len() > f.min_frac and frac.ends_with("0")
        frac = frac.slice(0, frac.chars().len() - 1)
    mut out := grouped(parts[0], f.grouping)
    if frac != ""
        out = "{out}.{frac}"
    if negative and (parts[0] != "0" or frac.replace("0", "") != "")
        out = "-{out}"
    match f.style
        "percent" => "{out}%"
        "currency" =>
            sym := currency_symbol(f.currency)
            if out.starts_with("-") then "-{sym}{out.slice(1, out.chars().len())}" else "{sym}{out}"
        _ => out

# -------------------------------------------------------------- objects

## Install `Intl` and its constructors.
fn Vm.intl_setup(mut self)
    intl := plain()
    methods(intl, "intl.Intl", "getCanonicalLocales:1 supportedValuesOf:1")
    bin_tag(intl, "Intl")
    for kind in INTL_KINDS
        proto := object("Object", proto_of("Object"))
        protos["Intl.{kind}"] = Value.Obj(proto)
        spec := match kind
            "DateTimeFormat" => "format:1 formatToParts:1 formatRange:2 resolvedOptions:0"
            "NumberFormat" => "format:1 formatToParts:1 formatRange:2 resolvedOptions:0"
            "Collator" => "compare:2 resolvedOptions:0"
            "PluralRules" => "select:1 selectRange:2 resolvedOptions:0"
            "RelativeTimeFormat" => "format:2 formatToParts:2 resolvedOptions:0"
            "ListFormat" => "format:1 formatToParts:1 resolvedOptions:0"
            "Segmenter" => "segment:1 resolvedOptions:0"
            _ => "of:1 resolvedOptions:0"
        methods(proto, "intl.{kind}", spec)
        bin_tag(proto, "Intl.{kind}")
        c := obj_of(native_fn("intl.new.{kind}", kind, 0)) else continue
        c.props["prototype"] = Prop(
            value: Value.Obj(proto),
            get: Undef,
            set: Undef,
            accessor: false,
            enumerable: false,
            writable: false,
            configurable: false,
        )
        methods(c, "intl.static", "supportedLocalesOf:1")
        proto.props["constructor"] = hidden(Value.Obj(c))
        intl.props[kind] = hidden(Value.Obj(c))
    global_obj.props["Intl"] = hidden(Value.Obj(intl))
    # What Intl.Segmenter.prototype.segment returns (segmenter.ail).
    seg_proto := object("Object", proto_of("Object"))
    protos["Intl.Segments"] = Value.Obj(seg_proto)
    methods(seg_proto, "intl.Segments", "containing:1")
    seg_proto.props[ITERATOR] = hidden(native_fn("intl.Segments.iterator", "[Symbol.iterator]", 0))

## The requested locale, as a string: the first of a list, else en-US.
fn Vm.locale_of(mut self, v Value) str ! Thrown
    if is_nullish(v)
        return LOCALE
    if o := obj_of(v)
        if o.class == "Array"
            if o.elems.len() == 0
                return LOCALE
            return to_string(o.elems[0])?
    to_string(v)?

## `new Intl.Kind(locales, options)`: the resolved options live on the
## object under a private key.
fn Vm.intl_new(mut self, kind str, args List[Value]) Value ! Thrown
    o := object("Intl.{kind}", proto_of("Intl.{kind}"))
    options := arg_at(args, 1)
    resolved := plain()
    locale := self.locale_of(arg_at(args, 0))?
    resolved.props["locale"] = data(Value.Str(if locale.to_lower().starts_with("en") then locale else LOCALE))
    match kind
        "DateTimeFormat" =>
            f := self.date_format_options("format", options)?
            resolved.props["calendar"] = data(Value.Str("gregory"))
            resolved.props["numberingSystem"] = data(Value.Str("latn"))
            resolved.props["timeZone"] = data(Value.Str(if f.zone != "" then f.zone else (if zone == "" then "UTC" else zone)))
            for pair in [
                ("weekday", f.weekday),
                ("year", f.year),
                ("month", f.month),
                ("day", f.day),
                ("hour", f.hour),
                ("minute", f.minute),
                ("second", f.second),
                ("timeZoneName", f.time_zone_name),
                ("dateStyle", f.date_style),
                ("timeStyle", f.time_style),
            ]
                if pair.1 != ""
                    resolved.props[pair.0] = data(Value.Str(pair.1))
            if f.hour != "" or f.time_style != ""
                resolved.props["hourCycle"] = data(Value.Str(if f.hour12 then "h12" else "h23"))
                resolved.props["hour12"] = data(Value.Bool(f.hour12))
        "NumberFormat" =>
            f := self.num_format_options(options)?
            resolved.props["numberingSystem"] = data(Value.Str("latn"))
            resolved.props["style"] = data(Value.Str(f.style))
            if f.style == "currency"
                resolved.props["currency"] = data(Value.Str(f.currency))
                resolved.props["currencyDisplay"] = data(Value.Str("symbol"))
                resolved.props["currencySign"] = data(Value.Str("standard"))
            resolved.props["minimumIntegerDigits"] = data(Value.Num(1.0))
            resolved.props["minimumFractionDigits"] = data(Value.Num(f.min_frac.to_float()))
            resolved.props["maximumFractionDigits"] = data(Value.Num(f.max_frac.to_float()))
            resolved.props["useGrouping"] = data(if f.grouping then Value.Str("auto") else Value.Bool(false))
            resolved.props["notation"] = data(Value.Str("standard"))
            resolved.props["signDisplay"] = data(Value.Str("auto"))
            resolved.props["roundingIncrement"] = data(Value.Num(1.0))
            resolved.props["roundingMode"] = data(Value.Str("halfExpand"))
            resolved.props["roundingPriority"] = data(Value.Str("auto"))
            resolved.props["trailingZeroDisplay"] = data(Value.Str("auto"))
        "Collator" =>
            resolved.props["usage"] = data(Value.Str(str_or(
                self.str_option(options, "usage")?,
                "sort",
            )))
            resolved.props["sensitivity"] = data(Value.Str(str_or(
                self.str_option(options, "sensitivity")?,
                "variant",
            )))
            resolved.props["ignorePunctuation"] = data(Value.Bool(false))
            resolved.props["collation"] = data(Value.Str("default"))
            mut numeric := false
            if is_obj(options)
                numeric = truthy(get(options, "numeric")?)
            resolved.props["numeric"] = data(Value.Bool(numeric))
            resolved.props["caseFirst"] = data(Value.Str("false"))
        "PluralRules" =>
            resolved.props["type"] = data(Value.Str(str_or(
                self.str_option(options, "type")?,
                "cardinal",
            )))
            resolved.props["minimumIntegerDigits"] = data(Value.Num(1.0))
            resolved.props["minimumFractionDigits"] = data(Value.Num(0.0))
            resolved.props["maximumFractionDigits"] = data(Value.Num(3.0))
            resolved.props["pluralCategories"] = data(array([Value.Str("one"), Value.Str("other")]))
            resolved.props["roundingMode"] = data(Value.Str("halfExpand"))
        "RelativeTimeFormat" =>
            resolved.props["style"] = data(Value.Str(str_or(
                self.str_option(options, "style")?,
                "long",
            )))
            resolved.props["numeric"] = data(Value.Str(str_or(
                self.str_option(options, "numeric")?,
                "always",
            )))
            resolved.props["numberingSystem"] = data(Value.Str("latn"))
        "Segmenter" =>
            granularity := str_or(self.str_option(options, "granularity")?, "grapheme")
            if granularity != "grapheme" and granularity != "word" and granularity != "sentence"
                return range_error("Value {granularity} out of range for Intl.Segmenter options property granularity")
            resolved.props["granularity"] = data(Value.Str(granularity))
        "ListFormat" =>
            resolved.props["type"] = data(Value.Str(str_or(
                self.str_option(options, "type")?,
                "conjunction",
            )))
            resolved.props["style"] = data(Value.Str(str_or(
                self.str_option(options, "style")?,
                "long",
            )))
        _ =>
            kind_opt := self.str_option(options, "type")?
            if kind_opt == ""
                return type_error("Required option 'type' is missing")
            resolved.props["type"] = data(Value.Str(kind_opt))
            resolved.props["style"] = data(Value.Str(str_or(
                self.str_option(options, "style")?,
                "long",
            )))
            resolved.props["fallback"] = data(Value.Str(str_or(
                self.str_option(options, "fallback")?,
                "code",
            )))
    o.props["{PRIVATE}resolved"] = hidden(Value.Obj(resolved))
    Value.Obj(o)

fn str_or(v str, fallback str) str
    if v == "" then fallback else v

## The resolved options object of an Intl receiver of `kind`.
fn Vm.intl_this(mut self, v Value, kind str, m str) ref JsObject ! Thrown
    o := this_class(v, "Intl.{kind}", m)?
    p := o.props.get("{PRIVATE}resolved") else return type_error("Illegal invocation")
    r := obj_of(p.value) else return type_error("Illegal invocation")
    r

fn resolved_str(r ref JsObject, key str) str
    p := r.props.get(key) else return ""
    str_of(p.value) else ""

## The formatter back from its resolved options.
fn date_fmt_of(r ref JsObject) DateFmt
    mut f := empty_fmt()
    f.weekday = resolved_str(r, "weekday")
    f.year = resolved_str(r, "year")
    f.month = resolved_str(r, "month")
    f.day = resolved_str(r, "day")
    f.hour = resolved_str(r, "hour")
    f.minute = resolved_str(r, "minute")
    f.second = resolved_str(r, "second")
    f.time_zone_name = resolved_str(r, "timeZoneName")
    f.zone = resolved_str(r, "timeZone")
    f.date_style = resolved_str(r, "dateStyle")
    f.time_style = resolved_str(r, "timeStyle")
    f.hour12 = resolved_str(r, "hourCycle") != "h23"
    f

fn num_fmt_of(r ref JsObject) NumFmt
    mut min_frac := 0
    mut max_frac := 3
    if p := r.props.get("minimumFractionDigits")
        min_frac = (num_of(p.value) else 0.0).to_int()
    if p := r.props.get("maximumFractionDigits")
        max_frac = (num_of(p.value) else 3.0).to_int()
    mut grouping := true
    if p := r.props.get("useGrouping")
        grouping = p.value != Value.Bool(false)
    NumFmt(
        style: str_or(resolved_str(r, "style"), "decimal"),
        currency: resolved_str(r, "currency"),
        min_frac: min_frac,
        max_frac: max_frac,
        grouping: grouping,
    )

## The time value of a `format` argument: now when absent.
fn Vm.date_arg(mut self, v Value) float ! Thrown
    if v == Undef
        return clock_ms
    if o := obj_of(v)
        if o.class == "Date"
            t := num_of(o.prim) else nan()
            if not is_finite(t)
                return range_error("Invalid time value")
            return t
    t := to_number(v)?
    if not is_finite(t)
        return range_error("Invalid time value")
    t

## One `{type, value}` part.
fn Vm.part(mut self, kind str, value str) Value
    o := plain()
    o.props["type"] = data(Value.Str(kind))
    o.props["value"] = data(Value.Str(value))
    Value.Obj(o)

## `formatToParts` from a formatted string: digit runs become "integer"
## parts and the rest "literal", enough for pages that join the parts.
fn Vm.parts_of_text(mut self, text str) Value
    mut out := List[Value]()
    mut run := ""
    mut digits := false
    for c in text.chars()
        d := c.is_digit()
        if run != "" and d != digits
            out.push(self.part(if digits then "integer" else "literal", run))
            run = ""
        digits = d
        run = "{run}{c}"
    if run != ""
        out.push(self.part(if digits then "integer" else "literal", run))
    array(out)

fn plural_of(n float, ordinal bool) str
    if not ordinal
        return if n == 1.0 then "one" else "other"
    i := n.abs().to_int()
    if n != i.to_float()
        return "other"
    if i % 100 >= 11 and i % 100 <= 13
        return "other"
    match i % 10
        1 => "one"
        2 => "two"
        3 => "few"
        _ => "other"

fn relative_text(v float, unit0 str, style str, numeric_auto bool) str?
    mut unit := unit0
    if unit.ends_with("s")
        unit = unit.slice(0, unit.chars().len() - 1)
    known := ["second", "minute", "hour", "day", "week", "month", "quarter", "year"]
    if not known.contains(unit)
        return none
    if numeric_auto and v == 0.0
        return match unit
            "second" => "now"
            "day" => "today"
            _ => "this {unit}"
    if numeric_auto
        and unit != "second"
        and unit != "minute"
        and unit != "hour"
        and (v == 1.0 or v == -1.0)
        if unit == "day"
            return if v > 0.0 then "tomorrow" else "yesterday"
        return if v > 0.0 then "next {unit}" else "last {unit}"
    n := locale_number(v.abs())
    mut name := unit
    if style != "long"
        name = match unit
            "second" => "sec."
            "minute" => "min."
            "hour" => "hr."
            "day" => "day"
            "week" => "wk."
            "month" => "mo."
            "quarter" => "qtr."
            _ => "yr."
    if style == "long" and v.abs() != 1.0
        name = "{name}s"
    elif style != "long" and v.abs() != 1.0 and (unit == "day" or unit == "quarter")
        name = if unit == "day" then "days" else "qtrs."
    if v < 0.0 then "{n} {name} ago" else "in {n} {name}"

fn list_text(items List[str], kind str, style str) str
    n := items.len()
    if n == 0
        return ""
    if n == 1
        return items[0]
    word := match kind
        "disjunction" => "or"
        "unit" => ""
        _ => if style == "long" then "and" else "&"
    if n == 2
        return if word == "" then "{items[0]}, {items[1]}" else "{items[0]} {word} {items[1]}"
    head := items[0..(n - 1)].join(", ")
    if word == ""
        return "{head}, {items[n - 1]}"
    "{head}, {word} {items[n - 1]}"

## The Intl natives: "new.Kind", "Kind.method", "Intl.fn", "static.fn".
pub fn Vm.intl_native(
    mut self,
    m str,
    this_val Value,
    args List[Value],
    new_target Value,
) Value ! Thrown
    if made := m.strip_prefix("new.")
        if made == "Segmenter" and new_target == Undef
            return type_error("Constructor Intl.Segmenter requires 'new'")
        return self.intl_new(made, args)
    a0 := arg_at(args, 0)
    if sm := m.strip_prefix("Segments.")
        return self.segments_method(sm, this_val, a0)
    if m == "static.supportedLocalesOf" or m == "Intl.getCanonicalLocales"
        if is_nullish(a0)
            return array([])
        mut out := List[Value]()
        if o := obj_of(a0)
            for x in o.elems
                out.push(Value.Str(to_string(x)?))
        else
            out.push(Value.Str(to_string(a0)?))
        if m == "static.supportedLocalesOf"
            out = [x for x in out if (str_of(x) else "").to_lower().starts_with("en")]
        return array(out)
    if m == "Intl.supportedValuesOf"
        key := to_string(a0)?
        return match key
            "calendar" => array([Value.Str("gregory")])
            "numberingSystem" => array([Value.Str("latn")])
            "timeZone" => array(
                if zone == "UTC" or zone == "" then [Value.Str("UTC")] else [
                    Value.Str("UTC"),
                    Value.Str(zone),
                ],
            )
            "currency" => array([
                Value.Str("EUR"),
                Value.Str("GBP"),
                Value.Str("JPY"),
                Value.Str("USD"),
            ])
            "unit" => array([
                Value.Str("byte"),
                Value.Str("day"),
                Value.Str("hour"),
                Value.Str("minute"),
                Value.Str("second"),
            ])
            "collation" => array([Value.Str("default")])
            _ => return range_error("Invalid key : {key}")
    dot := m.find(".") else return type_error("Intl.{m} is not supported yet")
    kind := m.slice(0, dot)
    method := m.slice(dot + 1, m.chars().len())
    r := self.intl_this(this_val, kind, method)?
    if method == "resolvedOptions"
        copy := plain()
        for k in r.props.keys()
            copy.props[k] = r.props[k]
        return Value.Obj(copy)
    match kind
        "DateTimeFormat" =>
            f := date_fmt_of(r)
            if method == "formatRange"
                return Value.Str("{self.format_date(self.date_arg(a0)?, f)} – {self.format_date(self.date_arg(arg_at(args, 1))?, f)}")
            text := self.format_date(self.date_arg(a0)?, f)
            if method == "formatToParts" then self.parts_of_text(text) else Value.Str(text)
        "NumberFormat" =>
            f := num_fmt_of(r)
            if method == "formatRange"
                return Value.Str("{format_number(to_number(a0)?, f)}–{format_number(to_number(arg_at(args, 1))?, f)}")
            text := format_number(to_number(a0)?, f)
            if method == "formatToParts" then self.parts_of_text(text) else Value.Str(text)
        "Collator" =>
            a := to_string(a0)?
            b := to_string(arg_at(args, 1))?
            sensitivity := resolved_str(r, "sensitivity")
            mut x := a
            mut y := b
            if sensitivity == "base" or sensitivity == "accent"
                x = a.to_lower()
                y = b.to_lower()
            if x == y
                return Value.Num(0.0)
            # Letters sort case-insensitively first, lower before upper on a tie.
            lx := x.to_lower()
            ly := y.to_lower()
            if lx != ly
                return Value.Num(if lx < ly then -1.0 else 1.0)
            Value.Num(if x > y then -1.0 else 1.0)
        "PluralRules" =>
            ordinal := resolved_str(r, "type") == "ordinal"
            if method == "selectRange"
                return Value.Str(plural_of(to_number(arg_at(args, 1))?, ordinal))
            Value.Str(plural_of(to_number(a0)?, ordinal))
        "RelativeTimeFormat" =>
            v := to_number(a0)?
            if not is_finite(v)
                return range_error("Value need to be finite number for Intl.RelativeTimeFormat.prototype.format()")
            unit := to_string(arg_at(args, 1))?
            auto := resolved_str(r, "numeric") == "auto"
            text := relative_text(
                v,
                unit,
                resolved_str(r, "style"),
                auto,
            ) else return range_error("Invalid unit argument for format() '{unit}'")
            if method == "formatToParts" then self.parts_of_text(text) else Value.Str(text)
        "ListFormat" =>
            mut items := List[str]()
            if not is_nullish(a0)
                for x in iterate(a0)?
                    items.push(to_string(x)?)
            text := list_text(items, resolved_str(r, "type"), resolved_str(r, "style"))
            if method == "formatToParts" then self.parts_of_text(text) else Value.Str(text)
        "Segmenter" => self.segment_text(r, to_string(a0)?)
        _ =>
            # DisplayNames.of: the code itself, as the "code" fallback writes it.
            code := to_string(a0)?
            shown := match code
                "en" => "English"
                "en-US" => "American English"
                "fr" => "French"
                "de" => "German"
                "es" => "Spanish"
                "US" => "United States"
                "GB" => "United Kingdom"
                "USD" => "US Dollar"
                "EUR" => "Euro"
                _ => code
            Value.Str(shown)

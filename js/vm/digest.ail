## SHA-1 and SHA-256 (FIPS 180-4) over a list of bytes, for
## `crypto.subtle.digest`. Words are ints kept to 32 bits.

M32 := 4294967295

fn rotl32(x int, n int) int
    x.shl(n).bit_or(x.shr(32 - n)).bit_and(M32)

fn rotr32(x int, n int) int
    x.shr(n).bit_or(x.shl(32 - n)).bit_and(M32)

## The message padded to a multiple of 64 bytes with its bit length.
fn pad_message(data List[int]) List[int]
    mut m := data
    m.push(128)
    while m.len() % 64 != 56
        m.push(0)
    bits := data.len() * 8
    for i in 0..8
        m.push(bits.shr(56 - 8 * i).bit_and(255))
    m

fn word_at(m List[int], at int) int
    m[at].shl(24) + m[at + 1].shl(16) + m[at + 2].shl(8) + m[at + 3]

fn words_bytes(hs List[int]) List[int]
    mut out := List[int]()
    for h in hs
        out.push(h.shr(24).bit_and(255))
        out.push(h.shr(16).bit_and(255))
        out.push(h.shr(8).bit_and(255))
        out.push(h.bit_and(255))
    out

pub fn digest_sha1(data List[int]) List[int]
    m := pad_message(data)
    mut h := [1732584193, 4023233417, 2562383102, 271733878, 3285377520]
    mut base := 0
    while base < m.len()
        mut w := List[int]()
        for t in 0..16
            w.push(word_at(m, base + 4 * t))
        for t in 16..80
            w.push(rotl32(w[t - 3].bit_xor(w[t - 8]).bit_xor(w[t - 14]).bit_xor(w[t - 16]), 1))
        mut a := h[0]
        mut b := h[1]
        mut c := h[2]
        mut d := h[3]
        mut e := h[4]
        for t in 0..80
            mut f := 0
            mut k := 0
            if t < 20
                f = b.bit_and(c).bit_or(b.bit_xor(M32).bit_and(d))
                k = 1518500249
            elif t < 40
                f = b.bit_xor(c).bit_xor(d)
                k = 1859775393
            elif t < 60
                f = b.bit_and(c).bit_or(b.bit_and(d)).bit_or(c.bit_and(d))
                k = 2400959708
            else
                f = b.bit_xor(c).bit_xor(d)
                k = 3395469782
            tmp := (rotl32(a, 5) + f + e + k + w[t]).bit_and(M32)
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = tmp
        h[0] = (h[0] + a).bit_and(M32)
        h[1] = (h[1] + b).bit_and(M32)
        h[2] = (h[2] + c).bit_and(M32)
        h[3] = (h[3] + d).bit_and(M32)
        h[4] = (h[4] + e).bit_and(M32)
        base += 64
    words_bytes(h)

fn sha256_k() List[int]
    [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]

pub fn digest_sha256(data List[int]) List[int]
    k := sha256_k()
    m := pad_message(data)
    mut h := [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    mut base := 0
    while base < m.len()
        mut w := List[int]()
        for t in 0..16
            w.push(word_at(m, base + 4 * t))
        for t in 16..64
            s0 := rotr32(w[t - 15], 7).bit_xor(rotr32(w[t - 15], 18)).bit_xor(w[t - 15].shr(3))
            s1 := rotr32(w[t - 2], 17).bit_xor(rotr32(w[t - 2], 19)).bit_xor(w[t - 2].shr(10))
            w.push((w[t - 16] + s0 + w[t - 7] + s1).bit_and(M32))
        mut a := h[0]
        mut b := h[1]
        mut c := h[2]
        mut d := h[3]
        mut e := h[4]
        mut f := h[5]
        mut g := h[6]
        mut hh := h[7]
        for t in 0..64
            s1 := rotr32(e, 6).bit_xor(rotr32(e, 11)).bit_xor(rotr32(e, 25))
            ch := e.bit_and(f).bit_xor(e.bit_xor(M32).bit_and(g))
            t1 := (hh + s1 + ch + k[t] + w[t]).bit_and(M32)
            s0 := rotr32(a, 2).bit_xor(rotr32(a, 13)).bit_xor(rotr32(a, 22))
            maj := a.bit_and(b).bit_xor(a.bit_and(c)).bit_xor(b.bit_and(c))
            t2 := (s0 + maj).bit_and(M32)
            hh = g
            g = f
            f = e
            e = (d + t1).bit_and(M32)
            d = c
            c = b
            b = a
            a = (t1 + t2).bit_and(M32)
        h[0] = (h[0] + a).bit_and(M32)
        h[1] = (h[1] + b).bit_and(M32)
        h[2] = (h[2] + c).bit_and(M32)
        h[3] = (h[3] + d).bit_and(M32)
        h[4] = (h[4] + e).bit_and(M32)
        h[5] = (h[5] + f).bit_and(M32)
        h[6] = (h[6] + g).bit_and(M32)
        h[7] = (h[7] + hh).bit_and(M32)
        base += 64
    words_bytes(h)

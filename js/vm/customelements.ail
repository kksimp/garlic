## `customElements` (HTML Standard §4.13.4): the registry, and upgrades.
## `define` records the constructor, settles `whenDefined` and upgrades the
## elements already in the page; an element made or inserted later is
## upgraded then. An upgrade runs the class constructor with the element's
## own object as `this` (HTMLElement's constructor hands it back, §4.13.5),
## then attributeChangedCallback for each observed attribute present and
## connectedCallback when the element is in the document. Removing an
## upgraded element runs disconnectedCallback.

CE_DEF := "\u{0}#ce:"
CE_WAIT := "\u{0}#cw:"

fn valid_element_name(name str) bool
    cs := name.chars()
    if cs.len() < 3 or not name.contains('-')
        return false
    if cs[0] < 'a' or cs[0] > 'z'
        return false
    for c in cs
        ok := (c >= 'a' and c <= 'z') or c.is_digit() or c == '-' or c == '.' or c == '_'
        if not ok
            return false
    match name
        "annotation-xml" | "color-profile" | "font-face" | "font-face-src" | "font-face-uri" | "font-face-format" | "font-face-name" | "missing-glyph" => false
        _ => true

fn Vm.custom_native(mut self, m str, this_val Value, args List[Value]) Value ! Thrown
    reg := this_kind(this_val, "CustomElementRegistry")?
    a0 := arg_at(args, 0)
    name := to_string(a0)?
    if m == "customElements.get"
        p := reg.props.get("{CE_DEF}{name}") else return Undef
        return p.value
    if m == "customElements.upgrade"
        if root := node_id(a0)
            self.ce_upgrade(root)
            for e in elements_under(root)
                self.ce_upgrade(e)
        return Undef
    if not valid_element_name(name)
        return dom_exception("SyntaxError", "\"{name}\" is not a valid custom element name")
    if m == "customElements.whenDefined"
        if d := reg.props.get("{CE_DEF}{name}")
            return Value.Obj(promise_resolve(d.value))
        if w := reg.props.get("{CE_WAIT}{name}")
            return w.value
        p := new_promise()
        reg.props["{CE_WAIT}{name}"] = hidden(Value.Obj(p))
        return Value.Obj(p)
    if m == "customElements.define"
        ctor := arg_at(args, 1)
        if not is_constructor(ctor)
            return type_error("Failed to execute 'define' on 'CustomElementRegistry': parameter 2 is not of type 'Function'.")
        if reg.props.get("{CE_DEF}{name}") != none
            return dom_exception(
                "NotSupportedError",
                "Failed to execute 'define' on 'CustomElementRegistry': the name \"{name}\" has already been used with this registry",
            )
        reg.props["{CE_DEF}{name}"] = hidden(ctor)
        if w := reg.props.get("{CE_WAIT}{name}")
            if p := obj_of(w.value)
                resolve_promise(p, ctor)
        for e in elements_under(0)
            if dom[e].tag == name
                self.ce_upgrade(e)
        return Undef
    type_error("{m} is not supported yet")

fn Vm.custom_setup(mut self)
    bin_ctor("CustomElementRegistry", 0)
    proto := obj_of(proto_of("CustomElementRegistry")) else return
    methods(proto, "bin.customElements", "define:2 get:1 whenDefined:1 upgrade:1")
    bin_tag(proto, "CustomElementRegistry")
    global_obj.props["customElements"] = hidden(Value.Obj(object(
        "CustomElementRegistry",
        Value.Obj(proto),
    )))

## The page's registry object.
fn Vm.ce_registry(self) ref JsObject?
    p := global_obj.props.get("customElements") else return none
    obj_of(p.value)

## The constructor defined for element name `name`.
pub fn Vm.ce_definition(self, name str) Value?
    reg := self.ce_registry() else return none
    p := reg.props.get("{CE_DEF}{name}") else return none
    p.value

## The element name `ctor` was defined for.
fn Vm.ce_name_of(self, ctor Value) str?
    reg := self.ce_registry() else return none
    for k in reg.props.keys()
        if name := k.strip_prefix(CE_DEF)
            if reg.props[k].value == ctor
                return name
    none

## HTMLElement's constructor reached through a class (`super()` in a
## derived constructor, or `new`): the element being upgraded, else a new
## element of the class's defined name (§4.13.5 HTML element constructors).
pub fn Vm.ce_construct(mut self, new_target Value) Value ! Thrown
    defined := self.ce_name_of(new_target)
    mut id := -1
    if ce_upgrading.len() > 0
        top := ce_upgrading[ce_upgrading.len() - 1]
        mut take := true
        if n := defined
            take = n == dom[top].tag
        if take
            ce_upgrading.remove_at(ce_upgrading.len() - 1)
            id = top
    if id < 0
        name := defined else return type_error("Illegal constructor")
        id = dom_create(name, 1, "")
    o := obj_of(node_value(id)) else return type_error("Illegal constructor")
    o.proto = get(new_target, "prototype")?
    ce_upgraded.add(id)
    Value.Obj(o)

## Upgrade element `id` if its name is defined and it isn't upgraded yet.
pub fn Vm.ce_upgrade(mut self, id int)
    if ce_upgraded.contains(id) or dom[id].kind != 1
        return
    ctor := self.ce_definition(dom[id].tag) else return
    ce_upgrading.push(id)
    if v := construct(ctor, [], ctor)
        v
    else err
        report_error(err)
    if ce_upgrading.len() > 0 and ce_upgrading[ce_upgrading.len() - 1] == id
        ce_upgrading.remove_at(ce_upgrading.len() - 1)
    if not ce_upgraded.contains(id)
        return
    if r := self.ce_after_upgrade(id, ctor)
        r
    else err
        report_error(err)
    if connected(id)
        self.ce_call(id, "connectedCallback", [])

fn Vm.ce_after_upgrade(mut self, id int, ctor Value) Value ! Thrown
    for name in self.ce_observed(ctor)?
        if v := attr_of(id, name)
            self.ce_call(id, "attributeChangedCallback", [
                Value.Str(name),
                Value.Null,
                Value.Str(v),
            ])
    Undef

## The class's `observedAttributes`, lower-cased.
fn Vm.ce_observed(mut self, ctor Value) List[str] ! Thrown
    v := get(ctor, "observedAttributes")?
    mut out := List[str]()
    if is_nullish(v)
        return out
    for x in iterate(v)?
        out.push(to_string(x)?.to_lower())
    out

## Run the element's reaction `method` if its class has one; an error is
## reported as an uncaught error, as Chrome reports it.
fn Vm.ce_call(mut self, id int, method str, args List[Value])
    if not ce_upgraded.contains(id)
        return
    if r := self.ce_invoke(node_value(id), method, args)
        r
    else err
        report_error(err)

fn Vm.ce_invoke(mut self, v Value, method str, args List[Value]) Value ! Thrown
    f := get(v, method)?
    if not is_callable(f)
        return Undef
    call(f, v, args)

## `id` and its descendants were put into the document: upgrade the custom
## elements among them, and tell the ones already upgraded.
pub fn Vm.ce_connected(mut self, id int)
    mut ids := [id]
    ids.extend(elements_under(id))
    for e in ids
        if ce_upgraded.contains(e)
            self.ce_call(e, "connectedCallback", [])
        else
            self.ce_upgrade(e)

## `id` and its descendants left the document.
pub fn Vm.ce_disconnected(mut self, id int)
    mut ids := [id]
    ids.extend(elements_under(id))
    for e in ids
        if ce_upgraded.contains(e)
            self.ce_call(e, "disconnectedCallback", [])

## An attribute of upgraded element `id` changed from `old` to `fresh`
## (none for absent).
pub fn Vm.ce_attr_changed(mut self, id int, name str, old str?, fresh str?)
    if not ce_upgraded.contains(id)
        return
    ctor := self.ce_definition(dom[id].tag) else return
    if r := self.ce_attr_reaction(id, ctor, name, old, fresh)
        r
    else err
        report_error(err)

fn Vm.ce_attr_reaction(mut self, id int, ctor Value, name str, old str?, fresh str?) Value ! Thrown
    if not self.ce_observed(ctor)?.contains(name)
        return Undef
    mut before := Value.Null
    if o := old
        before = Value.Str(o)
    mut after := Value.Null
    if f := fresh
        after = Value.Str(f)
    self.ce_call(id, "attributeChangedCallback", [Value.Str(name), before, after])
    Undef

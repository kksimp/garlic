## AV1 inverse transforms (spec 7.13), written from dav1d's `itx_1d.c` and `itx_tmpl.c`
## (BSD-2-Clause, VideoLAN): the integer butterflies are bit-exact with it. The 1-D
## functions are a mechanical translation of the C and
## work in place on `c[b + k * s]`; the DCT recursion takes the even half at stride `2 * s`.

fn av1c(v int, lo int, hi int) int
    if v < lo
        return lo
    if v > hi
        return hi
    v

fn av1_dct4(mut c List[int], b int, s int, lo int, hi int, t64 bool)
    mut t0 := 0
    mut t1 := 0
    mut t2 := 0
    mut t3 := 0
    in0 := c[b]
    in1 := c[b + 1 * s]
    if t64
        t1 = (in0 * 181 + 128).shr(8)
        t0 = t1
        t2 = (in1 * 1567 + 2048).shr(12)
        t3 = (in1 * 3784 + 2048).shr(12)
    else
        in2 := c[b + 2 * s]
        in3 := c[b + 3 * s]
        t0 = ((in0 + in2) * 181 + 128).shr(8)
        t1 = ((in0 - in2) * 181 + 128).shr(8)
        t2 = (in1 * 1567 - in3 * (3784 - 4096) + 2048).shr(12) - in3
        t3 = (in1 * (3784 - 4096) + in3 * 1567 + 2048).shr(12) + in1
    c[b] = av1c(t0 + t3, lo, hi)
    c[b + 1 * s] = av1c(t1 + t2, lo, hi)
    c[b + 2 * s] = av1c(t1 - t2, lo, hi)
    c[b + 3 * s] = av1c(t0 - t3, lo, hi)

fn av1_dct8(mut c List[int], b int, s int, lo int, hi int, t64 bool)
    mut t4a := 0
    mut t5a := 0
    mut t6a := 0
    mut t7a := 0
    av1_dct4(mut c, b, s * 2, lo, hi, t64)
    in1 := c[b + 1 * s]
    in3 := c[b + 3 * s]
    if t64
        t4a = (in1 * 799 + 2048).shr(12)
        t5a = (in3 * (-2276) + 2048).shr(12)
        t6a = (in3 * 3406 + 2048).shr(12)
        t7a = (in1 * 4017 + 2048).shr(12)
    else
        in5 := c[b + 5 * s]
        in7 := c[b + 7 * s]
        t4a = (in1 * 799 - in7 * (4017 - 4096) + 2048).shr(12) - in7
        t5a = (in5 * 1703 - in3 * 1138 + 1024).shr(11)
        t6a = (in5 * 1138 + in3 * 1703 + 1024).shr(11)
        t7a = (in1 * (4017 - 4096) + in7 * 799 + 2048).shr(12) + in1
    t4 := av1c(t4a + t5a, lo, hi)
    t5a = av1c(t4a - t5a, lo, hi)
    t7 := av1c(t7a + t6a, lo, hi)
    t6a = av1c(t7a - t6a, lo, hi)
    t5 := ((t6a - t5a) * 181 + 128).shr(8)
    t6 := ((t6a + t5a) * 181 + 128).shr(8)
    t0 := c[b]
    t1 := c[b + 2 * s]
    t2 := c[b + 4 * s]
    t3 := c[b + 6 * s]
    c[b] = av1c(t0 + t7, lo, hi)
    c[b + 1 * s] = av1c(t1 + t6, lo, hi)
    c[b + 2 * s] = av1c(t2 + t5, lo, hi)
    c[b + 3 * s] = av1c(t3 + t4, lo, hi)
    c[b + 4 * s] = av1c(t3 - t4, lo, hi)
    c[b + 5 * s] = av1c(t2 - t5, lo, hi)
    c[b + 6 * s] = av1c(t1 - t6, lo, hi)
    c[b + 7 * s] = av1c(t0 - t7, lo, hi)

fn av1_dct16(mut c List[int], b int, s int, lo int, hi int, t64 bool)
    mut t9 := 0
    mut t10 := 0
    mut t11 := 0
    mut t12 := 0
    mut t13 := 0
    mut t14 := 0
    mut t8a := 0
    mut t9a := 0
    mut t10a := 0
    mut t11a := 0
    mut t12a := 0
    mut t13a := 0
    mut t14a := 0
    mut t15a := 0
    av1_dct8(mut c, b, s * 2, lo, hi, t64)
    in1 := c[b + 1 * s]
    in3 := c[b + 3 * s]
    in5 := c[b + 5 * s]
    in7 := c[b + 7 * s]
    if t64
        t8a = (in1 * 401 + 2048).shr(12)
        t9a = (in7 * (-2598) + 2048).shr(12)
        t10a = (in5 * 1931 + 2048).shr(12)
        t11a = (in3 * (-1189) + 2048).shr(12)
        t12a = (in3 * 3920 + 2048).shr(12)
        t13a = (in5 * 3612 + 2048).shr(12)
        t14a = (in7 * 3166 + 2048).shr(12)
        t15a = (in1 * 4076 + 2048).shr(12)
    else
        in9 := c[b + 9 * s]
        in11 := c[b + 11 * s]
        in13 := c[b + 13 * s]
        in15 := c[b + 15 * s]
        t8a = (in1 * 401 - in15 * (4076 - 4096) + 2048).shr(12) - in15
        t9a = (in9 * 1583 - in7 * 1299 + 1024).shr(11)
        t10a = (in5 * 1931 - in11 * (3612 - 4096) + 2048).shr(12) - in11
        t11a = (in13 * (3920 - 4096) - in3 * 1189 + 2048).shr(12) + in13
        t12a = (in13 * 1189 + in3 * (3920 - 4096) + 2048).shr(12) + in3
        t13a = (in5 * (3612 - 4096) + in11 * 1931 + 2048).shr(12) + in5
        t14a = (in9 * 1299 + in7 * 1583 + 1024).shr(11)
        t15a = (in1 * (4076 - 4096) + in15 * 401 + 2048).shr(12) + in1
    t8 := av1c(t8a + t9a, lo, hi)
    t9 = av1c(t8a - t9a, lo, hi)
    t10 = av1c(t11a - t10a, lo, hi)
    t11 = av1c(t11a + t10a, lo, hi)
    t12 = av1c(t12a + t13a, lo, hi)
    t13 = av1c(t12a - t13a, lo, hi)
    t14 = av1c(t15a - t14a, lo, hi)
    t15 := av1c(t15a + t14a, lo, hi)
    t9a = (t14 * 1567 - t9 * (3784 - 4096) + 2048).shr(12) - t9
    t14a = (t14 * (3784 - 4096) + t9 * 1567 + 2048).shr(12) + t14
    t10a = (-(t13 * (3784 - 4096) + t10 * 1567) + 2048).shr(12) - t13
    t13a = (t13 * 1567 - t10 * (3784 - 4096) + 2048).shr(12) - t10
    t8a = av1c(t8 + t11, lo, hi)
    t9 = av1c(t9a + t10a, lo, hi)
    t10 = av1c(t9a - t10a, lo, hi)
    t11a = av1c(t8 - t11, lo, hi)
    t12a = av1c(t15 - t12, lo, hi)
    t13 = av1c(t14a - t13a, lo, hi)
    t14 = av1c(t14a + t13a, lo, hi)
    t15a = av1c(t15 + t12, lo, hi)
    t10a = ((t13 - t10) * 181 + 128).shr(8)
    t13a = ((t13 + t10) * 181 + 128).shr(8)
    t11 = ((t12a - t11a) * 181 + 128).shr(8)
    t12 = ((t12a + t11a) * 181 + 128).shr(8)
    t0 := c[b]
    t1 := c[b + 2 * s]
    t2 := c[b + 4 * s]
    t3 := c[b + 6 * s]
    t4 := c[b + 8 * s]
    t5 := c[b + 10 * s]
    t6 := c[b + 12 * s]
    t7 := c[b + 14 * s]
    c[b] = av1c(t0 + t15a, lo, hi)
    c[b + 1 * s] = av1c(t1 + t14, lo, hi)
    c[b + 2 * s] = av1c(t2 + t13a, lo, hi)
    c[b + 3 * s] = av1c(t3 + t12, lo, hi)
    c[b + 4 * s] = av1c(t4 + t11, lo, hi)
    c[b + 5 * s] = av1c(t5 + t10a, lo, hi)
    c[b + 6 * s] = av1c(t6 + t9, lo, hi)
    c[b + 7 * s] = av1c(t7 + t8a, lo, hi)
    c[b + 8 * s] = av1c(t7 - t8a, lo, hi)
    c[b + 9 * s] = av1c(t6 - t9, lo, hi)
    c[b + 10 * s] = av1c(t5 - t10a, lo, hi)
    c[b + 11 * s] = av1c(t4 - t11, lo, hi)
    c[b + 12 * s] = av1c(t3 - t12, lo, hi)
    c[b + 13 * s] = av1c(t2 - t13a, lo, hi)
    c[b + 14 * s] = av1c(t1 - t14, lo, hi)
    c[b + 15 * s] = av1c(t0 - t15a, lo, hi)

fn av1_dct32(mut c List[int], b int, s int, lo int, hi int, t64 bool)
    mut t16 := 0
    mut t17 := 0
    mut t18 := 0
    mut t19 := 0
    mut t20 := 0
    mut t21 := 0
    mut t22 := 0
    mut t23 := 0
    mut t24 := 0
    mut t25 := 0
    mut t26 := 0
    mut t27 := 0
    mut t28 := 0
    mut t29 := 0
    mut t30 := 0
    mut t31 := 0
    mut t16a := 0
    mut t17a := 0
    mut t18a := 0
    mut t19a := 0
    mut t20a := 0
    mut t21a := 0
    mut t22a := 0
    mut t23a := 0
    mut t24a := 0
    mut t25a := 0
    mut t26a := 0
    mut t27a := 0
    mut t28a := 0
    mut t29a := 0
    mut t30a := 0
    mut t31a := 0
    av1_dct16(mut c, b, s * 2, lo, hi, t64)
    in1 := c[b + 1 * s]
    in3 := c[b + 3 * s]
    in5 := c[b + 5 * s]
    in7 := c[b + 7 * s]
    in9 := c[b + 9 * s]
    in11 := c[b + 11 * s]
    in13 := c[b + 13 * s]
    in15 := c[b + 15 * s]
    if t64
        t16a = (in1 * 201 + 2048).shr(12)
        t17a = (in15 * (-2751) + 2048).shr(12)
        t18a = (in9 * 1751 + 2048).shr(12)
        t19a = (in7 * (-1380) + 2048).shr(12)
        t20a = (in5 * 995 + 2048).shr(12)
        t21a = (in11 * (-2106) + 2048).shr(12)
        t22a = (in13 * 2440 + 2048).shr(12)
        t23a = (in3 * (-601) + 2048).shr(12)
        t24a = (in3 * 4052 + 2048).shr(12)
        t25a = (in13 * 3290 + 2048).shr(12)
        t26a = (in11 * 3513 + 2048).shr(12)
        t27a = (in5 * 3973 + 2048).shr(12)
        t28a = (in7 * 3857 + 2048).shr(12)
        t29a = (in9 * 3703 + 2048).shr(12)
        t30a = (in15 * 3035 + 2048).shr(12)
        t31a = (in1 * 4091 + 2048).shr(12)
    else
        in17 := c[b + 17 * s]
        in19 := c[b + 19 * s]
        in21 := c[b + 21 * s]
        in23 := c[b + 23 * s]
        in25 := c[b + 25 * s]
        in27 := c[b + 27 * s]
        in29 := c[b + 29 * s]
        in31 := c[b + 31 * s]
        t16a = (in1 * 201 - in31 * (4091 - 4096) + 2048).shr(12) - in31
        t17a = (in17 * (3035 - 4096) - in15 * 2751 + 2048).shr(12) + in17
        t18a = (in9 * 1751 - in23 * (3703 - 4096) + 2048).shr(12) - in23
        t19a = (in25 * (3857 - 4096) - in7 * 1380 + 2048).shr(12) + in25
        t20a = (in5 * 995 - in27 * (3973 - 4096) + 2048).shr(12) - in27
        t21a = (in21 * (3513 - 4096) - in11 * 2106 + 2048).shr(12) + in21
        t22a = (in13 * 1220 - in19 * 1645 + 1024).shr(11)
        t23a = (in29 * (4052 - 4096) - in3 * 601 + 2048).shr(12) + in29
        t24a = (in29 * 601 + in3 * (4052 - 4096) + 2048).shr(12) + in3
        t25a = (in13 * 1645 + in19 * 1220 + 1024).shr(11)
        t26a = (in21 * 2106 + in11 * (3513 - 4096) + 2048).shr(12) + in11
        t27a = (in5 * (3973 - 4096) + in27 * 995 + 2048).shr(12) + in5
        t28a = (in25 * 1380 + in7 * (3857 - 4096) + 2048).shr(12) + in7
        t29a = (in9 * (3703 - 4096) + in23 * 1751 + 2048).shr(12) + in9
        t30a = (in17 * 2751 + in15 * (3035 - 4096) + 2048).shr(12) + in15
        t31a = (in1 * (4091 - 4096) + in31 * 201 + 2048).shr(12) + in1
    t16 = av1c(t16a + t17a, lo, hi)
    t17 = av1c(t16a - t17a, lo, hi)
    t18 = av1c(t19a - t18a, lo, hi)
    t19 = av1c(t19a + t18a, lo, hi)
    t20 = av1c(t20a + t21a, lo, hi)
    t21 = av1c(t20a - t21a, lo, hi)
    t22 = av1c(t23a - t22a, lo, hi)
    t23 = av1c(t23a + t22a, lo, hi)
    t24 = av1c(t24a + t25a, lo, hi)
    t25 = av1c(t24a - t25a, lo, hi)
    t26 = av1c(t27a - t26a, lo, hi)
    t27 = av1c(t27a + t26a, lo, hi)
    t28 = av1c(t28a + t29a, lo, hi)
    t29 = av1c(t28a - t29a, lo, hi)
    t30 = av1c(t31a - t30a, lo, hi)
    t31 = av1c(t31a + t30a, lo, hi)
    t17a = (t30 * 799 - t17 * (4017 - 4096) + 2048).shr(12) - t17
    t30a = (t30 * (4017 - 4096) + t17 * 799 + 2048).shr(12) + t30
    t18a = (-(t29 * (4017 - 4096) + t18 * 799) + 2048).shr(12) - t29
    t29a = (t29 * 799 - t18 * (4017 - 4096) + 2048).shr(12) - t18
    t21a = (t26 * 1703 - t21 * 1138 + 1024).shr(11)
    t26a = (t26 * 1138 + t21 * 1703 + 1024).shr(11)
    t22a = (-(t25 * 1138 + t22 * 1703) + 1024).shr(11)
    t25a = (t25 * 1703 - t22 * 1138 + 1024).shr(11)
    t16a = av1c(t16 + t19, lo, hi)
    t17 = av1c(t17a + t18a, lo, hi)
    t18 = av1c(t17a - t18a, lo, hi)
    t19a = av1c(t16 - t19, lo, hi)
    t20a = av1c(t23 - t20, lo, hi)
    t21 = av1c(t22a - t21a, lo, hi)
    t22 = av1c(t22a + t21a, lo, hi)
    t23a = av1c(t23 + t20, lo, hi)
    t24a = av1c(t24 + t27, lo, hi)
    t25 = av1c(t25a + t26a, lo, hi)
    t26 = av1c(t25a - t26a, lo, hi)
    t27a = av1c(t24 - t27, lo, hi)
    t28a = av1c(t31 - t28, lo, hi)
    t29 = av1c(t30a - t29a, lo, hi)
    t30 = av1c(t30a + t29a, lo, hi)
    t31a = av1c(t31 + t28, lo, hi)
    t18a = (t29 * 1567 - t18 * (3784 - 4096) + 2048).shr(12) - t18
    t29a = (t29 * (3784 - 4096) + t18 * 1567 + 2048).shr(12) + t29
    t19 = (t28a * 1567 - t19a * (3784 - 4096) + 2048).shr(12) - t19a
    t28 = (t28a * (3784 - 4096) + t19a * 1567 + 2048).shr(12) + t28a
    t20 = (-(t27a * (3784 - 4096) + t20a * 1567) + 2048).shr(12) - t27a
    t27 = (t27a * 1567 - t20a * (3784 - 4096) + 2048).shr(12) - t20a
    t21a = (-(t26 * (3784 - 4096) + t21 * 1567) + 2048).shr(12) - t26
    t26a = (t26 * 1567 - t21 * (3784 - 4096) + 2048).shr(12) - t21
    t16 = av1c(t16a + t23a, lo, hi)
    t17a = av1c(t17 + t22, lo, hi)
    t18 = av1c(t18a + t21a, lo, hi)
    t19a = av1c(t19 + t20, lo, hi)
    t20a = av1c(t19 - t20, lo, hi)
    t21 = av1c(t18a - t21a, lo, hi)
    t22a = av1c(t17 - t22, lo, hi)
    t23 = av1c(t16a - t23a, lo, hi)
    t24 = av1c(t31a - t24a, lo, hi)
    t25a = av1c(t30 - t25, lo, hi)
    t26 = av1c(t29a - t26a, lo, hi)
    t27a = av1c(t28 - t27, lo, hi)
    t28a = av1c(t28 + t27, lo, hi)
    t29 = av1c(t29a + t26a, lo, hi)
    t30a = av1c(t30 + t25, lo, hi)
    t31 = av1c(t31a + t24a, lo, hi)
    t20 = ((t27a - t20a) * 181 + 128).shr(8)
    t27 = ((t27a + t20a) * 181 + 128).shr(8)
    t21a = ((t26 - t21) * 181 + 128).shr(8)
    t26a = ((t26 + t21) * 181 + 128).shr(8)
    t22 = ((t25a - t22a) * 181 + 128).shr(8)
    t25 = ((t25a + t22a) * 181 + 128).shr(8)
    t23a = ((t24 - t23) * 181 + 128).shr(8)
    t24a = ((t24 + t23) * 181 + 128).shr(8)
    t0 := c[b]
    t1 := c[b + 2 * s]
    t2 := c[b + 4 * s]
    t3 := c[b + 6 * s]
    t4 := c[b + 8 * s]
    t5 := c[b + 10 * s]
    t6 := c[b + 12 * s]
    t7 := c[b + 14 * s]
    t8 := c[b + 16 * s]
    t9 := c[b + 18 * s]
    t10 := c[b + 20 * s]
    t11 := c[b + 22 * s]
    t12 := c[b + 24 * s]
    t13 := c[b + 26 * s]
    t14 := c[b + 28 * s]
    t15 := c[b + 30 * s]
    c[b] = av1c(t0 + t31, lo, hi)
    c[b + 1 * s] = av1c(t1 + t30a, lo, hi)
    c[b + 2 * s] = av1c(t2 + t29, lo, hi)
    c[b + 3 * s] = av1c(t3 + t28a, lo, hi)
    c[b + 4 * s] = av1c(t4 + t27, lo, hi)
    c[b + 5 * s] = av1c(t5 + t26a, lo, hi)
    c[b + 6 * s] = av1c(t6 + t25, lo, hi)
    c[b + 7 * s] = av1c(t7 + t24a, lo, hi)
    c[b + 8 * s] = av1c(t8 + t23a, lo, hi)
    c[b + 9 * s] = av1c(t9 + t22, lo, hi)
    c[b + 10 * s] = av1c(t10 + t21a, lo, hi)
    c[b + 11 * s] = av1c(t11 + t20, lo, hi)
    c[b + 12 * s] = av1c(t12 + t19a, lo, hi)
    c[b + 13 * s] = av1c(t13 + t18, lo, hi)
    c[b + 14 * s] = av1c(t14 + t17a, lo, hi)
    c[b + 15 * s] = av1c(t15 + t16, lo, hi)
    c[b + 16 * s] = av1c(t15 - t16, lo, hi)
    c[b + 17 * s] = av1c(t14 - t17a, lo, hi)
    c[b + 18 * s] = av1c(t13 - t18, lo, hi)
    c[b + 19 * s] = av1c(t12 - t19a, lo, hi)
    c[b + 20 * s] = av1c(t11 - t20, lo, hi)
    c[b + 21 * s] = av1c(t10 - t21a, lo, hi)
    c[b + 22 * s] = av1c(t9 - t22, lo, hi)
    c[b + 23 * s] = av1c(t8 - t23a, lo, hi)
    c[b + 24 * s] = av1c(t7 - t24a, lo, hi)
    c[b + 25 * s] = av1c(t6 - t25, lo, hi)
    c[b + 26 * s] = av1c(t5 - t26a, lo, hi)
    c[b + 27 * s] = av1c(t4 - t27, lo, hi)
    c[b + 28 * s] = av1c(t3 - t28a, lo, hi)
    c[b + 29 * s] = av1c(t2 - t29, lo, hi)
    c[b + 30 * s] = av1c(t1 - t30a, lo, hi)
    c[b + 31 * s] = av1c(t0 - t31, lo, hi)

fn av1_dct64(mut c List[int], b int, s int, lo int, hi int)
    mut t32 := 0
    mut t33 := 0

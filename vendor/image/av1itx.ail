    av1_dct32(mut c, b, s * 2, lo, hi, true)
    in1 := c[b + 1 * s]
    in3 := c[b + 3 * s]
    in5 := c[b + 5 * s]
    in7 := c[b + 7 * s]
    in9 := c[b + 9 * s]
    in11 := c[b + 11 * s]
    in13 := c[b + 13 * s]
    in15 := c[b + 15 * s]

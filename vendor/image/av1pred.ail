## AV1 intra prediction (spec 7.11.2), written from dav1d's `ipred_tmpl.c` and
## `ipred_prepare_tmpl.c` (BSD-2-Clause, VideoLAN) so the output matches it bit for
## bit. `av1_pred` gathers the edge pixels from the already reconstructed plane,
## picks the predictor and writes the block; palette and intrabc are not here.
## Modes use dav1d's numbering: DC 0, V 1, H 2, D45 3, D135 4, D113 5, D157 6,
## D203 7, D67 8, SMOOTH 9, SMOOTH_V 10, SMOOTH_H 11, PAETH 12, CFL 13. The
## internal modes DC_128 14, TOP_DC 15, LEFT_DC 16, Z1 17, Z2 18, Z3 19 and
## FILTER 20 come from the edge availability and the angle.

## What the caller knows about a block. `angle` is the angle delta -3..3;
## `have_*` say whether that neighbour is inside the tile and already decoded
## (top-right and bottom-left availability as the spec's tables give them);
## `filt` is the filter-intra mode 0..4 or -1; `smooth_nb` is set when an above
## or left neighbour uses a smooth mode; `edge_filter` is the sequence header's
## enable_intra_edge_filter; `ac` and `alpha` are the CFL luma AC values (from
## `av1_cfl_ac`, `w * h` entries) and the signed scale.
pub struct PredCtx
    pub angle int
    pub have_left bool
    pub have_top bool
    pub have_topright bool
    pub have_bottomleft bool
    pub filt int
    pub smooth_nb bool
    pub edge_filter bool
    pub alpha int
    pub ac List[int]
    pub bd int

pub fn av1_predctx(bd int) PredCtx
    PredCtx(
        angle: 0,
        have_left: false,
        have_top: false,
        have_topright: false,
        have_bottomleft: false,
        filt: -1,
        smooth_nb: false,
        edge_filter: false,
        alpha: 0,
        ac: [],
        bd: bd,
    )

## Which edges each mode reads: 1 left, 2 top, 4 top-left, 8 top-right, 16 bottom-left.
AV1_PRED_EDGES := [3, 2, 1, 0, 0, 0, 0, 0, 0, 3, 3, 3, 7, 0, 0, 2, 1, 14, 7, 21, 7]

## Base angle of the directional modes V..D67 (modes 1..8).
AV1_PRED_ANGLE := [90, 180, 45, 135, 113, 157, 203, 67]

fn av1_abs(v int) int
    if v < 0
        return 0 - v
    v

fn av1_min(a int, b int) int
    if a < b
        return a
    b

fn av1_max(a int, b int) int
    if a > b
        return a
    b

fn av1_ctz(n int) int
    mut k := 0
    mut v := n
    while v.bit_and(1) == 0 and k < 30
        v = v.shr(1)
        k += 1
    k

fn av1_px(v int, bd int) int
    top := (1).shl(bd) - 1
    if v < 0
        return 0
    if v > top
        return top
    v

## The mean of the top row and left column for the DC family (`m` 0, 14, 15, 16).
fn av1_dc_of(e List[int], t int, w int, h int, m int, bd int) int
    if m == 14
        return (1).shl(bd - 1)
    if m == 15
        mut s := w.shr(1)
        for i in 0..w
            s += e[t + 1 + i]
        return s.shr(av1_ctz(w))
    if m == 16
        mut s := h.shr(1)
        for i in 0..h
            s += e[t - 1 - i]
        return s.shr(av1_ctz(h))
    mut s := (w + h).shr(1)
    for i in 0..w
        s += e[t + 1 + i]
    for i in 0..h
        s += e[t - 1 - i]
    s = s.shr(av1_ctz(w + h))
    if w != h
        mul := if w > h * 2
            or h > w * 2 then (if bd == 8 then 13108 else 26215) else (if bd == 8 then 21846 else 43691)
        s = (s * mul).shr(if bd == 8 then 16 else 17)
    s

fn av1_strength(wh int, angle int, sm bool) int
    if sm
        if wh <= 8
            if angle >= 64
                return 2
            if angle >= 40
                return 1
        elif wh <= 16
            if angle >= 48
                return 2
            if angle >= 20
                return 1
        elif wh <= 24
            if angle >= 4
                return 3
        else
            return 3
    else
        if wh <= 8
            if angle >= 56
                return 1
        elif wh <= 16
            if angle >= 40
                return 1
        elif wh <= 24
            if angle >= 32
                return 3
            if angle >= 16
                return 2
            if angle >= 8
                return 1
        elif wh <= 32
            if angle >= 32
                return 3
            if angle >= 4
                return 2
            return 1
        else
            return 3
    0

fn av1_upsample_ok(wh int, angle int, sm bool) bool
    lim := if sm then 8 else 16
    angle < 40 and wh <= lim

## The 5-tap smoothing of an edge: `out[ob + i]` from `src[sb + clip(i - 2 + j)]`.
fn av1_filter_edge(
    mut out List[int],
    ob int,
    sz int,
    lim_from int,
    lim_to int,
    src List[int],
    sb int,
    fr int,
    en int,
    strength int,
)
    k0 := [0, 0, 2]
    k1 := [4, 5, 4]
    k2 := [8, 6, 4]
    mut i := 0
    while i < av1_min(sz, lim_from)
        out[ob + i] = src[sb + av1_max(fr, av1_min(i, en - 1))]
        i += 1
    while i < av1_min(lim_to, sz)
        mut s := 0
        for j in 0..5
            q := src[sb + av1_max(fr, av1_min(i - 2 + j, en - 1))]
            kk := if j == 0
                or j == 4 then k0[strength - 1] else (if j == 2 then k2[strength - 1] else k1[strength - 1])
            s += q * kk
        out[ob + i] = (s + 8).shr(4)
        i += 1
    while i < sz
        out[ob + i] = src[sb + av1_max(fr, av1_min(i, en - 1))]
        i += 1

## Doubles the edge resolution with the (-1, 9, 9, -1) filter.
fn av1_upsample_edge(
    mut out List[int],
    ob int,
    hsz int,
    src List[int],
    sb int,
    fr int,
    en int,
    bd int,
)
    mut i := 0
    while i < hsz - 1
        out[ob + i * 2] = src[sb + av1_max(fr, av1_min(i, en - 1))]
        a := src[sb + av1_max(fr, av1_min(i - 1, en - 1))]
        b := src[sb + av1_max(fr, av1_min(i, en - 1))]
        c := src[sb + av1_max(fr, av1_min(i + 1, en - 1))]
        d := src[sb + av1_max(fr, av1_min(i + 2, en - 1))]
        out[ob + i * 2 + 1] = av1_px((9 * (b + c) - a - d + 8).shr(4), bd)
        i += 1
    out[ob + i * 2] = src[sb + av1_max(fr, av1_min(i, en - 1))]

## Directional prediction between 0 and 90 degrees (from the top edge).
fn av1_z1(mut d List[int], e List[int], t int, w int, h int, ang int, bd int)
    sm := ang.shr(9).bit_and(1) == 1
    filt := ang.shr(10) == 1
    a := ang.bit_and(511)
    mut dx := AV1_DR_DERIV[a.shr(1)]
    mut tp := [0 for _ in 0..160]
    mut src := e
    mut sb := t + 1
    mut max_base := 0
    up := filt and av1_upsample_ok(w + h, 90 - a, sm)
    if up
        av1_upsample_edge(mut tp, 0, w + h, e, t + 1, -1, w + av1_min(w, h), bd)
        src = tp
        sb = 0
        max_base = 2 * (w + h) - 2
        dx = dx.shl(1)
    else
        st := if filt then av1_strength(w + h, 90 - a, sm) else 0
        if st > 0
            av1_filter_edge(mut tp, 0, w + h, 0, w + h, e, t + 1, -1, w + av1_min(w, h), st)
            src = tp
            sb = 0
            max_base = w + h - 1
        else
            max_base = w + av1_min(w, h) - 1
    inc := if up then 2 else 1
    mut xpos := dx
    for y in 0..h
        frac := xpos.bit_and(62)
        mut base := xpos.shr(6)
        for x in 0..w
            if base < max_base
                v := src[sb + base] * (64 - frac) + src[sb + base + 1] * frac
                d[y * w + x] = (v + 32).shr(6)
            else
                for x2 in x..w
                    d[y * w + x2] = src[sb + max_base]
                break
            base += inc
        xpos += dx

## Directional prediction between 90 and 180 degrees (both edges and the corner).
fn av1_z2(mut d List[int], e List[int], t int, w int, h int, ang int, maxw int, maxh int, bd int)
    sm := ang.shr(9).bit_and(1) == 1
    filt := ang.shr(10) == 1
    a := ang.bit_and(511)
    mut dy := AV1_DR_DERIV[(a - 90).shr(1)]
    mut dx := AV1_DR_DERIV[(180 - a).shr(1)]
    ul := if filt and av1_upsample_ok(w + h, 180 - a, sm) then 1 else 0
    ua := if filt and av1_upsample_ok(w + h, a - 90, sm) then 1 else 0
    z := 64
    mut ed := [0 for _ in 0..129]
    if ua == 1
        av1_upsample_edge(mut ed, z, w + 1, e, t, 0, w + 1, bd)
        dx = dx.shl(1)
    else
        st := if filt then av1_strength(w + h, a - 90, sm) else 0
        if st > 0
            av1_filter_edge(mut ed, z + 1, w, 0, maxw, e, t + 1, -1, w, st)
        else
            for i in 0..w
                ed[z + 1 + i] = e[t + 1 + i]
    if ul == 1
        av1_upsample_edge(mut ed, z - h * 2, h + 1, e, t - h, 0, h + 1, bd)
        dy = dy.shl(1)
    else
        st := if filt then av1_strength(w + h, 180 - a, sm) else 0
        if st > 0
            av1_filter_edge(mut ed, z - h, h, h - maxh, h, e, t - h, 0, h + 1, st)
        else
            for i in 0..h
                ed[z - h + i] = e[t - h + i]
    ed[z] = e[t]
    lb := z - (1 + ul)
    mut xpos := (1 + ua).shl(6) - dx
    for y in 0..h
        mut base_x := xpos.shr(6)
        frac_x := xpos.bit_and(62)
        mut ypos := (y.shl(6 + ul)) - dy
        for x in 0..w
            mut v := 0
            if base_x >= 0
                v = ed[z + base_x] * (64 - frac_x) + ed[z + base_x + 1] * frac_x
            else
                base_y := ypos.shr(6)
                frac_y := ypos.bit_and(62)
                v = ed[lb - base_y] * (64 - frac_y) + ed[lb - (base_y + 1)] * frac_y
            d[y * w + x] = (v + 32).shr(6)
            base_x += 1 + ua
            ypos -= dy
        xpos -= dx

## Directional prediction past 180 degrees (from the left edge).
fn av1_z3(mut d List[int], e List[int], t int, w int, h int, ang int, bd int)
    sm := ang.shr(9).bit_and(1) == 1
    filt := ang.shr(10) == 1
    a := ang.bit_and(511)
    mut dy := AV1_DR_DERIV[(270 - a).shr(1)]
    mut lo := [0 for _ in 0..160]
    mut src := e
    mut lb := t - 1
    mut max_base := 0
    up := filt and av1_upsample_ok(w + h, a - 180, sm)
    if up
        av1_upsample_edge(mut lo, 0, w + h, e, t - (w + h), av1_max(w - h, 0), w + h + 1, bd)
        src = lo
        lb = 2 * (w + h) - 2
        max_base = 2 * (w + h) - 2
        dy = dy.shl(1)
    else
        st := if filt then av1_strength(w + h, a - 180, sm) else 0
        if st > 0
            av1_filter_edge(
                mut lo,
                0,
                w + h,
                0,
                w + h,
                e,
                t - (w + h),
                av1_max(w - h, 0),
                w + h + 1,
                st,
            )
            src = lo
            lb = w + h - 1
            max_base = w + h - 1
        else
            max_base = h + av1_min(w, h) - 1
    inc := if up then 2 else 1
    mut ypos := dy
    for x in 0..w
        frac := ypos.bit_and(62)
        mut base := ypos.shr(6)
        for y in 0..h
            if base < max_base
                v := src[lb - base] * (64 - frac) + src[lb - (base + 1)] * frac
                d[y * w + x] = (v + 32).shr(6)
            else
                for y2 in y..h
                    d[y2 * w + x] = src[lb - max_base]
                break
            base += inc
        ypos += dy

## Filter intra: 4x2 cells predicted from their seven neighbours (up to 32x32).
fn av1_filter_pred(mut d List[int], e List[int], t int, w int, h int, fm int, bd int)
    mut y := 0
    while y < h
        mut x := 0
        while x < w
            mut p := [0 for _ in 0..7]
            if x == 0
                p[0] = e[t - y]
                p[5] = e[t - y - 1]
                p[6] = e[t - y - 2]
            else
                p[0] = if y == 0 then e[t + x] else d[(y - 1) * w + x - 1]
                p[5] = d[y * w + x - 1]
                p[6] = d[(y + 1) * w + x - 1]
            for k in 0..4
                p[1 + k] = if y == 0 then e[t + 1 + x + k] else d[(y - 1) * w + x + k]
            for o in 0..8
                mut acc := 0
                for k in 0..7
                    acc += AV1_FILTER_INTRA_TAPS[(fm * 8 + o) * 7 + k] * p[k]
                d[(y + o.shr(2)) * w + x + o.bit_and(3)] = av1_px((acc + 8).shr(4), bd)
            x += 4
        y += 2

## The CFL luma AC contribution for a `cw` by `ch` chroma block whose co-located
## luma starts at (lx, ly); `ssx`/`ssy` are the chroma subsampling shifts and
## `wpad`/`hpad` the number of 4-sample columns/rows past the visible luma edge.
pub fn av1_cfl_ac(
    luma Av1Plane,
    lx int,
    ly int,
    cw int,
    ch int,
    ssx int,
    ssy int,
    wpad int,
    hpad int,
) List[int]
    mut ac := [0 for _ in 0..cw * ch]
    st := luma.stride
    mut y := 0
    while y < ch - 4 * hpad
        base := (ly + (y.shl(ssy))) * st + lx
        mut x := 0
        while x < cw - 4 * wpad
            mut s := luma.pix[base + x.shl(ssx)]
            if ssx == 1
                s += luma.pix[base + x * 2 + 1]
            if ssy == 1
                s += luma.pix[base + x.shl(ssx) + st]
                if ssx == 1
                    s += luma.pix[base + x * 2 + 1 + st]
            ac[y * cw + x] = s.shl(1 + (1 - ssy) + (1 - ssx))
            x += 1
        while x < cw
            ac[y * cw + x] = ac[y * cw + x - 1]
            x += 1
        y += 1
    while y < ch
        for x in 0..cw
            ac[y * cw + x] = ac[(y - 1) * cw + x]
        y += 1
    lg := av1_ctz(cw) + av1_ctz(ch)
    mut sum := (1).shl(lg).shr(1)
    for i in 0..cw * ch
        sum += ac[i]
    sum = sum.shr(lg)
    for i in 0..cw * ch
        ac[i] -= sum
    ac

## Predicts the `w` by `h` block at (x, y) of plane `p` from its reconstructed
## neighbours. `w` and `h` are multiples of 4, at most 64.
pub fn av1_pred(mut p Av1Plane, x int, y int, w int, h int, mode int, ctx PredCtx)
    bd := ctx.bd
    st := p.stride
    rows := p.pix.len() / st
    aw := (p.w + 3).shr(2).shl(2)
    ah := (p.h + 3).shr(2).shl(2)
    hl := ctx.have_left
    ht := ctx.have_top
    mut m := mode
    mut ang := 0
    if mode >= 1 and mode <= 8
        ang = AV1_PRED_ANGLE[mode - 1] + 3 * ctx.angle
        if ang <= 90
            m = if ang < 90 and ht then 17 else 1
        elif ang < 180
            m = 18
        else
            m = if ang > 180 and hl then 19 else 2
        if ctx.edge_filter
            ang += 1024
        if ctx.smooth_nb
            ang += 512
    elif mode == 0 or mode == 12 or mode == 13
        if hl and ht
            m = if mode == 12 then 12 else 0
        elif hl
            m = if mode == 12 then 2 else 16
        elif ht
            m = if mode == 12 then 1 else 15
        else
            m = 14
        if mode == 0 and ctx.filt >= 0
            m = 20
    need := AV1_PRED_EDGES[m]
    ts := 192
    mut e := [0 for _ in 0..ts + 130]
    if need.bit_and(1) != 0
        if hl
            have := av1_min(h, ah - y)
            for i in 0..have
                e[ts - 1 - i] = p.pix[(y + i) * st + x - 1]
            for i in have..h
                e[ts - 1 - i] = e[ts - have]
        else
            v := if ht then p.pix[(y - 1) * st + x] else (1).shl(bd - 1) + 1
            for i in 0..h
                e[ts - 1 - i] = v
        if need.bit_and(16) != 0
            hbl := hl and ctx.have_bottomleft and y + h < ah
            if hbl
                have := av1_min(h, ah - y - h)
                for i in 0..have
                    e[ts - h - 1 - i] = p.pix[(y + h + i) * st + x - 1]
                for i in have..h
                    e[ts - h - 1 - i] = e[ts - h - have]
            else
                for i in 0..h
                    e[ts - h - 1 - i] = e[ts - h]
    if need.bit_and(2) != 0
        if ht
            have := av1_min(w, aw - x)
            for i in 0..have
                e[ts + 1 + i] = p.pix[(y - 1) * st + x + i]
            for i in have..w
                e[ts + 1 + i] = e[ts + have]
        else
            v := if hl then p.pix[y * st + x - 1] else (1).shl(bd - 1) - 1
            for i in 0..w
                e[ts + 1 + i] = v
        if need.bit_and(8) != 0
            htr := ht and ctx.have_topright and x + w < aw
            if htr
                have := av1_min(w, aw - x - w)
                for i in 0..have
                    e[ts + 1 + w + i] = p.pix[(y - 1) * st + x + w + i]
                for i in have..w
                    e[ts + 1 + w + i] = e[ts + w + have]
            else
                for i in 0..w
                    e[ts + 1 + w + i] = e[ts + w]
    if need.bit_and(4) != 0
        if hl
            e[ts] = if ht then p.pix[(y - 1) * st + x - 1] else p.pix[y * st + x - 1]
        else
            e[ts] = if ht then p.pix[(y - 1) * st + x] else (1).shl(bd - 1)
        if m == 18 and w.shr(2) + h.shr(2) >= 6 and ctx.edge_filter
            e[ts] = ((e[ts - 1] + e[ts + 1]) * 5 + e[ts] * 6 + 8).shr(4)
    mut d := [0 for _ in 0..w * h]
    if m == 0 or (m >= 14 and m <= 16)
        dc := av1_dc_of(e, ts, w, h, m, bd)
        if mode == 13
            for j in 0..h
                for i in 0..w
                    diff := ctx.alpha * ctx.ac[j * w + i]
                    r := (av1_abs(diff) + 32).shr(6)
                    d[j * w + i] = av1_px(dc + (if diff < 0 then 0 - r else r), bd)
        else
            for i in 0..w * h
                d[i] = dc
    elif m == 1
        for j in 0..h
            for i in 0..w
                d[j * w + i] = e[ts + 1 + i]
    elif m == 2
        for j in 0..h
            for i in 0..w
                d[j * w + i] = e[ts - 1 - j]
    elif m == 12
        tl := e[ts]
        for j in 0..h
            lf := e[ts - 1 - j]
            for i in 0..w
                tp := e[ts + 1 + i]
                base := lf + tp - tl
                ld := av1_abs(lf - base)
                td := av1_abs(tp - base)
                tld := av1_abs(tl - base)
                d[j * w + i] = if ld <= td and ld <= tld then lf else (if td <= tld then tp else tl)
    elif m >= 9 and m <= 11
        right := e[ts + w]
        bottom := e[ts - h]
        for j in 0..h
            wv := AV1_SM_WEIGHTS[h + j]
            for i in 0..w
                wh := AV1_SM_WEIGHTS[w + i]
                if m == 9
                    pr := wv * e[ts + 1 + i]
                        + (256 - wv) * bottom
                        + wh * e[ts - 1 - j]
                        + (256 - wh) * right
                    d[j * w + i] = (pr + 256).shr(9)
                elif m == 10
                    d[j * w + i] = (wv * e[ts + 1 + i] + (256 - wv) * bottom + 128).shr(8)
                else
                    d[j * w + i] = (wh * e[ts - 1 - j] + (256 - wh) * right + 128).shr(8)
    elif m == 17
        av1_z1(mut d, e, ts, w, h, ang, bd)
    elif m == 18
        av1_z2(mut d, e, ts, w, h, ang, av1_min(w, aw - x), av1_min(h, ah - y), bd)
    elif m == 19
        av1_z3(mut d, e, ts, w, h, ang, bd)
    else
        av1_filter_pred(mut d, e, ts, w, h, ctx.filt, bd)
    ww := av1_min(w, st - x)
    hh := av1_min(h, rows - y)
    for j in 0..hh
        for i in 0..ww
            p.pix[(y + j) * st + x + i] = d[j * w + i]

## One decoded AV1 plane: `pix` holds `h`-or-more rows of `stride` samples at the
## sequence bit depth. `w` and `h` are the visible size; the buffer is padded so a
## whole 64x64 block at the edge fits (the transforms and predictors drop writes
## outside it).
pub struct Av1Plane
    pub w int
    pub h int
    pub stride int
    pub pix List[int]

pub fn av1_plane(w int, h int, pad int) Av1Plane
    sw := (w + pad - 1) / pad * pad + 64
    sh := (h + pad - 1) / pad * pad + 64
    Av1Plane(w: w, h: h, stride: sw, pix: [0 for _ in 0..sw * sh])

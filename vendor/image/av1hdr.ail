## AV1 headers for still pictures (AV1 bitstream specification, section 5):
## OBU framing, the sequence header, and the key-frame header with its tile
## layout. Fields live in `Map[str, int]` tables (`Av1Hdr`); the tile decoder
## copies what it needs into locals. Only intra frames are supported.

## An MSB-first bit reader.
struct Gb
    data List[int]
    pos int

fn Gb.bit(mut self) int
    i := pos.shr(3)
    v := if i < data.len() then data[i].shr(7 - pos.bit_and(7)).bit_and(1) else 0
    pos += 1
    v

fn Gb.bits(mut self, n int) int
    mut v := 0
    for _ in 0..n
        v = v * 2 + bit()
    v

fn Gb.sbits(mut self, n int) int
    v := bits(n)
    if v >= 1.shl(n - 1)
        return v - 1.shl(n)
    v

## A flag, then a signed `n`-bit value when it is set (delta values).
fn Gb.opt_su(mut self, n int) int
    if bit() == 1
        return sbits(n + 1)
    0

fn Gb.leb(mut self) int
    mut v := 0
    for i in 0..8
        b := bits(8)
        v = v.bit_or(b.bit_and(127).shl(7 * i))
        if b < 128
            break
    v

fn Gb.uniform(mut self, n int) int
    mut w := 0
    mut x := n
    while x != 0
        x = x.shr(1)
        w += 1
    m := 1.shl(w) - n
    v := bits(w - 1)
    if v < m
        return v
    extra := bit()
    (v.shl(1)) - m + extra

fn Gb.align(mut self)
    pos = (pos + 7).shr(3).shl(3)

fn av1_tile_log2(sz int, tgt int) int
    mut k := 0
    while sz.shl(k) < tgt
        k += 1
    k

## Everything a decoder needs from the headers of one still picture.
pub struct Av1Hdr
    pub s Map[str, int]
    pub f Map[str, int]
    pub col_start List[int]
    pub row_start List[int]
    pub seg_q List[int]
    pub seg_lf List[int]
    pub cdef_y List[int]
    pub cdef_uv List[int]
    pub tile_data List[List[int]]
    pub tile_rc List[List[int]]

fn av1_g(m Map[str, int], k str) int
    m.get(k) else 0

## Parses the sequence header payload at bit reader `g` into `s`.
fn av1_seq(mut g Gb) Map[str, int] ! ImageError
    mut s := Map[str, int]()
    prof := g.bits(3)
    s["profile"] = prof
    s["still"] = g.bit()
    reduced := g.bit()
    s["reduced"] = reduced
    mut dm_present := 0
    mut equal_pic := 0
    mut fpd_len := 0
    mut brd_len := 0
    mut op_idc := 0
    mut op_dm := 0
    if reduced == 1
        g.bits(5)
    else
        if g.bit() == 1
            g.bits(32)
            g.bits(32)
            equal_pic = g.bit()
            if equal_pic == 1
                # uvlc
                mut lz := 0
                while g.bit() == 0 and lz < 32
                    lz += 1
                g.bits(lz)
            dm_present = g.bit()
            if dm_present == 1
                edb := g.bits(5) + 1
                g.bits(32)
                brd_len = g.bits(5) + 1
                fpd_len = g.bits(5) + 1
                s["edb"] = edb
        disp := g.bit()
        nops := g.bits(5) + 1
        for i in 0..nops
            idc := g.bits(12)
            lvl := g.bits(3) + 2
            g.bits(2)
            if lvl > 3
                g.bit()
            mut dmp := 0
            if dm_present == 1
                dmp = g.bit()
                if dmp == 1
                    g.bits(s["edb"])
                    g.bits(s["edb"])
                    g.bit()
            if disp == 1
                if g.bit() == 1
                    g.bits(4)
            if i == 0
                op_idc = idc
                op_dm = dmp
    s["dm_present"] = dm_present
    s["equal_pic"] = equal_pic
    s["fpd_len"] = fpd_len
    s["brd_len"] = brd_len
    s["op_idc"] = op_idc
    s["op_dm"] = op_dm
    wbits := g.bits(4) + 1
    hbits := g.bits(4) + 1
    s["wbits"] = wbits
    s["hbits"] = hbits
    s["max_w"] = g.bits(wbits) + 1
    s["max_h"] = g.bits(hbits) + 1
    if reduced == 0
        s["fid_present"] = g.bit()
        if s["fid_present"] == 1
            s["delta_fid_bits"] = g.bits(4) + 2
            s["fid_bits"] = g.bits(3) + s["delta_fid_bits"] + 1
    s["sb128"] = g.bit()
    s["filter_intra"] = g.bit()
    s["intra_edge"] = g.bit()
    s["screen_tools"] = 2
    s["order_hint_bits"] = 0
    if reduced == 0
        g.bits(4)
        s["order_hint"] = g.bit()
        if s["order_hint"] == 1
            g.bits(2)
        s["screen_tools"] = if g.bit() == 1 then 2 else g.bit()
        s["force_mv"] = 2
        if s["screen_tools"] > 0
            if g.bit() == 0
                s["force_mv"] = g.bit()
        if s["order_hint"] == 1
            s["order_hint_bits"] = g.bits(3) + 1
    s["super_res"] = g.bit()
    s["cdef"] = g.bit()
    s["restoration"] = g.bit()
    mut depth := 8
    hbd := g.bit()
    if hbd == 1
        depth = 10
        if prof == 2
            if g.bit() == 1
                depth = 12
    s["depth"] = depth
    mut mono := 0
    if prof != 1
        mono = g.bit()
    s["mono"] = mono
    mut pri := 2
    mut trc := 2
    mut mtrx := 2
    if g.bit() == 1
        pri = g.bits(8)
        trc = g.bits(8)
        mtrx = g.bits(8)
    s["pri"] = pri
    s["trc"] = trc
    s["mtrx"] = mtrx
    mut ssx := 1
    mut ssy := 1
    mut range := 0
    if mono == 1
        range = g.bit()
    elif pri == 1 and trc == 13 and mtrx == 0
        ssx = 0
        ssy = 0
        range = 1
    else
        range = g.bit()
        if prof == 1
            ssx = 0
            ssy = 0
        elif prof == 2
            if depth == 12
                ssx = g.bit()
                if ssx == 1
                    ssy = g.bit()
                else
                    ssy = 0
            else
                ssy = 0
        if ssx == 1 and ssy == 1
            g.bits(2)
    s["ssx"] = ssx
    s["ssy"] = ssy
    s["range"] = range
    s["sep_uv"] = 0
    if mono == 0
        s["sep_uv"] = g.bit()
    s["film_grain"] = g.bit()
    s

## Parses the (key frame) header at `g`; the bit reader ends just after it.
fn av1_frame(mut g Gb, s Map[str, int], temporal int, spatial int) Av1Hdr ! ImageError
    mut f := Map[str, int]()
    reduced := s["reduced"]
    if reduced == 0
        if g.bit() == 1
            return Unsupported(what: "AV1 show_existing_frame")
        ftype := g.bits(2)
        show := g.bit()
        if ftype != 0 or show == 0
            return Unsupported(what: "AV1 frame type {ftype}")
        if s["dm_present"] == 1 and s["equal_pic"] == 0
            g.bits(s["fpd_len"])
    f["error_res"] = 1
    f["disable_cdf_update"] = g.bit()
    mut screen := s["screen_tools"]
    if screen == 2
        screen = g.bit()
    f["screen"] = screen
    if screen == 1 and s["force_mv"] == 2
        g.bit()
    if s["fid_present"] == 1
        g.bits(s["fid_bits"])
    mut override := 0
    if reduced == 0
        override = g.bit()
    if s["order_hint"] == 1
        g.bits(s["order_hint_bits"])
    if s["dm_present"] == 1
        if g.bit() == 1
            nops := 1
            for _ in 0..nops
                if s["op_dm"] == 1
                    idc := s["op_idc"]
                    inl := idc.shr(temporal).bit_and(1)
                    ins := idc.shr(spatial + 8).bit_and(1)
                    if idc == 0 or (inl == 1 and ins == 1)
                        g.bits(s["brd_len"])
    # refresh_frame_flags are implied (0xff) for a shown key frame.
    mut fw := s["max_w"]
    mut fh := s["max_h"]
    if override == 1
        fw = g.bits(s["wbits"]) + 1
        fh = g.bits(s["hbits"]) + 1
    mut up_w := fw
    mut sr_denom := 8
    if s["super_res"] == 1
        if g.bit() == 1
            sr_denom = 9 + g.bits(3)
            up_w = (fw * 8 + sr_denom.shr(1)) / sr_denom
            up_w = up_w.max(16.min(fw))
    f["up_w"] = fw
    f["w"] = up_w
    f["h"] = fh
    f["sr_denom"] = sr_denom
    if g.bit() == 1
        g.bits(16)
        g.bits(16)
    f["intrabc"] = 0
    if screen == 1 and sr_denom == 8
        f["intrabc"] = g.bit()
    if reduced == 0 and f["disable_cdf_update"] == 0
        f["refresh_ctx"] = 1 - g.bit()
    # Tile info.
    sb128 := s["sb128"]
    uniform := g.bit()
    sbsz_log2 := 6 + sb128
    sbw := (up_w + 1.shl(sbsz_log2) - 1).shr(sbsz_log2)
    sbh := (fh + 1.shl(sbsz_log2) - 1).shr(sbsz_log2)
    max_tile_w_sb := 4096.shr(sbsz_log2)
    max_tile_area_sb := (4096 * 2304).shr(2 * sbsz_log2)
    min_log2_cols := av1_tile_log2(max_tile_w_sb, sbw)
    max_log2_cols := av1_tile_log2(1, sbw.min(64))
    max_log2_rows := av1_tile_log2(1, sbh.min(64))
    min_log2_tiles := av1_tile_log2(max_tile_area_sb, sbw * sbh).max(min_log2_cols)
    mut col_start := List[int]()
    mut row_start := List[int]()
    mut log2_cols := 0
    mut log2_rows := 0
    if uniform == 1
        log2_cols = min_log2_cols
        while log2_cols < max_log2_cols and g.bit() == 1
            log2_cols += 1
        tile_w := 1 + (sbw - 1).shr(log2_cols)
        mut sbx := 0
        while sbx < sbw
            col_start.push(sbx)
            sbx += tile_w
        min_log2_rows := (min_log2_tiles - log2_cols).max(0)
        log2_rows = min_log2_rows
        while log2_rows < max_log2_rows and g.bit() == 1
            log2_rows += 1
        tile_h := 1 + (sbh - 1).shr(log2_rows)
        mut sby := 0
        while sby < sbh
            row_start.push(sby)
            sby += tile_h
    else
        mut widest := 0
        mut sbx := 0
        while sbx < sbw
            tw := (sbw - sbx).min(max_tile_w_sb)
            sz := if tw > 1 then 1 + g.uniform(tw) else 1
            col_start.push(sbx)
            sbx += sz
            widest = widest.max(sz)
        log2_cols = av1_tile_log2(1, col_start.len())
        mut area := sbw * sbh
        if min_log2_tiles > 0
            area = area.shr(min_log2_tiles + 1)
        max_h_sb := (area / widest).max(1)
        mut sby := 0
        while sby < sbh
            th := (sbh - sby).min(max_h_sb)
            sz := if th > 1 then 1 + g.uniform(th) else 1
            row_start.push(sby)
            sby += sz
        log2_rows = av1_tile_log2(1, row_start.len())
    ncols := col_start.len()
    nrows := row_start.len()
    col_start.push(sbw)
    row_start.push(sbh)
    f["tile_cols"] = ncols
    f["tile_rows"] = nrows
    f["tile_bytes"] = 4
    f["context_tile"] = 0
    if log2_cols > 0 or log2_rows > 0
        f["context_tile"] = g.bits(log2_cols + log2_rows)
        f["tile_bytes"] = g.bits(2) + 1
    # Quantisation.
    yac := g.bits(8)
    f["yac"] = yac
    f["ydc"] = g.opt_su(6)
    mut udc := 0
    mut uac := 0
    mut vdc := 0
    mut vac := 0
    if s["mono"] == 0
        diff := if s["sep_uv"] == 1 then g.bit() else 0
        udc = g.opt_su(6)
        uac = g.opt_su(6)
        if diff == 1
            vdc = g.opt_su(6)
            vac = g.opt_su(6)
        else
            vdc = udc
            vac = uac
    f["udc"] = udc
    f["uac"] = uac
    f["vdc"] = vdc
    f["vac"] = vac
    f["qm"] = g.bit()
    if f["qm"] == 1
        f["qm_y"] = g.bits(4)
        f["qm_u"] = g.bits(4)
        f["qm_v"] = if s["sep_uv"] == 1 then g.bits(4) else f["qm_u"]
    # Segmentation (a key frame has no primary reference, so both updates are on).
    mut seg_q := [0 for _ in 0..8]
    mut seg_lf := [0 for _ in 0..32]
    f["seg"] = g.bit()
    if f["seg"] == 1
        for i in 0..8
            if g.bit() == 1
                seg_q[i] = g.sbits(9)
            for k in 0..4
                if g.bit() == 1
                    seg_lf[i * 4 + k] = g.sbits(7)
            if g.bit() == 1
                return Unsupported(what: "AV1 segment reference feature")
            if g.bit() == 1
                return Unsupported(what: "AV1 segment skip feature")
            if g.bit() == 1
                return Unsupported(what: "AV1 segment global motion feature")
    f["dq_present"] = 0
    f["dlf_present"] = 0
    f["dq_res"] = 0
    f["dlf_res"] = 0
    f["dlf_multi"] = 0
    if yac > 0
        f["dq_present"] = g.bit()
        if f["dq_present"] == 1
            f["dq_res"] = g.bits(2)
            if f["intrabc"] == 0
                f["dlf_present"] = g.bit()
                if f["dlf_present"] == 1
                    f["dlf_res"] = g.bits(2)
                    f["dlf_multi"] = g.bit()
    mut all_lossless := 1
    mut seg_lossless := [0 for _ in 0..8]
    dl := f["ydc"] == 0 and f["udc"] == 0 and f["uac"] == 0 and f["vdc"] == 0 and f["vac"] == 0
    for i in 0..8
        qi := if f["seg"] == 1 then (yac + seg_q[i]).max(0).min(255) else yac
        seg_lossless[i] = if qi == 0 and dl then 1 else 0
        if seg_lossless[i] == 0
            all_lossless = 0
    f["all_lossless"] = all_lossless
    # Loop filter.
    mut lf_ref := [1, 0, 0, 0, -1, 0, -1, -1]
    mut lf_mode := [0, 0]
    f["lf0"] = 0
    f["lf1"] = 0
    f["lfu"] = 0
    f["lfv"] = 0
    f["lf_sharp"] = 0
    if all_lossless == 0 and f["intrabc"] == 0
        f["lf0"] = g.bits(6)
        f["lf1"] = g.bits(6)
        if s["mono"] == 0 and (f["lf0"] > 0 or f["lf1"] > 0)
            f["lfu"] = g.bits(6)
            f["lfv"] = g.bits(6)
        f["lf_sharp"] = g.bits(3)
        f["lf_delta_enabled"] = g.bit()
        if f["lf_delta_enabled"] == 1
            if g.bit() == 1
                for i in 0..8
                    if g.bit() == 1
                        lf_ref[i] = g.sbits(7)
                for i in 0..2
                    if g.bit() == 1
                        lf_mode[i] = g.sbits(7)
    f["lf_ref0"] = lf_ref[0]
    f["lf_mode0"] = lf_mode[0]
    # CDEF.
    mut cdef_y := [0 for _ in 0..8]
    mut cdef_uv := [0 for _ in 0..8]
    f["cdef_damping"] = 3
    f["cdef_bits"] = 0
    f["cdef_on"] = 0
    if all_lossless == 0 and s["cdef"] == 1 and f["intrabc"] == 0
        f["cdef_on"] = 1
        f["cdef_damping"] = g.bits(2) + 3
        f["cdef_bits"] = g.bits(2)
        for i in 0..1.shl(f["cdef_bits"])
            cdef_y[i] = g.bits(6)
            if s["mono"] == 0
                cdef_uv[i] = g.bits(6)
    # Loop restoration.
    f["lr0"] = 0
    f["lr1"] = 0
    f["lr2"] = 0
    f["lr_unit0"] = 8
    f["lr_unit1"] = 8
    if (all_lossless == 0 or sr_denom != 8) and s["restoration"] == 1 and f["intrabc"] == 0
        f["lr0"] = g.bits(2)
        if s["mono"] == 0
            f["lr1"] = g.bits(2)
            f["lr2"] = g.bits(2)
        if f["lr0"] > 0 or f["lr1"] > 0 or f["lr2"] > 0
            mut u0 := 6 + sb128
            if g.bit() == 1
                u0 += 1
                if sb128 == 0
                    u0 += g.bit()
            mut u1 := u0
            if (f["lr1"] > 0 or f["lr2"] > 0) and s["ssx"] == 1 and s["ssy"] == 1
                u1 -= g.bit()
            f["lr_unit0"] = u0
            f["lr_unit1"] = u1
    f["tx_select"] = 0
    if all_lossless == 0
        f["tx_select"] = g.bit()
    f["reduced_tx_set"] = g.bit()
    if s["film_grain"] == 1
        if g.bit() == 1
            return Unsupported(what: "AV1 film grain")
    Av1Hdr(
        s: s,
        f: f,
        col_start: col_start,
        row_start: row_start,
        seg_q: seg_q,
        seg_lf: seg_lf,
        cdef_y: cdef_y,
        cdef_uv: cdef_uv,
        tile_data: List[List[int]](),
        tile_rc: List[List[int]](),
    )

## Reads the OBUs in `data` (the AV1 configuration OBUs and the item's data):
## the sequence header, the frame header and the tile data of the first frame.
pub fn av1_parse(data List[int]) Av1Hdr ! ImageError
    mut pos := 0
    mut s := Map[str, int]()
    mut hdr := none_hdr()
    mut have_hdr := false
    mut tiles := List[List[int]]()
    mut ntiles := 0
    mut done := false
    while pos < data.len() and not done
        h0 := data[pos]
        kind := h0.shr(3).bit_and(15)
        ext := h0.shr(2).bit_and(1)
        has_size := h0.shr(1).bit_and(1)
        mut temporal := 0
        mut spatial := 0
        mut p := pos + 1
        if ext == 1
            temporal = data[p].shr(5)
            spatial = data[p].shr(3).bit_and(3)
            p += 1
        mut size := data.len() - p
        if has_size == 1
            mut g := Gb(data: data, pos: p * 8)
            size = g.leb()
            p = g.pos / 8
        if p + size > data.len()
            return Bad(why: "AV1 OBU is cut off")
        if kind == 1
            mut g := Gb(data: data[p..p + size], pos: 0)
            s = av1_seq(mut g)?
        elif kind == 3 or kind == 6
            if have_hdr
                pos = p + size
                continue
            if s.len() == 0
                return Bad(why: "AV1 frame before the sequence header")
            mut g := Gb(data: data[p..p + size], pos: 0)
            hdr = av1_frame(mut g, s, temporal, spatial)?
            have_hdr = true
            ntiles = hdr.f["tile_cols"] * hdr.f["tile_rows"]
            if kind == 6
                g.align()
                tiles = av1_tile_group(data[p..p + size], g.pos / 8, hdr, ntiles)?
                done = true
        elif kind == 4 and have_hdr
            tiles = av1_tile_group(data[p..p + size], 0, hdr, ntiles)?
            done = true
        pos = p + size
    if not have_hdr or tiles.len() == 0
        return Bad(why: "AV1 data has no frame")
    hdr.tile_data = tiles
    hdr

fn none_hdr() Av1Hdr
    Av1Hdr(
        s: Map[str, int](),
        f: Map[str, int](),
        col_start: List[int](),
        row_start: List[int](),
        seg_q: List[int](),
        seg_lf: List[int](),
        cdef_y: List[int](),
        cdef_uv: List[int](),
        tile_data: List[List[int]](),
        tile_rc: List[List[int]](),
    )

## The tiles of a tile group at `at` in `d`, in tile order.
fn av1_tile_group(d List[int], at int, hdr Av1Hdr, ntiles int) List[List[int]] ! ImageError
    mut g := Gb(data: d, pos: at * 8)
    mut first := 0
    mut last := ntiles - 1
    if ntiles > 1
        if g.bit() == 1
            nb := av1_tile_log2(1, hdr.f["tile_cols"]) + av1_tile_log2(1, hdr.f["tile_rows"])
            first = g.bits(nb)
            last = g.bits(nb)
    g.align()
    mut p := g.pos / 8
    mut out := List[List[int]]()
    for i in first..last + 1
        mut sz := d.len() - p
        if i < last
            tb := hdr.f["tile_bytes"]
            mut v := 0
            for k in 0..tb
                v = v.bit_or(d[p + k].shl(8 * k))
            sz = v + 1
            p += tb
        if p + sz > d.len()
            return Bad(why: "AV1 tile is cut off")
        out.push(d[p..p + sz])
        p += sz
    out

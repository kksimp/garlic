## page: Garlic's text-cell layout and the page model agents read
## (docs/design/garlic-browser.md, "First milestone" and "The page model").
##
## `layout` flows a parsed document into rows of styled runs at a width,
## and records a `Box` for each perceivable element: its role, accessible
## name and the cells it was drawn in.

use html
use css

## How a run is drawn. `link` is the link's number (1-based), 0 if none;
## `heading` the heading level, 0 if none.
pub struct Style
    pub bold bool
    pub italic bool
    pub code bool
    pub quiet bool
    pub link int
    pub heading int
    ## The target's number (1-based) for focus, 0 if none.
    pub target int
    ## `text-transform: uppercase`.
    pub upper bool

## Text drawn in one style on one row, starting at column `col`.
pub struct Run
    pub col int
    pub text str
    pub style Style

## A perceivable element and where it was drawn. Rows and columns are
## 0-based; `end_row` and `end_col` are exclusive, as in `ail api` spans,
## and `end_col` is the end on the last row.
pub struct Box
    pub id int
    pub role str
    pub name str
    pub href str
    pub level int
    ## The link's number (1-based), 0 if not a link.
    pub link int
    ## A form control's current value (`textbox`, `combobox`), or "".
    pub value str
    ## Whether a `checkbox` or `radio` is checked.
    pub checked bool
    pub row int
    pub col int
    pub end_row int
    pub end_col int

## A laid-out page.
pub struct Page
    pub url str
    pub title str
    pub width int
    pub rows List[List[Run]]
    pub boxes List[Box]
    ## For each link number n, `links[n - 1]` is its box's index.
    pub links List[int]
    ## The boxes an agent or the keyboard can act on (links and form
    ## controls), in document order: `targets[n - 1]` for focus number n.
    pub targets List[int]
    ## The ids of nodes changed since the page was parsed (`html.Doc.changed`).
    pub changed List[int]

## Elements never drawn: metadata, scripts and templates.
pub HIDDEN := {
    "head",
    "script",
    "style",
    "template",
    "title",
    "meta",
    "link",
    "base",
    "datalist",
    "option",
}

## Elements laid out as blocks; the rest flow inline.
pub BLOCKS := {
    "address",
    "article",
    "aside",
    "blockquote",
    "body",
    "center",
    "dd",
    "details",
    "dialog",
    "div",
    "dl",
    "dt",
    "fieldset",
    "figcaption",
    "figure",
    "footer",
    "form",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "header",
    "hgroup",
    "hr",
    "html",
    "li",
    "main",
    "menu",
    "nav",
    "noscript",
    "ol",
    "p",
    "pre",
    "section",
    "summary",
    "table",
    "tbody",
    "tfoot",
    "thead",
    "tr",
    "ul",
}

## Blocks with an empty row before and after them.
SPACED := {
    "blockquote",
    "dl",
    "figure",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "ol",
    "p",
    "pre",
    "table",
    "ul",
}

## The ARIA role of an element that gets a box, when it has no `role=`.
ROLES := {
    "a": "link",
    "blockquote": "blockquote",
    "button": "button",
    "h1": "heading",
    "h2": "heading",
    "h3": "heading",
    "h4": "heading",
    "h5": "heading",
    "h6": "heading",
    "hr": "separator",
    "img": "image",
    "input": "textbox",
    "li": "listitem",
    "nav": "navigation",
    "ol": "list",
    "p": "paragraph",
    "pre": "code",
    "select": "combobox",
    "table": "table",
    "td": "cell",
    "textarea": "textbox",
    "th": "cell",
    "tr": "row",
    "ul": "list",
}

## Roles that take an action, so Tab stops on them, and their actions.
ACTIONS := {
    "link": ["follow"],
    "button": ["submit"],
    "textbox": ["type", "submit"],
    "checkbox": ["check"],
    "radio": ["check"],
    "combobox": ["select"],
}

## Input types and their roles; any other type is a `textbox`.
INPUT_ROLES := {
    "checkbox": "checkbox",
    "radio": "radio",
    "submit": "button",
    "button": "button",
    "reset": "button",
    "image": "button",
}

## Roles whose name is their text in full; other roles' names are cut to
## NAME_CUT characters, since the text is on the page already.
FULL_NAMES := {"button", "combobox", "heading", "image", "link", "textbox"}
NAME_CUT := 40
## Roles named only by `aria-label`: their text is their children's.
CONTAINERS := {"list", "navigation", "row", "table"}

## One level of indentation: `first` on the next row that starts, `rest`
## on the rows after it.
struct Indent
    first str
    rest str
    used bool

struct Flow
    d html.Doc
    width int
    rows List[List[Run]]
    cur List[Run]
    col int
    indents List[Indent]
    space bool
    blank bool
    style Style
    pre int
    boxes List[Box]
    targets List[int]
    open List[int]
    links List[int]
    base str
    sheet css.Sheet
    ## Whether the current element lays its children out as flex or grid
    ## items, which are set apart by a space.
    flex bool
    ## The start column of each cell of the data table being laid out,
    ## relative to its first cell (`grid_left`); empty outside one.
    grid List[int]
    grid_left int
    ## The index of the next cell in the current table row.
    cell int

## Whether the current row has text beyond its indentation.
fn Flow.dirty(self) bool
    for r in cur
        if not r.style.quiet
            return true
    false

## Ends the current row if it has anything on it.
fn Flow.break_row(mut self)
    if cur.len() > 0
        rows.push(cur)
        cur = []
        col = 0
    space = false

## Ends the row, then leaves one empty row unless one is already there or
## nothing has been drawn yet (margins collapse).
fn Flow.gap(mut self)
    break_row()
    if rows.len() > 0 and not blank
        rows.push([])
        blank = true

## Starts a row: draws the indentation.
fn Flow.start_row(mut self)
    mut parts := List[str]()
    for mut ind in indents
        if ind.used
            parts.push(ind.rest)
        else
            parts.push(ind.first)
            ind.used = true
    text := parts.join("")
    if text != ""
        q := Style(
            bold: false,
            italic: false,
            code: false,
            quiet: true,
            link: 0,
            heading: 0,
            target: 0,
            upper: false,
        )
        cur.push(Run(col: 0, text, style: q))
    col = text.chars().len()

## Puts `text` (no newlines) on the current row in the current style, and
## widens the open boxes to cover it.
fn Flow.put(mut self, text str)
    place(text, true)

## Puts a separator, which no open box covers.
fn Flow.put_sep(mut self, text str)
    place(text, false)

fn Flow.place(mut self, text str, mark bool)
    if cur.len() == 0
        start_row()
    n := text.chars().len()
    last := cur.len() - 1
    if last >= 0
        and cur[last].style == style
        and cur[last].col + cur[last].text.chars().len() == col
        cur[last].text = "{cur[last].text}{text}"
    else
        cur.push(Run(col, text, style))
    row := rows.len()
    for b in open
        if not mark
            break
        if boxes[b].row < 0
            boxes[b].row = row
            boxes[b].col = col
        boxes[b].end_row = row + 1
        boxes[b].end_col = col + n
    col += n
    blank = false

## Flows one word, wrapping before it when it doesn't fit, and breaking a
## word longer than the width.
fn Flow.word(mut self, w str)
    mut cs := w.chars()
    while true
        if cur.len() == 0
            start_row()
        sep := if space and dirty() then 1 else 0
        left := width - col - sep
        if cs.len() > left and dirty()
            break_row()
            continue
        if space and dirty()
            put_sep(" ")
        space = false
        if cs.len() <= width - col or width - col <= 0
            put(cs.join(""))
            return
        k := width - col
        put(cs[..k].join(""))
        cs = cs[k..]
        break_row()

## Flows text: words wrapped with whitespace collapsed, or kept as is
## inside `pre`.
fn Flow.text(mut self, raw str)
    s := if style.upper then raw.to_upper() else raw
    if pre > 0
        lines := s.split("\n")
        for k in 0..lines.len()
            if k > 0
                if cur.len() == 0
                    start_row()
                rows.push(cur)
                cur = []
                col = 0
            if lines[k] != ""
                put(lines[k].replace("\t", "    "))
        return
    mut buf := List[char]()
    for c in s.chars()
        if html.is_space(c) or c == '\u{a0}'
            if buf.len() > 0
                word(buf.join(""))
                buf.clear()
            space = true
        else
            buf.push(c)
    if buf.len() > 0
        word(buf.join(""))

## Opens a box for element `id` if it has a role.
fn Flow.open_box(mut self, id int, tag str) int?
    n := d.nodes[id]
    mut role := d.attr(id, "role") else (ROLES.get(tag) else return none)
    if tag == "a" and d.attr(id, "href") == none
        return none
    kind := input_type(d, id)
    if tag == "input"
        if kind == "hidden"
            return none
        role = INPUT_ROLES.get(kind) else "textbox"
    mut href := ""
    if h := d.attr(id, "href")
        href = resolve(base, h)
    level := if HEADINGS_LEVEL.contains(tag) then HEADINGS_LEVEL[tag] else 0
    mut name := d.attr(id, "aria-label") else (d.attr(id, "alt") else "")
    if name == "" and (tag == "input" or tag == "select" or tag == "textarea")
        name = label_of(d, id)
    if name == "" and tag == "input" and role == "button"
        name = d.attr(id, "value") else (if kind == "reset" then "Reset" else "Submit")
    if name == "" and not CONTAINERS.contains(role) and tag != "select" and tag != "textarea"
        name = html.collapse(d.visible_text(id))
    if name == "" and tag != "img"
        name = d.attr(
            id,
            "title",
        ) else (d.attr(id, "placeholder") else (d.attr(id, "name") else ""))
    if not FULL_NAMES.contains(role) and name.chars().len() > NAME_CUT
        name = "{name.slice(0, NAME_CUT)}..."
    link := if n.tag == "a" then links.len() + 1 else 0
    value := control_value(d, id)
    checked := d.attr(id, "checked") != none
    boxes.push(Box(
        id,
        role,
        name,
        href,
        level,
        link,
        value,
        checked,
        row: -1,
        col: -1,
        end_row: -1,
        end_col: -1,
    ))
    b := boxes.len() - 1
    open.push(b)
    if n.tag == "a"
        links.push(b)
    if ACTIONS.contains(role)
        targets.push(b)
        style.target = targets.len()
    b

## The `type` of an `input`, lowercase; "text" when absent.
pub fn input_type(d html.Doc, id int) str
    (d.attr(id, "type") else "text").to_lower()

## A form control's value: an input's `value`, a textarea's text (or the
## `value` typed into it), a select's selected option (or its first).
pub fn control_value(d html.Doc, id int) str
    tag := d.nodes[id].tag
    if tag == "textarea"
        return d.attr(id, "value") else d.text(id)
    if tag == "select"
        mut first := ""
        for o in d.all("option")
            if not d.within(o, id)
                continue
            text := html.collapse(d.visible_text(o))
            v := d.attr(o, "value") else text
            if d.attr(o, "selected") != none
                return v
            if first == ""
                first = v
        return first
    if tag == "input"
        return d.attr(id, "value") else ""
    ""

## The text of the `label` for control `id`: `<label for=ID>`, else a
## label around it.
fn label_of(d html.Doc, id int) str
    if key := d.attr(id, "id")
        for l in d.all("label")
            if d.attr(l, "for") == key
                return html.collapse(d.visible_text(l))
    mut p := d.nodes[id].parent
    while p > 0
        if d.nodes[p].tag == "label"
            return html.collapse(d.visible_text(p))
        p = d.nodes[p].parent
    ""

HEADINGS_LEVEL := {"h1": 1, "h2": 2, "h3": 3, "h4": 4, "h5": 5, "h6": 6}

## Whether element `id` is hidden by its tag or `hidden`.
fn Flow.hidden(self, id int, tag str) bool
    HIDDEN.contains(tag) or d.attr(id, "hidden") != none

## Display values that start a block; `none` and the inline ones don't.
BLOCK_DISPLAY := {"block", "flex", "grid", "list-item", "table", "table-row", "flow-root"}

fn Flow.node(mut self, id int)
    n := d.nodes[id]
    match n.kind
        Text => text(n.text)
        Comment => return
        Document | Element => element(id)

fn Flow.children(mut self, id int)
    for c in d.nodes[id].children
        node(c)

fn Flow.element(mut self, id int)
    tag := d.nodes[id].tag
    if tag != "#document" and hidden(id, tag)
        return
    cs := if tag == "#document" then Map[str, str]() else css.cascade(d, id, sheet)
    display := cs.get("display") else ""
    if display == "none" or cs.get("visibility") == "hidden"
        return
    block := if display == "" then BLOCKS.contains(tag) else BLOCK_DISPLAY.contains(display)
    inline_block := display.starts_with("inline-") or (display == "" and CONTROLS.contains(tag))
    gappy := not block and (flex or inline_block or spaced_x(cs))
    outer_flex := flex
    flex = FLEX.contains(display)
    if gappy
        space = true
    nested := (tag == "ul" or tag == "ol") and nested_list(id)
    spaced := SPACED.contains(tag) and not nested and block
    if spaced
        gap()
    elif block
        break_row()
    saved := style
    if level := HEADINGS_LEVEL.get(tag)
        style.heading = level
        style.bold = true
        put("{"#".repeat(level)} ")
    b := open_box(id, tag)
    mut indented := false
    if tag == "li"
        marker := list_marker(id)
        indents.push(Indent(first: marker, rest: " ".repeat(marker.chars().len()), used: false))
        indented = true
    elif tag == "blockquote"
        indents.push(Indent(first: "> ", rest: "> ", used: false))
        indented = true
    elif tag == "dd" or nested
        indents.push(Indent(first: "  ", rest: "  ", used: false))
        indented = true
    elif tag == "pre"
        indents.push(Indent(first: "    ", rest: "    ", used: false))
        indented = true
    outer_grid := grid
    outer_left := grid_left
    outer_cell := cell
    if tag == "table"
        mut used := 0
        for ind in indents
            used += ind.rest.chars().len()
        grid = table_grid(d, id, width - used)
        cell = 0
    elif tag == "tr"
        cell = 0
    match tag
        "b" | "strong" | "th" => style.bold = true
        "i" | "em" | "cite" | "var" => style.italic = true
        "code" | "kbd" | "samp" | "tt" => style.code = true
        "pre" => pre += 1
        _ => style.bold = style.bold
    if w := cs.get("font-weight")
        style.bold = w == "bold"
            or w == "bolder"
            or w == "600"
            or w == "700"
            or w == "800"
            or w == "900"
    if fs := cs.get("font-style")
        style.italic = fs == "italic" or fs == "oblique"
    if tt := cs.get("text-transform")
        style.upper = tt == "uppercase"
    ws := cs.get("white-space") else ""
    styled_pre := tag != "pre" and (ws == "pre" or ws == "pre-wrap")
    if styled_pre
        pre += 1
    match tag
        "a" =>
            if bi := b
                style.link = boxes[bi].link
        _ => style.bold = style.bold
    match tag
        "br" =>
            if cur.len() == 0
                start_row()
            rows.push(cur)
            cur = []
            col = 0
        "hr" =>
            put("-".repeat((width - col).max(1)))
        "img" =>
            alt := d.attr(id, "alt") else ""
            if alt != ""
                word("[{alt}]")
        "input" =>
            kind := input_type(d, id)
            checked := d.attr(id, "checked") != none
            if kind == "checkbox"
                word(if checked then "[x]" else "[ ]")
            elif kind == "radio"
                word(if checked then "(*)" else "( )")
            elif kind == "submit" or kind == "button" or kind == "reset" or kind == "image"
                fallback := if kind == "reset" then "Reset" else "Submit"
                word("[{d.attr(id, "value") else (d.attr(id, "alt") else fallback)}]")
            elif kind != "hidden"
                v := d.attr(id, "value") else ""
                shown := if kind == "password" then "*".repeat(v.chars().len()) else v
                ph := d.attr(id, "placeholder") else ""
                hint := if v == "" then ph else ""
                size := (d.attr(id, "size") else "20").to_int() else 20
                word(field("{shown}{hint}", size))
        "textarea" =>
            cols := (d.attr(id, "cols") else "20").to_int() else 20
            word(field(control_value(d, id).replace("\n", " "), cols))
        "select" => word("[{control_value(d, id)} v]")
        "button" =>
            word("[")
            space = false
            children(id)
            space = false
            put("]")
        "td" | "th" =>
            if grid.len() > 0 and cell < grid.len()
                if cur.len() == 0
                    start_row()
                if cell == 0
                    grid_left = col
                else
                    col = col.max(grid_left + grid[cell] - CELL_SEP.chars().len())
                    put_sep(CELL_SEP)
                cell += 1
            elif col > 0 and dirty()
                put_sep(CELL_SEP)
            space = false
            children(id)
        _ => children(id)
    if tag == "a"
        if bi := b
            if boxes[bi].row < 0 and boxes[bi].name != ""
                word(boxes[bi].name)
            style = saved
            put("[{boxes[bi].link}]")
    style = saved
    if tag == "table"
        grid = outer_grid
        grid_left = outer_left
        cell = outer_cell
    if tag == "pre" or styled_pre
        pre -= 1
    flex = outer_flex
    if gappy
        space = true
    if indented
        indents.pop()
    if b != none
        open.pop()
    if spaced
        gap()
    elif block or tag == "tr"
        break_row()

## What sets table cells apart on a row.
CELL_SEP := " | "

## Elements that make a table cell more than a line of text, so its table
## isn't laid out as a grid.
NOT_IN_GRID := {
    "table",
    "p",
    "div",
    "ul",
    "ol",
    "li",
    "br",
    "pre",
    "blockquote",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "input",
    "select",
    "textarea",
    "button",
    "img",
}

## The rows of table `id`: its `tr` children and those of its row groups.
fn table_rows(d html.Doc, id int) List[int]
    mut out := List[int]()
    for c in d.nodes[id].children
        t := d.nodes[c].tag
        if t == "tr"
            out.push(c)
        elif t == "thead" or t == "tbody" or t == "tfoot"
            for r in d.nodes[c].children
                if d.nodes[r].tag == "tr"
                    out.push(r)
    out

## Whether cell `id` holds only a line of text and links.
fn simple_cell(d html.Doc, id int) bool
    for c in d.nodes[id].children
        n := d.nodes[c]
        if n.kind == html.Kind.Element
            if NOT_IN_GRID.contains(n.tag) or not simple_cell(d, c)
                return false
    true

## How many links with an `href` are inside node `id`.
fn count_links(d html.Doc, id int) int
    mut n := if d.nodes[id].tag == "a" and d.attr(id, "href") != none then 1 else 0
    for c in d.nodes[id].children
        n += count_links(d, c)
    n

## The start column of each cell when table `id` is a data table that fits
## in `room` cells: two or more rows, a cell with more than one column,
## cells of one line of text and links, no `colspan`. Each column is as
## wide as its widest cell (link markers counted as `[NN]`), with
## `CELL_SEP` between columns. Empty when the table should flow instead.
fn table_grid(d html.Doc, id int, room int) List[int]
    rows := table_rows(d, id)
    if rows.len() < 2
        return []
    mut widths := List[int]()
    for r in rows
        mut k := 0
        for c in d.nodes[r].children
            t := d.nodes[c].tag
            if t != "td" and t != "th"
                continue
            if (d.attr(c, "colspan") else "1").trim() != "1" or not simple_cell(d, c)
                return []
            w := html.collapse(d.visible_text(c)).trim().chars().len() + count_links(d, c) * 4
            if k == widths.len()
                widths.push(w)
            else
                widths[k] = widths[k].max(w)
            k += 1
    if widths.len() < 2
        return []
    mut starts := List[int]()
    mut at := 0
    for w in widths
        starts.push(at)
        at += w + CELL_SEP.chars().len()
    if at - CELL_SEP.chars().len() > room
        return []
    starts

## A text field drawn as `[text___]`, padded with `_` to `size` characters
## (at least 4 underscores, at most 40 cells).
fn field(text str, size int) str
    pad := (size.min(40) - text.chars().len()).max(4)
    "[{text}{"_".repeat(pad)}]"

## Whether a horizontal margin or padding in `cs` is non-zero, so an inline
## element is set apart from its neighbours by a space.
fn spaced_x(cs Map[str, str]) bool
    for key in ["margin", "padding"]
        if v := cs.get(key)
            parts := [p for p in v.split(" ") if p != ""]
            x := if parts.len() >= 2 then parts[1] else (if parts.len() == 1 then parts[0] else "0")
            if nonzero(x)
                return true
        for side in ["-left", "-right", "-inline", "-inline-start", "-inline-end"]
            if v := cs.get("{key}{side}")
                if nonzero(v.split(" ")[0])
                    return true
    false

fn nonzero(v str) bool
    v != "" and v != "auto" and not v.starts_with("0") and not v.starts_with("-")

## Form controls, which browsers draw as inline blocks.
CONTROLS := {"button", "input", "select", "textarea"}

## Display values whose children are laid out as items with gaps.
FLEX := {"flex", "inline-flex", "grid", "inline-grid"}

## Whether list `id` sits inside a list item, so it indents further.
fn Flow.nested_list(self, id int) bool
    mut p := d.nodes[id].parent
    while p > 0
        if d.nodes[p].tag == "li"
            return true
        p = d.nodes[p].parent
    false

## "* " in an unordered list; "N. " in an ordered one, counting from `start`.
fn Flow.list_marker(self, id int) str
    parent := d.nodes[id].parent
    if parent < 0 or d.nodes[parent].tag != "ol"
        return "* "
    mut n := (d.attr(parent, "start") else "1").to_int() else 1
    for c in d.nodes[parent].children
        if c == id
            break
        if d.nodes[c].kind == html.Kind.Element and d.nodes[c].tag == "li"
            n += 1
    "{n}. "

## Lays `d` out at `width` columns; `url` resolves relative links. The
## document's own `<style>` sheets apply.
pub fn layout(d html.Doc, url str, width int) Page
    layout_with(d, url, width, css.parse("", 0))

## The `Referer` for a request to `to` from the page `from`: the whole
## address within one origin, only the origin across origins, nothing
## downgrading https to http or from a file or a typed address
## (strict-origin-when-cross-origin).
pub fn referrer(from str, to str) str
    sf := scheme(from)
    if sf != "http" and sf != "https"
        return ""
    st := scheme(to)
    if sf == "https" and st != "https"
        return ""
    base := from.split("#")[0]
    origin := base.split("/")[0..3].join("/")
    if to.starts_with("{origin}/") or to == origin
        return base
    origin

## Where relative addresses in `d` start from: its first `<base href>`
## (HTML 4.2.3) resolved against the page's own address, else `url`.
pub fn base_of(d html.Doc, url str) str
    for id in d.all("base")
        if h := d.attr(id, "href")
            if h.trim() != ""
                return resolve(url, h.trim())
    url

## CSS pixels per text cell, for `@media` widths: a 100-cell window is
## 800 px wide, so narrow windows get sites' small-screen layouts.
PX_PER_CELL := 8

## Lays `d` out with `sheet` (its linked style sheets) before its own.
pub fn layout_with(d html.Doc, url str, width int, sheet css.Sheet) Page
    plain := Style(
        bold: false,
        italic: false,
        code: false,
        quiet: false,
        link: 0,
        heading: 0,
        target: 0,
        upper: false,
    )
    mut f := Flow(
        d,
        width: width.max(10),
        rows: [],
        cur: [],
        col: 0,
        indents: [],
        space: false,
        blank: true,
        style: plain,
        pre: 0,
        boxes: [],
        targets: [],
        open: [],
        links: [],
        base: base_of(d, url),
        sheet: css.for_width(css.concat(sheet, css.document_sheet(d)), width.max(10) * PX_PER_CELL),
        flex: false,
        grid: [],
        grid_left: 0,
        cell: 0,
    )
    f.node(0)
    f.break_row()
    while f.rows.len() > 0 and f.rows[f.rows.len() - 1].len() == 0
        f.rows.pop()
    Page(
        url,
        title: d.title(),
        width: f.width,
        rows: f.rows,
        boxes: f.boxes,
        links: f.links,
        targets: f.targets,
        changed: d.changed,
    )

## Row `r` as plain text.
pub fn Page.row_text(self, r int) str
    mut out := List[str]()
    mut at := 0
    for run in rows[r]
        if run.col > at
            out.push(" ".repeat(run.col - at))
        out.push(run.text)
        at = run.col + run.text.chars().len()
    out.join("")

## The whole page as plain text, one row per line.
pub fn Page.text(self) str
    [row_text(r) for r in 0..rows.len()].join("\n")

## The first row at or after `from` whose text contains `needle`, ignoring
## case, or none.
pub fn Page.find(self, needle str, from int) int?
    want := needle.to_lower()
    for r in from..rows.len()
        if row_text(r).to_lower().contains(want)
            return r
    none

## The page model as one JSON object (api 1): the viewport `height` rows
## from row `scroll`, and every box with whether it shows in the viewport;
## only the boxes in the viewport when `viewport_only`, to save tokens.
pub fn Page.to_json(self, scroll int, height int, viewport_only bool) str
    nodes := node_objects(scroll, height)
    mut out := List[str]()
    for b in boxes
        if text := nodes.get(b.id)
            if not viewport_only or is_visible(b, scroll, height)
                out.push(text)
    "\{{head_json(scroll, height)},\"nodes\":[{out.join(",")}]}"

## Whether any of box `b` is in the viewport.
fn is_visible(b Box, scroll int, height int) bool
    b.row >= 0 and b.row < scroll + height and b.end_row > scroll

## The model's members before `nodes`: where the page is and what changed.
pub fn Page.head_json(self, scroll int, height int) str
    mut head := "\"api\":1,\"url\":{quote(url)},\"title\":{quote(title)},\"width\":{width},\"height\":{height},\"scroll\":{scroll},\"rows\":{rows.len()}"
    if changed.len() > 0
        head = "{head},\"changed\":[{changed.join(",")}]"
    head

## Each drawn box as its JSON object, by node id, in document order.
pub fn Page.node_objects(self, scroll int, height int) Map[int, str]
    mut out := Map[int, str]()
    for b in boxes
        if b.row < 0
            continue
        mut parts := ["\"id\":{b.id}", "\"role\":{quote(b.role)}", "\"name\":{quote(b.name)}"]
        if b.level > 0
            parts.push("\"level\":{b.level}")
        if b.href != ""
            parts.push("\"href\":{quote(b.href)}")
        parts.push("\"row\":{b.row},\"col\":{b.col},\"end_row\":{b.end_row},\"end_col\":{b.end_col}")
        parts.push("\"visible\":{is_visible(b, scroll, height)}")
        if b.link > 0
            parts.push("\"link\":{b.link}")
        if b.role == "textbox" or b.role == "combobox"
            parts.push("\"value\":{quote(b.value)}")
        if b.role == "checkbox" or b.role == "radio"
            parts.push("\"checked\":{b.checked}")
        mut acts := ACTIONS.get(b.role) else List[str]()
        if b.link > 0
            acts = ["follow"]
        if acts.len() > 0
            parts.push("\"actions\":[{[quote(a) for a in acts].join(",")}]")
        out[b.id] = "\{{parts.join(",")}}"
    out

## The model in at most about `max_chars` characters: the viewport's nodes
## first, then headings, links and form controls, then the rest, each in
## document order; `"omitted"` counts the nodes left out.
pub fn Page.to_json_budget(self, scroll int, height int, max_chars int) str
    nodes := node_objects(scroll, height)
    mut keep := Set[int]()
    mut size := head_json(scroll, height).chars().len() + 40
    for pass in 0..3
        for b in boxes
            text := nodes.get(b.id) else continue
            vis := is_visible(b, scroll, height)
            key := b.role == "heading" or ACTIONS.contains(b.role)
            wanted := if pass == 0 then vis else (if pass == 1 then key else true)
            if not wanted or keep.contains(b.id)
                continue
            n := text.chars().len() + 1
            if size + n > max_chars
                continue
            keep.add(b.id)
            size += n
    out := [nodes[b.id] for b in boxes if keep.contains(b.id)]
    omitted := nodes.len() - out.len()
    "\{{head_json(scroll, height)},\"omitted\":{omitted},\"nodes\":[{out.join(",")}]}"

## The drawn box at column `x`, row `y` as its JSON object, or `null`: the
## innermost one, which is the box starting last and then the shortest. A box
## covers from (row, col) up to (end_row - 1, end_col), as in `ail api` spans.
pub fn Page.at_json(self, x int, y int) str
    nodes := node_objects(0, rows.len())
    mut best := -1
    mut best_start := -1
    mut best_len := 0
    for k in 0..boxes.len()
        b := boxes[k]
        if b.row < 0
            continue
        at := y * 100000 + x
        start := b.row * 100000 + b.col
        last := (b.end_row - 1).max(b.row) * 100000 + b.end_col
        if at < start or (at >= last and not (b.end_row - 1 > b.row and y < b.end_row - 1))
            continue
        len := last - start
        if start > best_start or (start == best_start and len < best_len)
            best = k
            best_start = start
            best_len = len
    if best < 0
        return "null"
    nodes.get(boxes[best].id) else "null"

## The boxes whose role is `q` or whose name contains it (ignoring case), as
## `{"matches":[...]}`, in document order.
pub fn Page.where_json(self, q str) str
    nodes := node_objects(0, rows.len())
    want := q.to_lower()
    mut out := List[str]()
    for b in boxes
        if b.row < 0
            continue
        if b.role.to_lower() == want or (b.name != "" and b.name.to_lower().contains(want))
            if text := nodes.get(b.id)
                out.push(text)
    "\{\"matches\":[{out.join(",")}]}"

## `s` as a JSON string.
pub fn quote(s str) str
    mut out := List[str]()
    for c in s.chars()
        k := c.code()
        if c == '"'
            out.push("\\\"")
        elif c == '\\'
            out.push("\\\\")
        elif c == '\n'
            out.push("\\n")
        elif k < 32
            out.push("\\u{k:0>4x}")
        else
            out.push("{c}")
    "\"{out.join("")}\""

## The scheme of `u` (`https`), or "" when it has none (RFC 3986 3.1).
pub fn scheme(u str) str
    mut out := List[char]()
    for c in u.chars()
        if c == ':'
            return if out.len() > 0 then out.join("") else ""
        if not (c.is_alpha() or c.is_digit() or c == '+' or c == '-' or c == '.')
            return ""
        out.push(c.to_lower())
    ""

## `rel` resolved against `base` (RFC 3986 5.2): absolute URLs as they are,
## `//host`, `/path`, `?query`, `#fragment` and relative paths merged with
## dot segments removed. A `base` without a scheme is a file path.
pub fn resolve(base str, rel str) str
    r := rel.trim()
    if scheme(r) != ""
        return r
    s := scheme(base)
    if s == ""
        if r.starts_with("/") or r.starts_with("#") or r.starts_with("?")
            return r
        dir := path.dir(base)
        return if dir == "." then r else "{dir}/{r}"
    rest := base.slice(s.chars().len() + 1, base.chars().len())
    if r.starts_with("//")
        return "{s}:{r}"
    mut authority := ""
    mut bpath := rest
    if rest.starts_with("//")
        after := rest.slice(2, rest.chars().len())
        cut := first_of(after, ["/", "?", "#"]) else after.chars().len()
        authority = "//{after.slice(0, cut)}"
        bpath = after.slice(cut, after.chars().len())
    no_frag := bpath.split("#")[0]
    if r == ""
        return "{s}:{authority}{no_frag}"
    if r.starts_with("#")
        return "{s}:{authority}{no_frag}{r}"
    only_path := no_frag.split("?")[0]
    if r.starts_with("?")
        return "{s}:{authority}{only_path}{r}"
    if r.starts_with("/")
        return "{s}:{authority}{remove_dots(r)}"
    slash := last_slash(only_path)
    dir := if slash >= 0 then only_path.slice(0, slash + 1) else "/"
    "{s}:{authority}{remove_dots("{dir}{r}")}"

fn first_of(s str, needles List[str]) int?
    mut best := -1
    for n in needles
        if k := s.find(n)
            if best < 0 or k < best
                best = k
    if best < 0 then none else best

fn last_slash(s str) int
    cs := s.chars()
    mut k := cs.len() - 1
    while k >= 0
        if cs[k] == '/'
            return k
        k -= 1
    -1

## The path with `.` and `..` segments removed (RFC 3986 5.2.4); the query
## and fragment are kept as they are.
pub fn remove_dots(p str) str
    cut := first_of(p, ["?", "#"]) else p.chars().len()
    tail := p.slice(cut, p.chars().len())
    segs := p.slice(0, cut).split("/")
    mut out := List[str]()
    for k in 0..segs.len()
        seg := segs[k]
        last := k == segs.len() - 1
        if seg == "."
            if last
                out.push("")
        elif seg == ".."
            if out.len() > 1
                out.pop()
            if last
                out.push("")
        else
            out.push(seg)
    "{out.join("/")}{tail}"

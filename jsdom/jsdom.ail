## jsdom: runs a page's scripts with Garlic's JavaScript engine
## (js, docs/design/garlic-js.md) and replays every change
## they make to the tree into Garlic's `html.Doc`, so the page model shows
## what the scripts did.
use html
use garlicjs.vm

## What running a page's scripts left for the browser to do.
pub struct Outcome
    ## A navigation the page asked for (the first one), or "".
    pub url str
    pub method str
    pub body str
    ## Console lines and uncaught errors, in order.
    pub console List[str]
    ## External scripts the page wanted that weren't in `scripts`.
    pub missing List[str]
    ## How many changes were replayed.
    pub changes int
    ## What scripts assigned to `document.cookie`, in order.
    pub cookies List[str]
    ## Module sources the page wants (static imports it could not find, and
    ## `import()` targets), by the address the engine uses; answer each with
    ## `Session.module`.
    pub mods List[str]
    ## `fetch` and XMLHttpRequest requests that had no reply yet.
    pub asks List[Ask]
    ## What WebSockets asked for since the last call, in order.
    pub sockets List[SockOp]
    ## The `fetch` and XMLHttpRequest requests the browser made for the page, as `METHOD url`.
    pub net List[str]

## A request from `fetch` or XMLHttpRequest, numbered `id`: `packed` is the
## content type, a newline and the body. The browser makes it and hands the
## reply to `Session.reply`.
pub struct Ask
    pub id int
    pub method str
    pub url str
    pub packed str

## A WebSocket operation: `op` is "open" (`url`, `text` the protocols),
## "send" (`text`) or "close" (`text` the code) on socket `id`.
pub struct SockOp
    pub op str
    pub id int
    pub url str
    pub text str

## A page whose scripts have run and whose engine is kept, so that what
## the user does afterwards (click, type, submit) reaches the page's
## listeners and timers (WHATWG HTML §8.1.8, DOM §2.9).
pub struct Session
    machine vm.Vm
    ## How much of the engine's logs earlier calls already handed back.
    changes int
    requests int
    console int
    cookies int
    ## Whether the last `click` or `key` was cancelled by a listener.
    pub prevented bool

## Run the scripts of `d` (the page at `url`): inline ones, and external ones
## whose source is in `scripts` by resolved URL. `cookies` are the page's
## cookies by name and `now_ms` the time (ms since 1970). Timers run for
## `budget_ms` of virtual time; `max_steps` caps the work (0 for no cap).
pub fn run(
    mut d html.Doc,
    url str,
    scripts Map[str, str],
    cookies Map[str, str],
    now_ms float,
    budget_ms float,
    max_steps int,
) Outcome
    s := start(mut d, url, scripts, cookies, now_ms, budget_ms, max_steps)
    s.1

## Like `run`, and keeps the engine for `Session.click`, `Session.input`
## and `Session.submit`.
pub fn start(
    mut d html.Doc,
    url str,
    scripts Map[str, str],
    cookies Map[str, str],
    now_ms float,
    budget_ms float,
    max_steps int,
)(Session, Outcome)
    mut machine := vm.new_vm()
    machine.trace = true
    machine.step_limit = max_steps
    machine.clock_ms = now_ms
    machine.cookies = cookies
    machine.dom_setup()
    machine.net_setup()
    machine.dom = mirror(d)
    for id in 0..machine.dom.len()
        for a in machine.dom[id].attrs
            if a.name.starts_with("on")
                machine.handler_set(id, a.name)
    machine.external_scripts = scripts
    machine.load_page(url, budget_ms)
    mut s := Session(
        machine: machine,
        changes: 0,
        requests: 0,
        console: 0,
        cookies: 0,
        prevented: false,
    )
    out := s.collect(mut d)
    (s, out)

## What the engine did since the last call, replayed into `d`.
fn Session.collect(mut self, mut d html.Doc) Outcome
    mut out := Outcome(
        url: "",
        method: "",
        body: "",
        console: machine.console_out[console..],
        missing: [],
        mods: [],
        changes: 0,
        cookies: [],
        asks: [],
        sockets: [],
        net: [],
    )
    console = machine.console_out.len()
    out.changes = replay(mut d, machine.mutations[changes..])
    changes = machine.mutations.len()
    for r in machine.host_requests[requests..]
        if r.kind == "navigate" and out.url == ""
            out.url = r.url
            out.method = r.method
            out.body = r.text
        if r.kind == "fetch-script"
            out.missing.push(r.url)
        if r.kind == "fetch-module"
            out.mods.push(r.url)
        if r.kind == "fetch"
            out.asks.push(Ask(id: r.node, method: r.method, url: r.url, packed: r.text))
        if r.kind == "ws"
            out.sockets.push(SockOp(op: r.method, id: r.node, url: r.url, text: r.text))
        if r.kind == "cookie"
            out.cookies.push(r.text)
    requests = machine.host_requests.len()
    out

## The browser's JSON answer to request `id` (see `Ask`): the page's
## callbacks run, then timers and microtasks that became due.
pub fn Session.reply(mut self, mut d html.Doc, id int, json str, budget_ms float) Outcome
    machine.net_deliver(id, json)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The browser's answer for module `url` (see `Outcome.mods`): its source
## `text`, or `ok` false when it could not be fetched. The imports waiting
## for it go on, then timers and microtasks that became due.
pub fn Session.module(mut self, mut d html.Doc, url str, text str, ok bool, budget_ms float) Outcome
    machine.module_arrived(url, text, ok)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The modules a module's source imports statically, as engine addresses
## resolved against `base`, for the browser to fetch before the page runs.
pub fn module_deps(source str, base str) List[str]
    vm.module_dep_urls(source, base)

## Lets the page's timers and microtasks run for `budget_ms` of its own clock
## (`wait:idle`), and replays what they changed.
pub fn Session.idle(mut self, mut d html.Doc, budget_ms float) Outcome
    until := machine.clock_ms + budget_ms
    machine.run_event_loop(until, 10000)
    ## The clock only moves to timers that ran; a quiet second still passes.
    if machine.clock_ms < until
        machine.clock_ms = until
    collect(mut d)

## How many timers the page still has waiting.
pub fn Session.pending(self) int
    machine.timers.len()

## A WebSocket event for socket `id` (see `Vm.ws_event`), then the timers
## and microtasks it made due.
pub fn Session.ws_event(
    mut self,
    mut d html.Doc,
    id int,
    kind str,
    payload str,
    code int,
    budget_ms float,
) Outcome
    machine.ws_event(id, kind, payload, code)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The user clicked node `id`: `click` is dispatched (it bubbles and can be
## cancelled), then its default action runs (a link, a submit button, a
## check box), then timers and microtasks that became due.
pub fn Session.click(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    if id >= 0 and id < machine.dom.len()
        prevented = not machine.host_click(id)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The user typed `text` into field `id`, replacing its value: `keydown`,
## `input` and `keyup` fire for each character, then `change`.
pub fn Session.input(mut self, mut d html.Doc, id int, text str, budget_ms float) Outcome
    if id >= 0 and id < machine.dom.len()
        machine.host_input(id, text)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## Focus moved to node `id`, or to nothing for -1 (`blur`/`focus` events).
pub fn Session.focus(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    machine.host_focus(id)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The user pressed `key` with focus in node `id`; `prevented` says whether
## a `keydown` listener cancelled it.
pub fn Session.key(mut self, mut d html.Doc, id int, key str, budget_ms float) Outcome
    prevented = not machine.host_key(id, key)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The user submitted the form of node `id` (a button or a field in it):
## `submit` fires and, unless cancelled, the form goes on to the browser.
pub fn Session.submit(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    if id >= 0 and id < machine.dom.len()
        machine.host_submit(id)
    machine.run_event_loop(machine.clock_ms + budget_ms, 10000)
    collect(mut d)

## The engine's copy of the tree: the same nodes with the same ids.
fn mirror(d html.Doc) List[vm.DomNode]
    mut nodes := List[vm.DomNode]()
    for n in d.nodes
        kind := match n.kind
            html.Kind.Document => 9
            html.Kind.Element => 1
            html.Kind.Text => 3
            html.Kind.Comment => 8
        tag := match kind
            9 => "#document"
            3 => "#text"
            8 => "#comment"
            _ => n.tag
        attrs := [vm.DomAttr(name: a.name, value: a.value) for a in n.attrs]
        nodes.push(vm.DomNode(
            kind: kind,
            tag: tag,
            attrs: attrs,
            text: n.text,
            parent: n.parent,
            children: n.children,
        ))
    # Garlic's document node has parent -1, as the engine's does.
    nodes

## Apply the engine's log to `d`; new nodes get the same ids in both trees.
fn replay(mut d html.Doc, log List[vm.Mutation]) int
    for m in log
        match m.op
            "create" => d.create(m.name)
            "create_text" => d.create_text(m.value)
            "create_comment" => d.create_comment(m.value)
            "append" => d.append(m.parent, m.node)
            "insert_before" => d.insert_before(m.parent, m.node, m.before)
            "detach" => d.detach(m.node)
            "set_text" => d.set_text(m.node, m.value)
            "set_attr" => d.set_attr(m.node, m.name, m.value)
            "remove_attr" => d.remove_attr(m.node, m.name)
            "set_value" =>
                if m.name == "checked"
                    if m.value == "on"
                        d.set_attr(m.node, "checked", "")
                    else
                        d.remove_attr(m.node, "checked")
                else
                    d.set_attr(m.node, "value", m.value)
            _ => d.mark(m.node)
    log.len()

## jsdom: runs a page's scripts with Garlic's JavaScript engine
## (js, docs/design/garlic-js.md) and replays every change
## they make to the tree into Garlic's `html.Doc`, so the page model shows
## what the scripts did.
use html
use garlicjs.vm

## What running a page's scripts left for the browser to do.
pub struct Outcome
    ## A navigation the page asked for (the first one), or "".
    pub url str
    pub method str
    pub body str
    ## Console lines and uncaught errors, in order.
    pub console List[str]
    ## Classic scripts the page wanted that weren't in `scripts` (most often
    ## ones a script inserted); answer each with `Session.script`.
    pub missing List[ScriptAsk]
    ## How many changes were replayed.
    pub changes int
    ## What scripts assigned to `document.cookie`, in order.
    pub cookies List[str]
    ## What scripts wrote with `navigator.clipboard.writeText`, in order.
    pub clips List[str]
    ## Module sources the page wants (static imports it could not find, and
    ## `import()` targets), by the address the engine uses; answer each with
    ## `Session.module`.
    pub mods List[str]
    ## `fetch` and XMLHttpRequest requests that had no reply yet.
    pub asks List[Ask]
    ## What WebSockets asked for since the last call, in order.
    pub sockets List[SockOp]
    ## The `fetch` and XMLHttpRequest requests the browser made for the page, as `METHOD url`.
    pub net List[str]

## A classic script element (`node`) whose source at `url` (the address the
## engine uses) the browser fetches and hands to `Session.script`.
pub struct ScriptAsk
    pub node int
    pub url str

## A request from `fetch` or XMLHttpRequest, numbered `id`: `packed` is the
## content type, a newline and the body. The browser makes it and hands the
## reply to `Session.reply`.
pub struct Ask
    pub id int
    pub method str
    pub url str
    pub packed str

## A WebSocket operation: `op` is "open" (`url`, `text` the protocols),
## "send" (`text`) or "close" (`text` the code) on socket `id`.
pub struct SockOp
    pub op str
    pub id int
    pub url str
    pub text str

## A page whose scripts have run and whose engine is kept, so that what
## the user does afterwards (click, type, submit) reaches the page's
## listeners and timers (WHATWG HTML §8.1.8, DOM §2.9).
pub struct Session
    machine vm.Vm
    ## How much of the engine's logs earlier calls already handed back.
    changes int
    requests int
    console int
    cookies int
    ## The pool the page's workers run in, and the thread of each live one
    ## by the number the page's `Worker` knows it by.
    pool Pool
    live Map[int, int]
    ## Whether the last `click` or `key` was cancelled by a listener.
    pub prevented bool

## Run the scripts of `d` (the page at `url`): inline ones, and external ones
## whose source is in `scripts` by resolved URL. `cookies` are the page's
## cookies by name, `now_ms` the time (ms since 1970) and `zone` the local
## time zone of `Date` ("UTC" or an IANA name). Timers run for
## `budget_ms` of virtual time; `max_steps` caps the work (0 for no cap).
pub fn run(
    mut d html.Doc,
    url str,
    scripts Map[str, str],
    cookies Map[str, str],
    now_ms float,
    budget_ms float,
    max_steps int,
) Outcome
    s := start(mut d, url, scripts, cookies, now_ms, "UTC", budget_ms, max_steps, no_pool())
    s.1

## Like `run`, and keeps the engine for `Session.click`, `Session.input`
## and `Session.submit`.
pub fn start(
    mut d html.Doc,
    url str,
    scripts Map[str, str],
    cookies Map[str, str],
    now_ms float,
    zone str,
    budget_ms float,
    max_steps int,
    pool Pool,
)(Session, Outcome)
    mut machine := vm.new_vm()
    machine.trace = true
    machine.step_limit = max_steps
    machine.clock_ms = now_ms
    machine.zone = zone
    machine.cookies = cookies
    machine.dom_setup()
    machine.net_setup()
    machine.worker_setup()
    machine.dom = mirror(d)
    for id in 0..machine.dom.len()
        for a in machine.dom[id].attrs
            if a.name.starts_with("on")
                machine.handler_set(id, a.name)
    machine.external_scripts = scripts
    machine.load_page(url, budget_ms)
    mut s := Session(
        machine: machine,
        changes: 0,
        requests: 0,
        console: 0,
        cookies: 0,
        pool: pool,
        live: {},
        prevented: false,
    )
    out := s.collect(mut d)
    (s, out)

## What the engine did since the last call, replayed into `d`.
fn Session.collect(mut self, mut d html.Doc) Outcome
    mut out := Outcome(
        url: "",
        method: "",
        body: "",
        console: self.machine.console_out[self.console..],
        missing: [],
        mods: [],
        changes: 0,
        cookies: [],
        clips: [],
        asks: [],
        sockets: [],
        net: [],
    )
    self.console = self.machine.console_out.len()
    self.machine.canvas_flush()
    out.changes = replay(mut d, self.machine.mutations[self.changes..])
    self.changes = self.machine.mutations.len()
    for r in self.machine.host_requests[self.requests..]
        if r.kind == "navigate" and out.url == ""
            out.url = r.url
            out.method = r.method
            out.body = r.text
        if r.kind == "fetch-script"
            out.missing.push(ScriptAsk(node: r.node, url: r.url))
        if r.kind == "fetch-module"
            out.mods.push(r.url)
        if r.kind == "fetch"
            out.asks.push(Ask(id: r.node, method: r.method, url: r.url, packed: r.text))
        if r.kind == "ws"
            out.sockets.push(SockOp(op: r.method, id: r.node, url: r.url, text: r.text))
        if r.kind == "cookie"
            out.cookies.push(r.text)
        if r.kind == "clipboard"
            out.clips.push(r.text)
    mut ops := List[vm.HostRequest]()
    for r in self.machine.host_requests[self.requests..]
        if r.kind == "worker"
            ops.push(r)
    self.requests = self.machine.host_requests.len()
    for r in ops
        self.worker_op(r)
    out

## One worker request of the page: start worker `r.node` (`r.text` is
## "NAME\nURL\nBASE\nSOURCE"), pass it a message, or stop it. The page hears
## of a start that found no free thread as an error event.
fn Session.worker_op(mut self, r vm.HostRequest)
    if r.method == "start"
        parts := r.text.split("\n")
        if parts.len() < 4
            return
        at := self.pool.start(r.node, parts[0], parts[1], parts[2], parts[3..].join("\n"))
        if at < 0
            self.machine.worker_event(r.node, "error", "Too many workers are running.")
        else
            self.live[r.node] = at
        return
    at := self.live.get(r.node) else return
    if r.method == "post"
        self.pool.slots[at].post(r.node, "post", r.text)
    elif r.method == "net"
        self.pool.slots[at].post(r.node, "net", r.text)
    elif r.method == "stop"
        self.pool.slots[at].post(r.node, "stop", "")
        self.live.remove(r.node)

## Whether any of the page's workers is running.
pub fn Session.workers_live(self) bool
    self.live.len() > 0

## Stops the page's workers, as leaving the page does.
pub fn Session.stop_workers(mut self)
    for id in self.live.keys()
        at := self.live.get(id) else continue
        self.pool.slots[at].post(id, "stop", "")
    self.live = {}

## Hands the page what its workers sent since the last call (messages,
## errors, console lines, closes) and makes the `fetch` requests they asked
## for, then runs the timers and microtasks that became due.
pub fn Session.workers_poll(mut self, mut d html.Doc, budget_ms float) Outcome
    mut got := 0
    for id in self.live.keys()
        at := self.live.get(id) else continue
        for line in self.pool.slots[at].take()
            head := cut(line, "\t")
            who := head.0.to_int() else continue
            rest := cut(head.1, "\t")
            got += 1
            if rest.0 == "msg"
                self.machine.worker_event(who, "message", rest.1)
            elif rest.0 == "error"
                self.machine.worker_event(who, "error", rest.1)
            elif rest.0 == "log"
                self.machine.report(rest.1)
            elif rest.0 == "closed"
                self.machine.worker_event(who, "closed", "")
                self.live.remove(who)
            elif rest.0 == "fetch"
                f := rest.1.split("\u{1}")
                if f.len() >= 4
                    packed := f[3..].join("\u{1}")
                    self.machine.worker_fetch(who, f[0].to_int() else 0, f[1], f[2], packed)
    if got > 0
        self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The browser's JSON answer to request `id` (see `Ask`): the page's
## callbacks run, then timers and microtasks that became due.
pub fn Session.reply(mut self, mut d html.Doc, id int, json str, budget_ms float) Outcome
    self.machine.net_deliver(id, json)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The browser's answer for module `url` (see `Outcome.mods`): its source
## `text`, or `ok` false when it could not be fetched. The imports waiting
## for it go on, then timers and microtasks that became due.
pub fn Session.module(mut self, mut d html.Doc, url str, text str, ok bool, budget_ms float) Outcome
    self.machine.module_arrived(url, text, ok)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The browser's answer for classic script `url` that element `node` asked
## for (see `Outcome.missing`): when `ok`, `text` runs as that script (HTML
## §4.12.1.1, "execute the script element"), then `load` fires on the
## element; when not, `error` fires. Then timers and microtasks that became
## due run. `document.currentScript` is the element while it runs
## (`Vm.script_arrived`).
pub fn Session.script(
    mut self,
    mut d html.Doc,
    node int,
    url str,
    text str,
    ok bool,
    budget_ms float,
) Outcome
    if ok and not self.machine.stopped
        if node >= 0 and node < self.machine.dom.len()
            self.machine.script_arrived(node, url, text)
        else
            self.machine.cur_url = url
            self.machine.run_script_text(text)
            self.machine.run_microtasks()
    if node >= 0 and node < self.machine.dom.len()
        self.fire_plain(node, if ok then "load" else "error")
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## Fires a `type_name` event that does not bubble at node `id`, as a
## script element's `load` and `error` are (HTML §4.12.1.1).
fn Session.fire_plain(mut self, id int, type_name str)
    if self.machine.stopped
        return
    ev := self.machine.make_event_as("Event", type_name, vm.Value.Undef) else return
    _ := self.machine.dispatch(id, ev) else false

## How many statements the page's scripts have run (`--timings`).
pub fn Session.steps(self) int
    self.machine.step_count

## Whether the step limit stopped the page's scripts for good.
pub fn Session.stopped(self) bool
    self.machine.stopped

## The modules a module's source imports statically, as engine addresses
## resolved against `base`, for the browser to fetch before the page runs.
## Found by `import_specifiers`, a scan, not a parse: the engine parses each
## module once, when it runs it (js/vm/modules.ail). A specifier the scan
## misses is still asked for by the engine (`Outcome.mods`), and one it
## takes wrongly is only fetched in vain.
pub fn module_deps(source str, base str) List[str]
    mut out := List[str]()
    for spec in import_specifiers(source)
        u := vm.specifier_url(spec, base)
        if u != "" and not out.contains(u)
            out.push(u)
    out

## What the scan in `import_specifiers` is inside: no statement that can
## name a module, an `import` clause, or an `export` that may end `from "m"`.
enum Clause
    Free
    Importing
    Exporting

## The module specifiers of `source`'s static imports, in order: `import
## "m"`, `import x, { y } from "m"`, `import * as n from "m"` and `export
## ... from "m"`; not `import("m")` or `import.meta`. Comments, strings,
## template literals and regular expressions are skipped; a `/` is taken as
## a regular expression where the previous token can't end an operand.
pub fn import_specifiers(source str) List[str]
    cs := source.chars()
    n := cs.len()
    mut out := List[str]()
    mut i := 0
    ## The last character of the previous token (' ' at the start, 'a' for a
    ## word), for telling a regular expression from a division.
    mut prev := ' '
    mut clause := Clause.Free
    while i < n
        c := cs[i]
        if c == '/' and i + 1 < n and cs[i + 1] == '/'
            while i < n and cs[i] != '\n'
                i += 1
            continue
        if c == '/' and i + 1 < n and cs[i + 1] == '*'
            i = comment_after(cs, i + 2)
            continue
        if c == '"' or c == '\''
            end := quote_end(cs, i)
            ## `from "m"` ends a clause; a bare string ends it too.
            if clause != Clause.Free and prev == 'f' and end < n
                out.push(cs[i + 1..end].join(""))
            clause = Clause.Free
            i = end + 1
            prev = '"'
            continue
        if c == '`'
            i = quote_end(cs, i) + 1
            prev = '"'
            clause = Clause.Free
            continue
        if c == '/' and regex_can_start(prev)
            i = regex_end(cs, i) + 1
            prev = '"'
            continue
        if c.is_alpha() or c == '_' or c == '$'
            mut j := i
            while j < n and (cs[j].is_alnum() or cs[j] == '_' or cs[j] == '$')
                j += 1
            word := cs[i..j].join("")
            after := next_token(cs, j)
            mut mark := 'a'
            if prev != '.' and word == "import"
                if after == '"' or after == '\''
                    clause = Clause.Importing
                    mark = 'f'
                elif after != '(' and after != '.'
                    clause = Clause.Importing
            elif prev != '.' and word == "export"
                clause = Clause.Exporting
            elif word == "from" and clause != Clause.Free and (after == '"' or after == '\'')
                mark = 'f'
            i = j
            prev = mark
            continue
        if not c.is_space()
            ## Only names, `*`, braces and commas come between `import` or
            ## `export` and `from`; anything else ends the clause.
            if c != '{' and c != '}' and c != ',' and c != '*'
                clause = Clause.Free
            prev = c
        i += 1
    out

## The index just after the `*/` that ends a comment whose body starts at `at`.
fn comment_after(cs List[char], at int) int
    mut i := at
    while i + 1 < cs.len()
        if cs[i] == '*' and cs[i + 1] == '/'
            return i + 2
        i += 1
    cs.len()

## The index of the quote that closes the string or template literal opened
## at `open`, past backslash escapes; `cs.len()` when it is not closed.
fn quote_end(cs List[char], open int) int
    q := cs[open]
    mut i := open + 1
    while i < cs.len()
        if cs[i] == '\\'
            i += 2
            continue
        if cs[i] == q
            return i
        if q != '`' and cs[i] == '\n'
            return cs.len()
        i += 1
    cs.len()

## The index of the `/` that closes the regular expression opened at `open`
## (a `/` inside `[...]` doesn't close it).
fn regex_end(cs List[char], open int) int
    mut i := open + 1
    mut in_class := false
    while i < cs.len()
        c := cs[i]
        if c == '\\'
            i += 2
            continue
        if c == '\n'
            return i
        if c == '['
            in_class = true
        elif c == ']'
            in_class = false
        elif c == '/' and not in_class
            return i
        i += 1
    cs.len() - 1

## Whether a `/` after a token ending in `prev` starts a regular expression
## rather than dividing: after an operator, an opening bracket or the start.
fn regex_can_start(prev char) bool
    "(,=:[!&|?\{};+-*%<>~^ ".contains(prev)

## The first character from `at` that is not white space or inside a
## comment, ' ' at the end.
fn next_token(cs List[char], at int) char
    mut i := at
    while i < cs.len()
        if cs[i].is_space()
            i += 1
        elif cs[i] == '/' and i + 1 < cs.len() and cs[i + 1] == '*'
            i = comment_after(cs, i + 2)
        elif cs[i] == '/' and i + 1 < cs.len() and cs[i + 1] == '/'
            while i < cs.len() and cs[i] != '\n'
                i += 1
        else
            return cs[i]
    ' '

## Lets the page's timers and microtasks run for `budget_ms` of its own clock
## (`wait:idle`), and replays what they changed.
pub fn Session.idle(mut self, mut d html.Doc, budget_ms float) Outcome
    until := self.machine.clock_ms + budget_ms
    self.machine.run_event_loop(until, 10000)
    ## The clock only moves to timers that ran; a quiet second still passes.
    if self.machine.clock_ms < until
        self.machine.clock_ms = until
    self.collect(mut d)

## Hands the page's scripts the browser's layout: each box is a node id
## and its x, y, width and height in page pixels; `scroll` is how far the
## page is scrolled. `getBoundingClientRect` and `offsetWidth` answer from
## them.
pub fn Session.measure(mut self, boxes List[List[float]], scroll float)
    self.machine.measure(boxes, scroll)

## Tells the page's scripts the window's page area in CSS pixels, its device
## pixel ratio and the page's laid-out height (`Vm.viewport`); `resize` fires
## when the area changes.
pub fn Session.viewport(
    mut self,
    w float,
    h float,
    dpr float,
    page_height float,
    screen_w float,
    screen_h float,
)
    self.machine.viewport(w, h, dpr, page_height, screen_w, screen_h)

## How many timers the page still has waiting.
pub fn Session.pending(self) int
    self.machine.timers.len()

## A WebSocket event for socket `id` (see `Vm.ws_event`), then the timers
## and microtasks it made due.
pub fn Session.ws_event(
    mut self,
    mut d html.Doc,
    id int,
    kind str,
    payload str,
    code int,
    budget_ms float,
) Outcome
    self.machine.ws_event(id, kind, payload, code)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The user clicked node `id`: `click` is dispatched (it bubbles and can be
## cancelled), then its default action runs (a link, a submit button, a
## check box), then timers and microtasks that became due.
pub fn Session.click(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    if id >= 0 and id < self.machine.dom.len()
        self.prevented = not self.machine.host_click(id)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The user typed `text` into field `id`, replacing its value: `keydown`,
## `input` and `keyup` fire for each character, then `change`.
pub fn Session.input(mut self, mut d html.Doc, id int, text str, budget_ms float) Outcome
    if id >= 0 and id < self.machine.dom.len()
        self.machine.host_input(id, text)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## Focus moved to node `id`, or to nothing for -1 (`blur`/`focus` events).
pub fn Session.focus(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    self.machine.host_focus(id)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The user pressed `key` with focus in node `id`; `prevented` says whether
## a `keydown` listener cancelled it.
pub fn Session.key(mut self, mut d html.Doc, id int, key str, budget_ms float) Outcome
    self.prevented = not self.machine.host_key(id, key)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The user submitted the form of node `id` (a button or a field in it):
## `submit` fires and, unless cancelled, the form goes on to the browser.
pub fn Session.submit(mut self, mut d html.Doc, id int, budget_ms float) Outcome
    if id >= 0 and id < self.machine.dom.len()
        self.machine.host_submit(id)
    self.machine.run_event_loop(self.machine.clock_ms + budget_ms, 10000)
    self.collect(mut d)

## The engine's copy of the tree: the same nodes with the same ids.
fn mirror(d html.Doc) List[vm.DomNode]
    mut nodes := List[vm.DomNode]()
    for n in d.nodes
        kind := match n.kind
            html.Kind.Document => 9
            html.Kind.Element => 1
            html.Kind.Text => 3
            html.Kind.Comment => 8
        tag := match kind
            9 => "#document"
            3 => "#text"
            8 => "#comment"
            _ => n.tag
        attrs := [vm.DomAttr(name: a.name, value: a.value) for a in n.attrs]
        nodes.push(vm.DomNode(
            kind: kind,
            tag: tag,
            attrs: attrs,
            text: n.text,
            parent: n.parent,
            children: n.children,
        ))
    # Garlic's document node has parent -1, as the engine's does.
    nodes

## Apply the engine's log to `d`; new nodes get the same ids in both trees.
fn replay(mut d html.Doc, log List[vm.Mutation]) int
    for m in log
        match m.op
            "create" => d.create(m.name)
            "create_text" => d.create_text(m.value)
            "create_comment" => d.create_comment(m.value)
            "append" => d.append(m.parent, m.node)
            "insert_before" => d.insert_before(m.parent, m.node, m.before)
            "detach" => d.detach(m.node)
            "set_text" => d.set_text(m.node, m.value)
            "set_attr" => d.set_attr(m.node, m.name, m.value)
            "remove_attr" => d.remove_attr(m.node, m.name)
            "set_value" =>
                if m.name == "checked"
                    if m.value == "on"
                        d.set_attr(m.node, "checked", "")
                    else
                        d.remove_attr(m.node, "checked")
                else
                    d.set_attr(m.node, "value", m.value)
            _ => d.mark(m.node)
    log.len()

# ---- Tests -----------------------------------------------------------------

@test fn the_import_scan_finds_static_imports_only()
    lines := [
        "import \"./a.js\";",
        "import x, \{ y as z } from './b.js'",
        "import * as ns from \"/c.js\" with \{ type: \"json\" };",
        "// import \"./no-comment.js\"",
        "/* import \"./no-block.js\" */",
        "export \{ q } from \"./d.js\";",
        "export * from './e.js';",
        "export const s = \"./no-const.js\";",
        "const t = `import \"./no-template.js\"`;",
        "const r = /\"[/]/; const from = \"./no-name.js\";",
        "import(\"./no-dynamic.js\"); import.meta.url;",
        "obj.import(\"./no-member.js\");",
        "export default function f() \{ return \"./no-body.js\" }",
    ]
    assert_eq(import_specifiers(lines.join("\n")), [
        "./a.js",
        "./b.js",
        "/c.js",
        "./d.js",
        "./e.js",
    ])
    assert_eq(
        module_deps(
            "import \"./a.js\"; import \"https://x.test/m.js\"; import \"bare\"",
            "https://p.test/dir/main.js",
        ),
        ["https://p.test/dir/a.js", "https://x.test/m.js"],
    )
    assert_eq(import_specifiers("import \"unclosed"), List[str]())

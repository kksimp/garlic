## tabstrip: Garlic's tab strip, drawn on a canvas of its own so a tab can be
## closed with its x, a middle click or a right-click menu (std.app.5 gives
## `click` the button; a plain `Button` node cannot tell them apart).
##
## Everything here is pure: the strip's geometry, what a click hit, and the
## display list. `Garlic` owns the tabs and acts on the `Hit`.

use std.app

## One tab as the strip shows it.
pub struct Item
    pub title str
    pub url str

## The colors of the strip; a theme is one of these.
pub struct Theme
    pub bar int
    pub tab int
    pub active int
    pub text int
    pub active_text int
    pub accent int
    pub menu int
    pub menu_text int
    pub menu_hot int
    ## Flat tabs share the strip evenly and are told apart by `sep` lines (as Safari does); otherwise pills.
    pub flat bool
    pub sep int

## Clove: dark, violet accent, pill tabs (the look Kaleb chose, 2026-10-24).
pub fn clove() Theme
    Theme(
        bar: 0x1d1a23,
        tab: 0x1d1a23,
        active: 0x2e2a38,
        text: 0x8f89a0,
        active_text: 0xf3effa,
        accent: 0xb48cff,
        menu: 0x27232f,
        menu_text: 0xe6e1ee,
        menu_hot: 0x35303f,
        flat: false,
        sep: 0x35303f,
    )

## Safari-style dark: neutral grays, a blue accent, flat tabs.
pub fn safari() Theme
    Theme(
        bar: 0x2b2b2d,
        tab: 0x252527,
        active: 0x3b3b3e,
        text: 0x98989d,
        active_text: 0xf2f2f7,
        accent: 0x0a84ff,
        menu: 0x333336,
        menu_text: 0xf2f2f7,
        menu_hot: 0x0a84ff,
        flat: true,
        sep: 0x1c1c1e,
    )

## One channel (bits `sh` up) of the colour `t` of the way from `a` to `b`.
fn mix_ch(a int, b int, sh int, t float) int
    ca := a.shr(sh).bit_and(255).to_float()
    cb := b.shr(sh).bit_and(255).to_float()
    (ca + (cb - ca) * t).round().to_int()

## The colour `t` of the way from `a` to `b` (0 to 1).
fn mix(a int, b int, t float) int
    mix_ch(a, b, 16, t).shl(16).bit_or(mix_ch(a, b, 8, t).shl(8)).bit_or(mix_ch(a, b, 0, t))

## A rectangle with round corners of radius `r` over a flat background `bg`,
## one point-high band at a time. Each band's end pixels are blended with `bg`
## by how much of the pixel the corner covers, so the edge looks smooth.
pub fn round(mut ops List[app.Op], x float, y float, w float, h float, r float, c int, bg int)
    rr := r.min(h / 2.0).min(w / 2.0)
    n := rr.ceil().to_int()
    ops.push(app.draw_rect(x, y + rr, w, h - 2.0 * rr, c))
    for i in 0..n
        d := rr - i.to_float() - 0.5
        inset := rr - (rr * rr - d * d).max(0.0).sqrt()
        left := x + inset
        right := x + w - inset
        first := left.ceil()
        last := right.floor()
        for yy in [y + i.to_float(), y + h - i.to_float() - 1.0]
            ops.push(app.draw_rect(first, yy, (last - first).max(0.0), 1.0, c))
            if first > left
                ops.push(app.draw_rect(first - 1.0, yy, 1.0, 1.0, mix(bg, c, first - left)))
            if right > last
                ops.push(app.draw_rect(last, yy, 1.0, 1.0, mix(bg, c, right - last)))

## The toolbar's buttons (back, forward, reload) as a canvas of `NAV_W` by `NAV_H`.
pub NAV_W := 112.0
pub NAV_H := 40.0

pub fn nav(th Theme, can_back bool, can_forward bool) List[app.Op]
    [
        app.draw_rect(0.0, 0.0, NAV_W, NAV_H, th.bar),
        text(14.0, 9.0, "‹", if can_back then th.active_text else th.text, false, 20.0),
        text(44.0, 9.0, "›", if can_forward then th.active_text else th.text, false, 20.0),
        text(74.0, 11.0, "⟳", th.active_text, false, 16.0),
    ]

## Which button a click at `x` on the toolbar canvas hit: `back`, `forward`, `reload` or "".
pub fn nav_hit(x float) str
    if x < 34.0
        return "back"
    if x < 64.0
        return "forward"
    if x < 100.0
        return "reload"
    ""

## The status line below the page, `width` wide and `STATUS_H` high.
pub STATUS_H := 26.0

pub fn status(th Theme, line str, width float) List[app.Op]
    [
        app.draw_rect(0.0, 0.0, width.max(1.0), STATUS_H, th.bar),
        text(12.0, 6.0, line, th.text, false, 12.0),
    ]

## The strip's height without a menu, a menu row's height and the menu's width.
pub BAR_H := 36.0
pub ROW_H := 26.0
pub MENU_W := 210.0
MAX_TAB_W := 220.0
MIN_TAB_W := 60.0
GAP := 2.0
LEFT := 8.0
PLUS_W := 30.0
CLOSE_W := 20.0

## What a click landed on: `kind` is `tab`, `close`, `plus`, `menu` (row `k`
## of the open menu) or `none`; `k` is the tab or row.
pub struct Hit
    pub kind str
    pub k int

fn miss() Hit
    Hit(kind: "none", k: 0)

## A tab's width when `n` tabs share a strip `width` wide.
pub fn tab_w(n int, width float, flat bool) float
    if flat
        return flat_w(n, width)
    room := width - LEFT - PLUS_W - 8.0
    (room / n.max(1).to_float() - GAP).max(MIN_TAB_W).min(MAX_TAB_W)

## Flat tabs: the strip shared evenly, up to 360 points each.
pub fn flat_w(n int, width float) float
    ((width - PLUS_W) / n.max(1).to_float()).max(MIN_TAB_W).min(360.0)

pub fn tab_x(k int, n int, width float, flat bool) float
    if flat
        return k.to_float() * flat_w(n, width)
    LEFT + k.to_float() * (tab_w(n, width, flat) + GAP)

## The rows of the menu for tab `k` of `n`, `closed` being how many tabs
## can still be reopened.
pub fn menu_rows(k int, n int, closed int) List[str]
    mut rows := ["Close tab"]
    if n > 1
        rows.push("Close other tabs")
    if k < n - 1
        rows.push("Close tabs to the right")
    if closed > 0
        rows.push("Reopen closed tab")
    rows

## The height the canvas needs: the bar, plus the open menu below it.
pub fn height(menu_rows_n int) float
    if menu_rows_n == 0
        return BAR_H
    BAR_H + menu_rows_n.to_float() * ROW_H + 8.0

## What a click at (x, y) landed on. `menu_n` rows are open at `menu_x`.
pub fn hit(x float, y float, n int, width float, flat bool, menu_n int, menu_x float) Hit
    if menu_n > 0 and y >= BAR_H
        if x >= menu_x and x < menu_x + MENU_W
            row := ((y - BAR_H - 4.0) / ROW_H).floor().to_int()
            if row >= 0 and row < menu_n
                return Hit(kind: "menu", k: row)
        return miss()
    if y >= BAR_H
        return miss()
    w := tab_w(n, width, flat)
    for k in 0..n
        x0 := tab_x(k, n, width, flat)
        if x >= x0 and x < x0 + w
            if x >= x0 + w - CLOSE_W - 4.0
                return Hit(kind: "close", k: k)
            return Hit(kind: "tab", k: k)
    px := tab_x(n, n, width, flat)
    if x >= px and x < px + PLUS_W
        return Hit(kind: "plus", k: 0)
    miss()

fn text(x float, y float, s str, fg int, bold bool, size float) app.Op
    app.Op.Str(
        x: x,
        y: y,
        text: s,
        font: "sans",
        size: size,
        fg: fg,
        bold: bold,
        italic: false,
        underline: false,
    )

## The display list: the tabs (the shown one lifted, with an accent line), a
## close x on each, the + button and, if `menu` has rows, the menu at `menu_x`.
pub fn draw(
    th Theme,
    items List[Item],
    cur int,
    width float,
    menu List[str],
    menu_x float,
) List[app.Op]
    n := items.len()
    w := tab_w(n, width, th.flat)
    mut ops := [app.draw_rect(0.0, 0.0, width.max(1.0), height(menu.len()), th.bar)]
    for k in 0..n
        x0 := tab_x(k, n, width, th.flat)
        shown := k == cur
        if th.flat
            ops.push(app.draw_rect(x0, 0.0, w, BAR_H, if shown then th.active else th.tab))
            ops.push(app.draw_rect(x0 + w - 1.0, 0.0, 1.0, BAR_H, th.sep))
        elif shown
            round(mut ops, x0, 4.0, w, BAR_H - 6.0, 8.0, th.active, th.bar)
            ops.push(app.draw_rect(x0 + w / 2.0 - 10.0, BAR_H - 5.0, 20.0, 3.0, th.accent))
        title := if items[k].title == "" then "New tab" else items[k].title
        ops.push(app.Op.Clip(x: x0 + 10.0, y: 6.0, w: w - CLOSE_W - 18.0, h: BAR_H - 6.0))
        ops.push(text(
            x0 + 10.0,
            12.0,
            title,
            if shown then th.active_text else th.text,
            shown,
            12.0,
        ))
        ops.push(app.Op.Unclip)
        ops.push(text(
            x0 + w - CLOSE_W,
            11.0,
            "x",
            if shown then th.active_text else th.text,
            false,
            14.0,
        ))
    px := tab_x(n, n, width, th.flat)
    ops.push(text(px + 9.0, 8.0, "+", th.text, false, 18.0))
    if menu.len() > 0
        round(mut ops, menu_x, BAR_H, MENU_W, menu.len().to_float() * ROW_H + 8.0, 6.0, th.menu, th.bar)
        for r in 0..menu.len()
            ops.push(text(
                menu_x + 14.0,
                BAR_H + 4.0 + r.to_float() * ROW_H + 6.0,
                menu[r],
                th.menu_text,
                false,
                12.0,
            ))
    ops

@test fn clicks_land_on_the_tab_its_x_and_the_plus()
    w := 800.0
    x0 := tab_x(1, 3, w, false)
    assert_eq(hit(x0 + 30.0, 20.0, 3, w, false, 0, 0.0), Hit(kind: "tab", k: 1))
    assert_eq(
        hit(x0 + tab_w(3, w, false) - 8.0, 20.0, 3, w, false, 0, 0.0),
        Hit(kind: "close", k: 1),
    )
    assert_eq(hit(tab_x(3, 3, w, false) + 10.0, 20.0, 3, w, false, 0, 0.0).kind, "plus")
    assert_eq(hit(2.0, 20.0, 3, w, false, 0, 0.0).kind, "none")

@test fn the_menu_rows_depend_on_the_tab_and_what_was_closed()
    assert_eq(menu_rows(0, 1, 0), ["Close tab"])
    assert_eq(menu_rows(0, 3, 0), ["Close tab", "Close other tabs", "Close tabs to the right"])
    assert_eq(menu_rows(2, 3, 1), ["Close tab", "Close other tabs", "Reopen closed tab"])

@test fn an_open_menu_takes_the_clicks_below_the_bar()
    assert_eq(
        hit(110.0, BAR_H + 4.0 + ROW_H + 3.0, 2, 800.0, false, 3, 100.0),
        Hit(kind: "menu", k: 1),
    )
    assert_eq(hit(500.0, BAR_H + 10.0, 2, 800.0, false, 3, 100.0).kind, "none")

@test fn many_tabs_shrink_to_fit_the_strip()
    assert(tab_w(20, 800.0, false) < tab_w(3, 800.0, false))
    assert(
        tab_x(
            19,
            20,
            800.0,
            false,
        ) + tab_w(20, 800.0, false) <= 800.0 or tab_w(20, 800.0, false) == MIN_TAB_W,
    )

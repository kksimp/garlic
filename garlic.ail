    assert(failed_body("https://a.org/x", 404, "  ").contains("HTTP status 404"))

@test fn timings_list_phases_in_load_order_then_counters()
    p := ref Perf(
        start: 0,
        ms: {"fetch.sheets": 5, "html.parse": 2},
        counts: {"requests": 3},
        pending: false,
    )
    assert_eq(timing_lines(p, 9), [
        "timings: nav.total 9 ms",
        "timings: html.parse 2 ms",
        "timings: fetch.sheets 5 ms",
        "timings: requests 3",
    ])


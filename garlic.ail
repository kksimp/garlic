@test fn wrapping_chips_keep_their_padding_apart()
    s := pixels(
        "<body style='margin:0'><div style='display:flex;flex-wrap:wrap;gap:6px'><span style='padding:2px 8px;background:#333'>one</span><span style='padding:2px 8px;background:#333'>two</span></div></body>",
        300.0,
    )
    mut starts := List[float]()
    mut ends := List[float]()
    for op in s.ops
        match op
            Rect(x, _, w, _, c) => if c == 0x333333
                starts.push(x)
                ends.push(x + w)
            Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => starts = starts
    assert_eq(starts.len(), 2)
    assert(starts[1] >= ends[0] + 5.0)

@test fn pixel_forms_take_typing_and_submit_with_enter()
    b := Browser.new("{testdata()}/form.html", 60, 12)
    mut g := Gui.new(b, 600.0, 400.0, 7.5, 15.0)
    g.pixel = true
    g.refresh()
    mut at := -1
    for k in 0..g.scene.hits.len()
        h := g.scene.hits[k]
        if at < 0 and h.node >= 0 and g.b.role_of(h.node) == "textbox"
            at = k
    assert(at >= 0)
    f := g.scene.hits[at]
    g.click(f.x + 2.0, f.y + 2.0)
    assert_eq(g.b.editing(), f.node)
    g.refresh()
    assert(g.scene_edit == f.node)
    g.key("h", false, false)
    g.key("i", false, false)
    assert_eq(g.b.doc.attr(f.node, "value"), "hi")
    g.key("enter", false, false)
    assert(g.b.url.contains("q=hi"))


    mut l := app.key("l")
    l.meta = true
    a.update(l)
    assert(a.omni.editing)
    for c in "ail".chars()
        a.update(app.key("{c}"))
    rows := a.suggestions()
    assert_eq(rows.len(), 2)
    assert_eq(a.pick_row, -1)
    a.update(app.key("down"))
    assert_eq(a.pick_row, 0)
    a.update(app.key("down"))
    assert_eq(a.pick_row, 1)
    a.update(app.key("down"))
    assert_eq(a.pick_row, -1)
    a.update(app.key("up"))
    assert_eq(a.pick_row, 1)
    a.view()
    a.update(app.key("escape"))
    assert_eq(a.suggestions().len(), 0)

@test fn dragging_over_the_page_selects_text_that_cmd_c_copies()

fn probe_font(style str) str
    s := gfx.layout(
        html.parse("<p style=\"{style}\">zq</p>"),
        "file:///t.html",
        400.0,
        css.parse("", 0),
    )
    for p in s.probes
        if p.text == "zq"
            return p.font
    "none"

@test fn urlencode_escapes_utf8()
    assert_eq(urlencode("a b~é€/"), "a+b%7E%C3%A9%E2%82%AC%2F")

@test fn dom_mutations_are_recorded()
    mut d := html.parse("<p id=a>one</p>")
    p := d.first("p")?
    d.set_text(p, "two")
    li := d.create("LI")
    d.append(d.first("body")?, li)
    d.append(li, d.create_text("x"))
    d.insert_before(d.first("body")?, li, p)
    assert_eq(d.text(d.first("body")?), "xtwo")
    assert(d.changed.contains(p) and d.changed.contains(li))
    d.detach(p)
    assert_eq(d.text(0), "x")

@test fn css_selectors_parse_and_match()
    d := html.parse("<div id=m class='a b'><p class=x>1</p><ul><li><a href=h>2</a></ul></div>")
    p := d.first("p")?
    a := d.first("a")?
    assert(css.matches(d, p, css.selector("div#m > p.x")?))
    assert(css.matches(d, a, css.selector("#m a[href]")?))
    assert(css.matches(d, a, css.selector(".a.b li a[href=h]")?))
    assert(not css.matches(d, a, css.selector("div > a")?))
    assert(not css.matches(d, p, css.selector("p.y")?))
    assert(css.selector("a:hover") == none)

@test fn css_selectors_pseudo_classes_siblings_escapes_and_attribute_operators()
    d := html.parse("<ul><li class='a md:flex'>1</li><li id=two>2</li><li>3</li></ul><a href='https://x.org/f.pdf' data-k='p q'>l</a>")
    lis := d.all("li")
    a := d.first("a")?
    assert(css.matches(d, lis[0], css.selector("li:first-child")?))
    assert(not css.matches(d, lis[1], css.selector("li:first-child")?))
    assert(css.matches(d, lis[2], css.selector("li:last-child")?))
    assert(css.matches(d, lis[1], css.selector("li:nth-child(2)")?))
    assert(css.matches(d, lis[0], css.selector("li:nth-child(odd)")?))
    assert(css.matches(d, lis[2], css.selector("li:nth-child(2n+1)")?))
    assert(not css.matches(d, lis[1], css.selector("li:nth-child(odd)")?))
    assert(css.matches(d, lis[0], css.selector("li:nth-child(-n+2)")?))
    assert(not css.matches(d, lis[2], css.selector("li:nth-child(-n+2)")?))
    assert(css.matches(d, lis[2], css.selector("li:nth-last-child(1)")?))
    assert(css.matches(d, lis[1], css.selector("li + li")?))
    assert(not css.matches(d, lis[0], css.selector("li + li")?))
    assert(css.matches(d, lis[2], css.selector("li.a ~ li")?))
    assert(not css.matches(d, lis[2], css.selector("li.a + li")?))
    assert(css.matches(d, lis[0], css.selector(".md\\:flex")?))
    assert(css.matches(d, lis[1], css.selector("li:not(.a)")?))
    assert(not css.matches(d, lis[0], css.selector("li:not(.a)")?))
    assert(css.matches(d, a, css.selector("a[href^=https]")?))
    assert(css.matches(d, a, css.selector("a[href$=.pdf]")?))
    assert(css.matches(d, a, css.selector("a[data-k~=q]")?))
    assert(not css.matches(d, a, css.selector("a[data-k~=z]")?))
    assert(css.matches(d, a, css.selector("a:link")?))
    assert(css.selector("li::before") == none)
    assert(css.selector("a:focus-within") == none)
    assert(css.selector("li >") == none)
    assert(css.selector("li:not(.a):first-child")?.specificity > css.selector("li:first-child")?.specificity)

@test fn css_layer_blocks_apply_as_unlayered_rules()
    sheet := css.parse(
        "@layer a, b; @layer b \{ p \{ display: none } @media (min-width: 10px) \{ i \{ display: block } } } @layer c \{ b \{ display: block } }",
        0,
    )
    assert_eq(sheet.rules.len(), 3)

@test fn css_supports_blocks_apply_unless_they_are_fallbacks()
    sheet := css.parse(
        "@supports (display: grid) \{ p \{ display: none } } @supports not (display: grid) \{ i \{ display: block } } @supports (-webkit-hyphens: none) \{ b \{ display: block } }",
        0,
    )
    assert_eq(sheet.rules.len(), 1)

@test fn css_rule_lists_split_outside_parentheses()
    sheet := css.parse("li:not(.a, .b) \{ display: none } p, i \{ display: block }", 0)
    assert_eq(sheet.rules.len(), 2)

@test fn css_cascade_specificity_order_important_and_inline()
    sheet := css.parse(
        "p \{ display: none } .x \{ display: block; font-weight: bold } /* c */ @media print \{ p \{ display: inline } } p \{ font-style: italic !important } #y \{ font-style: normal }",
        0,
    )
    d := html.parse("<p class=x id=y style='font-weight: normal'>t</p>")
    got := css.cascade(d, d.first("p")?, sheet)
    assert_eq(got["display"], "block")
    assert_eq(got["font-weight"], "normal")
    assert_eq(got["font-style"], "italic")

@test fn css_hides_inlines_and_styles_text()

@test fn serve_answers_mcp_requests()
    mut b := Browser.empty("about:blank", 80, 24)
    mut g := Guard(allow: ["*"], log: [], fixed: [], ok_once: false)
    init := b.rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}")
    assert(init.contains("\"serverInfo\""))
    assert_eq(b.rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"), "")
    assert(
        b
            .rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"id\":\"a\",\"method\":\"tools/list\"}")
            .contains("\"screenshot\""),
    )
    call := b.rpc(
        mut g,
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"{testdata()}/form.html\"}}}",
    )
    assert(call.contains("\"content\""))
    assert(call.contains("textbox"))

@test fn serve_enforces_site_permission_confirmation_and_logs()
    mut b := Browser.empty("about:blank", 80, 24)
    mut g := Guard(allow: ["example.com"], log: [], fixed: [], ok_once: false)
    no := b.rpc(
        mut g,
        "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"https://evil.test/x\"}}}",
    )
    assert(no.contains("refused"))
    assert_eq(host_of("https://example.com:8080/a"), "example.com")
    mut open := Guard(allow: ["*"], log: [], fixed: [], ok_once: false)
    b.rpc(
        mut open,
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"{testdata()}/form.html\"}}}",
    )
    held := b.rpc(
        mut open,
        "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":\{\"name\":\"act\",\"arguments\":\{\"do\":\"submit\",\"id\":1}}}",
    )
    assert(held.contains("confirm required"))
    assert_eq(open.log.len(), 2)

@test fn an_attached_agent_drives_the_window_through_the_inbox()
    b := Browser.new("{testdata()}/form.html", 80, 24)
    mut a := Garlic.new(b, 800.0, 600.0, 7.5, 15.0)
    a.attached = true
    a.where = "http://127.0.0.1:1/mcp"
    a.update(app.external("mcp", "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"observe\",\"arguments\":\{}}}"))
    answer := a.bridge.replies.recv() else "none"
    assert(answer.contains("Search form"))
    assert_eq(a.calls, 1)
    assert(a.agent_line().contains("1 calls"))
    a.update(app.external("mcp", "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"https://elsewhere.test/\"}}}"))
    assert(a.pending != "")
    a.update(app.press("agent_deny"))
    refused := a.bridge.replies.recv() else "none"
    assert(refused.contains("denied"))
    a.update(app.external("mcp", "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":\{\"name\":\"log\",\"arguments\":\{}}}"))
    assert((a.bridge.replies.recv() else "").contains("open https://elsewhere.test/"))


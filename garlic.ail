    g.click(first.x + 1.0, first.y + 1.0)
    assert(not g.b.reading())

# Page-load phases of Garlic on a saved page, in milliseconds:
#   ail build garlic.ail -o garlic && ./garlic --bench FILE [ROUNDS]
# Each phase runs ROUNDS times (default 5); the lowest time is printed.

fn bench_run(phase int, src str, d html.Doc, sheet css.Sheet) int
    if phase == 0
        return html.parse(src).all("a").len()
    if phase == 1
        return css.document_sheet(d).rules.len()
    if phase == 2
        return page.layout_with(d, "https://x.test/", 100, sheet).rows.len()
    gfx.layout(d, "https://x.test/", 1000.0, sheet).ops.len()

## `garlic --bench FILE [ROUNDS]`: `args` are the words after `--bench`.
fn bench(args List[str])
    if args.len() < 1
        io.eprint("usage: bench FILE [ROUNDS]")
        return
    src := fs.read_text(args[0]) else
        io.eprint("can't read {args[0]}")
        return
    rounds := if args.len() > 1 then (args[1].to_int() else 5) else 5
    d := html.parse(src)
    sheet := css.document_sheet(d)
    names := ["html.parse ", "css sheet  ", "page.layout", "gfx.layout "]
    for phase in 0..4
        mut lo := 1000000000
        mut keep := 0
        for _ in 0..rounds
            t0 := time.now_ms()
            keep = bench_run(phase, src, d, sheet)
            dt := time.now_ms() - t0
            if dt < lo
                lo = dt
        print("{names[phase]}: {lo} ms ({keep})")

@test fn voltare_page_gets_variables_logo_icon_link_and_gradient_text()
    s := pixels(fs.read_text("{testdata()}/voltare.html") else "", 900.0)
    assert_eq(s.bg, 0x0a0a0f)
    mut texts := List[(str, int)]()
    for op in s.ops
        match op
            Str(_, _, t, _, _, fg, _, _, _) => texts.push((t, fg))
            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => texts = texts
    assert_eq(texts[0], ("Voltare", 0xf0f0f5))
    assert_eq(texts[1], ("Support", 0x6b6b80))
    assert_eq(texts[2], ("GitHub", 0x6b6b80))
    assert_eq(texts[3], ("Donations", 0x6b6b80))
    assert_eq(texts[4], ("Projects", 0xffffff))
    mut dot := false
    for op in s.ops
        match op
            Rect(_, _, w, h, c) => if c == 0x6c5ce7 and w == 8.0 and h == 8.0
                dot = true
            Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => dot = dot
    assert(dot)

@test fn pictures_without_sizes_take_their_own_from_the_fetched_header()
    dir := "{env.cwd()}/vendor/image/testdata"
    d := html.parse("<img src=gray8.png><img src=jpeg420.jpg height=58><img src=missing.png>")
    mut sizes := Map[str, List[int]]()
    mut bits := Map[str, images.Bitmap]()
    images.prefetch(d, "file://{dir}/page.html", "", jar.new(), options(), mut sizes, mut bits)
    assert_eq(bits["file://{dir}/gray8.png"].w, 37)
    assert_eq(sizes["file://{dir}/gray8.png"], [37, 29])
    assert_eq(sizes["file://{dir}/missing.png"], [0, 0])
    scene := gfx.layout_with(d, "file://{dir}/page.html", 400.0, css.parse("", 0), sizes)
    mut got := List[List[float]]()
    for op in scene.ops
        match op
            draw.Op.Pic(x, y, w, h, src) => got.push([w, h])
            draw.Op.Rect(_, _, _, _, _) => 0
            draw.Op.Text(_, _, _, _, _, _, _) => 0
            draw.Op.Str(_, _, _, _, _, _, _, _, _) => 0
    assert_eq(got, [[37.0, 29.0], [74.0, 58.0]])


## garlic: a web browser written in AIL (docs/design/garlic-browser.md).
##
## Text mode: it fetches a page over `std.net` (or reads a file), parses it
## with `html`, lays it out in text cells with `page`, and shows it in the
## `std.app` window host. Every page is also a page model an agent reads with
## `--json`: roles, names, links and the cells each was drawn in.

use std.env
use std.io
use std.fs
use std.net
use std.proc
use std.net.jar
use std.compress
use std.time
use std.app
use html
use page
use css
use draw
use gfx
use jsdom
use images
use attach
use ws

## The keys, as `--keys` prints them.
KEYS := [
    "Tab, Shift-Tab    next, previous link or form control",
    "Enter, click      follow a link, edit a field, press a button, toggle a box",
    "Backspace, Alt-Left  back; Alt-Right forward",
    "Up, Down, PageUp, PageDown, Home, End, Space  scroll",
    "g                 open a URL or file",
    "/                 find text; n finds the next match",
    "r                 reload",
    "q, Escape         quit",
]

## What the bottom row is doing: showing the status, or reading a URL, a
## search, or the text for form field `id`.
enum Prompt
    Status
    Url(text str)
    Find(text str)
    Field(id int, text str)

## The browser: the page shown (its tree and layout), where it is scrolled,
## the focused target (0 for none) and the pages to go back to.
struct Browser
    url str
    doc html.Doc
    ## The page's linked style sheets (`<link rel=stylesheet>`), as one.
    sheet css.Sheet
    pg page.Page
    scroll int
    focus int
    width int
    height int
    back List[str]
    message str
    prompt Prompt
    last_find str
    ## Whether the page model lists only the viewport's nodes (`--viewport`).
    viewport_only bool
    ## The page model's size limit in tokens (`--budget N`), 0 for none.
    budget int
    ## Whether `--session` answers with diffs (`--diff`), and what it last sent.
    diff bool
    last_url str
    last_nodes Map[int, str]
    ## Cookies from responses and scripts, sent back to their sites.
    cj jar.Jar
    ## Sheets and scripts fetched before, for `fetch_text`.
    cache Map[str, Cached]
    ## The page a link or form leads from, for the next load only ("" for a
    ## typed address, Back or Reload): the `Referer`, and SameSite cookies.
    refer str
    ## Set by Reload for the next load: ask the server even if the copy is fresh.
    reloading bool
    ## The page's open WebSockets by the number its scripts know them by.
    socks Map[int, ws.Sock]
    ## Counts page layouts, so the pixel window knows when to lay out again.
    stamp int
    ## Pixel sizes of the page's pictures by address (`images.prefetch`).
    sizes Map[str, List[int]]
    ## Pages left behind, kept so Back and Forward show them again without
    ## a fetch, oldest first in `kept_order`; and the pages Back came from.
    kept Map[str, Kept]
    kept_order List[str]
    ahead List[str]
    ## The pictures decoded for the window host, by address.
    bits Map[str, images.Bitmap]
    ## The page's engine while its scripts listen; clicks, typing and
    ## submits go through it first (GL-JS events).
    js jsdom.Session?

## A page as it was left: its tree, style sheets and place.
struct Kept
    doc html.Doc
    sheet css.Sheet
    scroll int

## Pages kept for Back and Forward.
MAX_KEPT := 16

## The headers Garlic sends: who it is, and that it wants HTML.
fn options() net.Options
    mut o := net.options()
    o.headers["user-agent"] = "Garlic/0.1 (AIL; text)"
    o.headers["accept"] = "text/html,application/xhtml+xml;q=0.9,text/plain;q=0.8,*/*;q=0.5"
    o.headers["accept-language"] = "en"
    o.headers["accept-encoding"] = "gzip, deflate"
    o

## The headers for a picture: any image type.
fn image_options() net.Options
    mut o := options()
    o.headers["accept"] = "image/png,image/jpeg,image/gif,*/*;q=0.5"
    o.headers["accept-encoding"] = "identity"
    o

## The text of `url`: `http` and `https` through `net.request` (which
## follows redirects), with `method` and a form `body`; `file://` and
## anything without a scheme from the file system. A failure is shown as a
## page, so the browser keeps going.
fn fetch(url str, method str, body str) str
    mut cj := jar.new()
    fetch_with(url, method, body, mut cj)

## `fetch`, sending `cj`'s cookies for the site and keeping the ones the
## response sets.
fn fetch_with(url str, method str, body str, mut cj jar.Jar) str
    mut none_kept := Map[str, Cached]()
    fetch_got(url, method, body, "", true, false, mut cj, mut none_kept).text

## What a fetch got: the address it ended at (after redirects) and the page.
struct Got
    url str
    text str
    ## False when nothing came or the status was 400 or more (`text` then
    ## shows why).
    ok bool

MAX_HOPS := 10

## Replies to a page's `fetch` and XMLHttpRequest asks, per load.
MAX_REPLIES := 32

## `fetch_with`, also telling where redirects ended. Every hop sends the
## cookies the jar holds for it and stores the ones it sets, so a login that
## sets a cookie on a redirect works; a 301, 302 or 303 turns a POST into a
## GET without its body.
fn fetch_got(
    url str,
    method str,
    body str,
    from str,
    navigation bool,
    reload bool,
    mut cj jar.Jar,
    mut cache Map[str, Cached],
) Got
    s := page.scheme(url)
    if s == "http" or s == "https"
        now := time.now_ms()
        have := if method == "GET" then cache.get(url) else none
        if h := have
            if not reload and h.fresh_until > now
                return Got(url: h.final_url, text: h.text, ok: true)
        mut cond := Map[str, str]()
        if h := have
            ## Only an answer that didn't come through a redirect can be asked
            ## about on the first request.
            if h.final_url == url
                if h.etag != ""
                    cond["if-none-match"] = h.etag
                if h.modified != ""
                    cond["if-modified-since"] = h.modified
        w := walk(
            method,
            url,
            body,
            if method == "POST" then "application/x-www-form-urlencoded" else "",
            from,
            navigation,
            true,
            cond,
            mut cj,
        )
        if w.failure != ""
            return Got(url: w.url, text: error_page(w.url, w.failure), ok: false)
        if w.status == 304
            if h := have
                cache[url] = Cached(
                    text: h.text,
                    final_url: h.final_url,
                    etag: h.etag,
                    modified: h.modified,
                    fresh_until: fresh_until(w.headers, now, h.fresh_until),
                )
                return Got(url: h.final_url, text: h.text, ok: true)
        if w.status >= 400
            return Got(url: w.url, text: "{w.text}<p>(HTTP status {w.status})", ok: false)
        if method == "GET" and w.status == 200
            keep_cached(url, w, now, mut cache)
        return Got(url: w.url, text: w.text, ok: true)
    file := (url.strip_prefix("file://") else url).split("?")[0].split("#")[0]
    data := fs.read_bytes(file) else err
        return Got(url, error_page(url, "{err}"), false)
    Got(url, decode(data, ""), true)

## When a response stops being fresh (ms): by `max-age`, else `fallback`
## (a 304 without one keeps what the copy had, a new answer passes 0).
fn fresh_until(headers Map[str, str], now int, fallback int) int
    age := max_age(headers.get("cache-control") else "")
    if age > 0
        return now + age * 1000
    if age == 0
        return 0
    fallback

## Keeps the answer `w` for `url` when it can be asked about again or is
## fresh, unless it says `no-store` or is large.
fn keep_cached(url str, w Walked, now int, mut cache Map[str, Cached])
    cc := (w.headers.get("cache-control") else "").to_lower()
    etag := w.headers.get("etag") else ""
    modified := w.headers.get("last-modified") else ""
    fresh := fresh_until(w.headers, now, 0)
    useful := etag != "" or modified != "" or fresh > 0
    if cc.contains("no-store") or not useful or w.text.len() > MAX_CACHED_TEXT
        cache.remove(url)
        return
    if cache.contains(url) or cache.len() < MAX_CACHED
        cache[url] = Cached(
            text: w.text,
            final_url: w.url,
            etag: etag,
            modified: modified,
            fresh_until: fresh,
        )

## Where a request ended up after its redirects, and what it got.
struct Walked
    url str
    ## "" or why no response came.
    failure str
    status int
    headers Map[str, str]
    text str

## `method` `url` with `body` (of `ctype`), following redirects by hand. A
## navigation (`navigation`) from the page `from` sends its lax cookies; a
## request that is cross-site sends none (fetch's credentials "same-origin").
fn walk(
    method str,
    url str,
    body str,
    ctype str,
    from str,
    navigation bool,
    creds bool,
    extra Map[str, str],
    mut cj jar.Jar,
) Walked
    mut o := options()
    o.max_redirects = 0
    ## `extra` (conditional headers) goes to the first request only.
    for k in extra.keys()
        o.headers[k] = extra[k]
    mut m := method
    if body != "" and m != "GET" and m != "HEAD"
        o.body = body
        o.headers["content-type"] = if ctype == "" then "text/plain;charset=UTF-8" else ctype
    mut cur := url
    for _ in 0..MAX_HOPS
        cookie := if creds then cj.header_from(cur, from, navigation and m == "GET") else ""
        via_page := page.referrer(from, cur)
        if via_page != ""
            o.headers["referer"] = via_page
        else
            o.headers.remove("referer")
        if cookie != ""
            o.headers["cookie"] = cookie
        else
            o.headers.remove("cookie")
        r := net.request_bytes(m, cur, o) else err
            return Walked(url: cur, failure: "{err}", status: 0, headers: {}, text: "")
        if creds
            for line in r.all_headers.get("set-cookie") else List[str]()
                cj.set_cookie(cur, line)
        loc := r.headers.get("location") else ""
        hop := r.status == 301
            or r.status == 302
            or r.status == 303
            or r.status == 307
            or r.status == 308
        if hop and loc != ""
            cur = page.resolve(cur, loc)
            for k in extra.keys()
                o.headers.remove(k)
            if m != "GET" and m != "HEAD" and r.status != 307 and r.status != 308
                m = "GET"
                o.body = ""
                o.headers.remove("content-type")
            continue
        return Walked(
            url: cur,
            failure: "",
            status: r.status,
            headers: r.headers,
            text: body_text(r),
        )
    Walked(url: cur, failure: "more than {MAX_HOPS} redirects", status: 0, headers: {}, text: "")

## The labels that name windows-1252, which HTML reads `iso-8859-1` and
## `us-ascii` as (WHATWG Encoding).
WINDOWS_1252 := {
    "windows-1252",
    "cp1252",
    "x-cp1252",
    "iso-8859-1",
    "iso8859-1",
    "latin1",
    "l1",
    "us-ascii",
    "ascii",
}

## A response body as text: its `Content-Encoding` (gzip or deflate)
## undone, then decoded by its charset. A body that won't decompress is
## used as it came.
fn body_text(r net.RawResponse) str
    mut data := r.data
    enc := (r.headers.get("content-encoding") else "").trim().to_lower()
    if enc == "gzip" or enc == "x-gzip"
        data = compress.gunzip(data) else data
    elif enc == "deflate"
        data = compress.unzlib(data) else (compress.inflate(data) else data)
    decode(data, r.headers.get("content-type") else "")

## `data` as text in the charset that `content_type` names, or failing that
## a `<meta charset>` in its first 1024 bytes (HTML's prescan, simplified).
## Without either, strict UTF-8 when it is valid and windows-1252 when not.
fn decode(data bytes, content_type str) str
    mut label := charset_label(content_type)
    if label == ""
        head := data[0..data.len().min(1024)].text().to_lower()
        if at := head.find("charset=")
            label = charset_label(head.slice(at, head.chars().len()))
    if label == ""
        if text := data.to_str()
            return text
        label = "windows-1252"
    if not WINDOWS_1252.contains(label)
        return data.text()
    mut ascii := true
    for b in data
        if b >= 0x80
            ascii = false
            break
    if ascii
        return data.text()
    mut out := List[char]()
    for b in data
        out.push(html.windows_1252(b.to_int()))
    out.join("")

## The value of the `charset=` in `s`, lowercased and unquoted; "" if none.
fn charset_label(s str) str
    lower := s.to_lower()
    at := lower.find("charset=") else return ""
    cs := lower.slice(at + 8, lower.chars().len()).trim().chars()
    mut out := List[char]()
    for c in cs
        if c == '"' or c == '\''
            if out.len() == 0
                continue
            break
        if c == ';' or c == ' ' or c == '>' or c == '/' or c == ','
            break
        out.push(c)
    out.join("")

fn error_page(url str, why str) str
    "<title>Can't open {url}</title><h1>Can't open this page</h1><p>{url}</p><p>{why}</p>"

## At most this many hops (a `<meta http-equiv=refresh>` or a script
## sending the browser on) are followed per load.
MAX_REFRESHES := 5

## A refresh with a longer delay is left alone, as the page asks to be read.
MAX_REFRESH_DELAY := 5

## Where the page's `<meta http-equiv=refresh content="N; url=...">` sends
## the browser, when it has a URL other than the page's own and a delay
## of at most `MAX_REFRESH_DELAY` seconds. Garlic goes there at once (HTML
## "shared declarative refresh steps", simplified).
## Some sites send script-less clients to a "turn on JavaScript" page
## this way.
fn refresh_target(d html.Doc, url str, scripting bool) str?
    for m in d.all("meta")
        if (d.attr(m, "http-equiv") else "").trim().to_lower() != "refresh"
            continue
        if scripting and d.enclosing(m, "noscript") != none
            continue
        content := (d.attr(m, "content") else "").trim()
        cs := content.chars()
        mut i := 0
        while i < cs.len() and cs[i].is_digit()
            i += 1
        if i == 0
            continue
        delay := content.slice(0, i).to_int() else continue
        if delay > MAX_REFRESH_DELAY
            continue
        while i < cs.len() and (cs[i].is_digit() or cs[i] == '.')
            i += 1
        mut rest := content.slice(i, cs.len()).trim()
        rest = (rest.strip_prefix(";") else rest.strip_prefix(",") else rest).trim()
        if rest.to_lower().starts_with("url")
            after := rest.slice(3, rest.chars().len()).trim()
            if after.starts_with("=")
                rest = after.slice(1, after.chars().len()).trim()
        if rest.starts_with("\"") or rest.starts_with("'")
            q := rest.slice(0, 1)
            rest = rest.slice(1, rest.chars().len())
            if end := rest.find(q)
                rest = rest.slice(0, end)
        if rest == ""
            continue
        target := page.resolve(url, rest)
        if target != url
            return target
    none

## At most this many linked style sheets are fetched per page.
MAX_SHEETS := 8

## The page's linked style sheets, fetched and parsed in document order.
fn linked_sheets(d html.Doc, url str, mut cj jar.Jar, mut cache Map[str, Cached]) css.Sheet
    mut all := css.parse("", 0)
    mut n := 0
    for l in d.all("link")
        rel := (d.attr(l, "rel") else "").to_lower().split(" ")
        media := (d.attr(l, "media") else "").trim()
        ## A sheet for print, or for no window width at all, isn't fetched;
        ## the rest apply by the window's width at layout.
        fits := css.media_matches(media, 320) or css.media_matches(media, 2000)
        if not rel.contains("stylesheet") or rel.contains("alternate") or not fits
            continue
        href := d.attr(l, "href") else continue
        if n == MAX_SHEETS
            break
        n += 1
        all = css.concat(all, css.parse_in(
            fetch_text(page.resolve(page.base_of(d, url), href), url, mut cj, mut cache),
            0,
            media,
        ))
    all

## The bytes of a `data:` URL's payload (RFC 2397): base64 or %-escapes.
fn data_bytes(url str) bytes
    raw := (url.strip_prefix("data:") else "").to_bytes()
    at := raw.find(b",") else return b""
    payload := raw[at + 1..raw.len()]
    if raw[0..at].text().to_lower().ends_with(";base64")
        return bytes.from_base64(payload.text()) else b""
    mut out := List[u8]()
    mut i := 0
    while i < payload.len()
        if payload[i].to_int() == 37 and i + 2 < payload.len()
            h := bytes.from_hex(payload[i + 1..i + 3].text()) else b""
            if h.len() == 1
                out.push(h[0])
                i += 3
                continue
        out.push(payload[i])
        i += 1
    bytes.from_list(out)

## The text of a `data:` URL, read by its media type's charset.
fn data_text(url str) str
    rest := url.strip_prefix("data:") else ""
    meta := (rest.split(",")[0]).trim()
    decode(data_bytes(url), meta)

## A sub-resource kept for later: its text, its validators, and when it
## stops being fresh (ms; 0 means check again on every use).
struct Cached
    text str
    ## Where a page came to rest after redirects (sheets and scripts: the address).
    final_url str
    etag str
    modified str
    fresh_until int

## Pages, sheets and scripts kept per browser, and the longest text kept.
MAX_CACHED := 64
MAX_CACHED_TEXT := 2000000

## The seconds of `max-age` in a `Cache-Control` value, -1 when absent.
fn max_age(cc str) int
    for part in cc.to_lower().split(",")
        p := part.trim()
        if p.starts_with("max-age=")
            return (p.strip_prefix("max-age=") else "").to_int() else -1
    -1

## The text of a sub-resource of the page `from`, or "" when it can't be
## fetched. It carries the jar's cookies (SameSite as for a subresource) and
## a `Referer`, and stores the cookies it sets. A copy still fresh by
## `max-age` is used without a request; an older one is asked about with
## `If-None-Match` or `If-Modified-Since`, and a 304 renews it. `no-store`
## responses are not kept.
fn fetch_text(url str, from str, mut cj jar.Jar, mut cache Map[str, Cached]) str
    if url.starts_with("data:")
        return data_text(url)
    got := fetch_got(url, "GET", "", from, false, false, mut cj, mut cache)
    if got.ok then got.text else ""

## A loaded page: where it ended up and its tree.
struct Loaded
    url str
    doc html.Doc
    ## The page's engine, when scripts ran and are still listening.
    js jsdom.Session?

## Fetches and parses `target`, then runs its scripts (unless `--no-js`),
## which change the tree or send the browser on to another page.
fn load_doc(
    target str,
    method str,
    body str,
    from str,
    reload bool,
    mut cj jar.Jar,
    mut cache Map[str, Cached],
    mut socks Map[int, ws.Sock],
) Loaded
    mut at := target
    mut m := method
    mut b := body
    mut via := from
    mut first := true
    for _ in 0..MAX_REFRESHES
        got := fetch_got(at, m, b, via, true, reload and first, mut cj, mut cache)
        first = false
        via = at
        at = got.url
        mut d := html.parse(got.text)
        if env.args().contains("--no-js")
            next := refresh_target(d, at, false) else return Loaded(url: at, doc: d, js: none)
            at = next
            m = "GET"
            b = ""
            continue
        mut scripts := Map[str, str]()
        for s in d.all("script")
            if src := d.attr(s, "src")
                u := page.resolve(page.base_of(d, at), src)
                scripts[script_url(u)] = fetch_text(u, at, mut cj, mut cache)
        now := time.now_ms().to_float()
        ## A page with no scripts has nothing to run, and starting the engine
        ## costs about 0.2 s.
        mut session := none
        mut out := jsdom.Outcome(
            url: "",
            method: "",
            body: "",
            console: [],
            missing: [],
            changes: 0,
            cookies: [],
            asks: [],
            sockets: [],
        )
        if d.all("script").len() > 0
            ran := jsdom.start(
                mut d,
                script_url(at),
                scripts,
                cj.for_script(at),
                now,
                1000.0,
                5000000,
            )
            mut live := ran.0
            out = serve_page(mut live, mut d, ran.1, at, mut cj, mut socks)
            session = live
        for line in out.cookies
            cj.set_from_script(at, line)
        if env.args().contains("--console")
            for line in out.console
                io.eprint("console: {line}")
        mut next := local_url(out.url)
        if next == "" or next == at
            # A `<meta http-equiv=refresh>` in `<noscript>` is for browsers
            # without scripts (HTML §4.12.2).
            next = refresh_target(d, at, true) else ""
            if next == ""
                return Loaded(url: at, doc: d, js: session)
            m = "GET"
            b = ""
        else
            m = out.method
            b = out.body
        at = next
    last := fetch_got(at, m, b, via, true, false, mut cj, mut cache)
    Loaded(url: last.url, doc: html.parse(last.text), js: none)

## What page scripts asked the browser for, answered against the live engine
## `live`; the scripts never run again. `fetch` and XMLHttpRequest requests
## (`out.asks`) are made and their replies handed back; WebSocket operations
## (`out.sockets`) open, write to and close the connections in `socks`, and
## whatever the open sockets have received is delivered. An answer can ask
## for more. What it all did is added to `out`.
fn serve_page(
    mut live jsdom.Session,
    mut d html.Doc,
    first jsdom.Outcome,
    at str,
    mut cj jar.Jar,
    mut socks Map[int, ws.Sock],
) jsdom.Outcome
    mut out := first
    mut asks := first.asks
    mut ops := first.sockets
    out.asks = []
    out.sockets = []
    mut work := 0
    mut polled := false
    while work < MAX_REPLIES
        mut more := quiet()
        if asks.len() > 0
            ask := asks.remove_at(0)
            more = live.reply(mut d, ask.id, script_reply(ask, at, mut cj), 1000.0)
        elif ops.len() > 0
            op := ops.remove_at(0)
            more = socket_op(mut live, mut d, op, at, mut cj, mut socks)
        elif not polled and socks.len() > 0
            ## A moment for the server to speak after an open or a send.
            polled = true
            more = deliver_received(mut live, mut d, mut socks, if work > 0 then 50 else 1)
            if more.changes == 0 and more.sockets.len() == 0 and more.asks.len() == 0
                break
        else
            break
        work += 1
        if out.url == ""
            out.url = more.url
            out.method = more.method
            out.body = more.body
        out.console.extend(more.console)
        out.cookies.extend(more.cookies)
        out.changes += more.changes
        asks.extend(more.asks)
        ops.extend(more.sockets)
        if more.changes > 0 or more.asks.len() > 0 or more.sockets.len() > 0
            polled = false
    out

fn quiet() jsdom.Outcome
    jsdom.Outcome(
        url: "",
        method: "",
        body: "",
        console: [],
        missing: [],
        changes: 0,
        cookies: [],
        asks: [],
        sockets: [],
    )

## One WebSocket operation of the page: connects (as a page does: with its
## origin and the cookies of the socket's site), writes or closes.
fn socket_op(
    mut live jsdom.Session,
    mut d html.Doc,
    op jsdom.SockOp,
    at str,
    mut cj jar.Jar,
    mut socks Map[int, ws.Sock],
) jsdom.Outcome
    if op.op == "open"
        asked := op.url.replace("ws://", "http://").replace("wss://", "https://")
        cookie := cj.header_from(asked, at, false)
        opened := ws.connect(op.url, op.text, origin_of(at), cookie) else err
            first := live.ws_event(mut d, op.id, "error", "", 0, 1000.0)
            return live.ws_event(mut d, op.id, "close", "", 1006, 1000.0)
        socks[op.id] = opened
        return live.ws_event(mut d, op.id, "open", opened.protocol, 0, 1000.0)
    mut s := socks.get(op.id) else return quiet()
    if op.op == "send"
        s.send_text(op.text) else err
            socks.remove(op.id)
            first := live.ws_event(mut d, op.id, "error", "", 0, 1000.0)
            return live.ws_event(mut d, op.id, "close", "", 1006, 1000.0)
        socks[op.id] = s
        return quiet()
    code := op.text.to_int() else 1000
    s.close(code)
    socks.remove(op.id)
    live.ws_event(mut d, op.id, "close", "", code, 1000.0)

## Hands the page what its open sockets have received.
fn deliver_received(
    mut live jsdom.Session,
    mut d html.Doc,
    mut socks Map[int, ws.Sock],
    wait_ms int,
) jsdom.Outcome
    mut out := quiet()
    for id in socks.keys()
        mut s := socks.get(id) else continue
        events := s.poll(wait_ms)
        socks[id] = s
        for ev in events
            more := live.ws_event(mut d, id, ev.kind, ev.text, ev.code, 1000.0)
            out.console.extend(more.console)
            out.cookies.extend(more.cookies)
            out.changes += more.changes + 1
            out.asks.extend(more.asks)
            out.sockets.extend(more.sockets)
            if out.url == ""
                out.url = more.url
                out.method = more.method
                out.body = more.body
            if ev.kind == "close"
                socks.remove(id)
    out

## The origin (`scheme://host:port`) of an address.
fn origin_of(u str) str
    parts := u.split("/")
    if parts.len() < 3
        return ""
    parts[0..3].join("/")

## What `fetch` or XMLHttpRequest from the page `from` gets for `ask`, as the
## JSON the script side reads (jsdom, vm/netapi.ail). Cookies go only to the
## page's own origin; another origin must allow it with
## `Access-Control-Allow-Origin` (`*` or the page's origin), else the script
## sees a network error, as in a browser. Custom request headers and
## preflights are not sent.
fn script_reply(ask jsdom.Ask, from str, mut cj jar.Jar) str
    failed := r"""{"error":true}"""
    s := page.scheme(ask.url)
    if s != "http" and s != "https"
        return failed
    lines := ask.packed.split("\n")
    ctype := lines[0]
    body := lines[1..lines.len()].join("\n")
    same := origin_of(from) == origin_of(ask.url)
    w := walk(ask.method, ask.url, body, ctype, from, false, same, {}, mut cj)
    if w.failure != ""
        return failed
    if origin_of(w.url) != origin_of(from)
        allow := w.headers.get("access-control-allow-origin") else ""
        if allow != "*" and allow != origin_of(from)
            return failed
    mut hs := List[str]()
    for k in w.headers.keys()
        hs.push("{page.quote(k)}:{page.quote(w.headers[k])}")
    "\{\"status\":{w.status},\"statusText\":\"\",\"url\":{page.quote(w.url)},\"headers\":\{{hs.join(",")}},\"body\":{page.quote(w.text)}}"

## The address scripts see: a local file gets a file:// URL.
fn script_url(u str) str
    if u.contains("://") then u else "file://local/{u}"

fn local_url(u str) str
    u.strip_prefix("file://local/") else u

fn Browser.new(url str, width int, height int) Browser
    mut b := Browser.empty(url, width, height)
    b.load(url, "GET", "")
    b

## A browser showing nothing yet, as a new tab does (`url` is only its label).
fn Browser.empty(url str, width int, height int) Browser
    d := html.parse("")
    sheet := css.parse("", 0)
    mut b := Browser(
        url,
        doc: d,
        sheet,
        pg: page.layout_with(d, url, width, sheet),
        scroll: 0,
        focus: 0,
        width,
        height,
        back: [],
        message: "",
        prompt: Status,
        last_find: "",
        viewport_only: false,
        budget: 0,
        diff: false,
        last_url: "",
        last_nodes: {},
        cj: jar.new(),
        cache: {},
        refer: "",
        reloading: false,
        socks: {},
        stamp: 0,
        sizes: {},
        kept: {},
        kept_order: [],
        ahead: [],
        bits: {},
        js: none,
    )
    b

## Rows of page the window shows: all but the status row.
fn Browser.view(self) int
    (height - 1).max(1)

fn Browser.max_scroll(self) int
    (pg.rows.len() - view()).max(0)

fn Browser.scroll_to(mut self, row int)
    scroll = row.max(0).min(max_scroll())

## Lays the page out again, after a resize or a change to a form control.
fn Browser.relayout(mut self)
    pg = page.layout_with(doc, url, width, sheet)
    stamp += 1
    scroll_to(scroll)

## Opens `target`, remembering the current page for Back.
fn Browser.go(mut self, target str)
    refer = url
    go_typed(target)

## `go` for an address the person typed: no referring page.
fn Browser.go_typed(mut self, target str)
    leave()
    ahead.clear()
    load(target, "GET", "")

## Pushes the current page on Back's stack and keeps its tree and place, so
## coming back needs no request.
fn Browser.leave(mut self)
    back.push(url)
    keep()

fn Browser.keep(mut self)
    if not kept.contains(url)
        kept_order.push(url)
        if kept_order.len() > MAX_KEPT
            kept.remove(kept_order.remove_at(0))
    kept[url] = Kept(doc, sheet, scroll)

## Shows `target` from the kept pages if it's there (with its scroll place),
## else fetches it.
fn Browser.revisit(mut self, target str)
    if k := kept.get(target)
        url = target
        doc = k.doc
        sheet = k.sheet
        pg = page.layout_with(doc, url, width, sheet)
        js = none
        stamp += 1
        scroll_to(k.scroll)
        focus = 0
        message = ""
    else
        load(target, "GET", "")

## Closes the page's WebSockets, as leaving the page does.
fn Browser.close_sockets(mut self)
    for id in socks.keys()
        mut s := socks.get(id) else continue
        s.close(1001)
        socks.remove(id)

## Delivers what the page's open sockets have received (the host calls this
## as events arrive), and shows what the page did with it.
fn Browser.pump(mut self)
    if socks.len() == 0
        return
    mut s := js else return
    out := serve_page(mut s, mut doc, quiet(), url, mut cj, mut socks)
    js = s
    if not js_went(out)
        relayout()

## Fetches the current page again, asking the server about any kept copy.
fn Browser.reload(mut self)
    reloading = true
    load(url, "GET", "")

fn Browser.load(mut self, target str, method str, body str)
    close_sockets()
    loaded := load_doc(target, method, body, refer, reloading, mut cj, mut cache, mut socks)
    reloading = false
    refer = ""
    url = loaded.url
    doc = loaded.doc
    js = loaded.js
    sheet = linked_sheets(doc, url, mut cj, mut cache)
    pg = page.layout_with(doc, url, width, sheet)
    stamp += 1
    scroll = 0
    focus = 0
    message = ""
    ## A fresh load replaces any copy kept for that address.
    kept.remove(url)
    kept_order = [u for u in kept_order if u != url]

fn Browser.go_back(mut self)
    prev := back.pop() else
        message = "no page to go back to"
        return
    ahead.push(url)
    keep()
    revisit(prev)

fn Browser.go_forward(mut self)
    next := ahead.pop() else
        message = "no page to go forward to"
        return
    back.push(url)
    keep()
    revisit(next)

## Follows link `n` (1-based).
fn Browser.follow(mut self, n int)
    if n < 1 or n > pg.links.len()
        message = "no link {n}"
        return
    href := pg.boxes[pg.links[n - 1]].href
    if href.starts_with("#")
        return
    go(href)

## Moves focus to the next target (`forward`) or the previous one,
## wrapping, and scrolls it into view.
fn Browser.step_focus(mut self, forward bool)
    n := pg.targets.len()
    if n == 0
        message = "nothing to focus on this page"
        return
    if forward
        focus = focus % n + 1
    else
        focus = if focus <= 1 then n else focus - 1
    b := pg.boxes[pg.targets[focus - 1]]
    if b.row < scroll or b.end_row > scroll + view()
        scroll_to(b.row - view() / 3)
    js_focus(b.id)

## Tells the page's scripts focus moved to node `id` (`blur`, `focus`).
fn Browser.js_focus(mut self, id int)
    if js == none
        return
    mut s := js else return
    out := s.focus(mut doc, id, 1000.0)
    js = s
    if out.changes > 0
        relayout()

## Tells the page's scripts the user pressed `key` in node `id`. True when
## a listener cancelled it, so the browser's own action should not follow.
fn Browser.js_key(mut self, id int, key str) bool
    if js == none
        return false
    mut s := js else return false
    out := s.key(mut doc, id, key, 1000.0)
    js = s
    if js_went(out)
        return true
    if out.changes > 0
        relayout()
    s.prevented

## Scrolls to the next row after the top one that contains `needle`.
fn Browser.find(mut self, needle str)
    last_find = needle
    if needle == ""
        return
    if r := pg.find(needle, scroll + 1)
        scroll_to(r)
        message = "found `{needle}` on row {r + 1}"
    elif r := pg.find(needle, 0)
        scroll_to(r)
        message = "found `{needle}` on row {r + 1} (wrapped)"
    else
        message = "`{needle}` not found"

## `text` after a key typed into a prompt: Backspace deletes, a character
## adds; none when the key does neither.
fn edit_text(text str, key str) str?
    if key == "backspace"
        return text.slice(0, (text.chars().len() - 1).max(0))
    if key == "space"
        return "{text} "
    if key.chars().len() == 1
        return "{text}{key}"
    none

## Handles a key; false when the browser should close.
fn Browser.key(mut self, key str, alt bool, shift bool) bool
    match prompt
        Url(text) =>
            prompt = Status
            if key == "enter"
                if text != ""
                    go(text)
            elif key != "escape"
                prompt = Url(edit_text(text, key) else text)
            return true
        Find(text) =>
            prompt = Status
            if key == "enter"
                find(text)
            elif key != "escape"
                prompt = Find(edit_text(text, key) else text)
            return true
        Field(id, text) =>
            prompt = Status
            if key == "enter"
                type_into(id, text)
                if not js_key(id, "Enter")
                    submit(id)
            elif key == "tab"
                type_into(id, text)
                step_focus(not shift)
            elif key != "escape"
                prompt = Field(id, edit_text(text, key) else text)
            return true
        Status => message = ""
    match key
        "q" | "escape" => return false
        "tab" => step_focus(not shift)
        "enter" =>
            if focus > 0
                activate(pg.boxes[pg.targets[focus - 1]].id)
        "backspace" => go_back()
        "left" =>
            if alt
                go_back()
        "right" =>
            if alt
                go_forward()
        "up" => scroll_to(scroll - 1)
        "down" => scroll_to(scroll + 1)
        "pageup" => scroll_to(scroll - view())
        "pagedown" | "space" => scroll_to(scroll + view())
        "home" => scroll_to(0)
        "end" => scroll_to(max_scroll())
        "g" => prompt = Url("")
        "/" => prompt = Find("")
        "n" => find(last_find)
        "r" => reload()
        _ => return true
    true

## The box of target node `id`, or none when `id` takes no action.
fn Browser.target(self, id int) page.Box?
    for t in pg.targets
        if pg.boxes[t].id == id
            return pg.boxes[t]
    none

## Acts on target node `id` as Enter or a click does: follows a link,
## edits a text field (in the window), submits with a button, toggles a
## check box, chooses a radio button.
fn Browser.activate(mut self, id int)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.role == "textbox"
        prompt = Field(id, b.value)
        return
    if js_click(id)
        return
    if b.link > 0
        follow(b.link)
        return
    match b.role
        "link" => follow(b.link)
        "button" => submit(id)
        "checkbox" | "radio" => check(id)
        _ => message = "use select:{id}=OPTION to choose an option"

## The page's scripts take a click on node `id` first. True when they dealt
## with it (cancelled it, navigated, or toggled a check box); false when
## the browser's own action should follow.
fn Browser.js_click(mut self, id int) bool
    mut s := js else return false
    out := serve_page(mut s, mut doc, s.click(mut doc, id, 1000.0), url, mut cj, mut socks)
    js = s
    if js_went(out)
        return true
    if s.prevented
        relayout()
        return true
    if role_of(id) == "checkbox"
        relayout()
        return true
    if out.changes > 0
        relayout()
    false

## Follows a navigation a script or a default action asked for.
fn Browser.js_went(mut self, out jsdom.Outcome) bool
    next := local_url(out.url)
    if out.url == "" or next == url
        if out.changes > 0
            relayout()
        return false
    leave()
    ahead.clear()
    load(next, if out.method == "" then "GET" else out.method, out.body)
    true

## Types `text` into text field `id`, replacing its value.
fn Browser.type_into(mut self, id int, text str)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.role != "textbox"
        message = "node {id} is a {b.role}, not a textbox"
        return
    if js != none
        mut s := js else return
        out := serve_page(
            mut s,
            mut doc,
            s.input(mut doc, id, text, 1000.0),
            url,
            mut cj,
            mut socks,
        )
        js = s
        if not js_went(out)
            relayout()
        return
    doc.set_attr(id, "value", text)
    relayout()

## Toggles check box `id`, or checks radio button `id` and unchecks the
## others of its group (same `name` in the same form).
fn Browser.check(mut self, id int)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.role == "checkbox"
        if b.checked
            doc.remove_attr(id, "checked")
        else
            doc.set_attr(id, "checked", "")
    elif b.role == "radio"
        group := doc.attr(id, "name") else ""
        form := doc.enclosing(id, "form") else 0
        for r in doc.all("input")
            if page.input_type(doc, r) == "radio" and doc.attr(
                r,
                "name",
            ) == group and doc.within(r, form)
                doc.remove_attr(r, "checked")
        doc.set_attr(id, "checked", "")
    else
        message = "node {id} is a {b.role}, not a checkbox or radio"
        return
    relayout()

## The role of control `id`, or "" when it has none.
fn Browser.role_of(self, id int) str
    t := target(id) else return ""
    t.role

## The text field being typed into (a node), or -1.
fn Browser.editing(self) int
    match prompt
        Field(id, _) => id
        Url(_) | Find(_) | Status => -1

## Moves select `id` to its next option, wrapping round.
fn Browser.cycle(mut self, id int)
    mut opts := List[int]()
    for o in doc.all("option")
        if doc.within(o, id)
            opts.push(o)
    if opts.len() == 0
        return
    mut at := 0
    for k in 0..opts.len()
        if doc.attr(opts[k], "selected") != none
            at = k
    next := opts[(at + 1) % opts.len()]
    choose(id, html.collapse(doc.text(next)))

## Chooses the option of select `id` whose text or value is `choice`.
fn Browser.choose(mut self, id int, choice str)
    for o in doc.all("option")
        if not doc.within(o, id)
            continue
        text := html.collapse(doc.text(o))
        if text == choice or doc.attr(o, "value") == choice
            for other in doc.all("option")
                if doc.within(other, id)
                    doc.remove_attr(other, "selected")
            doc.set_attr(o, "selected", "")
            relayout()
            return
    message = "node {id} has no option `{choice}`"

## Submits the form that control `id` is in (HTML 4.10.21, simplified):
## GET puts the fields in the query of the form's `action`, POST sends them
## as the body. `id` itself counts as the submitter when it is a button.
fn Browser.submit(mut self, id int)
    form := doc.enclosing(id, "form") else
        message = "node {id} is not in a form"
        return
    if js != none
        mut s := js else return
        out := serve_page(mut s, mut doc, s.submit(mut doc, id, 1000.0), url, mut cj, mut socks)
        js = s
        if not js_went(out)
            relayout()
        return
    fields := form_fields(doc, form, id)
    action := page.resolve(page.base_of(doc, url), doc.attr(form, "action") else "")
    method := (doc.attr(form, "method") else "get").to_upper()
    leave()
    ahead.clear()
    refer = url
    if method == "POST"
        load(action, "POST", fields)
    else
        base := action.split("#")[0].split("?")[0]
        load("{base}?{fields}", "GET", "")

## The form's fields, URL-encoded (`application/x-www-form-urlencoded`):
## named, enabled controls; checked boxes and radios; the submitter only
## among buttons.
fn form_fields(d html.Doc, form int, submitter int) str
    mut out := List[str]()
    for i in 0..d.nodes.len()
        n := d.nodes[i]
        if n.kind != html.Kind.Element or not d.within(i, form)
            continue
        if n.tag != "input" and n.tag != "select" and n.tag != "textarea" and n.tag != "button"
            continue
        name := d.attr(i, "name") else continue
        if name == "" or d.attr(i, "disabled") != none
            continue
        kind := page.input_type(d, i)
        if n.tag == "button"
            or (n.tag == "input" and (kind == "submit" or kind == "image" or kind == "button" or kind == "reset"))
            if i != submitter or kind == "reset" or kind == "button"
                continue
        if (kind == "checkbox" or kind == "radio") and n.tag == "input"
            if d.attr(i, "checked") == none
                continue
            out.push("{urlencode(name)}={urlencode(d.attr(i, "value") else "on")}")
            continue
        out.push("{urlencode(name)}={urlencode(page.control_value(d, i))}")
    out.join("&")

## `s` encoded for a form: letters, digits and `*-._` as they are, space as
## `+`, every other byte of its UTF-8 as `%XX`.
fn urlencode(s str) str
    mut out := List[str]()
    for c in s.chars()
        k := c.code()
        if c.is_alpha() and k < 128 or c.is_digit() or c == '*' or c == '-' or c == '.' or c == '_'
            out.push("{c}")
        elif c == ' '
            out.push("+")
        else
            for byte in utf8(k)
                out.push("%{byte:0>2x}".to_upper())
    out.join("")

## The UTF-8 bytes of code point `k`.
fn utf8(k int) List[int]
    if k < 0x80
        return [k]
    if k < 0x800
        return [0xC0 + k / 64, 0x80 + k % 64]
    if k < 0x10000
        return [0xE0 + k / 4096, 0x80 + k / 64 % 64, 0x80 + k % 64]
    [0xF0 + k / 262144, 0x80 + k / 4096 % 64, 0x80 + k / 64 % 64, 0x80 + k % 64]

## Does one agent action (docs/design/garlic-browser.md, "Agent actions"):
## `follow` a link number, `click` a node id (as Enter does), `type`
## `ID=TEXT`, `submit` the form of node ID, `check` ID, `select`
## `ID=OPTION`, `open` a URL, `back`, `find` text, `scroll` to a row,
## `reload`. False for an unknown action.
fn Browser.act(mut self, name str, arg str) bool
    message = ""
    eq := arg.find("=") else arg.chars().len()
    id := arg.slice(0, eq).to_int() else -1
    rest := arg.slice((eq + 1).min(arg.chars().len()), arg.chars().len())
    match name
        "follow" => follow(arg.to_int() else 0)
        "click" => activate(id)
        "type" => type_into(id, rest)
        "submit" => submit(id)
        "check" => check(id)
        "select" => choose(id, rest)
        "open" => go(arg)
        "back" => go_back()
        "forward" => go_forward()
        "pump" => pump()
        "find" => find(arg)
        "scroll" => scroll_to(arg.to_int() else 0)
        "reload" => reload()
        _ =>
            message = "unknown action `{name}`: try follow, click, type, submit, check, select, open, back, forward, find, scroll or reload"
            return false
    if prompt != Status
        prompt = Status
    true

## The page model, within the token budget if one is set, with the last
## action's message.
fn Browser.model(self) str
    if budget > 0
        return with_message(pg.to_json_budget(scroll, view(), budget * 4))
    with_message(pg.to_json(scroll, view(), viewport_only))

fn Browser.with_message(self, j str) str
    if message == ""
        return j
    j.replace(",\"nodes\":[", ",\"message\":{page.quote(message)},\"nodes\":[")

## The page model as a diff from the last one sent on this page: the nodes
## that are new or changed (`visible` included), and the ids `removed`.
## The whole model after loading a page.
fn Browser.diff_model(mut self) str
    now := pg.node_objects(scroll, view())
    if url != last_url
        last_url = url
        last_nodes = now
        return model()
    changed := [now[k] for k in now.keys() if last_nodes.get(k) != now[k]]
    removed := [k for k in last_nodes.keys() if not now.contains(k)]
    last_nodes = now
    head := pg.head_json(scroll, view())
    with_message("\{{head},\"diff\":true,\"removed\":[{removed.join(",")}],\"nodes\":[{changed.join(",")}]}")

## The model `--session` sends: a diff with `--diff`, else the whole model.
fn Browser.answer(mut self) str
    if diff
        return diff_model()
    model()

## One action from a session line: `\{"do":"follow","link":3}`. The
## argument is `link`, `id` or `row` (a number), or `url` or `text`; with
## both `id` and `text` (`type`, `select`), `ID=TEXT`.
fn Browser.act_json(mut self, line str)
    j := parse_json(line) else err
        message = "bad JSON: {err}"
        return
    act_from(j)

## Does the action in JSON `j` (see `act_json`).
fn Browser.act_from(mut self, j Json)
    name := j.str("do") else ""
    mut arg := ""
    for key in ["link", "id", "row"]
        if n := j.num(key)
            arg = "{n.to_int()}"
    for key in ["url", "text"]
        if t := j.str(key)
            arg = if j.num("id") != none then "{arg}={t}" else t
    act(name, arg)

## `--session`: reads one JSON action per line on stdin and answers each
## with the page model on one line, so an agent keeps one browser open.
fn Browser.session(mut self)
    print(answer())
    while true
        line := io.read_line() else break
        if line.trim() == ""
            continue
        act_json(line)
        print(answer())

## The JSON-RPC id of request `j`, as it goes back: a number or a string.
fn rpc_id(j Json) str
    if n := j.num("id")
        return "{n.to_int()}"
    if t := j.str("id")
        return page.quote(t)
    "null"

## The trust rules of an agent session (docs/design/garlic-browser.md): the
## sites it may use (`*` for any), the log of what it did, and whether one
## of its actions is waiting for a `confirm`.
struct Guard
    allow List[str]
    log List[str]
    ## Sites allowed at launch, on top of the tabs' (`--allow`).
    fixed List[str]
    ## The user said yes to the one send now being retried.
    ok_once bool

## The host of `url`: "example.com" for "https://example.com:8080/a".
fn host_of(url str) str
    rest := url.split("://").last() else url
    hostport := rest.split("/")[0]
    hostport.split(":")[0]

fn Guard.permits(self, url str) bool
    if allow.contains("*") or not url.contains("://")
        return true
    allow.contains(host_of(url))

## Whether `do` sends data: it needs `"confirm":true` to run.
fn sends(name str) bool
    name == "submit"

## The answer to a `tools/call` request `id` whose result is `text`.
fn rpc_reply(id str, text str) str
    "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\"content\":[\{\"type\":\"text\",\"text\":{page.quote(text)}}]}}"

## One tool call of the `--serve` server: the text it answers with. `g`
## refuses sites it doesn't permit, holds an action that sends data until
## it is repeated with `confirm`, and logs every call.
fn Browser.tool(mut self, mut g Guard, name str, a Json) str
    g.log.push("{name} {a.str("url") else (a.str("do") else (a.str("text") else ""))}")
    if name == "open" and not g.permits(a.str("url") else "")
        return "refused: the agent may not open `{a.str("url") else ""}`; allowed sites: {g.allow.join(", ")}"
    if not g.permits(url)
        return "refused: the agent may not use `{host_of(url)}`; allowed sites: {g.allow.join(", ")}"
    if name == "act" and sends(a.str("do") else "") and not (a.flag("confirm", false) or g.ok_once)
        return "confirm required: `{a.str("do") else ""}` sends data to {url}. Repeat it with \"confirm\":true if the user wants that."
    match name
        "open" =>
            act("open", a.str("url") else "")
            answer()
        "observe" => answer()
        "act" =>
            act_from(a)
            answer()
        "find" =>
            act("find", a.str("text") else "")
            answer()
        "extract" => pg.text()
        "screenshot" =>
            images.prefetch(
                doc,
                page.base_of(doc, url),
                url,
                cj,
                image_options(),
                mut sizes,
                mut bits,
            )
            s := gfx.layout_with(doc, url, 960.0, sheet, sizes)
            mut lines := ["canvas {s.bg.to_hex()} height {s.height.round()}"]
            for op in s.ops
                lines.push(op_line(op))
            lines.join("\n")
        "log" => g.log.join("\n")
        _ => "unknown tool `{name}`: open, observe, act, find, extract, screenshot or log"

## The tool list, with `<` and `>` for the braces of the JSON.
TOOLS_SRC := """[<"name":"open","description":"Open a URL; answers with the page model.","inputSchema":<"type":"object","properties":<"url":<"type":"string">>,"required":["url"]>>,<"name":"observe","description":"The page model: nodes with ids, roles, names and boxes.","inputSchema":<"type":"object","properties":<>>>,<"name":"act","description":"Do one action: follow, click, type, submit, check, select, back, forward, scroll, reload. Give link, id or row (a number) and text where needed.","inputSchema":<"type":"object","properties":<"do":<"type":"string">,"link":<"type":"integer">,"id":<"type":"integer">,"row":<"type":"integer">,"text":<"type":"string">>,"required":["do"]>>,<"name":"find","description":"Scroll to text on the page.","inputSchema":<"type":"object","properties":<"text":<"type":"string">>,"required":["text"]>>,<"name":"extract","description":"The page as plain text.","inputSchema":<"type":"object","properties":<>>>,<"name":"watch","description":"Tell me when the page changes: url (else the live tab), contains (text to wait for), every (seconds).","inputSchema":<"type":"object","properties":<"url":<"type":"string">,"contains":<"type":"string">,"every":<"type":"integer">>>>,<"name":"unwatch","description":"Stop watch id.","inputSchema":<"type":"object","properties":<"id":<"type":"integer">>,"required":["id"]>>,<"name":"watches","description":"The watches in force.","inputSchema":<"type":"object","properties":<>>>,<"name":"events","description":"What the watches saw change since the last call.","inputSchema":<"type":"object","properties":<>>>,<"name":"schedule","description":"Run one tool later: tool, arguments, in (seconds). It follows the same site and confirm rules.","inputSchema":<"type":"object","properties":<"tool":<"type":"string">,"arguments":<"type":"object">,"in":<"type":"integer">>,"required":["tool","in"]>>,<"name":"schedules","description":"The jobs waiting to run.","inputSchema":<"type":"object","properties":<>>>,<"name":"unschedule","description":"Cancel job id.","inputSchema":<"type":"object","properties":<"id":<"type":"integer">>,"required":["id"]>>,<"name":"log","description":"What this session did, one line per call.","inputSchema":<"type":"object","properties":<>>>,<"name":"screenshot","description":"The pixel layout as drawing operations.","inputSchema":<"type":"object","properties":<>>>]"""

fn tools_json() str
    TOOLS_SRC.replace("<", "\{").replace(">", "}")

## The answer to one MCP request line (JSON-RPC 2.0), or "" for a
## notification, which gets none.
fn Browser.rpc(mut self, mut g Guard, line str) str
    j := parse_json(line) else err
        return "\{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":\{\"code\":-32700,\"message\":{page.quote("{err}")}}}"
    method := j.str("method") else ""
    id := rpc_id(j)
    if method.starts_with("notifications/")
        return ""
    head := "\{\"jsonrpc\":\"2.0\",\"id\":{id},"
    match method
        "initialize" =>
            "{head}\"result\":\{\"protocolVersion\":\"2024-11-05\",\"capabilities\":\{\"tools\":\{}},\"serverInfo\":\{\"name\":\"garlic\",\"version\":\"0.1\"}}}"
        "ping" => "{head}\"result\":\{}}"
        "tools/list" => "{head}\"result\":\{\"tools\":{tools_json()}}}"
        "tools/call" =>
            params := j.need("params") else err
                return "{head}\"error\":\{\"code\":-32602,\"message\":\"missing params\"}}"
            args := params.need("arguments") else err
                params
            text := tool(mut g, params.str("name") else "", args)
            "{head}\"result\":\{\"content\":[\{\"type\":\"text\",\"text\":{page.quote(text)}}]}}"
        _ => "{head}\"error\":\{\"code\":-32601,\"message\":\"unknown method\"}}"

## `--serve`: an MCP server on stdio, one JSON-RPC message per line, so an
## agent drives the browser with the tools of `Browser.tool`.
fn Browser.serve(mut self, allow List[str])
    mut g := Guard(allow, log: [], fixed: [], ok_once: false)
    while true
        line := io.read_line() else break
        if line.trim() == ""
            continue
        out := rpc(mut g, line)
        if out != ""
            print(out)

## The target node drawn at window cell (`col`, `row`), or none.
fn Browser.target_at(self, col int, row int) int?
    r := row + scroll
    for t in pg.targets
        b := pg.boxes[t]
        if r >= b.row and r < b.end_row
            starts := r > b.row or col >= b.col
            ends := r < b.end_row - 1 or col < b.end_col
            if starts and ends
                return b.id
    none

## The status row's text.
fn Browser.status(self) str
    match prompt
        Url(text) => "Open: {text}_"
        Find(text) => "Find: {text}_"
        Field(_, text) => "Type: {text}_  (Enter submits, Tab moves on, Esc cancels)"
        Status =>
            if message != ""
                return message
            if focus > 0
                b := pg.boxes[pg.targets[focus - 1]]
                return if b.role
                    == "link" then "[{b.link}] {b.href}" else "{b.role} {b.name}: Enter to use"
            last := (scroll + view()).min(pg.rows.len())
            "{url}  rows {scroll + 1}-{last} of {pg.rows.len()}"

## Whether no prompt is open, so keys are commands rather than text.
fn Browser.reading(self) bool
    match prompt
        Status => true
        Url(_) | Find(_) | Field(_, _) => false

## The native window's side of the browser: the host's cell size in points
## (the monospace font it draws the page area in), the page area's size, and
## the scroll points that haven't added up to a row yet. The page area shows
## `rows` rows; the status line is the host's own node, not a page row.
struct Gui
    b Browser
    cell_w float
    cell_h float
    cols int
    rows int
    pending float
    ## The page area's size in points, as the host last reported it.
    area_w float
    area_h float
    ## Pixel layout (`gfx`) instead of text cells: the laid-out page, the
    ## page layout it was made from (`Browser.stamp`) and its width, and how
    ## far down it is scrolled, in points.
    pixel bool
    scene gfx.Scene
    scene_stamp int
    scene_w float
    scene_url str
    scene_edit int
    ## The text found by the last find-in-page, drawn highlighted.
    found str
    top float
    ## Pictures whose pixels went to the host in an earlier view, and those
    ## that go with this one: the host keeps a picture by address, so later
    ## views carry its id alone.
    sent Set[str]
    fresh Set[str]
    ## Text widths the host measured, by `gfx.probe_key` (std.app.13).
    meas Map[str, float]

fn Gui.new(b Browser, w float, h float, cell_w float, cell_h float) Gui
    mut g := Gui(
        b,
        cell_w,
        cell_h,
        cols: 1,
        rows: 1,
        pending: 0.0,
        area_w: w,
        area_h: h,
        pixel: false,
        scene: gfx.Scene(ops: [], hits: [], height: 0.0, bg: 0xffffff, probes: []),
        scene_stamp: -1,
        scene_w: 0.0,
        scene_url: "",
        scene_edit: -1,
        found: "",
        top: 0.0,
        sent: {},
        fresh: {},
        meas: {},
    )
    g.resize(w, h, cell_w, cell_h)
    g

## The page area is now `w` by `h` points with cells of `cell_w` by
## `cell_h`: lays the page out again for that many columns.
fn Gui.resize(mut self, w float, h float, cw float, ch float)
    cell_w = cw
    cell_h = ch
    area_w = w
    area_h = h
    size := draw.grid_size(w, h, cw, ch)
    cols = size.0
    rows = size.1
    b.width = cols
    b.height = rows + 1
    b.relayout()
    refresh()

## Lays the page out in pixels again when the page or the window width has
## changed since the last time.
fn Gui.refresh(mut self)
    if not pixel
        return
    if b.stamp != scene_stamp or area_w != scene_w or b.editing() != scene_edit
        images.prefetch(
            b.doc,
            page.base_of(b.doc, b.url),
            b.url,
            b.cj,
            image_options(),
            mut b.sizes,
            mut b.bits,
        )
        scene = gfx.layout_measured(b.doc, b.url, area_w, b.sheet, b.sizes, meas, b.editing())
        scene_edit = b.editing()
        scene_stamp = b.stamp
        scene_w = area_w
        for k in b.bits.keys()
            if not sent.contains(k)
                fresh.add(k)
        if b.url != scene_url
            top = 0.0
            scene_url = b.url
    top = top.max(0.0).min((scene.height - area_h).max(0.0))

## A click at (`x`, `y`) points in the page area: uses the target there.
fn Gui.click(mut self, x float, y float)
    if pixel
        if h := scene.hit_at(x, y + top)
            if h.node >= 0
                role := b.role_of(h.node)
                if role == "combobox"
                    b.cycle(h.node)
                else
                    b.activate(h.node)
            else
                b.go(h.href)
        else
            b.prompt = Status
        return
    at := draw.cell_at(x, y, cell_w, cell_h)
    if id := b.target_at(at.0, at.1)
        b.activate(id)

## A scroll of `dy` points, positive towards the end of the page. Whole
## rows move the page; the rest waits for the next scroll.
fn Gui.scroll(mut self, dy float)
    if pixel
        top = (top + dy).max(0.0).min((scene.height - area_h).max(0.0))
        return
    pending += dy
    lines := (pending / cell_h).to_int()
    if lines != 0
        pending -= lines.to_float() * cell_h
        b.scroll_to(b.scroll + lines)

## A key in the page area, by the host's key names. False when it asks to quit.
fn Gui.key(mut self, key str, alt bool, shift bool) bool
    pending = 0.0
    if pixel and b.reading()
        page_h := area_h * 0.9
        match key
            "down" | "j" => scroll(40.0)
            "up" | "k" => scroll(-40.0)
            "pagedown" | "space" => scroll(if shift then 0.0 - page_h else page_h)
            "pageup" => scroll(0.0 - page_h)
            "home" => top = 0.0
            "end" => top = scene.height
            _ => return self.typed(key, alt, shift)
        return true
    self.typed(key, alt, shift)

## A key for the browser; text typed into a field shows in it at once.
fn Gui.typed(mut self, key str, alt bool, shift bool) bool
    if pixel and key == "enter"
        match b.prompt
            Find(text) =>
                b.prompt = Status
                self.find_text(text)
                return true
            Url(_) | Field(_, _) | Status => pending = 0.0
    if pixel and key == "n" and b.prompt == Status and found != ""
        self.find_text(found)
        return true
    stay := b.key(key, alt, shift)
    if pixel
        match b.prompt
            Field(id, text) => b.type_into(id, text)
            Url(_) | Find(_) | Status => pending = 0.0
    stay

## What a typed address means: a URL as it is, a path to a file that exists
## as it is, and anything else (`projects.voltare.us/x`) as an `https` URL.
fn address(text str) str
    t := text.trim()
    if t == "" or page.scheme(t) != "" or t.starts_with("/") or fs.exists(t)
        return t
    "https://{t}"

## The URL field was submitted: opens it.
fn Gui.open(mut self, text str)
    t := address(text)
    if t != ""
        b.go_typed(t)

## The status line: the address in pixel mode, else the cell view's status.
fn Gui.status(self) str
    if pixel and b.message == "" and b.reading()
        return b.url
    b.status()

## The text runs the layout estimated, for the host to measure, at most
## `MEASURE_RUNS` at a time.
MEASURE_RUNS := 5000

fn Gui.wanted(self) List[app.Measure]
    mut out := List[app.Measure]()
    for p in scene.probes
        if out.len() == MEASURE_RUNS
            break
        if not meas.contains(gfx.probe_key(p.text, p.size, p.bold, p.mono))
            out.push(app.Measure(
                text: p.text,
                font: if p.mono then "mono" else "sans",
                size: p.size,
                bold: p.bold,
                italic: false,
            ))
    out

## Keeps the host's widths and lays the page out again with them.
fn Gui.learn(mut self, runs List[app.Measure], widths List[float])
    for k in 0..runs.len()
        r := runs[k]
        meas[gfx.probe_key(r.text, r.size, r.bold, r.font == "mono")] = widths[k]
    scene_stamp = -1
    refresh()

## The scene's operations with a highlight behind each `found` match.
fn Gui.marked(self) List[draw.Op]
    if found == ""
        return scene.ops
    want := found.to_lower()
    mut out := List[draw.Op]()
    for op in scene.ops
        match op
            Str(x, y, t, font, size, fg, bold, _, _) =>
                at := t.to_lower().find(want) else
                    out.push(op)
                    continue
                before := t.slice(0, at)
                out.push(draw.Op.Rect(
                    x: x + gfx.text_width(before, size, bold, font == "mono"),
                    y: y,
                    w: gfx.text_width(found, size, bold, font == "mono"),
                    h: size * 1.3,
                    color: 0xffe066,
                ))
                out.push(op)
            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => out.push(op)
    out

## Scrolls to the next line of the page with `needle` in it (case does not
## matter), wrapping round, and highlights the matches.
fn Gui.find_text(mut self, needle str)
    found = needle
    b.last_find = needle
    if needle == ""
        return
    want := needle.to_lower()
    mut ys := List[float]()
    for op in scene.ops
        match op
            Str(_, y, t, _, _, _, _, _, _) => if t.to_lower().contains(want)
                ys.push(y)
            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => ys = ys
    if ys.len() == 0
        b.message = "`{needle}` not found"
        return
    mut pick := ys[0]
    for y in ys
        if y > top + 24.0 and pick <= top + 24.0
            pick = y
    top = (pick - 40.0).max(0.0).min((scene.height - area_h).max(0.0))
    b.message = "found `{needle}` ({ys.len()} matches)"

## What the page area shows, as drawing operations.
fn Gui.display(self) List[draw.Op]
    if pixel
        return draw.shift(self.marked(), scene.bg, area_w, area_h, top)
    draw.display_list(b.pg, b.scroll, rows, cols, b.focus, cell_w, cell_h)

## The native window as a `std.app` app (docs/design/garlic-browser.md,
## "Native window"): an address bar with back and reload above the page, and
## the status line below it.
struct Garlic
    g Gui
    ## Every tab's window state; `tabs[cur]` is out of date while it is
    ## `g`, which is swapped in and out by `switch`.
    tabs List[Gui]
    cur int
    ## The address field's text.
    url_text str
    ## The control to give the keyboard focus; cleared by the next event.
    want str
    ## The attach server's side (`--attach`): its bridge, the rules an agent
    ## session follows and the number of calls it made; `attached` is false
    ## without `--attach`.
    attached bool
    bridge attach.Bridge
    guard Guard
    where str
    calls int
    ## Watches agents set, what they have seen and not yet read, and the
    ## seconds the timer has counted.
    ## An agent call waiting for the user's yes or no: the request, what it
    ## wants, and the site if it is a site.
    pending str
    asks str
    ask_site str
    watches List[attach.Watch]
    events List[str]
    seconds int
    next_watch int
    jobs List[attach.Job]

fn Garlic.new(b Browser, w float, h float, cell_w float, cell_h float) Garlic
    g := Gui.new(b, w, h, cell_w, cell_h)
    Garlic(
        g,
        tabs: [g],
        cur: 0,
        url_text: b.url,
        want: "",
        attached: false,
        bridge: attach.Bridge.new(),
        guard: Guard(allow: [], log: [], fixed: [], ok_once: false),
        where: "",
        calls: 0,
        pending: "",
        asks: "",
        ask_site: "",
        watches: [],
        events: [],
        seconds: 0,
        next_watch: 1,
        jobs: [],
    )

## Answers one MCP request from an attached agent: the sites it may use are
## the ones the tabs show plus those allowed at launch, and the answer goes
## back through the bridge.
fn Garlic.agent_call(mut self, body str)
    mut sites := guard.fixed
    for t in tabs
        sites.push(host_of(t.b.url))
    sites.push(host_of(g.b.url))
    guard.allow = sites
    j := parse_json(body) else err
        bridge.replies.send(g.b.rpc(mut guard, body))
        return
    calls += 1
    params := j.need("params") else err
        bridge.replies.send(g.b.rpc(mut guard, body))
        return
    name := params.str("name") else ""
    args := params.need("arguments") else err
        params
    if j.str("method") == "tools/call" and WATCH_TOOLS.contains(name)
        guard.log.push("{name}")
        bridge.replies.send(rpc_reply(rpc_id(j), watch_tool(name, args)))
        return
    answer := g.b.rpc(mut guard, body)
    guard.ok_once = false
    if answer.contains("confirm required:")
        pending = body
        asks = "send data from {g.b.url} ({name})"
        ask_site = ""
        g.b.message = "An agent wants to {asks}: Allow or Deny"
        return
    if answer.contains("refused: the agent may not")
        site := host_of(if name == "open" then (args.str("url") else "") else g.b.url)
        if site != "" and ["open", "act", "find"].contains(name)
            pending = body
            asks = "use {site}"
            ask_site = site
            g.b.message = "An agent wants to {asks}: Allow or Deny"
            return
    bridge.replies.send(answer)

## The user's answer to a pending agent request: allowed, the request runs
## again with that one permission; denied, the agent is told so.
fn Garlic.decide(mut self, allowed bool)
    if pending == ""
        return
    body := pending
    pending = ""
    if not allowed
        guard.log.push("denied: {asks}")
        id := rpc_id(parse_json(body) else Json.Null)
        bridge.replies.send(rpc_reply(id, "denied: the user did not allow the agent to {asks}"))
        return
    guard.log.push("allowed: {asks}")
    if ask_site != ""
        guard.fixed.push(ask_site)
    else
        guard.ok_once = true
    agent_call(body)

## The tools that set and read watches; the window answers them, not the page.
WATCH_TOOLS := {"watch", "unwatch", "watches", "events", "schedule", "schedules", "unschedule"}

## One watch tool call, as text. `watch` takes `url` (else the live tab),
## `contains` and `every` (seconds, default 30); `events` returns the changes
## seen since the last call.
fn Garlic.watch_tool(mut self, name str, args Json) str
    match name
        "watch" =>
            url := args.str("url") else ""
            if url != "" and not guard.permits(url)
                return "refused: the agent may not watch `{url}`"
            w := attach.Watch.start(
                next_watch,
                url,
                args.str("contains") else "",
                (args.num("every") else 30.0).to_int(),
                seconds,
                if url == "" then g.b.pg.text() else watched_text(url),
            )
            next_watch += 1
            watches.push(w)
            "watching {w.line()}"
        "unwatch" =>
            id := (args.num("id") else 0.0).to_int()
            watches = [w for w in watches if w.id != id]
            "stopped watch {id}"
        "watches" => [w.line() for w in watches].join("\n")
        "schedule" =>
            call := args.str("tool") else ""
            if call == "" or WATCH_TOOLS.contains(call)
                return "schedule needs `tool` (open, observe, act, find, extract, screenshot) and `in` seconds"
            inner := args.need("arguments") else err
                Json.Obj([])
            job := attach.Job(
                id: next_watch,
                due: seconds + (args.num("in") else 0.0).to_int(),
                tool: call,
                args: inner.to_text(),
            )
            next_watch += 1
            jobs.push(job)
            "scheduled {job.line(seconds)}"
        "schedules" => [j.line(seconds) for j in jobs].join("\n")
        "unschedule" =>
            id := (args.num("id") else 0.0).to_int()
            jobs = [j for j in jobs if j.id != id]
            "cancelled job {id}"
        _ =>
            out := events.join("\n")
            events = []
            if out == "" then "no changes" else out

fn watched_text(url str) str
    Browser.new(url, 100, 32).pg.text()

## One timer tick (once a second): looks at each watch that is due and
## notes what changed.
fn Garlic.tick(mut self)
    seconds += 1
    due := [j for j in jobs if j.due <= seconds]
    jobs = [j for j in jobs if j.due > seconds]
    for j in due
        mut sites := guard.fixed
        for t in tabs
            sites.push(host_of(t.b.url))
        sites.push(host_of(g.b.url))
        guard.allow = sites
        answer := g.b.rpc(mut guard, j.request())
        events.push("job {j.id} ({j.tool}) ran: {answer.slice(0, answer.chars().len().min(160))}")
    for k in 0..watches.len()
        if seconds < watches[k].due
            continue
        text := if watches[k].url == "" then g.b.pg.text() else watched_text(watches[k].url)
        change := watches[k].look(text, seconds)
        if change != ""
            events.push(change)
            g.b.message = change

## Makes tab `k` the one shown.
fn Garlic.switch(mut self, k int)
    if k < 0 or k >= tabs.len() or k == cur
        return
    tabs[cur] = g
    g = tabs[k]
    cur = k
    g.refresh()

## Opens an empty tab and shows it.
fn Garlic.new_tab(mut self)
    tabs[cur] = g
    mut fresh_gui := Gui.new(
        Browser.empty("", g.b.width, g.b.height),
        g.area_w,
        g.area_h,
        g.cell_w,
        g.cell_h,
    )
    fresh_gui.pixel = g.pixel
    fresh_gui.refresh()
    tabs.push(fresh_gui)
    cur = tabs.len() - 1
    g = fresh_gui
    want = "url"

## Closes the shown tab (the last one stays).
fn Garlic.close_tab(mut self)
    if tabs.len() < 2
        return
    tabs.remove_at(cur)
    cur = cur.min(tabs.len() - 1)
    g = tabs[cur]
    g.refresh()

## The line that tells the user an agent can drive this window; empty
## without `--attach`.
fn Garlic.agent_line(self) str
    if not attached
        return ""
    "Agent attached at {where}: {calls} calls so far; {watches.len()} watches, {events.len()} unread changes"

## The tab strip: one button per tab, titled by its page.
fn Garlic.strip(self) List[app.Node]
    mut out := List[app.Node]()
    for k in 0..tabs.len()
        t := if k == cur then g else tabs[k]
        title := if t.b.pg.title == "" then "New tab" else t.b.pg.title
        mark := if k == cur then "> " else ""
        out.push(app.button("tab:{k}", "{mark}{title.slice(0, title.chars().len().min(18))}"))
    out

impl app.App for Garlic
    fn update(mut self, ev app.Event)
        want = ""
        g.b.pump()
        g.sent = g.sent.union(g.fresh)
        g.fresh = {}
        match ev.kind
            "resize" => g.resize(ev.dx, ev.dy, ev.cell_w, ev.cell_h)
            "click" => g.click(ev.x, ev.y)
            "scroll" => g.scroll(ev.dy)
            "key" =>
                if (ev.meta and ev.text == "l") or (ev.text == "g" and g.b.reading())
                    want = "url"
                elif ev.meta and ev.text == "r"
                    g.b.reload()
                elif ev.meta and ev.text == "["
                    g.b.go_back()
                elif ev.meta and ev.text == "]"
                    g.b.go_forward()
                elif ev.meta and ev.text == "f"
                    g.b.prompt = Find("")
                elif ev.meta and ev.text == "t"
                    new_tab()
                elif ev.meta and ev.text == "w"
                    close_tab()
                elif ev.ctrl and ev.text == "tab"
                    switch((cur + 1) % tabs.len())
                else
                    g.key(ev.text, ev.alt, ev.shift)
            "edit" => url_text = ev.text
            "external" =>
                if ev.id == "mcp"
                    agent_call(ev.text)
                elif ev.id == "tick"
                    tick()
            "submit" => g.open(url_text)
            "press" =>
                if ev.id == "back"
                    g.b.go_back()
                elif ev.id == "reload"
                    g.b.reload()
                elif ev.id == "agent_allow"
                    decide(true)
                elif ev.id == "agent_deny"
                    decide(false)
                elif ev.id == "newtab"
                    new_tab()
                elif ev.id.starts_with("tab:")
                    switch(ev.id.slice(4, ev.id.chars().len()).to_int() else cur)
            _ => url_text = url_text
        g.refresh()
        if ev.kind != "edit"
            url_text = g.b.url

    fn view(self) app.Node
        bar := app.row([
            app.button("back", "Back"),
            app.button("reload", "Reload"),
            app.button("newtab", "+"),
            app.field("url", url_text, "Enter a web address"),
        ])
        ## A canvas of 0 by 0 fills the window; the host reports its size.
        mut rows := [app.row(strip()), bar]
        if attached
            rows.push(app.label(agent_line()))
        if pending != ""
            rows.push(app.row([
                app.label("The agent wants to {asks}."),
                app.button("agent_allow", "Allow"),
                app.button("agent_deny", "Deny"),
            ]))
        rows.push(app.canvas("page", 0.0, 0.0, [to_app(op, g) for op in g.display()]))
        rows.push(app.label(g.status()))
        app.column(rows)

    fn title(self) str
        "{g.b.pg.title} - Garlic"

    fn measures(self) List[app.Measure]
        g.wanted()

    fn measured(mut self, runs List[app.Measure], widths List[float])
        g.learn(runs, widths)

    fn focus(self) str
        want

## A drawing operation of the page, as a `std.app` canvas operation.
fn to_app(op draw.Op, g Gui) app.Op
    match op
        Rect(x, y, w, h, c) => app.draw_rect(x, y, w, h, c)
        Text(x, y, t, fg, bold, italic, underline) => app.Op.Str(
            x: x,
            y: y,
            text: t,
            font: "mono",
            size: 13.0,
            fg: fg,
            bold: bold,
            italic: italic,
            underline: underline,
        )
        Str(x, y, t, font, size, fg, bold, italic, underline) => app.Op.Str(
            x: x,
            y: y,
            text: t,
            font: font,
            size: size,
            fg: fg,
            bold: bold,
            italic: italic,
            underline: underline,
        )
        Pic(x, y, w, h, src) =>
            bm := g.b.bits.get(src) else return app.Op.Pic(x: x, y: y, w: w, h: h, src: src)
            app.Op.Bitmap(
                x: x,
                y: y,
                w: w,
                h: h,
                id: src,
                pw: bm.w,
                ph: bm.h,
                data: if g.fresh.contains(src) then bm.data else "",
            )

## The native window: the page area starts at `GUI_W` by `GUI_H` points with
## cells of `GUI_CELL_W` by `GUI_CELL_H` until the host reports its own.
GUI_W := 960.0
GUI_H := 600.0
GUI_CELL_W := 7.8
GUI_CELL_H := 16.0

fn app_main(b Browser, pixel bool, attached bool, sites str) !
    mut a := Garlic.new(b, GUI_W, GUI_H, GUI_CELL_W, GUI_CELL_H)
    a.g.pixel = pixel
    a.g.refresh()
    if attached
        attached_main(mut a, sites)?
        return
    app.run(mut a) else err
        print("garlic: no native window ({err.message}); the page as text:")
        print(a.g.b.pg.text())

## Posts a `tick` event every second until `stop` is set.
fn ticker(inbox app.Inbox, stop Atomic[int])
    while stop.load() == 0
        time.sleep_ms(1000)
        inbox.post(app.external("tick", ""))

## The attach server's task (a local function, which `spawn` needs natively).
fn serve(srv net.Server, inbox app.Inbox, bridge attach.Bridge, token str)
    attach.serve_loop(srv, inbox, bridge, token)

## `--attach`: the window as `app_main` runs it, with the attach server on
## 127.0.0.1 (a free port), its address and token in `~/.garlic-attach.json`
## for the agents on this machine.
fn attached_main(mut a Garlic, sites str) !
    srv := net.serve("127.0.0.1:0")?
    token := attach.make_token()
    path := "{env.get("HOME") else "."}/.garlic-attach.json"
    where := "http://{srv.addr()}/mcp"
    fs.write_text(path, "\{\"url\":\"{where}\",\"token\":\"{token}\"}\n")?
    mode := proc.run("chmod", ["600", path], none, none) else err
        print("garlic: could not restrict {path}: {err}")
        return
    a.attached = true
    a.where = where
    a.guard.fixed = [h for h in sites.split(",") if h != ""]
    inbox := app.new_inbox()
    g := TaskGroup()
    g.add(spawn serve(srv, inbox, a.bridge, token))
    stop := Atomic(0)
    g.add(spawn ticker(inbox, stop))
    print("garlic: agents attach at {where}; the token is in {path}")
    app.run_with(mut a, app.host_path()?, [], inbox) else err
        print("garlic: no native window ({err.message})")
    stop.add(1)
    srv.shutdown()

## The value after flag `name` (`--width 60`), or none.
fn flag(args List[str], name str) str?
    at := args.index_of(name) else return none
    if at + 1 < args.len() then args[at + 1] else none

fn usage()
    print("usage: ail run tools/garlic/garlic.ail [--width N] [--height N] [--follow N | --find TEXT | --do ACTION:ARG]... [--viewport] [--budget TOKENS] [--diff] [--no-js] [--console] [--print | --json | --links | --session | --pixels-dump [--pixel-width N] | --keys] URL|FILE (options may come before or after it)")

## Flags that take a value, so the address is the first argument that is
## neither a flag nor a value.
VALUE_FLAGS := {
    "--allow",
    "--width",
    "--height",
    "--follow",
    "--find",
    "--do",
    "--budget",
    "--pixel-width",
}

fn target_of(args List[str]) str
    mut k := 0
    while k < args.len()
        if VALUE_FLAGS.contains(args[k])
            k += 2
        elif args[k].starts_with("--")
            k += 1
        else
            return args[k]
    ""

## One drawing operation as a line a person or the Mac gate can check:
## kind, position, size, colour and text.
fn op_line(op draw.Op) str
    match op
        Rect(
            x,
            y,
            w,
            h,
            c,
        ) => "rect {x.round()},{y.round()} {w.round()}x{h.round()} #{c.to_hex().pad_left(6, '0')}"
        Text(
            x,
            y,
            t,
            fg,
            _,
            _,
            _,
        ) => "text {x.round()},{y.round()} #{fg.to_hex().pad_left(6, '0')} {t}"
        Str(
            x,
            y,
            t,
            font,
            size,
            fg,
            bold,
            _,
            _,
        ) => "str {x.round()},{y.round()} {font} {size.round()} #{fg.to_hex().pad_left(6, '0')}{if bold then " bold" else ""} {t}"
        Pic(x, y, w, h, src) => "pic {x.round()},{y.round()} {w.round()}x{h.round()} {src}"

## `--pixels-dump`: the pixel layout of the page, one operation per line,
## after the canvas colour and height.
fn pixels_dump(mut b Browser, width float)
    images.prefetch(
        b.doc,
        page.base_of(b.doc, b.url),
        b.url,
        b.cj,
        image_options(),
        mut b.sizes,
        mut b.bits,
    )
    s := gfx.layout_with(b.doc, b.url, width, b.sheet, b.sizes)
    print("canvas #{s.bg.to_hex().pad_left(6, '0')} height {s.height.round()} ops {s.ops.len()} links {s.hits.len()}")
    for op in s.ops
        print(op_line(op))
    for at in b.sizes.keys()
        dims := b.sizes[at]
        state := if dims[0] * dims[1]
            == 0 then "failed" else (if b.bits.contains(at) then "decoded" else "too big to decode")
        print("image {at} {dims[0]}x{dims[1]} {state}")

fn main() !
    args := env.args()
    if args.len() > 0 and args[0] == "--bench"
        bench([args[k] for k in 1..args.len()])
        return
    if args.contains("--keys")
        for k in KEYS
            print(k)
        return
    if args.len() == 0
        usage()
        return
    width := (flag(args, "--width") else "100").to_int() else 100
    height := (flag(args, "--height") else "32").to_int() else 32
    if args.contains("--serve")
        mut srv := Browser.empty("about:blank", width, height)
        srv.serve((flag(args, "--allow") else "*").split(","))
        return
    mut b := Browser.new(target_of(args), width, height)
    b.viewport_only = args.contains("--viewport")
    b.diff = args.contains("--diff")
    b.budget = (flag(args, "--budget") else "0").to_int() else 0
    for k in 0..args.len() - 1
        if VALUE_FLAGS.contains(args[k]) and k + 1 >= args.len()
            continue
        if args[k] == "--follow"
            b.follow(args[k + 1].to_int() else 0)
        elif args[k] == "--find"
            b.find(args[k + 1])
        elif args[k] == "--do"
            spec := args[k + 1]
            at := spec.find(":") else spec.chars().len()
            b.act(spec.slice(0, at), spec.slice(
                (at + 1).min(spec.chars().len()),
                spec.chars().len(),
            ))
    if args.contains("--pixels-dump")
        pixels_dump(mut b, (flag(args, "--pixel-width") else "960").to_float() else 960.0)
    elif args.contains("--session")
        b.session()
    elif args.contains("--print")
        print(b.pg.text())
    elif args.contains("--json")
        print(b.model())
    elif args.contains("--links")
        for n in 1..=b.pg.links.len()
            bx := b.pg.boxes[b.pg.links[n - 1]]
            print("[{n}] {bx.name} -> {bx.href}")
    else
        # The window is the std.app host's (ADR 0838); `--app` is the old
        # spelling of the default.
        app_main(b, not args.contains("--cells"), args.contains("--attach"), flag(args, "--allow") else "") else err
            print("garlic: {err}")

# ---- Tests -------------------------------------------------------------

## The tree of `src` in the html5lib-tests format.
fn tree(src str) str
    html.parse(src).dump()

@test fn implied_html_head_and_body()
    assert_eq(tree("Hi"), "| <html>\n|   <head>\n|   <body>\n|     \"Hi\"")

@test fn title_goes_in_head_and_text_in_body()
    want := """
        | <!DOCTYPE html>
        | <html>
        |   <head>
        |     <title>
        |       "A & B"
        |   <body>
        |     <p>
        |       "x"
        """
    assert_eq(tree("<!doctype HTML><title>A &amp; B</title><p>x"), want)

@test fn p_closes_on_block_and_li_closes_li()
    want := """
        | <html>
        |   <head>
        |   <body>
        |     <p>
        |       "one"
        |     <div>
        |       "two"
        |     <ul>
        |       <li>
        |         "a"
        |       <li>
        |         "b"
        """
    assert_eq(tree("<p>one<div>two</div><ul><li>a<li>b</ul>"), want)

@test fn attributes_quoted_unquoted_bare_and_duplicate()
    d := html.parse("<a href=x title='T &lt; U' hidden HREF=\"y\">z</a>")
    a := d.first("a")?
    assert_eq(d.attr(a, "href"), "x")
    assert_eq(d.attr(a, "title"), "T < U")
    assert_eq(d.attr(a, "hidden"), "")
    assert_eq(d.nodes[a].attrs.len(), 3)

@test fn script_and_style_are_raw_text()
    d := html.parse("<script>if (a < b && c) x = '</p>'</script><style>p>a\{}</style>")
    s := d.first("script")?
    assert_eq(d.text(s), "if (a < b && c) x = '</p>'")
    assert_eq(d.text(d.first("style")?), "p>a\{}")

@test fn script_ends_only_at_its_own_end_tag()
    d := html.parse("<script>a = \"</scripts>\"</SCRIPT >after")
    assert_eq(d.text(d.first("script")?), "a = \"</scripts>\"")
    assert_eq(d.text(d.first("body")?), "after")

@test fn character_references()
    d := html.parse("&lt;&#65;&#x42;&copy &amp;&nosuch; &#0;&#x80;&#150; &AMP;")
    assert_eq(d.text(d.first("body")?), "<AB\u{a9} &&nosuch; \u{fffd}\u{20ac}\u{2013} &AMP;")

@test fn legacy_reference_in_attribute_stays_literal_before_equals()
    d := html.parse("<a href=\"?a=1&copy=2&amp;b\">x</a>")
    assert_eq(d.attr(d.first("a")?, "href"), "?a=1&copy=2&b")

@test fn comments_and_doctype()
    d := html.parse("<!-- note --><!DOCTYPE html><p>a<!---->b")
    assert_eq(d.doctype, "html")
    assert_eq(
        tree("<p>a<!-- c -->b"),
        "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"a\"\n|       <!--  c  -->\n|       \"b\"",
    )

@test fn void_elements_and_stray_end_tags()
    assert_eq(
        tree("a<br>b</br>c</span>d<img src=x>"),
        "| <html>\n|   <head>\n|   <body>\n|     \"a\"\n|     <br>\n|     \"b\"\n|     <br>\n|     \"cd\"\n|     <img>\n|       src=\"x\"",
    )

@test fn tables_close_rows_and_cells()
    d := html.parse("<table><tr><td>a<td>b<tr><td>c</table>")
    assert_eq(d.all("tr").len(), 2)
    assert_eq(d.all("td").len(), 3)
    assert_eq(d.nodes[d.all("td")[2]].parent, d.all("tr")[1])

@test fn svg_self_closing_tags_close()
    d := html.parse("<svg><path d='M0'/><circle/></svg>x")
    path := d.first("path")?
    assert_eq(d.nodes[path].children.len(), 0)
    assert_eq(d.nodes[d.first("circle")?].parent, d.first("svg")?)

@test fn pre_drops_its_first_newline()
    assert_eq(
        html.parse("<pre>\nx\n</pre>").text(html.parse("<pre>\nx\n</pre>").first("pre")?),
        "x\n",
    )

@test fn unterminated_tag_and_comment_do_not_trap()
    assert_eq(html.parse("<p>a<b").text(0), "a")
    assert_eq(html.parse("a<!-- open").text(0), "a")
    assert_eq(html.parse("a < b & c").text(0), "a < b & c")

## Text without markup comes back unchanged (whitespace-only text before
## the body is dropped, 13.2.6.4.1).
@test fn plain_text_round_trips(s str)
    if s.contains("<")
        or s.contains("&")
        or s.contains("\r")
        or s.contains("\u{0}")
        or html.collapse(s) == ""
        return
    assert_eq(html.parse(s).text(0), s)

## Whatever the input, tokenizing and building never trap.
@test fn any_input_parses(s str)
    d := html.parse("<{s}>{s}</{s}<!{s}&{s};")
    assert(d.nodes.len() >= 4)

fn lay(src str, width int) page.Page
    page.layout(html.parse(src), "https://example.com/docs/a.html", width)

@test fn paragraphs_wrap_at_the_width_with_one_blank_row_between()
    p := lay("<p>one two three four five</p><p>six</p>", 10)
    assert_eq(p.text(), "one two\nthree four\nfive\n\nsix")

@test fn long_words_break_and_whitespace_collapses()
    p := lay("<p>  abcdefghijklmnopqrstuvw \n\n  x  </p>", 10)
    assert_eq(p.text(), "abcdefghij\nklmnopqrst\nuvw x")

@test fn headings_lists_quotes_and_pre()
    p := lay(
        "<h2>Title</h2><ul><li>a<li>b<ol start=3><li>c</ol></ul><blockquote>q</blockquote><pre>x  y\n z</pre>",
        40,
    )
    assert_eq(p.text(), "## Title\n\n* a\n* b\n    3. c\n\n> q\n\n    x  y\n     z")

@test fn hidden_elements_are_not_drawn()
    p := lay(
        "<p>a<span hidden>b</span><span style='display: none'>c</span><script>d</script>e</p>",
        40,
    )
    assert_eq(p.text(), "ae")

@test fn links_are_numbered_and_resolved()
    p := lay(
        "<p>See <a href='b.html'>the docs</a> and <a href='/x?q=1'>x</a>.</p><a name=anchor>no href</a>",
        80,
    )
    assert_eq(p.text(), "See the docs[1] and x[2].\n\nno href")
    assert_eq(p.links.len(), 2)
    one := p.boxes[p.links[0]]
    assert_eq(one.href, "https://example.com/docs/b.html")
    assert_eq([one.row, one.col, one.end_row, one.end_col], [0, 4, 1, 15])
    assert_eq(p.boxes[p.links[1]].href, "https://example.com/x?q=1")

@test fn a_wrapped_link_spans_rows()
    p := lay("<p>aaaa <a href=x>bb cc dd</a></p>", 10)
    assert_eq(p.text(), "aaaa bb cc\ndd[1]")
    b := p.boxes[p.links[0]]
    assert_eq([b.row, b.col, b.end_row, b.end_col], [0, 5, 2, 5])

@test fn tables_render_one_row_per_line()
    p := lay("<table><tr><th>k<th>v<tr><td>a<td>1</table>", 40)
    assert_eq(p.text(), "k | v\na | 1")

@test fn images_and_inputs_show_their_text()
    p := lay(
        "<p><img src=a.png alt=Logo> <input name=q placeholder=Search> <input type=submit value=Go></p>",
        60,
    )
    assert_eq(p.text(), "[Logo] [Search______________] [Go]")
    assert_eq([b.name for b in p.boxes if b.role == "image"], ["Logo"])

@test fn page_model_json_marks_the_viewport()
    p := lay("<title>T</title><h1>Head</h1><p>one</p><p><a href=n>next</a></p>", 40)
    want := r"""{"api":1,"url":"https://example.com/docs/a.html","title":"T","width":40,"height":2,"scroll":0,"rows":5,"nodes":[{"id":6,"role":"heading","name":"Head","level":1,"row":0,"col":2,"end_row":1,"end_col":6,"visible":true},{"id":8,"role":"paragraph","name":"one","row":2,"col":0,"end_row":3,"end_col":3,"visible":false},{"id":10,"role":"paragraph","name":"next","row":4,"col":0,"end_row":5,"end_col":7,"visible":false},{"id":11,"role":"link","name":"next","href":"https://example.com/docs/n","row":4,"col":0,"end_row":5,"end_col":7,"visible":false,"link":1,"actions":["follow"]}]}"""
    assert_eq(p.to_json(0, 2, false), want)
    assert_eq(p.to_json(0, 2, true).split("\"id\"").len(), 2)

@test fn explicit_role_and_aria_label_win()
    p := lay("<div role=button aria-label=Close>x</div>", 40)
    assert_eq(p.boxes[0].role, "button")
    assert_eq(p.boxes[0].name, "Close")

@test fn url_resolution()
    base := "https://a.org/b/c/d.html?q#f"
    assert_eq(page.resolve(base, "e.html"), "https://a.org/b/c/e.html")
    assert_eq(page.resolve(base, "../e"), "https://a.org/b/e")
    assert_eq(page.resolve(base, "./"), "https://a.org/b/c/")
    assert_eq(page.resolve(base, "/x/./y/../z"), "https://a.org/x/z")
    assert_eq(page.resolve(base, "//cdn.org/s.js"), "https://cdn.org/s.js")
    assert_eq(page.resolve(base, "?r"), "https://a.org/b/c/d.html?r")
    assert_eq(page.resolve(base, "#top"), "https://a.org/b/c/d.html?q#top")
    assert_eq(page.resolve(base, "mailto:x@y.z"), "mailto:x@y.z")
    assert_eq(page.resolve("https://a.org", "p"), "https://a.org/p")
    assert_eq(page.resolve("site/index.html", "b.html"), "site/b.html")

## `tools/garlic/testdata`, from the repository root or `bootstrap/`.
fn testdata() str
    if fs.exists("tools/garlic/testdata")
        return "{env.cwd()}/tools/garlic/testdata"
    # From `bootstrap/` (the selftest's directory): the parent, without `..`,
    # so page addresses compare equal after URL resolution.
    cwd := env.cwd()
    up := cwd.rfind("/") else 0
    "{cwd.slice(0, up)}/tools/garlic/testdata"

@test fn browser_follows_links_and_goes_back()
    dir := testdata()
    mut b := Browser.new("{dir}/index.html", 60, 12)
    assert_eq(b.pg.title, "Garlic test page")
    b.key("tab", false, false)
    assert_eq(b.focus, 1)
    b.key("enter", false, false)
    assert_eq(b.pg.title, "Second page")
    b.key("backspace", false, false)
    assert_eq(b.pg.title, "Garlic test page")
    assert(b.status().contains("index.html"))

@test fn shift_tab_wraps_to_the_last_link()

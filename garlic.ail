    assert_eq(page.file_path("file:///C:/Users/a/p.html"), "C:/Users/a/p.html")
    assert_eq(page.file_path("file://D:/x.html"), "D:/x.html")
    assert_eq(page.file_path("/tmp/p.html"), "/tmp/p.html")
    assert_eq(page.file_path("file:///tmp/a:b.html"), "/tmp/a:b.html")
    assert_eq(page.resolve("file:///C:/site/a.html", "b.png"), "file:///C:/site/b.png")

@test fn base_href_changes_where_relative_links_start()

## The text of the proportional `Str` operations in `ops`, as `text@x,y`.
fn pixel_text(ops List[draw.Op]) List[str]
    mut out := List[str]()
    for op in ops
        match op
            Str(x, y, text, _, _, _, _, _, _) => out.push("{text}@{x.round()},{y.round()}")
            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => out = out
    out

fn pixels(src str, width float) gfx.Scene
    gfx.layout(html.parse(src), "https://x.test/", width, css.parse("", 0))

@test fn pixel_text_widths_follow_the_font_table()
    assert_eq(
        gfx.text_width("ii", 10.0, false, false) < gfx.text_width("mm", 10.0, false, false),
        true,
    )
    assert_eq(gfx.text_width("abcd", 10.0, false, true), 24.0)

@test fn css_lengths_and_colors_parse()
    assert_eq(gfx.length("2em", 10.0, 0.0), 20.0)
    assert_eq(gfx.length("50%", 10.0, 200.0), 100.0)
    assert_eq(gfx.length("auto", 10.0, 0.0), none)
    assert_eq(gfx.length("calc(0.25rem * 4)", 10.0, 0.0), 16.0)
    assert_eq(gfx.length("calc(100% - 2em)", 10.0, 200.0), 180.0)
    assert_eq(gfx.length("calc((1px + 3px) * 2)", 10.0, 0.0), 8.0)
    assert_eq(gfx.number("calc(1.5 / 1)"), 1.5)
    assert_eq(gfx.number("calc(2.5 / 2.25)") > 1.1, true)
    assert_eq(gfx.number("calc(0.25rem * 4)"), none)
    assert_eq(gfx.color("light-dark(#eee, #222)"), 0x222222)
    assert_eq(gfx.color("light-dark(rgb(1, 2, 3), #fff)"), 0xffffff)
    assert_eq(gfx.color("#fff"), 0xffffff)
    assert_eq(gfx.color("rgb(255, 0, 0)"), 0xff0000)
    assert_eq(gfx.color("transparent"), none)

@test fn unitless_calc_line_heights_and_block_margins_keep_rows_apart()
    ## Tailwind 4 writes `line-height: calc(1.5 / 1)`: a number, not 1.5px.
    rules := css.parse(
        "h3 \{ line-height: calc(1.5 / 1); margin: 0 }"
            + " .row \{ margin-block-start: 8px; line-height: calc(1.25 / 0.875) }",
        0,
    )
    s := gfx.layout(html.parse("<h3>Graphics</h3><div class=row>WebGL</div>"), "https://x.test/", 400.0, rules)
    assert_eq(pixel_text(s.ops).len(), 2)
    assert(s.height >= 50.0)

@test fn the_pixel_layout_stacks_blocks_with_margins_and_wraps_words()
    s := pixels("<h1>Hi</h1><p>one two</p>", 400.0)
    t := pixel_text(s.ops)
    assert_eq(t.len(), 2)
    assert_eq(t[0].starts_with("Hi@8"), true)
    assert(t[1].starts_with("one two@"))
    narrow := pixels("<p>aaaa bbbb cccc dddd</p>", 60.0)
    assert_eq(pixel_text(narrow.ops).len(), 4)
    assert(narrow.height > s.height - 100.0)

@test fn the_pixel_layout_paints_backgrounds_and_finds_links()
    s := pixels(
        "<body style='background:#112233'><div style='background:#ff0000;padding:10px'><a href=/go>link</a></div></body>",
        300.0,
    )
    assert_eq(s.bg, 0x112233)
    mut found := false
    for op in s.ops
        match op
            Rect(_, _, w, _, c) => if c == 0xff0000 and w > 200.0
                found = true
            Text(_, _, _, _, _, _, _) | Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Pic(_, _, _, _, _) => found = found
    assert(found)
    h := s.hits[0]
    assert_eq(s.link_at(h.x + 1.0, h.y + 1.0), "https://x.test/go")
    assert_eq(s.link_at(0.0, 500.0), none)


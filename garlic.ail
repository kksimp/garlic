        <body style="margin: 0"><div style="column-count: 3; column-gap: 20px; width: 640px"><p style="margin: 0">aaa</p><p style="margin: 0">bbb</p><p style="margin: 0">ccc</p></div><p style="margin: 0">after</p></body>

@test fn budgets_keep_the_viewport_then_key_nodes()
    pg := Browser.empty("", 60, 4).pg
    assert(pg.to_json_budget(0, 4, 400).contains("\"omitted\":0"))
    ## A fixed URL, so the budget doesn't depend on where the checkout is.
    index := fs.read_text("{testdata()}/index.html") else ""
    p := lay(index, 60)
    full := p.to_json(0, 3, false)
    small := p.to_json_budget(0, 3, 900)
    assert(small.chars().len() <= 900 and small.chars().len() < full.chars().len())
    assert(small.contains("\"name\":\"Second page\"") and small.contains("\"role\":\"heading\",\"name\":\"Features\""))
    assert(not small.contains("\"omitted\":0"))

## A page shaped like google.com's home page, which Garlic first drew as
## "Gmail[1]Images[2]" and "  | [____]".
@test fn flex_items_margins_nbsp_and_scripts_lay_out_like_a_browser()
    src := """
        <style>.bar \{ display: flex } .m \{ margin: 0 8px }</style>
        <div class=bar><a href=/m>Gmail</a><a href=/i>Images</a><a role=button href=/apps>Apps</a></div>
        <p><span class=m>About</span><span class=m>Store</span></p>
        <table><tr><td>&nbsp;</td><td><textarea name=q title=Search></textarea><script>var x='y'</script></td></tr></table>
        """
    p := lay(src, 60)
    assert_eq(p.text(), "Gmail[1] Images[2] Apps[3]\n\nAbout Store\n\n[____________________]")
    apps := p.boxes[p.links[2]]
    assert_eq(apps.role, "button")
    icon := lay("<a href=/apps aria-label='Google apps'><svg><path d='M0'/></svg></a>", 40)
    assert_eq(icon.text(), "Google apps[1]")
    assert(p.to_json(0, 10, false).contains("\"link\":3,\"actions\":[\"follow\"]"))
    cells := [b.name for b in p.boxes if b.role == "cell"]
    assert(not cells.join(" ").contains("var x"))

@test fn grid_template_areas_place_items_by_name_in_their_tracks()
    src := """
        <style>.g \{ display: grid; grid-template-columns: 100px 1fr; column-gap: 0; grid-template-areas: 'h h' 's m' } .h \{ grid-area: h } .s \{ grid-area: s } .m \{ grid-area: m }</style>
        <div class=g><div class=m>main</div><div class=s>side</div><div class=h>head</div></div>
        """
    ts := pixel_text(gfx.layout(html.parse(src), "file:///t.html", 400.0, css.parse("", 0)).ops)
    head := at_of(ts, "head")
    side := at_of(ts, "side")
    mn := at_of(ts, "main")
    assert_eq(side[0], head[0])
    assert_eq(mn[0], side[0] + 100.0)
    assert_eq(mn[1], side[1])
    assert(side[1] > head[1])

## The x and y of the pixel text `word` in `ts` (from `pixel_text`), or [].
fn at_of(ts List[str], word str) List[float]
    for t in ts
        if t.starts_with("{word}@")
            parts := t.slice(word.chars().len() + 1, t.chars().len()).split(",")
            return [parts[0].to_float() else 0.0, parts[1].to_float() else 0.0]
    []

@test fn a_leading_dot_number_sets_the_margin_below_a_heading_in_a_positioned_header()
    ## browserleaks /javascript: `margin: 0 0 .45em 0` was read as 0, so the
    ## buttons after the heading were drawn over it.
    rules := "header\{position:relative} h1\{font-size:22px;line-height:1em;margin:0 0 .45em 0;padding-top:1em} #jspick1,#jspick2\{width:175px;height:24px;line-height:14px}"
    src := """
        <header><h1><a href="/javascript">Heading</a></h1></header>
        <div id=jspick><button id=jspick1>window</button> <button id=jspick2>iframe</button></div>
        """
    ts := pixel_text(gfx.layout(html.parse(src), "file:///t.html", 1000.0, css.parse(rules, 0)).ops)
    h := at_of(ts, "Heading")
    b := at_of(ts, "window")
    assert(b[1] >= h[1] + 22.0)
    assert_eq(gfx.length(".45em", 20.0, 0.0) else -1.0, 9.0)
    assert_eq(gfx.length("-.5px", 20.0, 0.0) else 0.0, -0.5)
    assert_eq(gfx.number(".5") else -1.0, 0.5)

@test fn list_style_none_applies_from_the_item_the_list_or_an_ancestor()
    src := """
        <style>.n \{ list-style: none outside } .i li \{ list-style-type: none } nav \{ list-style: none }</style>
        <ul class=n><li>one</li></ul><ul class=i><li>two</li></ul><nav><ul><li>three</li></ul></nav><ul><li>four</li></ul>
        """
    ts := pixel_text(gfx.layout(html.parse(src), "file:///t.html", 400.0, css.parse("", 0)).ops)
    assert_eq(len_starting(ts, "\u{2022}@"), 1)

fn len_starting(ts List[str], prefix str) int
    mut n := 0
    for t in ts
        if t.starts_with(prefix)
            n += 1
    n


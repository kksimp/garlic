@test fn the_referer_follows_the_origin_policy()
    assert_eq(page.referrer("https://a.com/x?y=1#f", "https://a.com/z"), "https://a.com/x?y=1")
    assert_eq(page.referrer("https://a.com/x", "https://b.com/z"), "https://a.com")
    assert_eq(page.referrer("https://a.com/x", "http://a.com/z"), "")
    assert_eq(page.referrer("http://a.com/x", "https://b.com/z"), "http://a.com")
    assert_eq(page.referrer("file:///tmp/p.html", "https://b.com/"), "")
    assert_eq(page.referrer("", "https://b.com/"), "")

@test fn a_file_url_names_a_path_also_on_a_windows_drive()

    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 300.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.doc = html.parse("<img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.refresh()
    first := [to_app(op, a.g) for op in a.g.display()]
    a.update(app.event("noop"))
    second := [to_app(op, a.g) for op in a.g.display()]
    assert_eq(bitmap_data_lens(first), [[37, 29, 1]])
    assert_eq(bitmap_data_lens(second)[0][2], 0)

@allow("expr.match.3") fn bitmap_data_lens(ops List[app.Op]) List[List[int]]
    mut out := List[List[int]]()
    for op in ops
        match op
            app.Op.Bitmap(_, _, _, _, _, pw, ph, data) => out.push([
                pw,
                ph,
                data.chars().len().min(1),
            ])
            _ => out = out
    out

@test fn the_native_build_draws_the_same_pixels_as_the_interpreter()
    root := testdata().replace("/tools/garlic/testdata", "")
    exe := "{env.cwd()}/garlic-native-test"
    built := proc.run(
        "{root}/ail",
        ["build", "{root}/tools/garlic/garlic.ail", "-o", exe],
        none,
        600000,
    )?
    assert(built.ok())
    html_file := "{testdata()}/voltare-full.html"
    native := proc.run(exe, [html_file, "--pixels-dump"], none, 60000)?
    fs.remove(exe) else return
    b := Browser.new(html_file, 100, 32)
    mut want := List[str]()
    s := gfx.layout(b.doc, b.url, 960.0, b.sheet)
    want.push("canvas #{s.bg.to_hex().pad_left(6, '0')} height {s.height.round()} ops {s.ops.len()} links {s.hits.len()}")
    for op in s.ops
        want.push(op_line(op))
    assert_eq(native.out.trim(), want.join("\n"))
    assert(native.out.contains("canvas #0a0a0f"))
    assert(native.out.contains("sans 14.0 #6b6b80 GitHub"))

## The `Str` and `Rect` operations of `s` as `text@x,y` and `rect@x,y wxh`.
fn flat(s gfx.Scene) List[str]
    mut out := List[str]()
    for op in s.ops
        match op
            Str(
                x,
                y,
                t,
                _,
                _,
                _,
                _,
                _,
                _,
            ) => out.push("{t}@{x.round().to_int()},{y.round().to_int()}")
            Rect(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("rect@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Pic(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("pic@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Text(_, _, _, _, _, _, _) => out = out
    out


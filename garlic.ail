    text := b.pg.text()
    assert(text.contains("late script ran / missing one failed"))
    assert(text.contains("load fired"))
    assert_eq(b.net_log.len(), 2)
    assert(b.net_log[1].ends_with("no-such-script.js (script, failed)"))

@test fn error_statuses_show_the_body_as_sent()

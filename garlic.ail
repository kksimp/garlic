    # A listener's preventDefault keeps the link from navigating.
    b.act("click", "{node_with(b, "a", "id", "stay")}")
    assert_eq(b.pg.title, "Events test")
    b.act("type", "{node_with(b, "input", "id", "q")}=onion")

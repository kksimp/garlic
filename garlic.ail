@test fn back_and_forward_show_kept_pages_without_a_fetch()
    mut b := Browser.new("{testdata()}/index.html", 60, 12)
    first := b.url
    title := b.pg.title
    b.scroll_to(1)
    b.go("{testdata()}/second.html")
    second := b.url
    assert(b.kept.contains(first))
    ## Back needs no file: the kept tree is shown, at the place it was left.
    b.kept[first].doc.nodes[0].tag = "#document"
    b.go_back()
    assert_eq(b.url, first)
    assert_eq(b.pg.title, title)
    assert_eq(b.ahead, [second])
    b.go_forward()
    assert_eq(b.url, second)
    assert_eq(b.back, [first])
    b.go_back()
    b.go("{testdata()}/second.html")
    assert_eq(b.ahead.len(), 0)
    b.go_forward()
    assert_eq(b.message, "no page to go forward to")

@test fn decoded_pictures_go_to_the_host_once()
    dir := "{env.cwd()}/vendor/image/testdata"
    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 300.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.doc = html.parse("<img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.refresh()
    first := [to_app(op, a.g) for op in a.g.display()]
    a.update(app.event(app.EventKind.Other))
    second := [to_app(op, a.g) for op in a.g.display()]
    assert_eq(bitmap_data_lens(first), [[37, 29, 1]])
    assert_eq(bitmap_data_lens(second)[0][2], 0)

@test fn a_picture_scrolled_into_view_after_it_was_decoded_still_gets_its_data()
    dir := "{env.cwd()}/vendor/image/testdata"
    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 100.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.doc = html.parse("<div style='height: 600px'>top</div><img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.refresh()
    ## Off screen: nothing to send yet, and a later event must not count it as sent.
    assert_eq(bitmap_data_lens([to_app(op, a.g) for op in a.g.display()]).len(), 0)
    a.update(app.event(app.EventKind.Other))
    a.g.top = 600.0
    a.g.refresh()
    first := [to_app(op, a.g) for op in a.g.display()]
    assert_eq(bitmap_data_lens(first), [[37, 29, 1]])

@allow("expr.match.3") fn bitmap_data_lens(ops List[app.Op]) List[List[int]]
    mut out := List[List[int]]()
    for op in ops
        match op
            app.Op.Bitmap(_, _, _, _, _, pw, ph, data) => out.push([
                pw,
                ph,
                data.chars().len().min(1),
            ])
            _ => out = out
    out

## Compares a native Garlic with the interpreter's layout. A native build of
## Garlic takes minutes, far past the test runner's 30 s per test, so the test
## only runs when the gate has built one and names it in `GARLIC_NATIVE_EXE`
## (`../ail/ail build garlic.ail -o EXE`).
@test fn the_native_build_draws_the_same_pixels_as_the_interpreter()
    exe := env.get("GARLIC_NATIVE_EXE") else return
    html_file := "{testdata()}/voltare-full.html"
    native := proc.run(exe, [html_file, "--pixels-dump"], none, 25000)?
    b := Browser.new(html_file, 100, 32)
    mut want := List[str]()
    s := gfx.layout(b.doc, b.url, 960.0, b.sheet)
    want.push("canvas #{s.bg.to_hex().pad_left(6, '0')} height {s.height.round()} ops {s.ops.len()} links {s.hits.len()}")
    for op in s.ops
        want.push(op_line(op))
    assert_eq(native.out.trim(), want.join("\n"))
    assert(native.out.contains("canvas #0a0a0f"))
    # The nav's SVG-only GitHub link draws its icon (#676), not its aria-label.
    assert(native.out.contains("pic 829.0,15.0 18.0x18.0 svg:"))

## The `Str` and `Rect` operations of `s` as `text@x,y` and `rect@x,y wxh`.
fn flat(s gfx.Scene) List[str]
    mut out := List[str]()
    for op in s.ops
        match op
            Str(
                x,
                y,
                t,
                _,
                _,
                _,
                _,
                _,
                _,
            ) => out.push("{t}@{x.round().to_int()},{y.round().to_int()}")
            Rect(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("rect@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Pic(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("pic@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Text(_, _, _, _, _, _, _) => out = out
    out

@test fn absolute_children_sit_at_the_positioned_ancestors_offsets()
    s := pixels(
        "<body style='margin:0'><div style='position:relative;height:100px;width:200px;background:#eee'><span style='position:absolute;top:10px;right:5px;width:40px;height:12px;background:#f00'></span>hi</div><p>after</p></body>",
        400.0,
    )
    f := flat(s)
    assert(f.contains("rect@155,10 40x12"))
    assert(f.contains("hi@0,0"))

@test fn floats_take_a_corner_and_text_wraps_beside_them()
    s := pixels(
        "<body style='margin:0'><img src=a.png width=100 height=80 style='float:right'><p style='margin:0'>aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk lll</p></body>",
        300.0,
    )
    f := flat(s)
    assert(f.contains("pic@200,0 100x80"))
    mut max_right := 0.0
    for op in s.ops
        match op
            Str(x, _, t, _, size, _, _, _, _) => max_right = max_right.max(x + gfx.text_width(
                t,
                size,
                false,
                false,
            ))
            Rect(_, _, _, _, _) | Text(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Pic(_, _, _, _, _) => max_right = max_right
    assert(max_right <= 200.0)

@test fn rounded_corners_cut_the_rectangle_into_strips()
    s := pixels(
        "<body style='margin:0'><div style='width:40px;height:40px;background:#f00;border-radius:8px'></div></body>",
        200.0,
    )
    f := flat(s)
    assert(f.len() > 5)
    assert(f.contains("rect@0,8 40x24"))
    assert(f.contains("rect@5,0 30x1"))

@test fn wrapping_chips_keep_their_padding_apart()
    s := pixels(
        "<body style='margin:0'><div style='display:flex;flex-wrap:wrap;gap:6px'><span style='padding:2px 8px;background:#333'>one</span><span style='padding:2px 8px;background:#333'>two</span></div></body>",
        300.0,
    )
    mut starts := List[float]()
    mut ends := List[float]()
    for op in s.ops
        match op
            Rect(x, _, w, _, c) => if c == 0x333333
                starts.push(x)
                ends.push(x + w)
            Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => starts = starts
    assert_eq(starts.len(), 2)
    assert(starts[1] >= ends[0] + 5.0)

@test fn pixel_forms_take_typing_and_submit_with_enter()
    b := Browser.new("{testdata()}/form.html", 60, 12)
    mut g := Gui.new(b, 600.0, 400.0, 7.5, 15.0)
    g.pixel = true
    g.refresh()
    mut at := -1
    for k in 0..g.scene.hits.len()
        h := g.scene.hits[k]
        if at < 0 and h.node >= 0 and g.b.role_of(h.node) == "textbox"
            at = k
    assert(at >= 0)
    f := g.scene.hits[at]
    g.click(f.x + 2.0, f.y + 2.0)
    assert_eq(g.b.editing(), f.node)
    g.refresh()
    assert(g.scene_edit == f.node)
    g.key("h", false, false)
    g.key("i", false, false)
    assert_eq(g.b.doc.attr(f.node, "value"), "hi")
    g.key("enter", false, false)
    assert(g.b.url.contains("q=hi"))

@test fn at_and_where_ground_a_point_and_a_word_in_the_model()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    link := b.pg.boxes[b.pg.links[0]]
    got := b.pg.at_json(link.col + 1, link.row)
    assert(got.contains("\"role\":\"link\""))
    assert(got.contains("\"link\":1"))
    assert_eq(b.pg.at_json(59, 11), "null")
    found := b.pg.where_json("second")
    assert(found.starts_with("\{\"matches\":[\{"))
    assert(found.contains("\"role\":\"link\""))
    assert_eq(b.pg.where_json("no such thing here"), "\{\"matches\":[]}")
    assert(b.pg.where_json("LINK").contains("\"role\":\"link\""))

@test fn the_id_overlay_tags_links_and_controls_with_their_node_numbers()
    b := Browser.new("{testdata()}/form.html", 80, 30)
    mut g := Gui.new(b, 640.0, 400.0, 8.0, 16.0)
    plain := g.display().len()
    g.ids = true
    assert(g.display().len() > plain)
    q := node_with(b, "input", "id", "q")
    assert(g.id_marks().len() >= 2 * b.pg.targets.len())
    mut p := Gui.new(Browser.new("{testdata()}/index.html", 60, 12), 640.0, 400.0, 8.0, 16.0)
    p.pixel = true
    p.refresh()
    link := p.b.pg.boxes[p.b.pg.links[0]]
    mut seen := false
    for h in p.scene.hits
        if h.anchor == link.id
            seen = true
    assert(seen)
    assert(q >= 0)

@test fn tabs_keep_their_own_pages_and_switch_back()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.new_tab()
    assert_eq((a.tabs.len(), a.cur), (2, 1))
    assert_eq(a.g.b.pg.title, "")
    a.g.open("{testdata()}/second.html")
    assert_eq(a.g.b.pg.title, "Second page")
    a.switch(0)
    assert_eq(a.g.b.pg.title, "Garlic test page")
    a.switch(1)
    assert_eq(a.g.b.pg.title, "Second page")
    assert_eq(a.item(1).title, "Second page")
    a.close_tab()
    assert_eq((a.tabs.len(), a.g.b.pg.title), (1, "Garlic test page"))

@test fn find_in_page_scrolls_to_the_match_and_marks_it()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut g := Gui.new(b, 400.0, 60.0, 7.5, 15.0)
    g.pixel = true
    g.refresh()
    g.b.prompt = Find("")
    for c in "SECOND".chars()
        g.key("{c}", false, false)
    g.key("enter", false, false)
    assert_eq(g.found, "SECOND")
    assert(g.b.message.contains("found"))
    assert(g.marked().len() > g.scene.ops.len())

@test fn the_find_bar_searches_as_you_type_and_steps_through_the_matches()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 400.0, 60.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(400.0, 60.0))
    mut f := app.key("f")
    f.meta = true
    a.update(f)
    assert(a.finding and a.find.editing)
    for c in "second".chars()
        a.update(app.key("{c}"))
    assert_eq(a.find.text, "second")
    assert(a.g.find_n >= 1)
    assert_eq(a.g.find_k, 0)
    a.update(app.key("enter"))
    assert(a.finding and a.find.editing)
    assert_eq(a.g.find_k, 1 % a.g.find_n)
    a.view()
    a.update(app.key("escape"))
    assert(not a.finding and a.g.found == "")

@test fn cmd_c_and_the_page_menu_copy_through_the_clipboard_line()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 400.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(400.0, 300.0))
    mut f := app.key("f")
    f.meta = true
    a.update(f)
    for ch in "second".chars()
        a.update(app.key("{ch}"))
    mut c := app.key("c")
    c.meta = true
    a.update(c)
    assert_eq(a.lines(), [app.clipboard("second")])
    assert_eq(a.lines(), [])
    a.update(app.key("escape"))
    mut ev := clicked(20.0, 20.0)
    ev.text = "right"
    a.update(ev)
    assert_eq(a.menu_tab, -3)
    rows := a.menu_rows()
    assert(rows.contains("Reload") and rows.contains("Back"))
    if rows.contains("Copy text")
        a.menu_pick(rows.index_of("Copy text") else 0)
        assert_eq(a.lines().len(), 1)

@test fn a_load_shows_the_spinner_until_the_load_event_arrives()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 400.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(400.0, 300.0))
    a.attach(app.new_inbox())
    mut r := app.key("r")
    r.meta = true
    a.update(r)
    assert(a.item(0).loading)
    a.update(app.external("load", "reload"))
    assert(not a.item(0).loading)

@test fn the_omnibox_dropdown_offers_history_and_the_arrows_pick_a_row()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(600.0, 300.0))
    a.visits.push(chrome.Suggestion(title: "AIL", url: "https://ail.dev/"))
    mut l := app.key("l")
    l.meta = true
    a.update(l)
    assert(a.omni.editing)
    for c in "ail".chars()
        a.update(app.key("{c}"))
    rows := a.suggestions()
    assert_eq(rows.len(), 2)
    assert_eq(a.pick_row, -1)
    a.update(app.key("down"))
    assert_eq(a.pick_row, 0)
    a.update(app.key("down"))
    assert_eq(a.pick_row, 1)
    a.update(app.key("down"))
    assert_eq(a.pick_row, -1)
    a.update(app.key("up"))
    assert_eq(a.pick_row, 1)
    a.view()
    a.update(app.key("escape"))
    assert_eq(a.suggestions().len(), 0)

@test fn dragging_over_the_page_selects_text_that_cmd_c_copies()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 400.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(400.0, 300.0))
    mut d := clicked(0.0, 0.0)
    d.kind = app.EventKind.Down
    a.update(d)
    assert(a.g.dragging and not a.g.sel_on)
    mut m := app.event(app.EventKind.Move)
    m.id = "page"
    m.x = 390.0
    m.y = 290.0
    a.update(m)
    assert(a.g.sel_on)
    mut u := clicked(390.0, 290.0)
    u.kind = app.EventKind.Up
    a.update(u)
    assert(not a.g.dragging and a.g.sel_on)
    text := a.g.selection()
    assert(text.contains("Garlic"))
    assert(a.g.marked().len() > a.g.scene.ops.len())
    mut c := app.key("c")
    c.meta = true
    a.update(c)
    assert_eq(a.lines(), [app.clipboard(text)])
    a.update(app.key("escape"))
    assert(not a.g.sel_on)

@test fn max_age_is_read_from_cache_control()
    assert_eq(max_age("public, max-age=60"), 60)
    assert_eq(max_age("no-store"), -1)
    assert_eq(max_age("Max-Age=x"), -1)

@test fn the_referer_follows_the_origin_policy()
    assert_eq(page.referrer("https://a.com/x?y=1#f", "https://a.com/z"), "https://a.com/x?y=1")
    assert_eq(page.referrer("https://a.com/x", "https://b.com/z"), "https://a.com")
    assert_eq(page.referrer("https://a.com/x", "http://a.com/z"), "")
    assert_eq(page.referrer("http://a.com/x", "https://b.com/z"), "http://a.com")
    assert_eq(page.referrer("file:///tmp/p.html", "https://b.com/"), "")
    assert_eq(page.referrer("", "https://b.com/"), "")

@test fn a_file_url_names_a_path_also_on_a_windows_drive()
    assert_eq(page.file_path("file:///tmp/p.html"), "/tmp/p.html")
    assert_eq(page.file_path("file:///C:/Users/a/p.html"), "C:/Users/a/p.html")
    assert_eq(page.file_path("file://D:/x.html"), "D:/x.html")
    assert_eq(page.file_path("/tmp/p.html"), "/tmp/p.html")
    assert_eq(page.file_path("file:///tmp/a:b.html"), "/tmp/a:b.html")
    assert_eq(page.resolve("file:///C:/site/a.html", "b.png"), "file:///C:/site/b.png")

@test fn base_href_changes_where_relative_links_start()
    d := html.parse("<base href=/other/><a href=x.html>x</a><img src=p.png>")
    assert_eq(page.base_of(d, "https://a.test/dir/page.html"), "https://a.test/other/")
    p := page.layout_with(d, "https://a.test/dir/page.html", 40, css.parse("", 0))
    assert_eq(p.boxes[p.links[0]].href, "https://a.test/other/x.html")
    assert_eq(p.url, "https://a.test/dir/page.html")
    plain := html.parse("<a href=x>x</a>")
    assert_eq(page.base_of(plain, "https://a.test/dir/page.html"), "https://a.test/dir/page.html")

@test fn data_urls_give_sheets_and_scripts()

@test fn cmd_c_and_the_page_menu_copy_through_the_clipboard_line()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 400.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(400.0, 300.0))
    mut f := app.key("f")
    f.meta = true
    a.update(f)
    for ch in "second".chars()
        a.update(app.key("{ch}"))
    mut c := app.key("c")
    c.meta = true
    a.update(c)
    assert_eq(a.lines(), [app.clipboard("second")])
    assert_eq(a.lines(), [])
    a.update(app.key("escape"))
    mut ev := clicked(20.0, 20.0)
    ev.text = "right"
    a.update(ev)
    assert_eq(a.menu_tab, -3)
    rows := a.menu_rows()
    assert(rows.contains("Reload") and rows.contains("Back"))
    if rows.contains("Copy text")
        a.menu_pick(rows.index_of("Copy text") else 0)
        assert_eq(a.lines().len(), 1)


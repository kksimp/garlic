@test fn clear_moves_below_the_floats()
    s := pixels(
        "<body style='margin:0'><img src=a.png width=100 height=80 style='float:left'><p style='margin:0;clear:left'>below</p></body>",
        300.0,
    )
    assert(flat(s).contains("below@0,84"))

## A path as it can sit inside a JSON string: Windows backslashes become
## slashes, which every Garlic file open accepts.
fn fwd_slashes(p str) str
    p.replace("\\", "/")

@test fn serve_answers_mcp_requests()
    mut b := Browser.empty("about:blank", 80, 24)
    mut g := Guard(allow: ["*"], log: [], fixed: [], ok_once: false)
    init := b.rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}")
    assert(init.contains("\"serverInfo\""))
    assert_eq(b.rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"), "")
    assert(
        b
            .rpc(mut g, "\{\"jsonrpc\":\"2.0\",\"id\":\"a\",\"method\":\"tools/list\"}")
            .contains("\"screenshot\""),
    )
    call := b.rpc(
        mut g,
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"{fwd_slashes(testdata())}/form.html\"}}}",
    )
    assert(call.contains("\"content\""))
    assert(call.contains("textbox"))

@test fn serve_enforces_site_permission_confirmation_and_logs()
    mut b := Browser.empty("about:blank", 80, 24)
    mut g := Guard(allow: ["example.com"], log: [], fixed: [], ok_once: false)
    no := b.rpc(
        mut g,
        "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"https://evil.test/x\"}}}",
    )
    assert(no.contains("refused"))
    assert_eq(host_of("https://example.com:8080/a"), "example.com")
    mut open := Guard(allow: ["*"], log: [], fixed: [], ok_once: false)
    b.rpc(
        mut open,
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"{fwd_slashes(testdata())}/form.html\"}}}",
    )
    held := b.rpc(
        mut open,
        "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":\{\"name\":\"act\",\"arguments\":\{\"do\":\"submit\",\"id\":1}}}",
    )
    assert(held.contains("confirm required"))
    assert_eq(open.log.len(), 2)

@test fn an_attached_agent_drives_the_window_through_the_inbox()
    b := Browser.new("{testdata()}/form.html", 80, 24)
    mut a := Garlic.new(b, 800.0, 600.0, 7.5, 15.0)
    a.attached = true
    a.where = "http://127.0.0.1:1/mcp"
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"observe\",\"arguments\":\{}}}",
    ))
    answer := a.bridge.replies.recv() else "none"
    assert(answer.contains("Search form"))
    assert_eq(a.calls, 1)
    assert(a.agent_line().contains("1 calls"))
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"https://elsewhere.test/\"}}}",
    ))
    assert(a.pending != "")
    a.update(app.press("agent_deny"))
    refused := a.bridge.replies.recv() else "none"
    assert(refused.contains("denied"))
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":\{\"name\":\"log\",\"arguments\":\{}}}",
    ))
    assert((a.bridge.replies.recv() else "").contains("open https://elsewhere.test/"))

@needs(proc) @test fn the_attach_token_must_match()
    tok := attach.make_token()
    assert(tok.chars().len() >= 24)
    assert(tok != attach.make_token())

@test fn a_watch_reports_changes_and_appearances()
    mut w := attach.Watch.start(1, "", "", 5, 0, "one")
    assert_eq(w.look("one", 3), "")
    assert_eq(w.look("one", 5), "")
    assert_eq(w.look("two", 10), "watch 1: the page changed")
    mut k := attach.Watch.start(2, "", "Sold out", 1, 0, "in stock")
    assert_eq(k.look("In stock", 1), "")
    assert_eq(k.look("SOLD OUT today", 2), "watch 2: `Sold out` appeared")
    assert_eq(k.look("back", 3), "watch 2: `Sold out` disappeared")

@test fn agents_set_watches_and_read_their_events_through_the_window()
    b := Browser.new("{testdata()}/form.html", 80, 24)
    mut a := Garlic.new(b, 800.0, 600.0, 7.5, 15.0)
    a.attached = true
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"watch\",\"arguments\":\{\"contains\":\"Brand new\",\"every\":1}}}",
    ))
    assert((a.bridge.replies.recv() else "").contains("watching 1"))
    a.update(app.external("tick", ""))
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"events\",\"arguments\":\{}}}",
    ))
    assert((a.bridge.replies.recv() else "").contains("no changes"))
    a.g.b.pg = lay("Brand new text", 40)
    a.update(app.external("tick", ""))
    a.update(app.external("tick", ""))
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":\{\"name\":\"events\",\"arguments\":\{}}}",
    ))
    assert((a.bridge.replies.recv() else "").contains("appeared"))

@test fn a_scheduled_action_runs_when_due_and_follows_the_rules()
    b := Browser.new("{testdata()}/form.html", 80, 24)
    mut a := Garlic.new(b, 800.0, 600.0, 7.5, 15.0)
    a.attached = true
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":\{\"name\":\"schedule\",\"arguments\":\{\"tool\":\"extract\",\"arguments\":\{},\"in\":2}}}",
    ))
    assert((a.bridge.replies.recv() else "").contains("scheduled"))
    a.update(app.external("tick", ""))
    assert_eq(a.jobs.len(), 1)
    a.update(app.external("tick", ""))
    assert_eq(a.jobs.len(), 0)
    assert(a.events.len() == 1)
    assert(a.events[0].contains("job"))
    a.update(app.external(
        "mcp",
        "\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":\{\"name\":\"schedule\",\"arguments\":\{\"tool\":\"open\",\"arguments\":\{\"url\":\"https://elsewhere.test/\"},\"in\":1}}}",
    ))
    a.bridge.replies.recv()
    a.update(app.external("tick", ""))
    assert(a.events[1].contains("refused"))

@needs(net) @test fn the_user_decides_on_an_agents_site_and_send_requests()
    b := Browser.new("{testdata()}/form.html", 80, 24)
    mut a := Garlic.new(b, 800.0, 600.0, 7.5, 15.0)
    a.attached = true
    open := "\{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":\{\"name\":\"open\",\"arguments\":\{\"url\":\"{testdata()}/index.html\"}}}"
    a.update(app.external("mcp", open.replace(
        "{testdata()}/index.html",
        "https://elsewhere.test/",
    )))
    assert(a.pending != "")
    assert_eq(a.ask_site, "elsewhere.test")
    assert(app.outline(a.view()).contains("\"Allow\""))
    a.update(app.press("agent_deny"))
    assert_eq(a.pending, "")
    assert((a.bridge.replies.recv() else "").contains("denied"))
    ## a yes allows the site and runs the call again (the fetch itself may fail)
    a.update(app.external("mcp", open.replace(
        "{testdata()}/index.html",
        "https://elsewhere.test/",
    )))
    a.update(app.press("agent_allow"))
    assert(a.guard.fixed.contains("elsewhere.test"))
    got := a.bridge.replies.recv() else ""
    assert(got != "")

@test fn svg_shapes_become_pixels()
    d := html.parse("<svg viewBox='0 0 4 4' width=4 height=4><rect x=0 y=0 width=2 height=4 fill='#ff0000'/></svg>")
    ids := d.all("svg")
    bm := images.svg_render(d, ids[0], 4, 4, 0) else
        assert(false)
        return
    assert_eq(bm.w, 4)
    raw := bytes.from_base64(bm.data) else
        assert(false)
        return
    assert_eq(raw.len(), 64)
    assert_eq(raw[0].to_int(), 255)
    assert_eq(raw[3].to_int(), 255)
    assert_eq(raw[11].to_int(), 0)

@test fn inline_svg_icons_are_drawn_as_pictures()
    src := "<body style='margin:0'><p>Go <svg width=16 height=16 viewBox='0 0 16 16'><path d='M2 2h12v12H2z' fill='#00ff00'/></svg> now</p></body>"
    s := pixels(src, 300.0)
    mut found := false
    for op in s.ops
        match op
            Pic(_, _, w, h, p) => if p.starts_with("svg:") and w == 16.0 and h == 16.0
                found = true
            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) => found = found
    assert(found)
    assert_eq(s.bits.len(), 1)

@test fn closing_tabs_remembers_them_for_reopen()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.new_tab()
    a.g.open("{testdata()}/second.html")
    a.new_tab()
    assert_eq(a.tabs.len(), 3)
    a.close_at(1)
    assert_eq((a.tabs.len(), a.cur, a.closed.len()), (2, 1, 1))
    a.reopen()
    assert_eq((a.tabs.len(), a.g.b.pg.title, a.closed.len()), (3, "Second page", 0))

@test fn close_others_and_close_right_keep_the_right_tabs()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.new_tab()
    a.g.open("{testdata()}/second.html")
    a.new_tab()
    a.new_tab()
    a.close_right(1)
    assert_eq(a.tabs.len(), 2)
    a.close_others(1)
    assert_eq((a.tabs.len(), a.g.b.pg.title), (1, "Second page"))

@test fn the_strip_menu_and_middle_click_close_tabs()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.new_tab()
    a.new_tab()
    mut ev := app.event(app.EventKind.Click)
    ev.id = "chrome"
    ev.x = chrome.tab_x(1, 3, a.strip_w, 0.0) + 20.0
    ev.y = 20.0
    ev.text = "other"
    a.update(ev)
    assert_eq(a.tabs.len(), 2)
    ev.text = "right"
    ev.x = chrome.tab_x(0, 2, a.strip_w, 0.0) + 20.0
    a.update(ev)
    assert_eq(a.menu_tab, 0)
    ev.text = "left"
    ev.id = "page"
    ev.y = 8.0 + 3.0
    ev.x = a.menu_x + 5.0
    a.update(ev)
    assert_eq((a.tabs.len(), a.menu_tab), (1, -1))

@test fn the_empty_strip_drags_the_window_and_tabs_start_right_of_the_controls()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    assert(a.edge())
    mut start := app.event(app.EventKind.Start)
    start.inset_left = 78.0
    start.inset_top = 28.0
    a.update(start)
    assert_eq(a.inset_left, 78.0)
    mut ev := app.event(app.EventKind.Click)
    ev.id = "chrome"
    ev.x = 40.0
    ev.y = 20.0
    ev.text = "left"
    ev.clicks = 1
    a.update(ev)
    assert_eq(a.lines(), ["\{\"v\":1,\"t\":\"drag\"}"])
    assert_eq(a.lines(), [])
    ev.clicks = 2
    a.update(ev)
    assert_eq(a.lines(), ["\{\"v\":1,\"t\":\"zoom\"}"])
    ev.x = chrome.tab_x(0, 1, a.strip_w, 78.0) + 20.0
    ev.clicks = 1
    ev.text = "other"
    a.update(ev)
    assert_eq(a.tabs.len(), 1)

@test fn the_omnibox_takes_typing_and_opens_the_address()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    mut ev := app.event(app.EventKind.Click)
    ev.id = "chrome"
    ev.x = 300.0
    ev.y = 66.0
    ev.text = "left"
    a.update(ev)
    assert(a.omni.editing and a.omni.all)
    for c in "{testdata()}/second.html".chars()
        mut k := app.key("{c}")
        k.id = "chrome"
        a.update(k)
    mut enter := app.key("enter")
    enter.id = "chrome"
    a.update(enter)
    assert_eq(a.g.b.pg.title, "Second page")
    assert(not a.omni.editing)
    assert_eq(a.omni.text, a.g.b.url)
    mut menu := app.event(app.EventKind.Click)
    menu.id = "chrome"
    menu.x = a.strip_w - 20.0
    menu.y = 66.0
    menu.text = "left"
    a.update(menu)
    assert_eq(a.menu_tab, -2)
    assert(a.menu_rows().contains("Light theme"))
    ## A second click on the button closes its menu.
    a.update(menu)
    assert_eq(a.menu_tab, -1)

@test fn a_click_on_a_dropdown_row_opens_it_and_the_pointer_lights_rows()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(600.0, 300.0))
    a.visits.push(chrome.Suggestion(title: "Second", url: "{testdata()}/second.html"))
    mut l := app.key("l")
    l.meta = true
    a.update(l)
    for c in "seco".chars()
        a.update(app.key("{c}"))
    assert_eq(a.suggestions().len(), 2)
    ## The pointer over the second row: the view lights it.
    mut over := app.event(app.EventKind.Move)
    over.id = "page"
    over.x = 200.0
    over.y = 50.0
    a.update(over)
    assert_eq((a.page_x, a.page_y), (200.0, 50.0))
    a.view()
    mut ev := app.event(app.EventKind.Click)
    ev.id = "page"
    ev.x = 200.0
    ev.y = 50.0
    ev.text = "left"
    a.update(ev)
    assert_eq(a.g.b.pg.title, "Second page")
    assert(not a.omni.editing)

@test fn the_chrome_asks_the_host_for_its_own_text_widths_once()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 600.0, 300.0, 7.5, 15.0)
    a.g.pixel = true
    a.update(resized(600.0, 300.0))
    a.hover_href = "https://example.com/a"
    want := a.measures()
    page_n := a.g.wanted().len()
    assert(want.len() > page_n)
    assert_eq(want[want.len() - 1].text, "https://example.com/a")
    mut widths := List[float]()
    for _ in 0..want.len()
        widths.push(7.0)
    a.measured(want, widths)
    got := a.cw.get(chrome.width_key("https://example.com/a", 12.0)) else 0.0
    assert_eq(got, 7.0)
    assert_eq(a.measures().len(), a.g.wanted().len())

@test fn font_keywords_inherit_oblique_and_the_font_shorthand()
    assert(page.font_italic("oblique 10deg", false))
    assert(page.font_italic(" Italic ", false))
    assert(not page.font_italic("normal", true))
    assert(page.font_italic("inherit", true))
    assert(not page.font_italic("inherit", false))
    assert(page.font_bold("700", false))
    assert(not page.font_bold("500", true))
    assert(page.font_bold("unset", true))
    assert_eq(page.font_shorthand("italic bold 16px/1.5 Georgia", false, false), (true, true))
    assert_eq(page.font_shorthand("700 14px Arial", true, false), (false, true))
    assert_eq(page.font_shorthand("12px Arial", true, true), (false, false))
    assert_eq(page.font_shorthand("italic", false, true), (false, true))

# ---- Loading in steps, side-by-side fetches, pictures after the first frame --

@test fn a_stepped_load_paints_before_the_scripts_and_ends_as_a_whole_load_does()
    url := "{testdata()}/noscript-text.html"
    whole := Browser.new(url, 60, 12)
    mut b := Browser.empty(url, 60, 12)
    b.stepped = true
    b.load(url, "GET", "")
    ## The first step: the page as it came, `<noscript>` already hidden.
    assert(b.loading())
    assert(b.pg.text().contains("Waiting"))
    assert(not b.pg.text().contains("enable JavaScript"))
    assert(not b.has_js())
    b.step()
    assert(not b.loading())
    assert(b.pg.text().contains("Scripts ran"))
    assert_eq(b.pg.text(), whole.pg.text())

@test fn stepped_hops_follow_a_refresh_and_fetch_each_sheet_once()
    for name in ["refresh.html", "many-sheets.html", "imports.html", "styled.html"]
        url := "{testdata()}/{name}"
        whole := Browser.new(url, 60, 12)
        mut b := Browser.empty(url, 60, 12)
        b.stepped = true
        b.load(url, "GET", "")
        mut steps := 1
        while b.loading() and steps < 20
            b.step()
            steps += 1
        assert(not b.loading())
        assert_eq(b.url, whole.url)
        assert_eq(b.pg.text(), whole.pg.text())
        assert_eq(b.sheet.rules.len(), whole.sheet.rules.len())
        assert_eq((b.perf.counts.get("sheets") else 0), (whole.perf.counts.get("sheets") else 0))

@test fn side_by_side_fetches_come_back_in_the_order_asked()
    names := [
        "styled.css",
        "print.css",
        "import-a.css",
        "import-b.css",
        "import-c.css",
        "import-print.css",
        "late-script.js",
        "no-such-file.css",
    ]
    urls := ["{testdata()}/{n}" for n in names]
    mut cj := jar.new()
    mut cache := Map[str, Cached]()
    perf := new_perf()
    got := fetch_gots(urls, "{testdata()}/index.html", mut cj, mut cache, perf)
    assert_eq([g.url for g in got], urls)
    last := urls.len() - 1
    for k in 0..last
        assert(got[k].ok)
        assert_eq(
            got[k].text,
            fetch_got(urls[k], "GET", "", "", false, false, mut cj, mut cache, perf).text,
        )
    assert(not got[last].ok)
    ## `data:` addresses are their own text, in their places.
    mixed := fetch_gots(
        ["data:text/css,a", urls[0], "data:text/css,b"],
        "",
        mut cj,
        mut cache,
        perf,
    )
    assert_eq(mixed[0].text, "a")
    assert_eq(mixed[1].text, got[0].text)
    assert_eq(mixed[2].text, "b")
    assert_eq(fetch_gots([], "", mut cj, mut cache, perf).len(), 0)

## The box of picture `op` (x, y, w, h); empty for any other operation.
fn pic_box(op draw.Op) List[float]
    match op
        Pic(x, y, w, h, _) => [x, y, w, h]
        Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Str(_, _, _, _, _, _, _, _, _) => []

@test fn pictures_still_coming_keep_their_room_and_arrive_in_a_step()
    dir := "{env.cwd()}/vendor/image/testdata"
    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 300.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.lazy_pics = true
    a.g.b.doc = html.parse("<img src=gray8.png width=20 height=10><img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.b.pics_due = true
    a.g.refresh()
    ## Before the pictures' step: the sized one keeps its 20 by 10 as a
    ## placeholder; the unsized one has no room until its size is known.
    pics := [op for op in a.g.display() if pic_src(op) != ""]
    assert_eq(pics.len(), 1)
    bx := pic_box(pics[0])
    assert_eq([bx[2], bx[3]], [20.0, 10.0])
    assert(to_app(pics[0], a.g) == app.draw_rect(bx[0], bx[1], 20.0, 10.0, PICTURE_PLACEHOLDER))
    assert(a.steps_left())
    a.g.b.picture_step()
    assert_eq(a.g.b.sizes["file://{dir}/gray8.png"], [37, 29])
    a.g.refresh()
    assert_eq([op for op in a.g.display() if pic_src(op) != ""].len(), 2)
    ## Nothing is missing now: the next step ends the pictures' steps.
    a.g.b.picture_step()
    assert(not a.g.b.pics_due)
    assert(not a.steps_left())

@test fn the_window_queues_one_step_at_a_time_until_the_load_is_done()
    url := "{testdata()}/noscript-text.html"
    mut a := Garlic.new(Browser.empty(url, 100, 32), 400.0, 300.0, 8.0, 16.0)
    a.has_kick = true
    a.load_next = "first"
    a.do_load()
    assert(a.g.b.loading())
    assert(not a.g.b.stepped)
    assert(a.g.b.pg.text().contains("Waiting"))
    a.continue_load()
    assert(a.step_posted)
    assert_eq((a.kick.try_recv() else 0), 1)
    ## One at a time: no second token while the first is on its way.
    a.continue_load()
    assert_eq((a.kick.try_recv() else 0), 0)
    a.update(app.external("load-step", ""))
    assert(not a.g.b.loading())
    assert(not a.step_posted)
    assert(a.g.b.pg.text().contains("Scripts ran"))
    assert_eq((a.kick.try_recv() else 0), 0)

@test fn leading_imports_stop_at_the_first_rule()
    imps := leading_imports("@charset \"utf-8\";\n/* c */ @import url(\"a.css\") screen; @import 'b.css' layer(base) supports(display: grid) (min-width: 10px);\n@import url(data:text/css;x,a);\n.x \{} @import \"late.css\";")
    assert_eq([i.href for i in imps], ["a.css", "b.css", "data:text/css;x,a"])
    assert_eq([i.media for i in imps], ["screen", "(min-width: 10px)", ""])
    assert_eq(leading_imports("@media screen \{ p \{} } @import \"z.css\";").len(), 0)
    assert_eq(leading_imports("@layer base, theme;\n@import \"z.css\" layer;").len(), 1)
    assert(import_of("nothing") == none)

@test fn script_inserted_scripts_are_fetched_run_and_told_load_or_error()

@test fn grid_template_areas_place_items_by_name_in_their_tracks()
    src := """
        <style>.g \{ display: grid; grid-template-columns: 100px 1fr; column-gap: 0; grid-template-areas: 'h h' 's m' } .h \{ grid-area: h } .s \{ grid-area: s } .m \{ grid-area: m }</style>
        <div class=g><div class=m>main</div><div class=s>side</div><div class=h>head</div></div>
        """
    ts := pixel_text(gfx.layout(html.parse(src), "file:///t.html", 400.0, css.parse("", 0)).ops)
    head := at_of(ts, "head")
    side := at_of(ts, "side")
    mn := at_of(ts, "main")
    assert_eq(side[0], head[0])
    assert_eq(mn[0], side[0] + 100.0)
    assert_eq(mn[1], side[1])
    assert(side[1] > head[1])

## The x and y of the pixel text `word` in `ts` (from `pixel_text`), or [].
fn at_of(ts List[str], word str) List[float]
    for t in ts
        if t.starts_with("{word}@")
            parts := t.slice(word.chars().len() + 1, t.chars().len()).split(",")
            return [parts[0].to_float() else 0.0, parts[1].to_float() else 0.0]
    []

@test fn list_style_none_applies_from_the_item_the_list_or_an_ancestor()
    src := """
        <style>.n \{ list-style: none outside } .i li \{ list-style-type: none } nav \{ list-style: none }</style>
        <ul class=n><li>one</li></ul><ul class=i><li>two</li></ul><nav><ul><li>three</li></ul></nav><ul><li>four</li></ul>
        """
    ts := pixel_text(gfx.layout(html.parse(src), "file:///t.html", 400.0, css.parse("", 0)).ops)
    assert_eq(len_starting(ts, "\u{2022}@"), 1)

fn len_starting(ts List[str], prefix str) int
    mut n := 0
    for t in ts
        if t.starts_with(prefix)
            n += 1
    n


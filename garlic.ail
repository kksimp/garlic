@test fn typing_fires_focus_key_input_and_change_events_and_enter_can_be_cancelled()
    mut b := Browser.new("{testdata()}/keys.html", 80, 30)
    b.act("type", "{node_with(b, "input", "id", "q")}=axb")
    assert(b.pg.text().contains("q focus | down a | input a | down x | down b | input ab | change ab"))
    # Tab moves focus on to the next field: q blurs and r focuses.
    mut c := Browser.new("{testdata()}/keys.html", 80, 30)
    c.act("type", "{node_with(c, "input", "id", "q")}=a")
    c.key("tab", false, false)
    assert_eq(c.focus, 1)
    c.key("tab", false, false)
    assert_eq(c.focus, 2)
    # Enter in a field the page cancels: no submission.
    mut d := Browser.new("{testdata()}/keys.html", 80, 30)
    w := node_with(d, "input", "id", "w")
    d.prompt = Field(w, "z")
    d.key("enter", false, false)
    assert_eq(d.pg.title, "Keys test")
    assert(d.pg.text().contains("enter stopped"))


@test fn back_and_forward_show_kept_pages_without_a_fetch()
    mut b := Browser.new("{testdata()}/index.html", 60, 12)
    first := b.url
    title := b.pg.title
    b.scroll_to(1)
    b.go("{testdata()}/second.html")
    second := b.url
    assert(b.kept.contains(first))
    ## Back needs no file: the kept tree is shown, at the place it was left.
    b.kept[first].doc.nodes[0].tag = "#document"
    b.go_back()
    assert_eq(b.url, first)
    assert_eq(b.pg.title, title)
    assert_eq(b.ahead, [second])
    b.go_forward()
    assert_eq(b.url, second)
    assert_eq(b.back, [first])
    b.go_back()
    b.go("{testdata()}/second.html")
    assert_eq(b.ahead.len(), 0)
    b.go_forward()
    assert_eq(b.message, "no page to go forward to")

@test fn decoded_pictures_go_to_the_host_once()
    dir := "{env.cwd()}/vendor/image/testdata"
    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 300.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.doc = html.parse("<img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.refresh()
    first := [to_app(op, a.g) for op in a.g.display()]
    a.update(app.event("noop"))
    second := [to_app(op, a.g) for op in a.g.display()]
    assert_eq(bitmap_data_lens(first), [[37, 29, 1]])
    assert_eq(bitmap_data_lens(second)[0][2], 0)

@test fn a_picture_scrolled_into_view_after_it_was_decoded_still_gets_its_data()
    dir := "{env.cwd()}/vendor/image/testdata"
    mut a := Garlic.new(Browser.new("file://{dir}/missing.html", 100, 32), 400.0, 100.0, 8.0, 16.0)
    a.g.pixel = true
    a.g.b.doc = html.parse("<div style='height: 600px'>top</div><img src=gray8.png>")
    a.g.b.url = "file://{dir}/page.html"
    a.g.b.stamp += 1
    a.g.refresh()
    ## Off screen: nothing to send yet, and a later event must not count it as sent.
    assert_eq(bitmap_data_lens([to_app(op, a.g) for op in a.g.display()]).len(), 0)
    a.update(app.event("noop"))
    a.g.top = 600.0
    a.g.refresh()
    first := [to_app(op, a.g) for op in a.g.display()]
    assert_eq(bitmap_data_lens(first), [[37, 29, 1]])

@allow("expr.match.3") fn bitmap_data_lens(ops List[app.Op]) List[List[int]]
    mut out := List[List[int]]()
    for op in ops
        match op
            app.Op.Bitmap(_, _, _, _, _, pw, ph, data) => out.push([
                pw,
                ph,
                data.chars().len().min(1),
            ])
            _ => out = out
    out

## Compares a native Garlic with the interpreter's layout. A native build of
## Garlic takes minutes, far past the test runner's 30 s per test, so the test
## only runs when the gate has built one and names it in `GARLIC_NATIVE_EXE`
## (`../ail/ail build garlic.ail -o EXE`).
@test fn the_native_build_draws_the_same_pixels_as_the_interpreter()
    exe := env.get("GARLIC_NATIVE_EXE") else return
    html_file := "{testdata()}/voltare-full.html"
    native := proc.run(exe, [html_file, "--pixels-dump"], none, 25000)?
    b := Browser.new(html_file, 100, 32)
    mut want := List[str]()
    s := gfx.layout(b.doc, b.url, 960.0, b.sheet)
    want.push("canvas #{s.bg.to_hex().pad_left(6, '0')} height {s.height.round()} ops {s.ops.len()} links {s.hits.len()}")
    for op in s.ops
        want.push(op_line(op))
    assert_eq(native.out.trim(), want.join("\n"))
    assert(native.out.contains("canvas #0a0a0f"))
    # The nav's SVG-only GitHub link draws its icon (#676), not its aria-label.
    assert(native.out.contains("pic 829.0,15.0 18.0x18.0 svg:"))

## The `Str` and `Rect` operations of `s` as `text@x,y` and `rect@x,y wxh`.
fn flat(s gfx.Scene) List[str]
    mut out := List[str]()
    for op in s.ops
        match op
            Str(
                x,
                y,
                t,
                _,
                _,
                _,
                _,
                _,
                _,
            ) => out.push("{t}@{x.round().to_int()},{y.round().to_int()}")
            Rect(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("rect@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Pic(
                x,
                y,
                w,
                h,
                _,
            ) => out.push("pic@{x.round().to_int()},{y.round().to_int()} {w.round().to_int()}x{h.round().to_int()}")
            Text(_, _, _, _, _, _, _) => out = out
    out

@test fn absolute_children_sit_at_the_positioned_ancestors_offsets()
    s := pixels(
        "<body style='margin:0'><div style='position:relative;height:100px;width:200px;background:#eee'><span style='position:absolute;top:10px;right:5px;width:40px;height:12px;background:#f00'></span>hi</div><p>after</p></body>",
        400.0,
    )
    f := flat(s)
    assert(f.contains("rect@155,10 40x12"))
    assert(f.contains("hi@0,0"))

@test fn floats_take_a_corner_and_text_wraps_beside_them()
    s := pixels(
        "<body style='margin:0'><img src=a.png width=100 height=80 style='float:right'><p style='margin:0'>aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk lll</p></body>",
        300.0,
    )
    f := flat(s)
    assert(f.contains("pic@200,0 100x80"))
    mut max_right := 0.0
    for op in s.ops
        match op
            Str(x, _, t, _, size, _, _, _, _) => max_right = max_right.max(x + gfx.text_width(
                t,
                size,
                false,
                false,
            ))
            Rect(_, _, _, _, _) | Text(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Pic(_, _, _, _, _) => max_right = max_right
    assert(max_right <= 200.0)

@test fn rounded_corners_cut_the_rectangle_into_strips()
    s := pixels(
        "<body style='margin:0'><div style='width:40px;height:40px;background:#f00;border-radius:8px'></div></body>",
        200.0,
    )
    f := flat(s)
    assert(f.len() > 5)
    assert(f.contains("rect@0,8 40x24"))
    assert(f.contains("rect@5,0 30x1"))

@test fn wrapping_chips_keep_their_padding_apart()
    s := pixels(
        "<body style='margin:0'><div style='display:flex;flex-wrap:wrap;gap:6px'><span style='padding:2px 8px;background:#333'>one</span><span style='padding:2px 8px;background:#333'>two</span></div></body>",
        300.0,
    )
    mut starts := List[float]()
    mut ends := List[float]()
    for op in s.ops
        match op
            Rect(x, _, w, _, c) => if c == 0x333333
                starts.push(x)
                ends.push(x + w)
            Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) | Text(_, _, _, _, _, _, _) | Pic(_, _, _, _, _) => starts = starts
    assert_eq(starts.len(), 2)
    assert(starts[1] >= ends[0] + 5.0)

@test fn pixel_forms_take_typing_and_submit_with_enter()

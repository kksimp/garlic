## garlic: a web browser written in AIL (docs/design/garlic-browser.md).
##
## Text mode: it fetches a page over `std.net` (or reads a file), parses it
## with `html`, lays it out in text cells with `page`, and draws it in a
## `std.ui` window. Every page is also a page model an agent reads with
## `--json`: roles, names, links and the cells each was drawn in.

use std.env
use std.io
use std.fs
use std.net
use std.net.jar
use std.compress
use std.time
use std.ui
use std.app
use html
use page
use css
use draw
use jsdom

## The keys, as `--keys` prints them.
KEYS := [
    "Tab, Shift-Tab    next, previous link or form control",
    "Enter, click      follow a link, edit a field, press a button, toggle a box",
    "Backspace, Alt-Left  back",
    "Up, Down, PageUp, PageDown, Home, End, Space  scroll",
    "g                 open a URL or file",
    "/                 find text; n finds the next match",
    "r                 reload",
    "q, Escape         quit",
]

## What the bottom row is doing: showing the status, or reading a URL, a
## search, or the text for form field `id`.
enum Prompt
    Status
    Url(text str)
    Find(text str)
    Field(id int, text str)

## The browser: the page shown (its tree and layout), where it is scrolled,
## the focused target (0 for none) and the pages to go back to.
struct Browser
    url str
    doc html.Doc
    ## The page's linked style sheets (`<link rel=stylesheet>`), as one.
    sheet css.Sheet
    pg page.Page
    scroll int
    focus int
    width int
    height int
    back List[str]
    message str
    prompt Prompt
    last_find str
    ## Whether the page model lists only the viewport's nodes (`--viewport`).
    viewport_only bool
    ## The page model's size limit in tokens (`--budget N`), 0 for none.
    budget int
    ## Whether `--session` answers with diffs (`--diff`), and what it last sent.
    diff bool
    last_url str
    last_nodes Map[int, str]
    ## Cookies from responses and scripts, sent back to their sites.
    cj jar.Jar

## The headers Garlic sends: who it is, and that it wants HTML.
fn options() net.Options
    mut o := net.options()
    o.headers["user-agent"] = "Garlic/0.1 (AIL; text)"
    o.headers["accept"] = "text/html,application/xhtml+xml;q=0.9,text/plain;q=0.8,*/*;q=0.5"
    o.headers["accept-language"] = "en"
    o.headers["accept-encoding"] = "gzip, deflate"
    o

## The text of `url`: `http` and `https` through `net.request` (which
## follows redirects), with `method` and a form `body`; `file://` and
## anything without a scheme from the file system. A failure is shown as a
## page, so the browser keeps going.
fn fetch(url str, method str, body str) str
    mut cj := jar.new()
    fetch_with(url, method, body, mut cj)

## `fetch`, sending `cj`'s cookies for the site and keeping the ones the
## response sets.
fn fetch_with(url str, method str, body str, mut cj jar.Jar) str
    s := page.scheme(url)
    if s == "http" or s == "https"
        mut o := options()
        if method == "POST"
            o.body = body
            o.headers["content-type"] = "application/x-www-form-urlencoded"
        cookie := cj.header(url)
        if cookie != ""
            o.headers["cookie"] = cookie
        r := net.request_bytes(method, url, o) else err
            return error_page(url, "{err}")
        for line in r.all_headers.get("set-cookie") else List[str]()
            cj.set_cookie(url, line)
        if r.status >= 400
            return "{body_text(r)}<p>(HTTP status {r.status})"
        return body_text(r)
    file := (url.strip_prefix("file://") else url).split("?")[0].split("#")[0]
    data := fs.read_bytes(file) else err
        return error_page(url, "{err}")
    decode(data, "")

## The labels that name windows-1252, which HTML reads `iso-8859-1` and
## `us-ascii` as (WHATWG Encoding).
WINDOWS_1252 := {
    "windows-1252",
    "cp1252",
    "x-cp1252",
    "iso-8859-1",
    "iso8859-1",
    "latin1",
    "l1",
    "us-ascii",
    "ascii",
}

## A response body as text: its `Content-Encoding` (gzip or deflate)
## undone, then decoded by its charset. A body that won't decompress is
## used as it came.
fn body_text(r net.RawResponse) str
    mut data := r.data
    enc := (r.headers.get("content-encoding") else "").trim().to_lower()
    if enc == "gzip" or enc == "x-gzip"
        data = compress.gunzip(data) else data
    elif enc == "deflate"
        data = compress.unzlib(data) else (compress.inflate(data) else data)
    decode(data, r.headers.get("content-type") else "")

## `data` as text in the charset that `content_type` names, or failing that
## a `<meta charset>` in its first 1024 bytes (HTML's prescan, simplified).
## Without either, strict UTF-8 when it is valid and windows-1252 when not.
fn decode(data bytes, content_type str) str
    mut label := charset_label(content_type)
    if label == ""
        head := data[0..data.len().min(1024)].text().to_lower()
        if at := head.find("charset=")
            label = charset_label(head.slice(at, head.chars().len()))
    if label == ""
        if text := data.to_str()
            return text
        label = "windows-1252"
    if not WINDOWS_1252.contains(label)
        return data.text()
    mut ascii := true
    for b in data
        if b >= 0x80
            ascii = false
            break
    if ascii
        return data.text()
    mut out := List[char]()
    for b in data
        out.push(html.windows_1252(b.to_int()))
    out.join("")

## The value of the `charset=` in `s`, lowercased and unquoted; "" if none.
fn charset_label(s str) str
    lower := s.to_lower()
    at := lower.find("charset=") else return ""
    cs := lower.slice(at + 8, lower.chars().len()).trim().chars()
    mut out := List[char]()
    for c in cs
        if c == '"' or c == '\''
            if out.len() == 0
                continue
            break
        if c == ';' or c == ' ' or c == '>' or c == '/' or c == ','
            break
        out.push(c)
    out.join("")

fn error_page(url str, why str) str
    "<title>Can't open {url}</title><h1>Can't open this page</h1><p>{url}</p><p>{why}</p>"

## At most this many hops (a `<meta http-equiv=refresh>` or a script
## sending the browser on) are followed per load.
MAX_REFRESHES := 5

## A refresh with a longer delay is left alone, as the page asks to be read.
MAX_REFRESH_DELAY := 5

## Where the page's `<meta http-equiv=refresh content="N; url=...">` sends
## the browser, when it has a URL other than the page's own and a delay
## of at most `MAX_REFRESH_DELAY` seconds. Garlic goes there at once (HTML
## "shared declarative refresh steps", simplified).
## Some sites send script-less clients to a "turn on JavaScript" page
## this way.
fn refresh_target(d html.Doc, url str, scripting bool) str?
    for m in d.all("meta")
        if (d.attr(m, "http-equiv") else "").trim().to_lower() != "refresh"
            continue
        if scripting and d.enclosing(m, "noscript") != none
            continue
        content := (d.attr(m, "content") else "").trim()
        cs := content.chars()
        mut i := 0
        while i < cs.len() and cs[i].is_digit()
            i += 1
        if i == 0
            continue
        delay := content.slice(0, i).to_int() else continue
        if delay > MAX_REFRESH_DELAY
            continue
        while i < cs.len() and (cs[i].is_digit() or cs[i] == '.')
            i += 1
        mut rest := content.slice(i, cs.len()).trim()
        rest = (rest.strip_prefix(";") else rest.strip_prefix(",") else rest).trim()
        if rest.to_lower().starts_with("url")
            after := rest.slice(3, rest.chars().len()).trim()
            if after.starts_with("=")
                rest = after.slice(1, after.chars().len()).trim()
        if rest.starts_with("\"") or rest.starts_with("'")
            q := rest.slice(0, 1)
            rest = rest.slice(1, rest.chars().len())
            if end := rest.find(q)
                rest = rest.slice(0, end)
        if rest == ""
            continue
        target := page.resolve(url, rest)
        if target != url
            return target
    none

## At most this many linked style sheets are fetched per page.
MAX_SHEETS := 8

## The page's linked style sheets, fetched and parsed in document order.
fn linked_sheets(d html.Doc, url str) css.Sheet
    mut all := css.parse("", 0)
    mut n := 0
    for l in d.all("link")
        rel := (d.attr(l, "rel") else "").to_lower().split(" ")
        media := (d.attr(l, "media") else "").trim()
        ## A sheet for print, or for no window width at all, isn't fetched;
        ## the rest apply by the window's width at layout.
        fits := css.media_matches(media, 320) or css.media_matches(media, 2000)
        if not rel.contains("stylesheet") or rel.contains("alternate") or not fits
            continue
        href := d.attr(l, "href") else continue
        if n == MAX_SHEETS
            break
        n += 1
        all = css.concat(all, css.parse_in(fetch_text(page.resolve(url, href)), 0, media))
    all

## The text of a sub-resource, or "" when it can't be fetched.
fn fetch_text(url str) str
    s := page.scheme(url)
    if s == "http" or s == "https"
        r := net.request_bytes("GET", url, options()) else return ""
        return if r.status < 400 then body_text(r) else ""
    fs.read_text(url.strip_prefix("file://") else url) else ""

## A loaded page: where it ended up and its tree.
struct Loaded
    url str
    doc html.Doc

## Fetches and parses `target`, then runs its scripts (unless `--no-js`),
## which change the tree or send the browser on to another page.
fn load_doc(target str, method str, body str, mut cj jar.Jar) Loaded
    mut at := target
    mut m := method
    mut b := body
    for _ in 0..MAX_REFRESHES
        mut d := html.parse(fetch_with(at, m, b, mut cj))
        if env.args().contains("--no-js")
            next := refresh_target(d, at, false) else return Loaded(url: at, doc: d)
            at = next
            m = "GET"
            b = ""
            continue
        mut scripts := Map[str, str]()
        for s in d.all("script")
            if src := d.attr(s, "src")
                u := page.resolve(at, src)
                scripts[script_url(u)] = fetch_text(u)
        now := time.now_ms().to_float()
        ## A page with no scripts has nothing to run, and starting the engine
        ## costs about 0.2 s.
        out := if d.all("script").len() == 0 then jsdom.Outcome(
            url: "",
            method: "",
            body: "",
            console: [],
            missing: [],
            changes: 0,
            cookies: [],
        ) else jsdom.run(mut d, script_url(at), scripts, cj.for_script(at), now, 1000.0, 5000000)
        for line in out.cookies
            cj.set_from_script(at, line)
        if env.args().contains("--console")
            for line in out.console
                io.eprint("console: {line}")
        mut next := local_url(out.url)
        if next == "" or next == at
            # A `<meta http-equiv=refresh>` in `<noscript>` is for browsers
            # without scripts (HTML §4.12.2).
            next = refresh_target(d, at, true) else ""
            if next == ""
                return Loaded(url: at, doc: d)
            m = "GET"
            b = ""
        else
            m = out.method
            b = out.body
        at = next
    Loaded(url: at, doc: html.parse(fetch_with(at, m, b, mut cj)))

## The address scripts see: a local file gets a file:// URL.
fn script_url(u str) str
    if u.contains("://") then u else "file://local/{u}"

fn local_url(u str) str
    u.strip_prefix("file://local/") else u

fn Browser.new(url str, width int, height int) Browser
    d := html.parse("")
    sheet := css.parse("", 0)
    mut b := Browser(
        url,
        doc: d,
        sheet,
        pg: page.layout_with(d, url, width, sheet),
        scroll: 0,
        focus: 0,
        width,
        height,
        back: [],
        message: "",
        prompt: Status,
        last_find: "",
        viewport_only: false,
        budget: 0,
        diff: false,
        last_url: "",
        last_nodes: {},
        cj: jar.new(),
    )
    b.load(url, "GET", "")
    b

## Rows of page the window shows: all but the status row.
fn Browser.view(self) int
    (height - 1).max(1)

fn Browser.max_scroll(self) int
    (pg.rows.len() - view()).max(0)

fn Browser.scroll_to(mut self, row int)
    scroll = row.max(0).min(max_scroll())

## Lays the page out again, after a resize or a change to a form control.
fn Browser.relayout(mut self)
    pg = page.layout_with(doc, url, width, sheet)
    scroll_to(scroll)

## Opens `target`, remembering the current page for Back.
fn Browser.go(mut self, target str)
    back.push(url)
    load(target, "GET", "")

fn Browser.load(mut self, target str, method str, body str)
    loaded := load_doc(target, method, body, mut cj)
    url = loaded.url
    doc = loaded.doc
    sheet = linked_sheets(doc, url)
    pg = page.layout_with(doc, url, width, sheet)
    scroll = 0
    focus = 0
    message = ""

fn Browser.go_back(mut self)
    prev := back.pop() else
        message = "no page to go back to"
        return
    load(prev, "GET", "")

## Follows link `n` (1-based).
fn Browser.follow(mut self, n int)
    if n < 1 or n > pg.links.len()
        message = "no link {n}"
        return
    href := pg.boxes[pg.links[n - 1]].href
    if href.starts_with("#")
        return
    go(href)

## Moves focus to the next target (`forward`) or the previous one,
## wrapping, and scrolls it into view.
fn Browser.step_focus(mut self, forward bool)
    n := pg.targets.len()
    if n == 0
        message = "nothing to focus on this page"
        return
    if forward
        focus = focus % n + 1
    else
        focus = if focus <= 1 then n else focus - 1
    b := pg.boxes[pg.targets[focus - 1]]
    if b.row < scroll or b.end_row > scroll + view()
        scroll_to(b.row - view() / 3)

## Scrolls to the next row after the top one that contains `needle`.
fn Browser.find(mut self, needle str)
    last_find = needle
    if needle == ""
        return
    if r := pg.find(needle, scroll + 1)
        scroll_to(r)
        message = "found `{needle}` on row {r + 1}"
    elif r := pg.find(needle, 0)
        scroll_to(r)
        message = "found `{needle}` on row {r + 1} (wrapped)"
    else
        message = "`{needle}` not found"

## `text` after a key typed into a prompt: Backspace deletes, a character
## adds; none when the key does neither.
fn edit_text(text str, key str) str?
    if key == "backspace"
        return text.slice(0, (text.chars().len() - 1).max(0))
    if key == "space"
        return "{text} "
    if key.chars().len() == 1
        return "{text}{key}"
    none

## Handles a key; false when the browser should close.
fn Browser.key(mut self, key str, alt bool, shift bool) bool
    match prompt
        Url(text) =>
            prompt = Status
            if key == "enter"
                if text != ""
                    go(text)
            elif key != "escape"
                prompt = Url(edit_text(text, key) else text)
            return true
        Find(text) =>
            prompt = Status
            if key == "enter"
                find(text)
            elif key != "escape"
                prompt = Find(edit_text(text, key) else text)
            return true
        Field(id, text) =>
            prompt = Status
            if key == "enter"
                type_into(id, text)
                submit(id)
            elif key == "tab"
                type_into(id, text)
                step_focus(not shift)
            elif key != "escape"
                prompt = Field(id, edit_text(text, key) else text)
            return true
        Status => message = ""
    match key
        "q" | "escape" => return false
        "tab" => step_focus(not shift)
        "enter" =>
            if focus > 0
                activate(pg.boxes[pg.targets[focus - 1]].id)
        "backspace" => go_back()
        "left" =>
            if alt
                go_back()
        "up" => scroll_to(scroll - 1)
        "down" => scroll_to(scroll + 1)
        "pageup" => scroll_to(scroll - view())
        "pagedown" | "space" => scroll_to(scroll + view())
        "home" => scroll_to(0)
        "end" => scroll_to(max_scroll())
        "g" => prompt = Url("")
        "/" => prompt = Find("")
        "n" => find(last_find)
        "r" => load(url, "GET", "")
        _ => return true
    true

## The box of target node `id`, or none when `id` takes no action.
fn Browser.target(self, id int) page.Box?
    for t in pg.targets
        if pg.boxes[t].id == id
            return pg.boxes[t]
    none

## Acts on target node `id` as Enter or a click does: follows a link,
## edits a text field (in the window), submits with a button, toggles a
## check box, chooses a radio button.
fn Browser.activate(mut self, id int)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.link > 0
        follow(b.link)
        return
    match b.role
        "link" => follow(b.link)
        "textbox" => prompt = Field(id, b.value)
        "button" => submit(id)
        "checkbox" | "radio" => check(id)
        _ => message = "use select:{id}=OPTION to choose an option"

## Types `text` into text field `id`, replacing its value.
fn Browser.type_into(mut self, id int, text str)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.role != "textbox"
        message = "node {id} is a {b.role}, not a textbox"
        return
    doc.set_attr(id, "value", text)
    relayout()

## Toggles check box `id`, or checks radio button `id` and unchecks the
## others of its group (same `name` in the same form).
fn Browser.check(mut self, id int)
    b := target(id) else
        message = "node {id} has no action"
        return
    if b.role == "checkbox"
        if b.checked
            doc.remove_attr(id, "checked")
        else
            doc.set_attr(id, "checked", "")
    elif b.role == "radio"
        group := doc.attr(id, "name") else ""
        form := doc.enclosing(id, "form") else 0
        for r in doc.all("input")
            if page.input_type(doc, r) == "radio" and doc.attr(
                r,
                "name",
            ) == group and doc.within(r, form)
                doc.remove_attr(r, "checked")
        doc.set_attr(id, "checked", "")
    else
        message = "node {id} is a {b.role}, not a checkbox or radio"
        return
    relayout()

## Chooses the option of select `id` whose text or value is `choice`.
fn Browser.choose(mut self, id int, choice str)
    for o in doc.all("option")
        if not doc.within(o, id)
            continue
        text := html.collapse(doc.text(o))
        if text == choice or doc.attr(o, "value") == choice
            for other in doc.all("option")
                if doc.within(other, id)
                    doc.remove_attr(other, "selected")
            doc.set_attr(o, "selected", "")
            relayout()
            return
    message = "node {id} has no option `{choice}`"

## Submits the form that control `id` is in (HTML 4.10.21, simplified):
## GET puts the fields in the query of the form's `action`, POST sends them
## as the body. `id` itself counts as the submitter when it is a button.
fn Browser.submit(mut self, id int)
    form := doc.enclosing(id, "form") else
        message = "node {id} is not in a form"
        return
    fields := form_fields(doc, form, id)
    action := page.resolve(url, doc.attr(form, "action") else "")
    method := (doc.attr(form, "method") else "get").to_upper()
    back.push(url)
    if method == "POST"
        load(action, "POST", fields)
    else
        base := action.split("#")[0].split("?")[0]
        load("{base}?{fields}", "GET", "")

## The form's fields, URL-encoded (`application/x-www-form-urlencoded`):
## named, enabled controls; checked boxes and radios; the submitter only
## among buttons.
fn form_fields(d html.Doc, form int, submitter int) str
    mut out := List[str]()
    for i in 0..d.nodes.len()
        n := d.nodes[i]
        if n.kind != html.Kind.Element or not d.within(i, form)
            continue
        if n.tag != "input" and n.tag != "select" and n.tag != "textarea" and n.tag != "button"
            continue
        name := d.attr(i, "name") else continue
        if name == "" or d.attr(i, "disabled") != none
            continue
        kind := page.input_type(d, i)
        if n.tag == "button"
            or (n.tag == "input" and (kind == "submit" or kind == "image" or kind == "button" or kind == "reset"))
            if i != submitter or kind == "reset" or kind == "button"
                continue
        if (kind == "checkbox" or kind == "radio") and n.tag == "input"
            if d.attr(i, "checked") == none
                continue
            out.push("{urlencode(name)}={urlencode(d.attr(i, "value") else "on")}")
            continue
        out.push("{urlencode(name)}={urlencode(page.control_value(d, i))}")
    out.join("&")

## `s` encoded for a form: letters, digits and `*-._` as they are, space as
## `+`, every other byte of its UTF-8 as `%XX`.
fn urlencode(s str) str
    mut out := List[str]()
    for c in s.chars()
        k := c.code()
        if c.is_alpha() and k < 128 or c.is_digit() or c == '*' or c == '-' or c == '.' or c == '_'
            out.push("{c}")
        elif c == ' '
            out.push("+")
        else
            for byte in utf8(k)
                out.push("%{byte:0>2x}".to_upper())
    out.join("")

## The UTF-8 bytes of code point `k`.
fn utf8(k int) List[int]
    if k < 0x80
        return [k]
    if k < 0x800
        return [0xC0 + k / 64, 0x80 + k % 64]
    if k < 0x10000
        return [0xE0 + k / 4096, 0x80 + k / 64 % 64, 0x80 + k % 64]
    [0xF0 + k / 262144, 0x80 + k / 4096 % 64, 0x80 + k / 64 % 64, 0x80 + k % 64]

## Does one agent action (docs/design/garlic-browser.md, "Agent actions"):
## `follow` a link number, `click` a node id (as Enter does), `type`
## `ID=TEXT`, `submit` the form of node ID, `check` ID, `select`
## `ID=OPTION`, `open` a URL, `back`, `find` text, `scroll` to a row,
## `reload`. False for an unknown action.
fn Browser.act(mut self, name str, arg str) bool
    message = ""
    eq := arg.find("=") else arg.chars().len()
    id := arg.slice(0, eq).to_int() else -1
    rest := arg.slice((eq + 1).min(arg.chars().len()), arg.chars().len())
    match name
        "follow" => follow(arg.to_int() else 0)
        "click" => activate(id)
        "type" => type_into(id, rest)
        "submit" => submit(id)
        "check" => check(id)
        "select" => choose(id, rest)
        "open" => go(arg)
        "back" => go_back()
        "find" => find(arg)
        "scroll" => scroll_to(arg.to_int() else 0)
        "reload" => load(url, "GET", "")
        _ =>
            message = "unknown action `{name}`: try follow, click, type, submit, check, select, open, back, find, scroll or reload"
            return false
    if prompt != Status
        prompt = Status
    true

## The page model, within the token budget if one is set, with the last
## action's message.
fn Browser.model(self) str
    if budget > 0
        return with_message(pg.to_json_budget(scroll, view(), budget * 4))
    with_message(pg.to_json(scroll, view(), viewport_only))

fn Browser.with_message(self, j str) str
    if message == ""
        return j
    j.replace(",\"nodes\":[", ",\"message\":{page.quote(message)},\"nodes\":[")

## The page model as a diff from the last one sent on this page: the nodes
## that are new or changed (`visible` included), and the ids `removed`.
## The whole model after loading a page.
fn Browser.diff_model(mut self) str
    now := pg.node_objects(scroll, view())
    if url != last_url
        last_url = url
        last_nodes = now
        return model()
    changed := [now[k] for k in now.keys() if last_nodes.get(k) != now[k]]
    removed := [k for k in last_nodes.keys() if not now.contains(k)]
    last_nodes = now
    head := pg.head_json(scroll, view())
    with_message("\{{head},\"diff\":true,\"removed\":[{removed.join(",")}],\"nodes\":[{changed.join(",")}]}")

## The model `--session` sends: a diff with `--diff`, else the whole model.
fn Browser.answer(mut self) str
    if diff
        return diff_model()
    model()

## One action from a session line: `\{"do":"follow","link":3}`. The
## argument is `link`, `id` or `row` (a number), or `url` or `text`; with
## both `id` and `text` (`type`, `select`), `ID=TEXT`.
fn Browser.act_json(mut self, line str)
    j := parse_json(line) else err
        message = "bad JSON: {err}"
        return
    name := j.str("do") else ""
    mut arg := ""
    for key in ["link", "id", "row"]
        if n := j.num(key)
            arg = "{n.to_int()}"
    for key in ["url", "text"]
        if t := j.str(key)
            arg = if j.num("id") != none then "{arg}={t}" else t
    act(name, arg)

## `--session`: reads one JSON action per line on stdin and answers each
## with the page model on one line, so an agent keeps one browser open.
fn Browser.session(mut self)
    print(answer())
    while true
        line := io.read_line() else break
        if line.trim() == ""
            continue
        act_json(line)
        print(answer())

## The target node drawn at window cell (`col`, `row`), or none.
fn Browser.target_at(self, col int, row int) int?
    r := row + scroll
    for t in pg.targets
        b := pg.boxes[t]
        if r >= b.row and r < b.end_row
            starts := r > b.row or col >= b.col
            ends := r < b.end_row - 1 or col < b.end_col
            if starts and ends
                return b.id
    none

## The status row's text.
fn Browser.status(self) str
    match prompt
        Url(text) => "Open: {text}_"
        Find(text) => "Find: {text}_"
        Field(_, text) => "Type: {text}_  (Enter submits, Tab moves on, Esc cancels)"
        Status =>
            if message != ""
                return message
            if focus > 0
                b := pg.boxes[pg.targets[focus - 1]]
                return if b.role
                    == "link" then "[{b.link}] {b.href}" else "{b.role} {b.name}: Enter to use"
            last := (scroll + view()).min(pg.rows.len())
            "{url}  rows {scroll + 1}-{last} of {pg.rows.len()}"

fn Browser.draw(self, mut w ui.Window)
    w.clear(draw.BG)
    for r in 0..view()
        at := scroll + r
        if at >= pg.rows.len()
            break
        for run in pg.rows[at]
            bg := if run.style.target > 0
                and run.style.target == focus then draw.FOCUS_BG else draw.BG
            st := ui.Style(
                bold: run.style.bold,
                italic: run.style.italic,
                underline: run.style.link > 0,
            )
            w.put_styled(run.col, r, run.text, draw.color(run.style), bg, st)
    line := status()
    w.put(
        0,
        height - 1,
        line.pad_right(width.max(line.chars().len()), ' '),
        draw.STATUS_FG,
        draw.STATUS_BG,
    )
    w.present()

fn window_main(mut b Browser) !
    mut w := ui.open("Garlic", b.width, b.height)?
    w.set_title("{b.pg.title} - Garlic")
    b.draw(mut w)
    while true
        was := b.url
        match w.next_event()
            Key(key, _, alt, shift) =>
                if not b.key(key, alt, shift)
                    break
            Resize(cols, rows) =>
                b.width = cols
                b.height = rows
                b.relayout()
            Mouse(col, row, _, kind) =>
                if kind == "down"
                    if id := b.target_at(col, row)
                        b.activate(id)
            Scroll(lines) => b.scroll_to(b.scroll + lines)
            Close => break
        if b.url != was
            w.set_title("{b.pg.title} - Garlic")
        b.draw(mut w)
    w.close()

## Whether no prompt is open, so keys are commands rather than text.
fn Browser.reading(self) bool
    match prompt
        Status => true
        Url(_) | Find(_) | Field(_, _) => false

## The native window's side of the browser: the host's cell size in points
## (the monospace font it draws the page area in), the page area's size, and
## the scroll points that haven't added up to a row yet. The page area shows
## `rows` rows; the status line is the host's own node, not a page row.
struct Gui
    b Browser
    cell_w float
    cell_h float
    cols int
    rows int
    pending float
    ## The page area's size in points, as the host last reported it.
    area_w float
    area_h float

fn Gui.new(b Browser, w float, h float, cell_w float, cell_h float) Gui
    mut g := Gui(b, cell_w, cell_h, cols: 1, rows: 1, pending: 0.0, area_w: w, area_h: h)
    g.resize(w, h, cell_w, cell_h)
    g

## The page area is now `w` by `h` points with cells of `cell_w` by
## `cell_h`: lays the page out again for that many columns.
fn Gui.resize(mut self, w float, h float, cw float, ch float)
    cell_w = cw
    cell_h = ch
    area_w = w
    area_h = h
    size := draw.grid_size(w, h, cw, ch)
    cols = size.0
    rows = size.1
    b.width = cols
    b.height = rows + 1
    b.relayout()

## A click at (`x`, `y`) points in the page area: uses the target there.
fn Gui.click(mut self, x float, y float)
    at := draw.cell_at(x, y, cell_w, cell_h)
    if id := b.target_at(at.0, at.1)
        b.activate(id)

## A scroll of `dy` points, positive towards the end of the page. Whole
## rows move the page; the rest waits for the next scroll.
fn Gui.scroll(mut self, dy float)
    pending += dy
    lines := (pending / cell_h).to_int()
    if lines != 0
        pending -= lines.to_float() * cell_h
        b.scroll_to(b.scroll + lines)

## A key in the page area, by the `std.ui` names. False when it asks to quit.
fn Gui.key(mut self, key str, alt bool, shift bool) bool
    pending = 0.0
    b.key(key, alt, shift)

## What a typed address means: a URL as it is, a path to a file that exists
## as it is, and anything else (`projects.voltare.us/x`) as an `https` URL.
fn address(text str) str
    t := text.trim()
    if t == "" or page.scheme(t) != "" or t.starts_with("/") or fs.exists(t)
        return t
    "https://{t}"

## The URL field was submitted: opens it.
fn Gui.open(mut self, text str)
    t := address(text)
    if t != ""
        b.go(t)

## What the page area shows, as drawing operations.
fn Gui.display(self) List[draw.Op]
    draw.display_list(b.pg, b.scroll, rows, cols, b.focus, cell_w, cell_h)

## The native window as a `std.app` app (docs/design/garlic-browser.md,
## "Native window"): an address bar with back and reload above the page, and
## the status line below it.
struct Garlic
    g Gui
    ## The address field's text.
    url_text str
    ## The control to give the keyboard focus; cleared by the next event.
    want str

fn Garlic.new(b Browser, w float, h float, cell_w float, cell_h float) Garlic
    Garlic(g: Gui.new(b, w, h, cell_w, cell_h), url_text: b.url, want: "")

impl app.App for Garlic
    fn update(mut self, ev app.Event)
        want = ""
        match ev.kind
            "resize" => g.resize(ev.dx, ev.dy, ev.cell_w, ev.cell_h)
            "click" => g.click(ev.x, ev.y)
            "scroll" => g.scroll(ev.dy)
            "key" =>
                if (ev.meta and ev.text == "l") or (ev.text == "g" and g.b.reading())
                    want = "url"
                elif ev.meta and ev.text == "r"
                    g.b.load(g.b.url, "GET", "")
                elif ev.meta and ev.text == "["
                    g.b.go_back()
                else
                    g.key(ev.text, ev.alt, ev.shift)
            "edit" => url_text = ev.text
            "submit" => g.open(url_text)
            "press" =>
                if ev.id == "back"
                    g.b.go_back()
                elif ev.id == "reload"
                    g.b.load(g.b.url, "GET", "")
            _ => url_text = url_text
        if ev.kind != "edit"
            url_text = g.b.url

    fn view(self) app.Node
        bar := app.row([
            app.button("back", "Back"),
            app.button("reload", "Reload"),
            app.field("url", url_text, "Enter a web address"),
        ])
        ## A canvas of 0 by 0 fills the window; the host reports its size.
        app.column([
            bar,
            app.canvas("page", 0.0, 0.0, [to_app(op) for op in g.display()]),
            app.label(g.b.status()),
        ])

    fn title(self) str
        "{g.b.pg.title} - Garlic"

    fn focus(self) str
        want

## A drawing operation of the page, as a `std.app` canvas operation.
fn to_app(op draw.Op) app.Op
    match op
        Rect(x, y, w, h, c) => app.draw_rect(x, y, w, h, c)
        Text(x, y, t, fg, bold, italic, underline) => app.Op.Str(
            x: x,
            y: y,
            text: t,
            font: "mono",
            size: 13.0,
            fg: fg,
            bold: bold,
            italic: italic,
            underline: underline,
        )

## The native window: the page area starts at `GUI_W` by `GUI_H` points with
## cells of `GUI_CELL_W` by `GUI_CELL_H` until the host reports its own.
GUI_W := 960.0
GUI_H := 600.0
GUI_CELL_W := 7.8
GUI_CELL_H := 16.0

fn app_main(b Browser) !
    mut a := Garlic.new(b, GUI_W, GUI_H, GUI_CELL_W, GUI_CELL_H)
    app.run(mut a) else err
        print("garlic: no native window ({err.message}); the page as text:")
        print(a.g.b.pg.text())

## The value after flag `name` (`--width 60`), or none.
fn flag(args List[str], name str) str?
    at := args.index_of(name) else return none
    if at + 1 < args.len() then args[at + 1] else none

fn usage()
    print("usage: ail run tools/garlic/garlic.ail [--width N] [--height N] [--follow N | --find TEXT | --do ACTION:ARG]... [--viewport] [--budget TOKENS] [--diff] [--no-js] [--console] [--print | --json | --links | --session | --keys] URL|FILE")

fn main() !
    args := env.args()
    if args.contains("--keys")
        for k in KEYS
            print(k)
        return
    if args.len() == 0
        usage()
        return
    width := (flag(args, "--width") else "100").to_int() else 100
    height := (flag(args, "--height") else "32").to_int() else 32
    mut b := Browser.new(args[args.len() - 1], width, height)
    b.viewport_only = args.contains("--viewport")
    b.diff = args.contains("--diff")
    b.budget = (flag(args, "--budget") else "0").to_int() else 0
    for k in 0..args.len() - 1
        if args[k] == "--follow"
            b.follow(args[k + 1].to_int() else 0)
        elif args[k] == "--find"
            b.find(args[k + 1])
        elif args[k] == "--do"
            spec := args[k + 1]
            at := spec.find(":") else spec.chars().len()
            b.act(spec.slice(0, at), spec.slice(
                (at + 1).min(spec.chars().len()),
                spec.chars().len(),
            ))
    if args.contains("--session")
        b.session()
    elif args.contains("--print")
        print(b.pg.text())
    elif args.contains("--json")
        print(b.model())
    elif args.contains("--links")
        for n in 1..=b.pg.links.len()
            bx := b.pg.boxes[b.pg.links[n - 1]]
            print("[{n}] {bx.name} -> {bx.href}")
    elif args.contains("--app")
        app_main(b) else err
            print("garlic: {err}")
    else
        window_main(mut b) else err
            print("garlic: no window ({err}); the page as text:")
            print(b.pg.text())

# ---- Tests -------------------------------------------------------------

## The tree of `src` in the html5lib-tests format.
fn tree(src str) str
    html.parse(src).dump()

@test fn implied_html_head_and_body()
    assert_eq(tree("Hi"), "| <html>\n|   <head>\n|   <body>\n|     \"Hi\"")

@test fn title_goes_in_head_and_text_in_body()
    want := """
        | <!DOCTYPE html>
        | <html>
        |   <head>
        |     <title>
        |       "A & B"
        |   <body>
        |     <p>
        |       "x"
        """
    assert_eq(tree("<!doctype HTML><title>A &amp; B</title><p>x"), want)

@test fn p_closes_on_block_and_li_closes_li()
    want := """
        | <html>
        |   <head>
        |   <body>
        |     <p>
        |       "one"
        |     <div>
        |       "two"
        |     <ul>
        |       <li>
        |         "a"
        |       <li>
        |         "b"
        """
    assert_eq(tree("<p>one<div>two</div><ul><li>a<li>b</ul>"), want)

@test fn attributes_quoted_unquoted_bare_and_duplicate()
    d := html.parse("<a href=x title='T &lt; U' hidden HREF=\"y\">z</a>")
    a := d.first("a")?
    assert_eq(d.attr(a, "href"), "x")
    assert_eq(d.attr(a, "title"), "T < U")
    assert_eq(d.attr(a, "hidden"), "")
    assert_eq(d.nodes[a].attrs.len(), 3)

@test fn script_and_style_are_raw_text()
    d := html.parse("<script>if (a < b && c) x = '</p>'</script><style>p>a\{}</style>")
    s := d.first("script")?
    assert_eq(d.text(s), "if (a < b && c) x = '</p>'")
    assert_eq(d.text(d.first("style")?), "p>a\{}")

@test fn script_ends_only_at_its_own_end_tag()
    d := html.parse("<script>a = \"</scripts>\"</SCRIPT >after")
    assert_eq(d.text(d.first("script")?), "a = \"</scripts>\"")
    assert_eq(d.text(d.first("body")?), "after")

@test fn character_references()
    d := html.parse("&lt;&#65;&#x42;&copy &amp;&nosuch; &#0;&#x80;&#150; &AMP;")
    assert_eq(d.text(d.first("body")?), "<AB\u{a9} &&nosuch; \u{fffd}\u{20ac}\u{2013} &AMP;")

@test fn legacy_reference_in_attribute_stays_literal_before_equals()
    d := html.parse("<a href=\"?a=1&copy=2&amp;b\">x</a>")
    assert_eq(d.attr(d.first("a")?, "href"), "?a=1&copy=2&b")

@test fn comments_and_doctype()
    d := html.parse("<!-- note --><!DOCTYPE html><p>a<!---->b")
    assert_eq(d.doctype, "html")
    assert_eq(
        tree("<p>a<!-- c -->b"),
        "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"a\"\n|       <!--  c  -->\n|       \"b\"",
    )

@test fn void_elements_and_stray_end_tags()
    assert_eq(
        tree("a<br>b</br>c</span>d<img src=x>"),
        "| <html>\n|   <head>\n|   <body>\n|     \"a\"\n|     <br>\n|     \"b\"\n|     <br>\n|     \"cd\"\n|     <img>\n|       src=\"x\"",
    )

@test fn tables_close_rows_and_cells()
    d := html.parse("<table><tr><td>a<td>b<tr><td>c</table>")
    assert_eq(d.all("tr").len(), 2)
    assert_eq(d.all("td").len(), 3)
    assert_eq(d.nodes[d.all("td")[2]].parent, d.all("tr")[1])

@test fn svg_self_closing_tags_close()
    d := html.parse("<svg><path d='M0'/><circle/></svg>x")
    path := d.first("path")?
    assert_eq(d.nodes[path].children.len(), 0)
    assert_eq(d.nodes[d.first("circle")?].parent, d.first("svg")?)

@test fn pre_drops_its_first_newline()
    assert_eq(
        html.parse("<pre>\nx\n</pre>").text(html.parse("<pre>\nx\n</pre>").first("pre")?),
        "x\n",
    )

@test fn unterminated_tag_and_comment_do_not_trap()
    assert_eq(html.parse("<p>a<b").text(0), "a")
    assert_eq(html.parse("a<!-- open").text(0), "a")
    assert_eq(html.parse("a < b & c").text(0), "a < b & c")

## Text without markup comes back unchanged (whitespace-only text before
## the body is dropped, 13.2.6.4.1).
@test fn plain_text_round_trips(s str)
    if s.contains("<")
        or s.contains("&")
        or s.contains("\r")
        or s.contains("\u{0}")
        or html.collapse(s) == ""
        return
    assert_eq(html.parse(s).text(0), s)

## Whatever the input, tokenizing and building never trap.
@test fn any_input_parses(s str)
    d := html.parse("<{s}>{s}</{s}<!{s}&{s};")
    assert(d.nodes.len() >= 4)

fn lay(src str, width int) page.Page
    page.layout(html.parse(src), "https://example.com/docs/a.html", width)

@test fn paragraphs_wrap_at_the_width_with_one_blank_row_between()
    p := lay("<p>one two three four five</p><p>six</p>", 10)
    assert_eq(p.text(), "one two\nthree four\nfive\n\nsix")

@test fn long_words_break_and_whitespace_collapses()
    p := lay("<p>  abcdefghijklmnopqrstuvw \n\n  x  </p>", 10)
    assert_eq(p.text(), "abcdefghij\nklmnopqrst\nuvw x")

@test fn headings_lists_quotes_and_pre()
    p := lay(
        "<h2>Title</h2><ul><li>a<li>b<ol start=3><li>c</ol></ul><blockquote>q</blockquote><pre>x  y\n z</pre>",
        40,
    )
    assert_eq(p.text(), "## Title\n\n* a\n* b\n    3. c\n\n> q\n\n    x  y\n     z")

@test fn hidden_elements_are_not_drawn()
    p := lay(
        "<p>a<span hidden>b</span><span style='display: none'>c</span><script>d</script>e</p>",
        40,
    )
    assert_eq(p.text(), "ae")

@test fn links_are_numbered_and_resolved()
    p := lay(
        "<p>See <a href='b.html'>the docs</a> and <a href='/x?q=1'>x</a>.</p><a name=anchor>no href</a>",
        80,
    )
    assert_eq(p.text(), "See the docs[1] and x[2].\n\nno href")
    assert_eq(p.links.len(), 2)
    one := p.boxes[p.links[0]]
    assert_eq(one.href, "https://example.com/docs/b.html")
    assert_eq([one.row, one.col, one.end_row, one.end_col], [0, 4, 1, 15])
    assert_eq(p.boxes[p.links[1]].href, "https://example.com/x?q=1")

@test fn a_wrapped_link_spans_rows()
    p := lay("<p>aaaa <a href=x>bb cc dd</a></p>", 10)
    assert_eq(p.text(), "aaaa bb cc\ndd[1]")
    b := p.boxes[p.links[0]]
    assert_eq([b.row, b.col, b.end_row, b.end_col], [0, 5, 2, 5])

@test fn tables_render_one_row_per_line()
    p := lay("<table><tr><th>k<th>v<tr><td>a<td>1</table>", 40)
    assert_eq(p.text(), "k | v\na | 1")

@test fn images_and_inputs_show_their_text()
    p := lay(
        "<p><img src=a.png alt=Logo> <input name=q placeholder=Search> <input type=submit value=Go></p>",
        60,
    )
    assert_eq(p.text(), "[Logo] [Search______________] [Go]")
    assert_eq([b.name for b in p.boxes if b.role == "image"], ["Logo"])

@test fn page_model_json_marks_the_viewport()
    p := lay("<title>T</title><h1>Head</h1><p>one</p><p><a href=n>next</a></p>", 40)
    want := r"""{"api":1,"url":"https://example.com/docs/a.html","title":"T","width":40,"height":2,"scroll":0,"rows":5,"nodes":[{"id":6,"role":"heading","name":"Head","level":1,"row":0,"col":2,"end_row":1,"end_col":6,"visible":true},{"id":8,"role":"paragraph","name":"one","row":2,"col":0,"end_row":3,"end_col":3,"visible":false},{"id":10,"role":"paragraph","name":"next","row":4,"col":0,"end_row":5,"end_col":7,"visible":false},{"id":11,"role":"link","name":"next","href":"https://example.com/docs/n","row":4,"col":0,"end_row":5,"end_col":7,"visible":false,"link":1,"actions":["follow"]}]}"""
    assert_eq(p.to_json(0, 2, false), want)
    assert_eq(p.to_json(0, 2, true).split("\"id\"").len(), 2)

@test fn explicit_role_and_aria_label_win()
    p := lay("<div role=button aria-label=Close>x</div>", 40)
    assert_eq(p.boxes[0].role, "button")
    assert_eq(p.boxes[0].name, "Close")

@test fn url_resolution()
    base := "https://a.org/b/c/d.html?q#f"
    assert_eq(page.resolve(base, "e.html"), "https://a.org/b/c/e.html")
    assert_eq(page.resolve(base, "../e"), "https://a.org/b/e")
    assert_eq(page.resolve(base, "./"), "https://a.org/b/c/")
    assert_eq(page.resolve(base, "/x/./y/../z"), "https://a.org/x/z")
    assert_eq(page.resolve(base, "//cdn.org/s.js"), "https://cdn.org/s.js")
    assert_eq(page.resolve(base, "?r"), "https://a.org/b/c/d.html?r")
    assert_eq(page.resolve(base, "#top"), "https://a.org/b/c/d.html?q#top")
    assert_eq(page.resolve(base, "mailto:x@y.z"), "mailto:x@y.z")
    assert_eq(page.resolve("https://a.org", "p"), "https://a.org/p")
    assert_eq(page.resolve("site/index.html", "b.html"), "site/b.html")

## `tools/garlic/testdata`, from the repository root or `bootstrap/`.
fn testdata() str
    for d in ["tools/garlic/testdata", "../tools/garlic/testdata"]
        if fs.exists(d)
            return "{env.cwd()}/{d}"
    "tools/garlic/testdata"

@test fn browser_follows_links_and_goes_back()
    dir := testdata()
    mut b := Browser.new("{dir}/index.html", 60, 12)
    assert_eq(b.pg.title, "Garlic test page")
    b.key("tab", false, false)
    assert_eq(b.focus, 1)
    b.key("enter", false, false)
    assert_eq(b.pg.title, "Second page")
    b.key("backspace", false, false)
    assert_eq(b.pg.title, "Garlic test page")
    assert(b.status().contains("index.html"))

@test fn shift_tab_wraps_to_the_last_link()
    mut b := Browser.new("{testdata()}/index.html", 60, 12)
    b.key("tab", false, true)
    assert_eq(b.focus, b.pg.links.len())
    b.key("tab", false, false)
    assert_eq(b.focus, 1)
    assert(b.status().starts_with("[1] "))

@test fn a_meta_refresh_moves_to_its_target_at_once()
    b := Browser.new("{testdata()}/refresh.html", 60, 12)
    assert_eq(b.pg.title, "Second page")
    assert(b.url.ends_with("/second.html"))
    assert_eq(b.back.len(), 0)

@test fn a_slow_meta_refresh_stays_put()
    b := Browser.new("{testdata()}/slow-refresh.html", 60, 12)
    assert_eq(b.pg.title, "Read me first")

@test fn refresh_targets_parse_like_browsers()
    d := html.parse("<meta http-equiv=refresh content=\"1, URL = 'a b.html' \">")
    assert_eq(refresh_target(d, "http://x/y/z.html", false) else "", "http://x/y/a b.html")
    assert(
        refresh_target(
            html.parse("<meta http-equiv=refresh content=0>"),
            "http://x/",
            false,
        ) == none,
    )
    same := html.parse("<meta http-equiv=refresh content=\"0;url=z.html\">")
    assert(refresh_target(same, "http://x/z.html", false) == none)

@test fn bodies_decode_by_charset_and_content_encoding()
    latin := bytes.from_list([0x63, 0x61, 0x66, 0xE9, 0x20, 0x93, 0x6F, 0x6B, 0x94])
    assert_eq(decode(latin, "text/html; charset=ISO-8859-1"), "café \u{201c}ok\u{201d}")
    assert_eq(decode(latin, "text/html"), "café \u{201c}ok\u{201d}")
    utf := "café".to_bytes()
    assert_eq(decode(utf, ""), "café")
    meta := "<meta charset=\"windows-1252\"><p>".to_bytes() + bytes.from_list([0xA9])
    assert(decode(meta, "text/html").ends_with("<p>©"))
    doc := "<title>Zipped</title>"
    gz := net.RawResponse(
        status: 200,
        headers: {"content-encoding": "gzip", "content-type": "text/html; charset=utf-8"},
        data: compress.gzip(doc),
        all_headers: {},
    )
    assert_eq(body_text(gz), doc)
    z := net.RawResponse(
        status: 200,
        headers: {"content-encoding": "deflate"},
        data: compress.zlib(doc),
        all_headers: {},
    )
    assert_eq(body_text(z), doc)
    raw := net.RawResponse(
        status: 200,
        headers: {"content-encoding": "deflate"},
        data: compress.deflate(doc),
        all_headers: {},
    )
    assert_eq(body_text(raw), doc)

@test fn data_tables_line_up_in_columns()
    src := """
        <table><thead><tr><th>Lang</th><th>Site</th></tr></thead>
        <tr><td>AIL</td><td><a href=/ail>home</a></td></tr>
        <tr><td>Go</td><td><a href=/go>go.dev</a> and more</td></tr></table>
        """
    assert_eq(lay(src, 60).text(), "Lang | Site\nAIL  | home[1]\nGo   | go.dev[2] and more")
    narrow := lay(src, 12)
    assert(narrow.text().starts_with("Lang | Site\nAIL | home[1]"))
    layout := "<table><tr><td><p>Menu</p></td><td>x</td></tr><tr><td>a</td><td>bb</td></tr></table>"
    assert(lay(layout, 60).text().ends_with("a | bb"))
    span := "<table><tr><td colspan=2>Wide</td></tr><tr><td>a</td><td>b</td></tr><tr><td>ccc</td><td>d</td></tr></table>"
    assert(lay(span, 60).text().ends_with("ccc | d"))
    p := lay(src, 60)
    cells := [b for b in p.boxes if b.role == "cell"]
    assert_eq(cells[2].col, cells[4].col)

@test fn media_queries_follow_the_window_width()
    assert(css.media_matches("", 800))
    assert(css.media_matches("screen and (max-width: 600px)", 480))
    assert(not css.media_matches("screen and (max-width: 600px)", 800))
    assert(css.media_matches("print, (min-width: 40em)", 800))
    assert(not css.media_matches("print", 800))
    assert(css.media_matches("not print", 800))
    assert(css.media_matches("(width >= 700px)", 800))
    assert(not css.media_matches("(prefers-color-scheme: dark)", 800))
    src := """
        <style>.wide \{ display: none } @media (min-width: 640px) \{ .wide \{ display: block } .narrow \{ display: none } }</style>
        <p class=wide>Wide layout</p><p class=narrow>Narrow layout</p>
        """
    assert_eq(lay(src, 100).text(), "Wide layout")
    assert_eq(lay(src, 60).text(), "Narrow layout")

## The ops of a display list as `text@x,y` and `rect@x,y wxh` lines.
fn show_ops(ops List[draw.Op]) List[str]
    mut out := List[str]()
    for op in ops
        match op
            Rect(x, y, w, h, _) => out.push("rect@{x},{y} {w}x{h}")
            Text(x, y, text, _, _, _, _) => out.push("{text}@{x},{y}")
    out

@test fn the_display_list_draws_each_run_at_its_cell()
    p := lay("<h1>Hi</h1><p>one <a href=/x>two</a></p>", 40)
    ops := draw.display_list(p, 0, 6, 40, 0, 8.0, 16.0)
    assert_eq(show_ops(ops), [
        "rect@0.0,0.0 320.0x96.0",
        "# Hi@0.0,0.0",
        "one@0.0,32.0",
        "two@32.0,32.0",
        "[1]@56.0,32.0",
    ])
    link := ops[3]
    match link
        Text(_, _, _, fg, _, _, underline) =>
            assert_eq(fg, draw.LINK_FG)
            assert(underline)
        Rect(_, _, _, _, _) => assert(false)
    scrolled := show_ops(draw.display_list(p, 2, 2, 40, 0, 8.0, 16.0))
    assert_eq(scrolled[1], "one@0.0,0.0")
    assert(not scrolled.contains("# Hi@0.0,0.0"))

@test fn the_focused_target_gets_a_highlight_and_clicks_map_to_cells()
    p := lay("<p><a href=/x>go</a> <a href=/y>there</a></p>", 40)
    plain := draw.display_list(p, 0, 2, 40, 0, 7.5, 15.0)
    lit := draw.display_list(p, 0, 2, 40, 2, 7.5, 15.0)
    assert_eq(lit.len(), plain.len() + 1)
    assert_eq(show_ops(lit), [
        "rect@0.0,0.0 300.0x30.0",
        "go@0.0,0.0",
        "[1]@15.0,0.0",
        "rect@45.0,0.0 37.5x15.0",
        "there@45.0,0.0",
        "[2]@82.5,0.0",
    ])
    assert_eq(draw.cell_at(23.0, 14.9, 7.5, 15.0), (3, 0))
    assert_eq(draw.cell_at(-1.0, 15.0, 7.5, 15.0), (-1, 1))
    assert_eq(draw.grid_size(600.0, 400.0, 7.5, 15.0), (80, 26))
    assert_eq(draw.grid_size(1.0, 1.0, 7.5, 15.0), (1, 1))

@test fn the_native_window_scrolls_clicks_and_resizes_by_points()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut g := Gui.new(b, 600.0, 300.0, 7.5, 15.0)
    assert_eq((g.cols, g.rows), (80, 20))
    assert_eq((g.b.width, g.b.height), (80, 21))
    g.resize(300.0, 45.0, 7.5, 15.0)
    assert_eq((g.cols, g.rows), (40, 3))
    g.scroll(10.0)
    assert_eq(g.b.scroll, 0)
    g.scroll(10.0)
    assert_eq(g.b.scroll, 1)
    g.scroll(-30.0)
    assert_eq(g.b.scroll, 0)
    g.scroll(15.0 * 100.0)
    assert_eq(g.b.scroll, g.b.max_scroll())
    g.b.scroll_to(0)
    ops := g.display()
    assert_eq(show_ops(ops)[0], "rect@0.0,0.0 300.0x45.0")
    link := g.b.pg.boxes[g.b.pg.links[0]]
    g.click(link.col.to_float() * 7.5 + 1.0, link.row.to_float() * 15.0 + 1.0)
    assert_eq(g.b.pg.title, "Second page")
    g.open("{testdata()}/index.html")
    assert_eq(g.b.pg.title, "Garlic test page")

fn resized(w float, h float) app.Event
    mut e := app.event("resize")
    e.id = "page"
    e.dx = w
    e.dy = h
    e.cell_w = 8.0
    e.cell_h = 16.0
    e

fn clicked(x float, y float) app.Event
    mut e := app.event("click")
    e.id = "page"
    e.text = "left"
    e.x = x
    e.y = y
    e

@test fn the_app_shows_the_page_and_follows_links_by_click()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 960.0, 600.0, 8.0, 16.0)
    outlines := app.script(mut a, [resized(480.0, 96.0)])
    top := outlines[0].split("\n")
    assert_eq(top[0], "column")
    assert_eq(top[1], "  row")
    assert(top[2].starts_with("    [Back] #back"))
    assert(top[4].contains("#url"))
    assert(top[5].starts_with("  canvas #page"))
    assert(outlines[0].contains("str 0.0,32.0 \"# Garlic\" mono 13.0 dcdcaa"))
    assert(top[top.len() - 1].starts_with("  \""))
    link := a.g.b.pg.boxes[a.g.b.pg.links[0]]
    shown := app.script(mut a, [clicked(
        link.col.to_float() * 8.0 + 1.0,
        link.row.to_float() * 16.0 + 1.0,
    )])
    assert_eq(a.g.b.pg.title, "Second page")
    assert(a.url_text.ends_with("second.html"))
    assert(shown[0].contains("<{a.url_text}> #url"))
    assert_eq(a.title(), "Second page - Garlic")
    app.script(mut a, [app.press("back")])
    assert_eq(a.g.b.pg.title, "Garlic test page")

@test fn the_address_field_opens_urls_and_cmd_l_focuses_it()
    b := Browser.new("{testdata()}/index.html", 60, 12)
    mut a := Garlic.new(b, 960.0, 600.0, 8.0, 16.0)
    app.script(mut a, [app.edit("url", "{testdata()}/second.html")])
    assert_eq(a.g.b.pg.title, "Garlic test page")
    mut submit := app.event("submit")
    submit.id = "url"
    app.script(mut a, [submit])
    assert_eq(a.g.b.pg.title, "Second page")
    mut cmd_l := app.key("l")
    cmd_l.meta = true
    app.script(mut a, [cmd_l])
    assert_eq(a.focus(), "url")
    app.script(mut a, [app.key("down")])
    assert_eq(a.focus(), "")
    assert_eq(address("projects.voltare.us"), "https://projects.voltare.us")
    assert_eq(address(" https://a.b/c "), "https://a.b/c")
    assert_eq(address("/tmp/x.html"), "/tmp/x.html")

@test fn agent_actions_follow_click_back_and_report()
    mut b := Browser.new("{testdata()}/index.html", 60, 12)
    second := b.pg.boxes[b.pg.links[0]].id
    assert(b.act("click", "{second}"))
    assert_eq(b.pg.title, "Second page")
    assert(b.act("back", ""))
    assert(not b.act("fly", ""))
    assert(b.model().contains("\"message\":\"unknown action `fly`"))
    b.act_json("\{\"do\":\"follow\",\"link\":1}")
    assert_eq(b.pg.title, "Second page")
    b.act_json("\{\"do\":\"click\",\"id\":0}")
    assert(b.model().contains("\"message\":\"node 0 has no action\""))
    b.act_json("not json")
    assert(b.message.starts_with("bad JSON"))

## The id of the first element `tag` whose `attr` is `value` in `b`'s page.
fn node_with(b Browser, tag str, attr str, value str) int
    for i in b.doc.all(tag)
        if b.doc.attr(i, attr) == value
            return i
    -1

@test fn forms_render_and_join_the_model()
    b := Browser.new("{testdata()}/form.html", 120, 30)
    text := b.pg.text()
    assert(text.contains("[a b&c_______________] [Send]"))
    assert(text.contains("Query [words_______________] [ ] Exact (*) New ( ) Old [en v] [hi__________________] [Search] [Clear]"))
    q := node_with(b, "input", "name", "q")
    box := b.target(q)?
    assert_eq([box.role, box.name, box.value], ["textbox", "Query", ""])
    assert(b.model().contains("\"role\":\"textbox\",\"name\":\"Query\""))
    assert(b.model().contains("\"actions\":[\"type\",\"submit\"]"))
    assert_eq(b.target(node_with(b, "input", "name", "exact"))?.name, "Exact")

@test fn typing_checking_selecting_and_submitting_with_get()
    mut b := Browser.new("{testdata()}/form.html", 80, 30)
    q := node_with(b, "input", "name", "q")
    assert(b.act("type", "{q}=garlic bread"))
    assert(b.pg.text().contains("[garlic bread________]"))
    assert(b.model().contains("\"changed\":[{q}]"))
    b.act("check", "{node_with(b, "input", "name", "exact")}")
    b.act("check", "{node_with(b, "input", "value", "old")}")
    b.act("select", "{node_with(b, "select", "name", "lang")}=French")
    assert(b.pg.text().contains("[x] Exact ( ) New (*) Old [fr v]"))
    b.act("submit", "{node_with(b, "input", "name", "go")}")
    assert_eq(b.pg.title, "Results")
    assert(b.url.ends_with("/result.html?q=garlic+bread&src=garlic&exact=on&sort=old&lang=fr&note=hi&go=Search"))
    b.act("back", "")
    assert_eq(b.pg.title, "Search form")

@test fn enter_in_a_field_types_then_submits()
    mut b := Browser.new("{testdata()}/form.html", 80, 30)
    b.key("tab", false, false)
    b.key("enter", false, false)
    for k in ["x", "space", "y", "enter"]
        b.key(k, false, false)
    assert_eq(b.pg.title, "Results")
    assert(b.url.contains("?q=x+y&"))
    assert(not b.url.contains("go=Search"))

@test fn post_forms_send_the_body()
    mut b := Browser.new("{testdata()}/form.html", 80, 30)
    b.act_json("\{\"do\":\"click\",\"id\":{node_with(b, "button", "name", "b")}}")
    assert_eq(b.pg.title, "Posted")
    assert_eq(
        form_fields(
            html.parse("<form><input name=who value='a b&c'><button name=b value=1>x</button></form>"),
            1,
            -1,
        ),
        "who=a+b%26c",
    )

@test fn urlencode_escapes_utf8()
    assert_eq(urlencode("a b~é€/"), "a+b%7E%C3%A9%E2%82%AC%2F")

@test fn dom_mutations_are_recorded()
    mut d := html.parse("<p id=a>one</p>")
    p := d.first("p")?
    d.set_text(p, "two")
    li := d.create("LI")
    d.append(d.first("body")?, li)
    d.append(li, d.create_text("x"))
    d.insert_before(d.first("body")?, li, p)
    assert_eq(d.text(d.first("body")?), "xtwo")
    assert(d.changed.contains(p) and d.changed.contains(li))
    d.detach(p)
    assert_eq(d.text(0), "x")

@test fn css_selectors_parse_and_match()
    d := html.parse("<div id=m class='a b'><p class=x>1</p><ul><li><a href=h>2</a></ul></div>")
    p := d.first("p")?
    a := d.first("a")?
    assert(css.matches(d, p, css.selector("div#m > p.x")?))
    assert(css.matches(d, a, css.selector("#m a[href]")?))
    assert(css.matches(d, a, css.selector(".a.b li a[href=h]")?))
    assert(not css.matches(d, a, css.selector("div > a")?))
    assert(not css.matches(d, p, css.selector("p.y")?))
    assert(css.selector("a:hover") == none)

@test fn css_cascade_specificity_order_important_and_inline()
    sheet := css.parse(
        "p \{ display: none } .x \{ display: block; font-weight: bold } /* c */ @media print \{ p \{ display: inline } } p \{ font-style: italic !important } #y \{ font-style: normal }",
        0,
    )
    d := html.parse("<p class=x id=y style='font-weight: normal'>t</p>")
    got := css.cascade(d, d.first("p")?, sheet)
    assert_eq(got["display"], "block")
    assert_eq(got["font-weight"], "normal")
    assert_eq(got["font-style"], "italic")

@test fn css_hides_inlines_and_styles_text()
    src := """
        <style>.skip, nav \{ display: none } .tag \{ display: inline } .up \{ text-transform: uppercase } b.plain \{ font-weight: normal }</style>
        <nav>menu</nav><a class=skip href=x>skip</a>
        <p>one</p><p class=tag>two</p>
        <span class=up>loud</span> <b class=plain>soft</b>
        """
    p := lay(src, 40)
    assert_eq(p.text(), "one\n\ntwo LOUD soft")
    assert_eq(p.links.len(), 0)
    soft := [r for r in p.rows[p.rows.len() - 1] if r.text.contains("soft")]
    assert(not soft[0].style.bold)

@test fn linked_style_sheets_apply()
    b := Browser.new("{testdata()}/styled.html", 60, 12)
    assert_eq(b.pg.text(), "# Styled\n\nshown")

@test fn session_diffs_report_only_what_changed()
    mut b := Browser.new("{testdata()}/form.html", 80, 30)
    b.diff = true
    first := b.answer()
    assert(first.contains("\"nodes\":[") and not first.contains("\"diff\""))
    q := node_with(b, "input", "name", "q")
    b.act("type", "{q}=x")
    d := b.answer()
    assert(d.contains("\"diff\":true,\"removed\":[],\"nodes\":[\{\"id\":{q},"))
    assert(d.split("\"id\":").len() < first.split("\"id\":").len())
    assert_eq(b.answer().split("\"id\":").len(), 1)

@test fn budgets_keep_the_viewport_then_key_nodes()
    pg := Browser.new("/dev/null", 60, 4).pg
    assert(pg.to_json_budget(0, 4, 400).contains("\"omitted\":0"))
    ## A fixed URL, so the budget doesn't depend on where the checkout is.
    index := fs.read_text("{testdata()}/index.html") else ""
    p := lay(index, 60)
    full := p.to_json(0, 3, false)
    small := p.to_json_budget(0, 3, 900)
    assert(small.chars().len() <= 900 and small.chars().len() < full.chars().len())
    assert(small.contains("\"name\":\"Second page\"") and small.contains("\"role\":\"heading\",\"name\":\"Features\""))
    assert(not small.contains("\"omitted\":0"))

## A page shaped like google.com's home page, which Garlic first drew as
## "Gmail[1]Images[2]" and "  | [____]".
@test fn flex_items_margins_nbsp_and_scripts_lay_out_like_a_browser()
    src := """
        <style>.bar \{ display: flex } .m \{ margin: 0 8px }</style>
        <div class=bar><a href=/m>Gmail</a><a href=/i>Images</a><a role=button href=/apps>Apps</a></div>
        <p><span class=m>About</span><span class=m>Store</span></p>
        <table><tr><td>&nbsp;</td><td><textarea name=q title=Search></textarea><script>var x='y'</script></td></tr></table>
        """
    p := lay(src, 60)
    assert_eq(p.text(), "Gmail[1] Images[2] Apps[3]\n\nAbout Store\n\n[____________________]")
    apps := p.boxes[p.links[2]]
    assert_eq(apps.role, "button")
    icon := lay("<a href=/apps aria-label='Google apps'><svg><path d='M0'/></svg></a>", 40)
    assert_eq(icon.text(), "Google apps[1]")
    assert(p.to_json(0, 10, false).contains("\"link\":3,\"actions\":[\"follow\"]"))
    cells := [b.name for b in p.boxes if b.role == "cell"]
    assert(not cells.join(" ").contains("var x"))

@test fn browser_finds_text_and_scrolls()
    dir := testdata()
    mut b := Browser.new("{dir}/index.html", 60, 6)
    for k in ["/", "e", "n", "d", "enter"]
        b.key(k, false, false)
    r := b.pg.find("the end", 0)?
    assert(r >= b.scroll and r < b.scroll + b.view())
    assert(b.status().contains("found `end`"))

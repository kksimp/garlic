    t := pixel_text(s.ops)
    assert_eq(t.len(), 2)
    assert(t[0] != t[1])

@test fn pixel_clicks_use_form_controls()
    b := Browser.new("{testdata()}/form.html", 60, 12)
    mut g := Gui.new(b, 600.0, 400.0, 7.5, 15.0)
    g.pixel = true
    g.refresh()

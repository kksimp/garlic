@test fn a_script_reads_the_window_area_the_browser_reported()
    mut b := Browser.new("{testdata()}/viewport.html", 80, 30)
    go := node_with(b, "button", "id", "go")
    b.act("click", "{go}")
    # Before the window reports its area, a script sees the headless 1280x800.
    assert(b.pg.text().contains("1280 800 1280 1280 800 1 1280"))
    b.viewport(900.0, 600.0, 2400.0, 1.0, 0.0, 0.0)
    b.act("click", "{go}")
    assert(b.pg.text().contains("900 600 900 900 600 1 900"))
    # A new area fires `resize` once; the same area again does not.
    b.viewport(900.0, 600.0, 2400.0, 1.0, 0.0, 0.0)
    b.viewport(700.0, 500.0, 2400.0, 1.0, 0.0, 0.0)
    b.act("click", "{go}")
    assert(b.pg.text().contains("700 500 700 700 500 1 700"))
    assert(b.pg.text().contains("resized1"))

@test fn the_hosts_display_size_and_scale_reach_scripts()
    mut b := Browser.new("{testdata()}/viewport.html", 80, 30)
    go := node_with(b, "button", "id", "go")
    b.viewport(900.0, 600.0, 2400.0, 2.0, 1512.0, 982.0)
    b.act("click", "{go}")
    assert(b.pg.text().contains("900 600 900 900 600 2 1512"))

@test fn typing_fires_focus_key_input_and_change_events_and_enter_can_be_cancelled()
    mut b := Browser.new("{testdata()}/keys.html", 80, 30)
    b.act("type", "{node_with(b, "input", "id", "q")}=axb")
    assert(b.pg.text().contains("q focus | down a | input a | down x | down b | input ab | change ab"))
    # Tab moves focus on to the next field: q blurs and r focuses.
    mut c := Browser.new("{testdata()}/keys.html", 80, 30)
    c.act("type", "{node_with(c, "input", "id", "q")}=a")
    c.key("tab", false, false)
    assert_eq(c.focus, 1)
    c.key("tab", false, false)
    assert_eq(c.focus, 2)
    # Enter in a field the page cancels: no submission.
    mut d := Browser.new("{testdata()}/keys.html", 80, 30)
    w := node_with(d, "input", "id", "w")
    d.prompt = Field(w, "z")
    d.key("enter", false, false)
    assert_eq(d.pg.title, "Keys test")
    assert(d.pg.text().contains("enter stopped"))


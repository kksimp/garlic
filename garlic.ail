            Rect(_, _, _, _, _) | Text(_, _, _, _, _, _, _) | Str(
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
                _,
            ) => pw = pw
    assert_eq(pw, 15.0)

@test fn column_count_balances_blocks_into_columns()

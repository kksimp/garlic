## css: Garlic's CSS parser, selector matching and cascade for text cells
## (docs/design/garlic-browser.md, "CSS on cells").
##
## Written from CSS Syntax Level 3 (tokenizing, simplified), Selectors
## Level 4 (type, universal, `#id`, `.class`, `[attr]` with operators,
## structural pseudo-classes, `:not()`, the four combinators, `,` lists) and CSS Cascade Level 4
## (specificity, order, `!important`, inline `style`). At-rules are skipped
## with their blocks, except `@layer` (its rules count as unlayered) and `@media`, whose rules apply when its query
## matches the window (Media Queries Level 4, simplified: `media_matches`).

use html

## One declaration: `name: value [!important]`, the name lowercase.
pub struct Decl
    pub name str
    pub value str
    pub important bool

## The simple selectors that must all hold on one element: an optional
## type, ids, classes, attribute tests and structural pseudo-classes.
pub struct Neg
    pub tag str
    pub ids List[str]
    pub classes List[str]
    pub attrs List[AttrTest]
    pub pseudos List[str]

## A compound selector: a `Neg`'s tests plus the `:not(...)` ones, none
## of which may hold.
pub struct Compound
    pub tag str
    pub ids List[str]
    pub classes List[str]
    pub attrs List[AttrTest]
    pub pseudos List[str]
    pub nots List[Neg]

## `[name]` (`op` empty) or `[name op value]` with `op` one of `=`, `~=`,
## `|=`, `^=`, `$=`, `*=`.
pub struct AttrTest
    pub name str
    pub op str
    pub value str

## A complex selector: compounds left to right; `comb[k]` is the
## combinator between compound k and k+1: " ", ">", "+" or "~".
pub struct Selector
    pub parts List[Compound]
    pub comb List[str]
    pub specificity int

## A style rule; `order` is its position, for the cascade. `media` holds
## the media queries it sits in, one per line, all of which must match;
## "" for none.
pub struct Rule
    pub selector Selector
    pub decls List[Decl]
    pub order int
    pub media str

## A parsed style sheet: rules indexed by their rightmost compound's id,
## first class or type, so matching an element tries only likely rules.
pub struct Sheet
    pub rules List[Rule]
    pub by_id Map[str, List[int]]
    pub by_class Map[str, List[int]]
    pub by_tag Map[str, List[int]]
    pub general List[int]

## The properties Garlic uses on text cells; the rest are dropped at parse.
USED := {
    "display",
    "margin",
    "margin-left",
    "margin-right",
    "margin-inline",
    "margin-inline-start",
    "margin-inline-end",
    "padding",
    "padding-left",
    "padding-right",
    "padding-inline",
    "padding-inline-start",
    "padding-inline-end",
    "visibility",
    "font-weight",
    "font-style",
    "text-transform",
    "white-space",
    "content",
    "position",
    "top",
    "right",
    "bottom",
    "left",
    "float",
    "clear",
    "border-radius",
    "height",
    "min-height",
    "box-sizing",
    "align-items",
    "background-image",
    "background-clip",
    "-webkit-background-clip",
    "-webkit-text-fill-color",
    "color",
    "background",
    "background-color",
    "font-size",
    "line-height",
    "text-align",
    "text-decoration",
    "border",
    "border-top",
    "border-right",
    "border-bottom",
    "border-left",
    "border-color",
    "border-width",
    "margin-top",
    "margin-bottom",
    "padding-top",
    "padding-bottom",
    "width",
    "max-width",
    "flex-direction",
    "flex-wrap",
    "justify-content",
    "gap",
    "column-gap",
    "flex",
    "flex-grow",
    "flex-basis",
    "grid-template-columns",
    "grid-template",
    "grid-template-areas",
    "grid-area",
    "list-style",
    "list-style-type",
    "font-family",
    "color-scheme",
}

## Removes `/* ... */` comments.
fn strip_comments(src str) str
    mut out := List[str]()
    mut rest := src
    while true
        at := rest.find("/*") else
            out.push(rest)
            break
        out.push(rest.slice(0, at))
        after := rest.slice(at + 2, rest.chars().len())
        close := after.find("*/") else break
        rest = after.slice(close + 2, after.chars().len())
    out.join("")

## Parses a style sheet. Rules after an index of `start` keep their order
## after earlier sheets' rules.
pub fn parse(src str, start int) Sheet
    parse_in(src, start, "")

## Parses a style sheet whose rules all sit in the media queries `media`
## (as `Rule.media`), such as a `<link media=...>` sheet.
pub fn parse_in(src str, start int, media str) Sheet
    mut rules := List[Rule]()
    rules_of(strip_comments(src).chars(), media, start, mut rules)
    index(rules)

## Adds the rules in `cs` to `rules`, inside media queries `media`.
fn rules_of(cs List[char], media str, start int, mut rules List[Rule])
    mut i := 0
    mut prelude := List[char]()
    while i < cs.len()
        c := cs[i]
        if c == '@' and prelude.join("").trim() == ""
            end := skip_at_rule(cs, i)
            head := cs[i..end].join("")
            if head.to_lower().starts_with("@media")
                if open := head.find("\{")
                    query := head.slice(6, open).trim()
                    inner := if media == "" then query else "{media}\n{query}"
                    close := block_end(cs, i + open)
                    rules_of(cs[i + open + 1..close], inner, start, mut rules)
            elif head.to_lower().starts_with("@supports")
                ## Conditional Rules 3, simplified: a plain feature test passes
                ## (Garlic claims a modern engine); anything with `not` or a
                ## vendor-prefixed test is a fallback for other engines.
                if open := head.find("\{")
                    cond := head.slice(9, open).to_lower()
                    if not cond.contains("not")
                        and not cond.contains("-webkit-")
                        and not cond.contains("-moz-")
                        close := block_end(cs, i + open)
                        rules_of(cs[i + open + 1..close], media, start, mut rules)
            elif head.to_lower().starts_with("@layer")
                ## Cascade Layers 5, simplified: the rules apply as if unlayered.
                if open := head.find("\{")
                    close := block_end(cs, i + open)
                    rules_of(cs[i + open + 1..close], media, start, mut rules)
            i = end
            prelude.clear()
            continue
        if c == '{'
            close := block_end(cs, i)
            body := cs[i + 1..close].join("")
            decls := declarations(body)
            if decls.len() > 0
                for text in split_top(prelude.join(""))
                    if sel := selector(text)
                        rules.push(Rule(selector: sel, decls, order: start + rules.len(), media))
            prelude.clear()
            i = close + 1
            continue
        prelude.push(c)
        i += 1

## `text` split at the commas outside parentheses and brackets.
fn split_top(text str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    mut depth := 0
    for ch in text.chars()
        if ch == '(' or ch == '['
            depth += 1
        elif ch == ')' or ch == ']'
            depth -= 1
        if ch == ',' and depth == 0
            out.push(cur.join(""))
            cur.clear()
        else
            cur.push(ch)
    out.push(cur.join(""))
    out

## Builds the lookup maps of a sheet's rules.
pub fn index(rules List[Rule]) Sheet
    mut s := Sheet(rules, by_id: {}, by_class: {}, by_tag: {}, general: [])
    for k in 0..rules.len()
        last := rules[k].selector.parts[rules[k].selector.parts.len() - 1]
        if last.ids.len() > 0
            s.by_id.push(last.ids[0], k)
        elif last.classes.len() > 0
            s.by_class.push(last.classes[0], k)
        elif last.tag != ""
            s.by_tag.push(last.tag, k)
        else
            s.general.push(k)
    s

## Two sheets as one, `b`'s rules after `a`'s.
pub fn concat(a Sheet, b Sheet) Sheet
    mut all := a.rules
    for r in b.rules
        all.push(Rule(
            selector: r.selector,
            decls: r.decls,
            order: a.rules.len() + r.order,
            media: r.media,
        ))
    index(all)

## The rules of `s` that apply in a window `px` CSS pixels wide.
pub fn for_width(s Sheet, px int) Sheet
    index([r for r in s.rules if r.media == "" or all_match(r.media, px)])

fn all_match(media str, px int) bool
    for q in media.split("\n")
        if not media_matches(q, px)
            return false
    true

## Whether media query list `query` matches a screen `px` CSS pixels wide
## (Media Queries 4, simplified). Types `all` and `screen` match; widths
## compare in `px`, `em` and `rem` (16 px); the screen is dark (Kaleb, 2026-10-26), without
## hover or motion. Anything else doesn't match, so its rules stay off.
pub fn media_matches(query str, px int) bool
    q := query.trim().to_lower()
    if q == ""
        return true
    for part in q.split(",")
        if one_matches(part.trim(), px)
            return true
    false

fn one_matches(query str, px int) bool
    mut q := query.strip_prefix("only ") else query
    mut negate := false
    if rest := q.strip_prefix("not ")
        negate = true
        q = rest
    mut ok := true
    for piece in q.split(" and ")
        p := piece.trim()
        if p.starts_with("(")
            inner := (p.strip_prefix("(") else p).trim()
            ok = ok and feature_matches((inner.strip_suffix(")") else inner).trim(), px)
        else
            ok = ok and (p == "all" or p == "screen")
    ok != negate

fn feature_matches(f str, px int) bool
    for op in [">=", "<=", ">", "<"]
        if at := f.find(op)
            name := f.slice(0, at).trim()
            n := length_px(f.slice(at + op.chars().len(), f.chars().len())) else return false
            if name != "width"
                return false
            return match op
                ">=" => px >= n
                "<=" => px <= n
                ">" => px > n
                _ => px < n
    colon := f.find(":") else return f == "color"
    name := f.slice(0, colon).trim()
    value := f.slice(colon + 1, f.chars().len()).trim()
    match name
        "min-width" | "min-device-width" => px >= (length_px(value) else return false)
        "max-width" | "max-device-width" => px <= (length_px(value) else return false)
        "width" => px == (length_px(value) else return false)
        "prefers-color-scheme" => value == "dark"
        "prefers-reduced-motion" => value == "reduce"
        "hover" | "any-hover" => value == "none"
        "orientation" => value == "landscape"
        _ => false

## A length in CSS pixels: `N`, `Npx`, `Nem` or `Nrem`, with a fraction.
fn length_px(s str) int?
    t := s.trim()
    mut scale := 1.0
    mut num := t
    if rest := t.strip_suffix("rem")
        scale = 16.0
        num = rest
    elif rest := t.strip_suffix("em")
        scale = 16.0
        num = rest
    elif rest := t.strip_suffix("px")
        num = rest
    v := num.trim().to_float()?
    (v * scale).to_int()

## The index just past the matching `}` of the block opening at `open`
## (or the end of input), skipping strings.
fn block_end(cs List[char], open int) int
    mut depth := 0
    mut i := open
    while i < cs.len()
        c := cs[i]
        if c == '"' or c == '\''
            i = string_end(cs, i)
            continue
        if c == '{'
            depth += 1
        elif c == '}'
            depth -= 1
            if depth == 0
                return i
        i += 1
    cs.len()

## The index just past the string starting at `at`.
fn string_end(cs List[char], at int) int
    q := cs[at]
    mut i := at + 1
    while i < cs.len() and cs[i] != q
        if cs[i] == '\\'
            i += 1
        i += 1
    i + 1

## Skips an at-rule from `@`: up to `;`, or past its block.
fn skip_at_rule(cs List[char], at int) int
    mut i := at
    while i < cs.len()
        if cs[i] == ';'
            return i + 1
        if cs[i] == '{'
            return block_end(cs, i) + 1
        i += 1
    i

## The declarations of a block body that Garlic uses.
pub fn declarations(body str) List[Decl]
    mut out := List[Decl]()
    for part in body.split(";")
        colon := part.find(":") else continue
        name := part.slice(0, colon).trim().to_lower()
        ## Custom properties (`--x`) are kept for `var()` in the layout.
        if not USED.contains(name) and not name.starts_with("--")
            continue
        mut value := part.slice(colon + 1, part.chars().len()).trim()
        mut important := false
        if bang := value.find("!")
            important = value.slice(bang + 1, value.chars().len()).trim().to_lower() == "important"
            value = value.slice(0, bang).trim()
        if name == "list-style"
            ## The shorthand resets the type, so it competes with `list-style-type`.
            out.push(Decl("list-style-type", value: list_style_type(value.to_lower()), important))
        else
            out.push(Decl(name, value: value.to_lower(), important))
    out

## The type a `list-style` shorthand sets: `none`, a keyword, or `disc`.
fn list_style_type(v str) str
    for t in v.split(" ")
        if t == "none"
            return "none"
        if t != "" and t != "inside" and t != "outside" and not t.starts_with("url(")
            return t
    "disc"

## Parses one complex selector, or none when Garlic doesn't support it
## (pseudo-elements, dynamic pseudo-classes such as `:hover`, `:is`,
## `:where`, `:has`), so the rule is dropped. Selectors Level 4: type,
## `*`, `#id`, `.class` (with `\` escapes), `[attr]` and its operators,
## `:not()`, `:first-child`, `:nth-child()` and kin, `:empty`, `:checked`,
## `:disabled`, `:enabled`, `:link`, and the ` `, `>`, `+`, `~` combinators.
pub fn selector(text str) Selector?
    t := text.trim().replace(":root", "html")
    if t == ""
        return none
    cs := t.chars()
    mut parts := List[Compound]()
    mut comb := List[str]()
    mut buf := List[char]()
    mut pending := ""
    mut depth := 0
    mut i := 0
    while i <= cs.len()
        ch := if i < cs.len() then cs[i] else ' '
        if i < cs.len() and ch == '\\'
            buf.push(ch)
            if i + 1 < cs.len()
                buf.push(cs[i + 1])
            i += 2
            continue
        if i < cs.len() and (ch == '(' or ch == '[')
            depth += 1
        if i < cs.len() and (ch == ')' or ch == ']')
            depth -= 1
        gap := ch == ' ' or ch == '\t' or ch == '\n'
        sym := ch == '>' or ch == '+' or ch == '~'
        if depth == 0 and (i == cs.len() or gap or sym)
            if buf.len() > 0
                c := compound(buf.join(""))?
                if parts.len() > 0
                    comb.push(if pending == "" then " " else pending)
                parts.push(c)
                buf.clear()
                pending = ""
            if i < cs.len() and sym
                if parts.len() == 0 or pending != ""
                    return none
                pending = "~"
                if ch == '>'
                    pending = ">"
                elif ch == '+'
                    pending = "+"
        else
            buf.push(ch)
        i += 1
    if parts.len() == 0 or pending != ""
        return none
    mut spec := 0
    for p in parts
        spec += simple_weight(p.tag, p.ids, p.classes, p.attrs, p.pseudos)
        for ng in p.nots
            spec += simple_weight(ng.tag, ng.ids, ng.classes, ng.attrs, ng.pseudos)
    Selector(parts, comb, specificity: spec)

## The specificity a compound's simple selectors add (Selectors 4, 17).
fn simple_weight(
    tag str,
    ids List[str],
    classes List[str],
    attrs List[AttrTest],
    pseudos List[str],
) int
    mut w := ids.len() * 10000 + (classes.len() + attrs.len() + pseudos.len()) * 100
    if tag != ""
        w += 1
    w

## Adds the type, id or class `name` that ended where `kind` began
## (`t` type, `.`, `#`, `x` nothing may precede); false when invalid.
fn add_simple(mut c Compound, kind char, name str) bool
    if kind == 't'
        if name != "*"
            c.tag = name.to_lower()
        return true
    if kind == 'x'
        return name == ""
    if name == ""
        return false
    if kind == '.'
        c.classes.push(name)
    else
        c.ids.push(name)
    true

## `[name]`, `[name=v]`, `[name~=v]`, `[name|=v]`, `[name^=v]`,
## `[name$=v]`, `[name*=v]`, from the text between the brackets.
fn attr_test(inner str) AttrTest?
    eq := inner.find("=") else return AttrTest(name: inner.trim().to_lower(), op: "", value: "")
    before := if eq > 0 then inner.slice(eq - 1, eq) else ""
    two := before != "" and "~|^$*".contains(before)
    op := if two then "{before}=" else "="
    name := inner.slice(0, if two then eq - 1 else eq).trim().to_lower()
    v := inner.slice(eq + 1, inner.chars().len()).trim().replace("\"", "").replace("'", "")
    if name == ""
        return none
    AttrTest(name, op, value: v)

PLAIN_PSEUDOS := {
    "first-child",
    "last-child",
    "only-child",
    "first-of-type",
    "last-of-type",
    "only-of-type",
    "empty",
    "checked",
    "disabled",
    "enabled",
    "link",
    "any-link",
}

NTH_PSEUDOS := {"nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type"}

## Adds the pseudo-class `name(arg)` to `c`; false when Garlic doesn't
## support it (the rule is then dropped).
fn add_pseudo(mut c Compound, name str, arg str) bool
    if PLAIN_PSEUDOS.contains(name)
        c.pseudos.push(name)
        return true
    if NTH_PSEUDOS.contains(name)
        if nth_ab(arg).len() == 0
            return false
        compact := arg.replace(" ", "").to_lower()
        c.pseudos.push("{name}({compact})")
        return true
    if name == "not"
        inner := arg.trim()
        for bad in [",", " ", ">", "+", "~"]
            if inner.contains(bad)
                return false
        if inner == ""
            return false
        n := compound(inner) else return false
        if n.nots.len() > 0
            return false
        c.nots.push(Neg(
            tag: n.tag,
            ids: n.ids,
            classes: n.classes,
            attrs: n.attrs,
            pseudos: n.pseudos,
        ))
        return true
    false

## `an+b` as [a, b] (`odd`, `even`, `n`, `2n`, `-n+3`, `4`), or [] when
## it isn't one.
fn nth_ab(arg str) List[int]
    t := arg.replace(" ", "").to_lower()
    if t == "odd"
        return [2, 1]
    if t == "even"
        return [2, 0]
    if at := t.find("n")
        apart := t.slice(0, at).replace("+", "")
        bpart := t.slice(at + 1, t.chars().len()).replace("+", "")
        mut a := 1
        if apart == "-"
            a = -1
        elif apart != ""
            a = (apart.to_float() else return []).to_int()
        mut b := 0
        if bpart != ""
            b = (bpart.to_float() else return []).to_int()
        return [a, b]
    n := (t.to_float() else return []).to_int()
    [0, n]

## Parses a compound selector such as `a.nav#top[href]:not(.x)`.
fn compound(word str) Compound?
    mut c := Compound(tag: "", ids: [], classes: [], attrs: [], pseudos: [], nots: [])
    cs := word.chars()
    mut i := 0
    mut kind := 't'
    mut buf := List[char]()
    while i <= cs.len()
        ch := if i < cs.len() then cs[i] else '.'
        if i < cs.len() and ch == '\\'
            if i + 1 < cs.len()
                buf.push(cs[i + 1])
            i += 2
            continue
        if i == cs.len() or ch == '.' or ch == '#' or ch == '[' or ch == ':'
            if not add_simple(mut c, kind, buf.join(""))
                return none
            buf.clear()
            if i == cs.len()
                break
            if ch == '['
                close := word.slice(i, cs.len()).find("]")?
                c.attrs.push(attr_test(word.slice(i + 1, i + close))?)
                i += close + 1
                kind = 'x'
                continue
            if ch == ':'
                if i + 1 < cs.len() and cs[i + 1] == ':'
                    return none
                mut j := i + 1
                mut pname := List[char]()
                while j < cs.len()
                    and cs[j] != '('
                    and cs[j] != '.'
                    and cs[j] != '#'
                    and cs[j] != '['
                    and cs[j] != ':'
                    pname.push(cs[j])
                    j += 1
                mut arg := ""
                if j < cs.len() and cs[j] == '('
                    mut open := 1
                    mut k := j + 1
                    mut inner := List[char]()
                    while k < cs.len() and open > 0
                        if cs[k] == '('
                            open += 1
                        elif cs[k] == ')'
                            open -= 1
                        if open > 0
                            inner.push(cs[k])
                        k += 1
                    arg = inner.join("")
                    j = k
                if not add_pseudo(mut c, pname.join("").to_lower(), arg)
                    return none
                i = j
                kind = 'x'
                continue
            kind = ch
            i += 1
            continue
        buf.push(ch)
        i += 1
    c

## Whether element `id` has attribute `name`, whatever its value.
fn has_attr(d html.Doc, id int, name str) bool
    for a in d.nodes[id].attrs
        if a.name == name
            return true
    false

## Whether attribute test `a` holds on element `id`.
fn attr_ok(d html.Doc, id int, a AttrTest) bool
    v := d.attr(id, a.name) else return false
    n := a.value.chars().len()
    if a.op == ""
        return true
    if a.op == "="
        return v == a.value
    if n == 0
        return false
    if a.op == "~="
        return v.replace("\n", " ").replace("\t", " ").split(" ").contains(a.value)
    if a.op == "|="
        return v == a.value or v.starts_with("{a.value}-")
    if a.op == "^="
        return v.starts_with(a.value)
    if a.op == "$="
        return v.chars().len() >= n and v.slice(v.chars().len() - n, v.chars().len()) == a.value
    a.op == "*=" and v.contains(a.value)

## The 1-based position of element `id` among its parent's element
## children (or those of its type), counted from the start or the end.
fn sib_pos(d html.Doc, id int, from_end bool, of_type bool) int
    p := d.nodes[id].parent
    if p < 0
        return 1
    mut before := 0
    mut after := 0
    mut seen := false
    for s in d.nodes[p].children
        if s == id
            seen = true
        elif d.nodes[s].kind == html.Kind.Element
            and (not of_type or d.nodes[s].tag == d.nodes[id].tag)
            if seen
                after += 1
            else
                before += 1
    (if from_end then after else before) + 1

## Whether pseudo-class `p` (as `add_pseudo` stored it) holds on `id`.
fn pseudo_ok(d html.Doc, id int, p str) bool
    tag := d.nodes[id].tag
    if p == "first-child"
        return sib_pos(d, id, false, false) == 1
    if p == "last-child"
        return sib_pos(d, id, true, false) == 1
    if p == "only-child"
        return sib_pos(d, id, false, false) == 1 and sib_pos(d, id, true, false) == 1
    if p == "first-of-type"
        return sib_pos(d, id, false, true) == 1
    if p == "last-of-type"
        return sib_pos(d, id, true, true) == 1
    if p == "only-of-type"
        return sib_pos(d, id, false, true) == 1 and sib_pos(d, id, true, true) == 1
    if p == "empty"
        for k in d.nodes[id].children
            n := d.nodes[k]
            if n.kind == html.Kind.Element or (n.kind == html.Kind.Text and n.text != "")
                return false
        return true
    if p == "checked"
        return has_attr(d, id, "checked") or has_attr(d, id, "selected")
    if p == "disabled"
        return has_attr(d, id, "disabled")
    if p == "enabled"
        return (tag == "input" or tag == "button" or tag == "select" or tag == "textarea")
            and not has_attr(d, id, "disabled")
    if p == "link" or p == "any-link"
        return (tag == "a" or tag == "area") and has_attr(d, id, "href")
    open := p.find("(") else return false
    name := p.slice(0, open)
    ab := nth_ab(p.slice(open + 1, p.chars().len() - 1))
    if ab.len() == 0
        return false
    pos := sib_pos(d, id, name.contains("last"), name.contains("of-type"))
    diff := pos - ab[1]
    if ab[0] == 0
        return diff == 0
    if ab[0] > 0
        return diff >= 0 and diff % ab[0] == 0
    diff <= 0 and (0 - diff) % (0 - ab[0]) == 0

## Whether element `id` satisfies one set of simple selectors.
fn simple_ok(
    d html.Doc,
    id int,
    tag str,
    ids List[str],
    classes List[str],
    attrs List[AttrTest],
    pseudos List[str],
) bool
    if tag != "" and tag != d.nodes[id].tag
        return false
    for want in ids
        if d.attr(id, "id") != want
            return false
    if classes.len() > 0
        have := (d.attr(id, "class") else "").replace("\n", " ").replace("\t", " ").split(" ")
        for want in classes
            if not have.contains(want)
                return false
    for a in attrs
        if not attr_ok(d, id, a)
            return false
    for p in pseudos
        if not pseudo_ok(d, id, p)
            return false
    true

## Whether element `id` matches compound `c`.
fn matches_compound(d html.Doc, id int, c Compound) bool
    if d.nodes[id].kind != html.Kind.Element
        return false
    if not simple_ok(d, id, c.tag, c.ids, c.classes, c.attrs, c.pseudos)
        return false
    for ng in c.nots
        if simple_ok(d, id, ng.tag, ng.ids, ng.classes, ng.attrs, ng.pseudos)
            return false
    true

## Whether element `id` matches selector `s`, right to left.
pub fn matches(d html.Doc, id int, s Selector) bool
    matches_from(d, id, s, s.parts.len() - 1)

fn matches_from(d html.Doc, id int, s Selector, k int) bool
    if not matches_compound(d, id, s.parts[k])
        return false
    if k == 0
        return true
    op := s.comb[k - 1]
    mut p := d.nodes[id].parent
    if op == "+" or op == "~"
        if p < 0
            return false
        mut before := List[int]()
        for sb in d.nodes[p].children
            if sb == id
                break
            if d.nodes[sb].kind == html.Kind.Element
                before.push(sb)
        if before.len() == 0
            return false
        if op == "+"
            return matches_from(d, before[before.len() - 1], s, k - 1)
        for sb in before
            if matches_from(d, sb, s, k - 1)
                return true
        return false
    if op == ">"
        return p > 0 and matches_from(d, p, s, k - 1)
    while p > 0
        if matches_from(d, p, s, k - 1)
            return true
        p = d.nodes[p].parent
    false

## The rules of `sheet` that may match element `id`, by the index.
fn candidates(d html.Doc, id int, sheet Sheet) List[int]
    mut out := sheet.general
    if key := d.attr(id, "id")
        for k in sheet.by_id.get(key) else []
            out.push(k)
    for cls in (d.attr(id, "class") else "").split(" ")
        if cls != ""
            for k in sheet.by_class.get(cls) else []
                out.push(k)
    for k in sheet.by_tag.get(d.nodes[id].tag) else []
        out.push(k)
    out

## The cascaded value of each property Garlic uses on element `id`:
## matching rules by importance, specificity and order, then the element's
## own `style` attribute (Cascade 4, simplified). Inherited values are the
## layout's business.
pub fn cascade(d html.Doc, id int, sheet Sheet) Map[str, str]
    mut best := Map[str, int]()
    mut out := Map[str, str]()
    for k in candidates(d, id, sheet)
        r := sheet.rules[k]
        if not matches(d, id, r.selector)
            continue
        for decl in r.decls
            level := if decl.important then 2 else 0
            weight := level * 1000000000000 + r.selector.specificity * 1000000 + r.order
            if weight >= (best.get(decl.name) else -1)
                best[decl.name] = weight
                out[decl.name] = decl.value
    if inline := d.attr(id, "style")
        for decl in declarations(inline)
            level := if decl.important then 3 else 1
            weight := level * 1000000000000
            if weight >= (best.get(decl.name) else -1)
                best[decl.name] = weight
                out[decl.name] = decl.value
    out

## Every `<style>` element's sheet, in document order, as one sheet.
pub fn document_sheet(d html.Doc) Sheet
    mut all := parse("", 0)
    for s in d.all("style")
        all = concat(all, parse_in(d.text(s), 0, (d.attr(s, "media") else "").trim()))
    all

## chrome: Garlic's window chrome drawn Chromium-style on one canvas: the tab
## strip (rounded tabs that flare into the toolbar), the toolbar with back,
## forward, reload, a pill omnibox and the menu button, an infobar for an
## agent's Allow / Deny, and the menus and status bubble drawn over the page.
## Everything is pure: geometry, hit tests and display lists. `Garlic` owns
## the state and acts on the `Hit`.

use std.app

## One tab as the strip shows it.
pub struct Item
    pub title str
    pub url str
    ## The favicon: the host's bitmap id ("" for the stand-in globe), its
    ## pixel size, and its data the first time it goes to the host.
    pub icon str
    pub icon_w int
    pub icon_h int
    pub icon_data str
    ## Whether the page is loading: a spinner takes the favicon's place.
    pub loading bool

## The colours of the chrome; `dark()` and `light()` are Chromium's.
pub struct Theme
    ## The strip behind the tabs, the toolbar and the shown tab.
    pub frame int
    pub toolbar int
    ## The omnibox at rest and under the pointer.
    pub omni int
    pub omni_hot int
    pub text int
    pub dim int
    ## A toolbar button under the pointer, an inactive tab under the pointer.
    pub hover int
    pub tab_hover int
    pub sep int
    pub accent int
    ## Text on the accent.
    pub on_accent int
    pub menu int
    pub menu_text int
    pub menu_hot int
    pub is_light bool

## Chromium's dark look.
pub fn dark() Theme
    Theme(
        frame: 0x202124,
        toolbar: 0x35363a,
        omni: 0x202124,
        omni_hot: 0x292a2d,
        text: 0xe8eaed,
        dim: 0x9aa0a6,
        hover: 0x4a4d51,
        tab_hover: 0x2b2c2f,
        sep: 0x5f6368,
        accent: 0x8ab4f8,
        on_accent: 0x202124,
        menu: 0x292a2d,
        menu_text: 0xe8eaed,
        menu_hot: 0x3c4043,
        is_light: false,
    )

## Chromium's light look.
pub fn light() Theme
    Theme(
        frame: 0xdee1e6,
        toolbar: 0xffffff,
        omni: 0xf1f3f4,
        omni_hot: 0xe8eaed,
        text: 0x202124,
        dim: 0x5f6368,
        hover: 0xe8eaed,
        tab_hover: 0xe9ebee,
        sep: 0xb8bcc0,
        accent: 0x1a73e8,
        on_accent: 0xffffff,
        menu: 0xffffff,
        menu_text: 0x202124,
        menu_hot: 0xf1f3f4,
        is_light: true,
    )

# ---- Geometry -------------------------------------------------------------

## The strip, the toolbar, the infobar and the whole chrome without one.
pub STRIP_H := 42.0
pub TOOL_H := 52.0
pub INFO_H := 44.0
pub H := 94.0
TAB_TOP := 8.0
TAB_H := 34.0
TAB_R := 8.0
MAX_TAB_W := 240.0
MIN_TAB_W := 24.0
## A tab narrower than this shows no title: its favicon alone, or, when it is
## the shown tab, its close button alone (as Chromium does).
pub TITLE_MIN := 72.0
LEFT := 8.0
PLUS_W := 28.0
CLOSE_W := 16.0
## Toolbar buttons: 28 points each, 8 apart, the first at `LEFT`.
BTN := 28.0
BTN_STEP := 36.0
OMNI_X := 124.0
OMNI_H := 34.0
OMNI_Y := 51.0
MENU_BTN_W := 44.0
AGENT_W := 96.0
## A dropdown menu's row height and width.
pub ROW_H := 32.0
pub MENU_W := 240.0
MENU_PAD := 8.0

## What a click landed on: `kind` is `tab`, `close`, `plus`, `back`,
## `forward`, `reload`, `omni`, `agent`, `menu`, `allow`, `deny` or `none`;
## `k` is the tab.
pub struct Hit
    pub kind str
    pub k int

fn miss() Hit
    Hit(kind: "none", k: 0)

## The height the chrome canvas needs.
pub fn height(with_infobar bool) float
    if with_infobar then H + INFO_H else H

## A tab's width when `n` tabs share a strip `width` wide.
## `left` is the room the window controls take in edge mode (std.app.25).
pub fn tab_w(n int, width float, left float) float
    room := width - LEFT - left - PLUS_W - TAB_R - 24.0
    (room / n.max(1).to_float()).max(MIN_TAB_W).min(MAX_TAB_W)

pub fn tab_x(k int, n int, width float, left float) float
    LEFT + left + k.to_float() * tab_w(n, width, left)

## Whether the tabs are too narrow for titles when `n` share the strip.
pub fn tiny(n int, width float, left float) bool
    tab_w(n, width, left) < TITLE_MIN

## The new-tab button's left edge: after the last tab, kept inside the strip.
fn plus_x(n int, width float, left float) float
    (tab_x(n, n, width, left) + 6.0).min(width - PLUS_W - 4.0)

## The omnibox's left edge and width; `agent` leaves room for the chip.
pub fn omni_w(width float, agent bool) float
    (width - OMNI_X - MENU_BTN_W - (if agent then AGENT_W + 8.0 else 0.0) - 8.0).max(80.0)

## Whether (x, y) is within `BTN` points square at (bx, by).
fn in_btn(x float, y float, bx float, by float) bool
    x >= bx and x < bx + BTN and y >= by and y < by + BTN

## The top of the toolbar buttons.
BTN_Y := 54.0

## What a click at (x, y) on the chrome canvas landed on.
pub fn hit(x float, y float, n int, width float, left float, agent bool, with_infobar bool) Hit
    if y < STRIP_H
        if y < TAB_TOP
            return miss()
        ## The new-tab button first: with more tabs than fit it sits over them.
        px := plus_x(n, width, left)
        if x >= px and x < px + PLUS_W
            return Hit(kind: "plus", k: 0)
        w := tab_w(n, width, left)
        for k in 0..n
            x0 := tab_x(k, n, width, left)
            if x >= x0 and x < x0 + w
                if w >= TITLE_MIN and x >= x0 + w - CLOSE_W - 12.0 and x < x0 + w - 8.0
                    return Hit(kind: "close", k: k)
                return Hit(kind: "tab", k: k)
        return miss()
    if y < H
        if in_btn(x, y, LEFT, BTN_Y)
            return Hit(kind: "back", k: 0)
        if in_btn(x, y, LEFT + BTN_STEP, BTN_Y)
            return Hit(kind: "forward", k: 0)
        if in_btn(x, y, LEFT + 2.0 * BTN_STEP, BTN_Y)
            return Hit(kind: "reload", k: 0)
        ow := omni_w(width, agent)
        if x >= OMNI_X and x < OMNI_X + ow and y >= OMNI_Y and y < OMNI_Y + OMNI_H
            return Hit(kind: "omni", k: 0)
        if agent and x >= OMNI_X + ow + 8.0 and x < OMNI_X + ow + 8.0 + AGENT_W
            return Hit(kind: "agent", k: 0)
        if in_btn(x, y, width - MENU_BTN_W, BTN_Y)
            return Hit(kind: "menu", k: 0)
        return miss()
    if with_infobar and y < H + INFO_H
        if x >= width - 88.0 and x < width - 12.0
            return Hit(kind: "allow", k: 0)
        if x >= width - 172.0 and x < width - 96.0
            return Hit(kind: "deny", k: 0)
    miss()

# ---- The omnibox's text -----------------------------------------------------

## The address field: its text, the caret (in characters), whether all of
## it is selected (typing replaces it) and whether it is being edited.
pub struct Omni
    pub text str
    pub cursor int
    pub all bool
    pub editing bool

pub fn omni(text str) Omni
    Omni(text: text, cursor: text.chars().len(), all: false, editing: false)

## Starts editing with everything selected, as a click on the omnibox does.
pub fn Omni.start(mut self)
    editing = true
    all = true
    cursor = text.chars().len()

## Puts `s` in place of the selection or at the caret.
pub fn Omni.insert(mut self, s str)
    if all
        text = ""
        cursor = 0
        all = false
    text = "{text.slice(0, cursor)}{s}{text.slice(cursor, text.chars().len())}"
    cursor += s.chars().len()

## A key while editing: `open` when Return was pressed, `cancel` for Escape,
## else "" (the text may have changed). `meta` is Command (Control on
## other systems), as `std.app` reports it.
pub fn Omni.key(mut self, key str, meta bool, shift bool) str
    n := text.chars().len()
    if key == "enter"
        editing = false
        all = false
        return "open"
    if key == "escape"
        editing = false
        all = false
        return "cancel"
    if meta
        if key == "a"
            all = true
            cursor = n
        elif key == "left"
            cursor = 0
            all = false
        elif key == "right"
            cursor = n
            all = false
        return ""
    match key
        "backspace" =>
            if all
                text = ""
                cursor = 0
                all = false
            elif cursor > 0
                text = "{text.slice(0, cursor - 1)}{text.slice(cursor, n)}"
                cursor -= 1
        "delete" =>
            if all
                text = ""
                cursor = 0
                all = false
            elif cursor < n
                text = "{text.slice(0, cursor)}{text.slice(cursor + 1, n)}"
        "left" =>
            cursor = if all then 0 else (cursor - 1).max(0)
            all = false
        "right" =>
            cursor = if all then n else (cursor + 1).min(n)
            all = false
        "home" | "up" =>
            cursor = 0
            all = false
        "end" | "down" =>
            cursor = n
            all = false
        "space" => insert(" ")
        "tab" => return ""
        _ =>
            if key.chars().len() == 1
                insert(key)
    ""

## The address as the omnibox shows it at rest: no `https://`, and the
## host apart from the rest so the path can be dimmed.
pub fn pretty(url str)(str, str)
    mut u := url
    if r := u.strip_prefix("https://")
        u = r
    mut from := 0
    if k := u.find("://")
        from = k + 3
    rest := u.slice(from, u.chars().len())
    i := rest.find("/") else return (u, "")
    (u.slice(0, from + i), rest.slice(i, rest.chars().len()))

# ---- Drawing helpers ---------------------------------------------------------

## One channel (bits `sh` up) of the colour `t` of the way from `a` to `b`.
fn mix_ch(a int, b int, sh int, t float) int
    ca := a.shr(sh).bit_and(255).to_float()
    cb := b.shr(sh).bit_and(255).to_float()
    (ca + (cb - ca) * t).round().to_int()

## The colour `t` of the way from `a` to `b` (0 to 1).
pub fn mix(a int, b int, t float) int
    mix_ch(a, b, 16, t).shl(16).bit_or(mix_ch(a, b, 8, t).shl(8)).bit_or(mix_ch(a, b, 0, t))

## One point-high band of `c` from `left` to `right`, its end pixels blended
## with `bg` by how much of them the band covers.
fn band(mut ops List[app.Op], left float, right float, y float, c int, bg int)
    first := left.ceil()
    last := right.floor()
    if last > first
        ops.push(app.draw_rect(first, y, last - first, 1.0, c))
    if first > left
        ops.push(app.draw_rect(first - 1.0, y, 1.0, 1.0, mix(bg, c, first - left)))
    if right > last
        ops.push(app.draw_rect(last, y, 1.0, 1.0, mix(bg, c, right - last)))

## A rectangle with round corners of radius `r` over a flat background `bg`.
pub fn round(mut ops List[app.Op], x float, y float, w float, h float, r float, c int, bg int)
    rr := r.min(h / 2.0).min(w / 2.0)
    n := rr.ceil().to_int()
    ops.push(app.draw_rect(x, y + rr, w, h - 2.0 * rr, c))
    for i in 0..n
        d := rr - i.to_float() - 0.5
        inset := rr - (rr * rr - d * d).max(0.0).sqrt()
        band(mut ops, x + inset, x + w - inset, y + i.to_float(), c, bg)
        band(mut ops, x + inset, x + w - inset, y + h - i.to_float() - 1.0, c, bg)

## Chromium's tab: round top corners and a bottom that flares outwards by
## `r` on each side into the bar below, over a strip coloured `bg`.
fn tab_shape(mut ops List[app.Op], x float, y float, w float, h float, r float, c int, bg int)
    n := r.ceil().to_int()
    ops.push(app.draw_rect(x, y + r, w, h - 2.0 * r, c))
    for i in 0..n
        d := r - i.to_float() - 0.5
        inset := r - (r * r - d * d).max(0.0).sqrt()
        band(mut ops, x + inset, x + w - inset, y + i.to_float(), c, bg)
        ## The flare: the bottom row is `r` wider on each side, the top of
        ## the flare meets the sides.
        flare := r - (r * r - (i.to_float() + 0.5) * (i.to_float() + 0.5)).max(0.0).sqrt()
        band(mut ops, x - r + flare, x + w + r - flare, y + h - i.to_float() - 1.0, c, bg)

fn txt(x float, y float, s str, fg int, bold bool, size float) app.Op
    app.Op.Str(
        x: x,
        y: y,
        text: s,
        font: "sans",
        size: size,
        fg: fg,
        bold: bold,
        italic: false,
        underline: false,
    )

## The key a measured sans run's width is kept under.
pub fn width_key(s str, size float) str
    "{size}|{s}"

## The width of sans text `s`: the host's measure when `meas` has it, else
## `tw`'s estimate.
fn run_w(meas Map[str, float], tw fn(str, float) float, s str, size float) float
    if w := meas.get(width_key(s, size))
        return w
    tw(s, size)

fn line(x1 float, y1 float, x2 float, y2 float, c int, w float) app.Op
    app.Op.Stroke(x1: x1, y1: y1, x2: x2, y2: y2, color: c, width: w)

## A circle of diameter `d` at (x, y) over `bg`.
fn disc(mut ops List[app.Op], x float, y float, d float, c int, bg int)
    round(mut ops, x, y, d, d, d / 2.0, c, bg)

## An arc of a circle at (cx, cy) with radius `r` from angle `a0` to `a1`
## (radians, clockwise on the flipped canvas), as short strokes.
fn arc(
    mut ops List[app.Op],
    cx float,
    cy float,
    r float,
    a0 float,
    a1 float,
    c int,
    w float,
    steps int,
)
    for i in 0..steps
        t0 := a0 + (a1 - a0) * i.to_float() / steps.to_float()
        t1 := a0 + (a1 - a0) * (i + 1).to_float() / steps.to_float()
        ops.push(line(
            cx + r * t0.cos(),
            cy + r * t0.sin(),
            cx + r * t1.cos(),
            cy + r * t1.sin(),
            c,
            w,
        ))

# ---- Icons -------------------------------------------------------------------

## Chromium's loading spinner: three quarters of a ring, centred on (cx, cy).
fn spinner(mut ops List[app.Op], cx float, cy float, c int)
    arc(mut ops, cx, cy, 6.0, 0.0 - 1.2, 3.5, c, 2.0, 16)

## A left or right arrow in a 28 point box at (x, y).
fn arrow(mut ops List[app.Op], x float, y float, c int, back bool)
    cx := x + BTN / 2.0
    cy := y + BTN / 2.0
    tip := if back then cx - 7.0 else cx + 7.0
    tail := if back then cx + 7.0 else cx - 7.0
    bend := if back then cx - 1.0 else cx + 1.0
    ops.push(line(tail, cy, tip, cy, c, 2.0))
    ops.push(line(tip, cy, bend, cy - 6.0, c, 2.0))
    ops.push(line(tip, cy, bend, cy + 6.0, c, 2.0))

## The reload icon: an open circle with an arrow head at its end.
fn reload_icon(mut ops List[app.Op], x float, y float, c int)
    cx := x + BTN / 2.0
    cy := y + BTN / 2.0
    r := 6.5
    ## Chromium's: a ring open at the top right, drawn clockwise from about
    ## two o'clock round to twelve, where a small head points clockwise.
    a0 := 0.0 - 0.55
    a1 := 0.0 - 1.57 + 6.28
    arc(mut ops, cx, cy, r, a0, a1, c, 2.0, 24)
    px := cx + r * a1.cos()
    py := cy + r * a1.sin()
    ops.push(line(px + 0.5, py, px - 3.5, py - 3.5, c, 2.0))
    ops.push(line(px + 0.5, py, px - 3.5, py + 3.5, c, 2.0))

## The menu button: three dots.
fn kebab(mut ops List[app.Op], x float, y float, c int, bg int)
    cx := x + BTN / 2.0 - 2.0
    for k in 0..3
        disc(mut ops, cx, y + 5.0 + k.to_float() * 7.0, 4.0, c, bg)

## A plus centred in a 28 point box at (x, y), and an x centred at (cx, cy).
fn plus(mut ops List[app.Op], x float, y float, c int)
    cx := x + BTN / 2.0
    cy := y + BTN / 2.0
    ops.push(line(cx - 6.0, cy, cx + 6.0, cy, c, 2.0))
    ops.push(line(cx, cy - 6.0, cx, cy + 6.0, c, 2.0))

fn cross(mut ops List[app.Op], cx float, cy float, c int)
    ops.push(line(cx - 4.0, cy - 4.0, cx + 4.0, cy + 4.0, c, 1.5))
    ops.push(line(cx + 4.0, cy - 4.0, cx - 4.0, cy + 4.0, c, 1.5))

## A globe: the stand-in favicon.
fn globe(mut ops List[app.Op], x float, y float, c int, bg int)
    disc(mut ops, x, y, 16.0, c, bg)
    disc(mut ops, x + 1.5, y + 1.5, 13.0, bg, c)
    ops.push(line(x + 2.0, y + 8.0, x + 14.0, y + 8.0, c, 1.0))
    ops.push(line(x + 8.0, y + 2.0, x + 8.0, y + 14.0, c, 1.0))
    arc(mut ops, x + 8.0, y + 8.0, 6.0, 0.0 - 1.57, 1.57, c, 1.0, 12)

## A padlock, 12 points high, its top-left at (x, y).
fn padlock(mut ops List[app.Op], x float, y float, c int, bg int)
    round(mut ops, x, y + 5.0, 10.0, 7.0, 1.5, c, bg)
    arc(mut ops, x + 5.0, y + 4.5, 3.0, 3.14, 6.28, c, 1.5, 12)

## A magnifier, 14 points high, its top-left at (x, y): the omnibox while it
## is edited or empty.
fn magnifier(mut ops List[app.Op], x float, y float, c int)
    arc(mut ops, x + 5.5, y + 5.5, 4.5, 0.0, 6.2832, c, 1.5, 16)
    ops.push(line(x + 8.9, y + 8.9, x + 13.0, y + 13.0, c, 1.5))

## Chromium's "i" in a ring, 14 points high, its top-left at (x, y): a page
## that did not come over https.
fn info_icon(mut ops List[app.Op], x float, y float, c int)
    arc(mut ops, x + 7.0, y + 7.0, 6.0, 0.0, 6.2832, c, 1.5, 20)
    ops.push(line(x + 7.0, y + 6.5, x + 7.0, y + 10.5, c, 1.5))
    ops.push(app.draw_rect(x + 6.25, y + 3.25, 1.5, 1.5, c))

## The spark of the agent chip: a four-point star.
fn spark(mut ops List[app.Op], cx float, cy float, c int)
    ops.push(line(cx, cy - 6.0, cx, cy + 6.0, c, 2.0))
    ops.push(line(cx - 6.0, cy, cx + 6.0, cy, c, 2.0))
    ops.push(line(cx - 3.5, cy - 3.5, cx + 3.5, cy + 3.5, c, 1.0))
    ops.push(line(cx + 3.5, cy - 3.5, cx - 3.5, cy + 3.5, c, 1.0))

# ---- The chrome ----------------------------------------------------------------

## What the chrome shows besides the tabs.
pub struct State
    pub omni Omni
    pub can_back bool
    pub can_forward bool
    ## The pointer on the chrome canvas, or `hover_x` below 0 when away.
    pub hover_x float
    pub hover_y float
    ## The agent chip's text (empty without `--attach`) and the infobar's
    ## question (empty when none is open).
    pub agent str
    pub ask str
    ## The chrome canvas's width, as the host last reported it.
    pub width float
    ## The room the window controls take at the top-left (std.app.25).
    pub inset_left float

## Whether the hovered point is in the button at (bx, by).
fn hot(st State, bx float, by float) bool
    st.hover_x >= 0.0 and in_btn(st.hover_x, st.hover_y, bx, by)

## A toolbar button's hover disc and icon colour.
fn button_bg(mut ops List[app.Op], th Theme, st State, x float, y float, on bool)
    if on and hot(st, x, y)
        disc(mut ops, x, y, BTN, th.hover, th.toolbar)

## The display list for the chrome canvas: the tabs, the toolbar and, if
## `st.ask` is set, the infobar. `tw` estimates sans text at 12 and 14 points
## (Garlic passes the layout's estimate); `meas` holds the widths the host
## measured, by `width_key`, which win.
pub fn draw(
    th Theme,
    items List[Item],
    cur int,
    st State,
    tw fn(str, float) float,
    meas Map[str, float],
) List[app.Op]
    width := st.width.max(1.0)
    mut ops := [
        app.draw_rect(0.0, 0.0, width, STRIP_H, th.frame),
        app.draw_rect(0.0, STRIP_H, width, TOOL_H, th.toolbar),
    ]
    n := items.len()
    left := st.inset_left
    w := tab_w(n, width, left)
    hover_tab := if st.hover_x >= 0.0 then hit(
        st.hover_x,
        st.hover_y,
        n,
        width,
        left,
        st.agent != "",
        false,
    ) else miss()
    hover_k := if hover_tab.kind == "tab" or hover_tab.kind == "close" then hover_tab.k else -1
    small := w < TITLE_MIN
    for k in 0..n
        x0 := tab_x(k, n, width, left)
        shown := k == cur
        hovered := hover_k == k
        if shown
            tab_shape(mut ops, x0, TAB_TOP, w, TAB_H, TAB_R, th.toolbar, th.frame)
        elif hovered
            tab_shape(mut ops, x0, TAB_TOP, w, TAB_H, TAB_R, th.tab_hover, th.frame)
        elif k + 1 < n and k + 1 != cur and k + 1 != hover_k
            ops.push(app.draw_rect(x0 + w - 0.5, TAB_TOP + 9.0, 1.0, TAB_H - 18.0, th.sep))
        bg := if shown then th.toolbar else (if hovered then th.tab_hover else th.frame)
        fg := if shown then th.text else th.dim
        close := if small then shown else (shown or hovered or w >= 120.0)
        ix := if small then x0 + (w - 16.0) / 2.0 else x0 + 10.0
        ## A narrow shown tab has room for its close button only.
        has_icon := not (small and shown)
        if has_icon and items[k].icon != ""
            ops.push(app.Op.Bitmap(
                x: ix,
                y: TAB_TOP + 9.0,
                w: 16.0,
                h: 16.0,
                id: items[k].icon,
                pw: items[k].icon_w,
                ph: items[k].icon_h,
                data: items[k].icon_data,
            ))
        elif has_icon and items[k].loading
            spinner(mut ops, ix + 8.0, TAB_TOP + 17.0, th.accent)
        elif has_icon
            globe(mut ops, ix, TAB_TOP + 9.0, th.dim, bg)
        if not small
            title := if items[k].title == "" then "New tab" else items[k].title
            room := w - 32.0 - (if close then CLOSE_W + 12.0 else 10.0)
            ops.push(app.Op.Clip(x: x0 + 32.0, y: TAB_TOP, w: room.max(0.0), h: TAB_H))
            ops.push(txt(x0 + 32.0, TAB_TOP + 10.0, title, fg, false, 12.0))
            ops.push(app.Op.Unclip)
        if close
            cx := if small then x0 + w / 2.0 else x0 + w - 8.0 - CLOSE_W / 2.0
            cy := TAB_TOP + TAB_H / 2.0
            if (hover_tab.kind == "close" or (small and hover_tab.kind == "tab")) and hover_k == k
                disc(mut ops, cx - 8.0, cy - 8.0, 16.0, th.hover, bg)
            cross(mut ops, cx, cy, fg)
    ## The new-tab button.
    px := plus_x(n, width, left)
    py := TAB_TOP + 3.0
    if px < tab_x(n, n, width, left) + 6.0
        ## More tabs than fit: the button covers the ones under it.
        ops.push(app.draw_rect(px - 4.0, 0.0, width - px + 4.0, STRIP_H, th.frame))
    if hot(st, px, py)
        disc(mut ops, px, py, BTN, th.tab_hover, th.frame)
    plus(mut ops, px, py, th.dim)
    ## The toolbar.
    button_bg(mut ops, th, st, LEFT, BTN_Y, st.can_back)
    arrow(mut ops, LEFT, BTN_Y, if st.can_back then th.dim else mix(th.toolbar, th.dim, 0.4), true)
    button_bg(mut ops, th, st, LEFT + BTN_STEP, BTN_Y, st.can_forward)
    arrow(
        mut ops,
        LEFT + BTN_STEP,
        BTN_Y,
        if st.can_forward then th.dim else mix(th.toolbar, th.dim, 0.4),
        false,
    )
    button_bg(mut ops, th, st, LEFT + 2.0 * BTN_STEP, BTN_Y, true)
    reload_icon(mut ops, LEFT + 2.0 * BTN_STEP, BTN_Y, th.dim)
    omnibox(mut ops, th, st, tw, meas)
    ow := omni_w(width, st.agent != "")
    if st.agent != ""
        ax := OMNI_X + ow + 8.0
        round(
            mut ops,
            ax,
            OMNI_Y + 3.0,
            AGENT_W,
            OMNI_H - 6.0,
            (OMNI_H - 6.0) / 2.0,
            th.accent,
            th.toolbar,
        )
        spark(mut ops, ax + 16.0, OMNI_Y + OMNI_H / 2.0, th.on_accent)
        ops.push(app.Op.Clip(x: ax + 28.0, y: OMNI_Y, w: AGENT_W - 36.0, h: OMNI_H))
        ops.push(txt(ax + 28.0, OMNI_Y + 9.0, st.agent, th.on_accent, true, 12.0))
        ops.push(app.Op.Unclip)
    ops.push(app.draw_rect(0.0, H - 1.0, width, 1.0, mix(th.toolbar, th.sep, 0.5)))
    mx := width - MENU_BTN_W
    button_bg(mut ops, th, st, mx, BTN_Y, true)
    kebab(mut ops, mx, BTN_Y, th.dim, if hot(st, mx, BTN_Y) then th.hover else th.toolbar)
    if st.ask != ""
        infobar(mut ops, th, st, width)
    ops

## The omnibox: a pill with a padlock, the address (host bright, the rest
## dim) or the text being edited with its caret or selection.
fn omnibox(
    mut ops List[app.Op],
    th Theme,
    st State,
    tw fn(str, float) float,
    meas Map[str, float],
)
    width := st.width.max(1.0)
    ow := omni_w(width, st.agent != "")
    o := st.omni
    over := st.hover_x >= 0.0 and hit(
        st.hover_x,
        st.hover_y,
        0,
        width,
        st.inset_left,
        st.agent != "",
        false,
    ).kind == "omni"
    if o.editing
        round(
            mut ops,
            OMNI_X - 1.0,
            OMNI_Y - 1.0,
            ow + 2.0,
            OMNI_H + 2.0,
            OMNI_H / 2.0 + 1.0,
            th.accent,
            th.toolbar,
        )
        round(
            mut ops,
            OMNI_X,
            OMNI_Y,
            ow,
            OMNI_H,
            OMNI_H / 2.0,
            if th.is_light then th.toolbar else th.omni,
            th.accent,
        )
    else
        round(
            mut ops,
            OMNI_X,
            OMNI_Y,
            ow,
            OMNI_H,
            OMNI_H / 2.0,
            if over then th.omni_hot else th.omni,
            th.toolbar,
        )
    tx := OMNI_X + 40.0
    ty := OMNI_Y + 8.0
    field_bg := if o.editing then (if th.is_light then th.toolbar else th.omni) else (if over then th.omni_hot else th.omni)
    if o.editing or o.text == ""
        magnifier(mut ops, OMNI_X + 13.0, OMNI_Y + 10.0, th.dim)
    elif o.text.starts_with("https://")
        padlock(mut ops, OMNI_X + 14.0, OMNI_Y + 10.0, th.dim, field_bg)
    else
        info_icon(mut ops, OMNI_X + 12.0, OMNI_Y + 10.0, th.dim)
    room := (ow - 52.0).max(0.0)
    ops.push(app.Op.Clip(x: tx, y: OMNI_Y, w: room, h: OMNI_H))
    if o.editing
        ## The text slides left to keep the caret in view.
        caret := run_w(meas, tw, o.text.slice(0, o.cursor), 14.0)
        slide := if o.all then 0.0 else (caret - room + 4.0).max(0.0)
        if o.text == ""
            ops.push(txt(tx, ty, "Search DuckDuckGo or type a URL", th.dim, false, 14.0))
        else
            if o.all
                ops.push(app.Op.Shade(
                    x: tx - 1.0,
                    y: OMNI_Y + 6.0,
                    w: run_w(meas, tw, o.text, 14.0) + 2.0,
                    h: OMNI_H - 12.0,
                    color: th.accent,
                    alpha: 0.35,
                ))
            ops.push(txt(tx - slide, ty, o.text, th.text, false, 14.0))
        if not o.all
            ops.push(app.draw_rect(tx - slide + caret, OMNI_Y + 8.0, 1.5, OMNI_H - 16.0, th.text))
    else
        if o.text == ""
            ops.push(txt(tx, ty, "Search DuckDuckGo or type a URL", th.dim, false, 14.0))
        else
            hp := pretty(o.text)
            ops.push(txt(tx, ty, hp.0, th.text, false, 14.0))
            if hp.1 != ""
                ops.push(txt(tx + run_w(meas, tw, hp.0, 14.0), ty, hp.1, th.dim, false, 14.0))
    ops.push(app.Op.Unclip)

## The infobar under the toolbar: the question at the left, Deny and Allow
## at the right (Allow filled with the accent, as Chromium's default button).
fn infobar(mut ops List[app.Op], th Theme, st State, width float)
    y := H
    ops.push(app.draw_rect(0.0, y, width, INFO_H, th.toolbar))
    ops.push(app.draw_rect(0.0, y, width, 1.0, th.sep))
    ops.push(app.Op.Clip(x: 16.0, y: y, w: (width - 200.0).max(0.0), h: INFO_H))
    ops.push(txt(16.0, y + 14.0, st.ask, th.text, false, 13.0))
    ops.push(app.Op.Unclip)
    round(mut ops, width - 172.0, y + 8.0, 76.0, 28.0, 14.0, th.toolbar, th.toolbar)
    round(mut ops, width - 172.0, y + 8.0, 76.0, 28.0, 14.0, th.sep, th.toolbar)
    round(mut ops, width - 171.0, y + 9.0, 74.0, 26.0, 13.0, th.toolbar, th.sep)
    ops.push(txt(width - 152.0, y + 14.0, "Deny", th.accent, true, 13.0))
    round(mut ops, width - 88.0, y + 8.0, 76.0, 28.0, 14.0, th.accent, th.toolbar)
    ops.push(txt(width - 68.0, y + 14.0, "Allow", th.on_accent, true, 13.0))

# ---- Over the page: menus and the status bubble ------------------------------------

## A dropdown menu with `rows` whose top-left corner is at (x, y) on a canvas
## coloured `bg`; `hot` is the row under the pointer, or -1.
pub fn menu_ops(th Theme, rows List[str], x float, y float, bg int, hot_row int) List[app.Op]
    mut ops := List[app.Op]()
    if rows.len() == 0
        return ops
    h := rows.len().to_float() * ROW_H + 2.0 * MENU_PAD
    ops.push(app.Op.Shade(x: x + 2.0, y: y + 3.0, w: MENU_W, h: h, color: 0x000000, alpha: 0.25))
    round(mut ops, x, y, MENU_W, h, 8.0, th.menu, bg)
    for r in 0..rows.len()
        ry := y + MENU_PAD + r.to_float() * ROW_H
        if r == hot_row
            ops.push(app.draw_rect(x, ry, MENU_W, ROW_H, th.menu_hot))
        ops.push(txt(x + 16.0, ry + 8.0, rows[r], th.menu_text, false, 13.0))
    ops

## Which menu row a click at (x, y) landed on, for a menu at (mx, my), or -1.
pub fn menu_hit(x float, y float, n int, mx float, my float) int
    if n == 0 or x < mx or x >= mx + MENU_W
        return -1
    row := ((y - my - MENU_PAD) / ROW_H).floor().to_int()
    if row >= 0 and row < n
        return row
    -1

## The status bubble at the bottom-left of a page `h` high (Chromium shows
## the link under the pointer there): empty for an empty line.
pub fn status_ops(
    th Theme,
    msg str,
    h float,
    bg int,
    tw fn(str, float) float,
    meas Map[str, float],
) List[app.Op]
    mut ops := List[app.Op]()
    if msg == ""
        return ops
    w := run_w(meas, tw, msg, 12.0) + 24.0
    round(mut ops, 0.0 - 8.0, h - 24.0, w + 8.0, 32.0, 8.0, th.sep, bg)
    round(mut ops, 0.0 - 8.0, h - 23.0, w + 7.0, 32.0, 7.0, th.toolbar, th.sep)
    ops.push(txt(8.0, h - 18.0, msg, th.text, false, 12.0))
    ops

FIND_W := 360.0
FIND_H := 40.0
FIND_BTN := 32.0

## The find bar's left edge on a page `width` wide: it hangs from the
## toolbar at the right, as Chromium's does.
fn find_x(width float) float
    (width - FIND_W - 16.0).max(0.0)

## The find bar's count as Chromium writes it: `1/5`, `0/0`, or "" for no text.
pub fn find_count(o Omni, k int, n int) str
    if o.text == ""
        return ""
    if n == 0
        return "0/0"
    "{k + 1}/{n}"

## The find bar: a card under the toolbar at the right with the text typed
## (`o`), the match shown and the count (`k` of `n`, Chromium's `1/5`, or
## `0/0`), then previous, next and close.
pub fn find_ops(
    th Theme,
    o Omni,
    k int,
    n int,
    width float,
    bg int,
    tw fn(str, float) float,
    meas Map[str, float],
) List[app.Op]
    mut ops := List[app.Op]()
    x := find_x(width)
    ops.push(app.Op.Shade(x: x + 1.0, y: 2.0, w: FIND_W, h: FIND_H, color: 0x000000, alpha: 0.25))
    round(mut ops, x, 0.0 - 8.0, FIND_W, FIND_H + 8.0, 8.0, th.toolbar, bg)
    ops.push(app.draw_rect(x, 0.0, FIND_W, 1.0, mix(th.toolbar, th.sep, 0.5)))
    tx := x + 16.0
    ty := 12.0
    count := find_count(o, k, n)
    sep_x := x + FIND_W - 3.0 * FIND_BTN - 12.0
    cw := run_w(meas, tw, count, 12.0)
    ops.push(app.Op.Clip(x: tx, y: 0.0, w: (sep_x - cw - 24.0 - tx).max(0.0), h: FIND_H))
    if o.text == ""
        ops.push(txt(tx, ty, "Find in page", th.dim, false, 14.0))
    else
        if o.all and o.editing
            ops.push(app.Op.Shade(
                x: tx - 1.0,
                y: 6.0,
                w: run_w(meas, tw, o.text, 14.0) + 2.0,
                h: FIND_H - 12.0,
                color: th.accent,
                alpha: 0.35,
            ))
        ops.push(txt(tx, ty, o.text, th.text, false, 14.0))
    if o.editing and not o.all
        cx := tx + run_w(meas, tw, o.text.slice(0, o.cursor), 14.0)
        ops.push(app.draw_rect(cx, 8.0, 1.5, FIND_H - 16.0, th.text))
    ops.push(app.Op.Unclip)
    if count != ""
        ops.push(txt(
            sep_x - cw - 12.0,
            ty + 1.0,
            count,
            if n == 0 then 0xd93025 else th.dim,
            false,
            12.0,
        ))
    ops.push(line(sep_x, 8.0, sep_x, FIND_H - 8.0, th.sep, 1.0))
    c := if n == 0 then th.dim else th.text
    bx := sep_x + 6.0
    chevron(mut ops, bx + FIND_BTN / 2.0, FIND_H / 2.0, c, true)
    chevron(mut ops, bx + FIND_BTN * 1.5, FIND_H / 2.0, c, false)
    cross(mut ops, bx + FIND_BTN * 2.5, FIND_H / 2.0, th.text)
    ops

## A chevron pointing up (`up`) or down, centred on (cx, cy).
fn chevron(mut ops List[app.Op], cx float, cy float, c int, up bool)
    d := if up then 2.5 else 0.0 - 2.5
    ops.push(line(cx - 5.0, cy + d, cx, cy - d, c, 1.5))
    ops.push(line(cx, cy - d, cx + 5.0, cy + d, c, 1.5))

## What a click at (x, y) on a page `width` wide hits in the find bar:
## `text`, `up`, `down`, `close`, or "" outside it.
pub fn find_hit(x float, y float, width float) str
    x0 := find_x(width)
    if y < 0.0 or y >= FIND_H or x < x0 or x >= x0 + FIND_W
        return ""
    bx := x0 + FIND_W - 3.0 * FIND_BTN - 6.0
    if x < bx
        return "text"
    match ((x - bx) / FIND_BTN).floor().to_int()
        0 => "up"
        1 => "down"
        _ => "close"

SUG_ROW := 36.0
SUG_MAX := 6

## One row of the omnibox's dropdown: a page from the history, or the
## typed text itself (`url` "" for a search).
pub struct Suggestion
    pub title str
    pub url str

## The omnibox dropdown over the page: the typed text first, then the
## history pages that match, `hot_row` highlighted (-1 for none). The page
## canvas starts right under the toolbar, so it hangs from y 0.
pub fn suggest_ops(
    th Theme,
    rows List[Suggestion],
    hot_row int,
    width float,
    agent bool,
    bg int,
    tw fn(str, float) float,
    meas Map[str, float],
) List[app.Op]
    mut ops := List[app.Op]()
    if rows.len() == 0
        return ops
    w := omni_w(width.max(1.0), agent)
    h := rows.len().to_float() * SUG_ROW + 8.0
    ops.push(app.Op.Shade(x: OMNI_X + 2.0, y: 3.0, w: w, h: h, color: 0x000000, alpha: 0.25))
    round(mut ops, OMNI_X, 0.0 - 8.0, w, h + 8.0, 8.0, th.menu, bg)
    for r in 0..rows.len()
        ry := r.to_float() * SUG_ROW
        if r == hot_row
            ops.push(app.draw_rect(OMNI_X, ry, w, SUG_ROW, th.menu_hot))
        s := rows[r]
        if s.url == ""
            ops.push(txt(OMNI_X + 40.0, ry + 10.0, s.title, th.menu_text, false, 14.0))
            ops.push(txt(
                OMNI_X + 40.0 + run_w(meas, tw, s.title, 14.0),
                ry + 10.0,
                " - DuckDuckGo Search",
                th.dim,
                false,
                14.0,
            ))
            spark(mut ops, OMNI_X + 20.0, ry + SUG_ROW / 2.0, th.dim)
        else
            globe(
                mut ops,
                OMNI_X + 12.0,
                ry + 10.0,
                th.dim,
                if r == hot_row then th.menu_hot else th.menu,
            )
            hp := pretty(s.url)
            ops.push(app.Op.Clip(x: OMNI_X + 40.0, y: ry, w: (w - 48.0).max(0.0), h: SUG_ROW))
            lead := lead_of(s)
            ops.push(txt(OMNI_X + 40.0, ry + 10.0, lead, th.menu_text, false, 14.0))
            ops.push(txt(
                OMNI_X + 40.0 + run_w(meas, tw, lead, 14.0),
                ry + 10.0,
                "{hp.0}{hp.1}",
                th.dim,
                false,
                14.0,
            ))
            ops.push(app.Op.Unclip)
    ops

## A history row's first text: its title and a dash, "" without a title.
fn lead_of(s Suggestion) str
    if s.title == "" then "" else "{s.title} - "

## One run of sans text the chrome places other things by.
pub struct Run
    pub text str
    pub size float

## The sans runs whose widths place the caret, the selection, the dim part
## of the address, the dropdown's second texts, the find bar's count and
## the status bubble. Garlic asks the host for the ones it has no width for.
pub fn runs(
    o Omni,
    rows List[Suggestion],
    finding bool,
    find Omni,
    k int,
    n int,
    status str,
) List[Run]
    mut all := List[Run]()
    if o.editing
        all.push(Run(text: o.text, size: 14.0))
        all.push(Run(text: o.text.slice(0, o.cursor), size: 14.0))
    else
        all.push(Run(text: pretty(o.text).0, size: 14.0))
    for s in rows
        all.push(Run(text: if s.url == "" then s.title else lead_of(s), size: 14.0))
    if finding
        all.push(Run(text: find.text, size: 14.0))
        all.push(Run(text: find.text.slice(0, find.cursor), size: 14.0))
        all.push(Run(text: find_count(find, k, n), size: 12.0))
    all.push(Run(text: status, size: 12.0))
    mut out := List[Run]()
    for r in all
        if r.text != ""
            out.push(r)
    out

## Which row of a dropdown of `n` rows a click at (x, y) on the page lands
## on, or -1.
pub fn suggest_hit(x float, y float, n int, width float, agent bool) int
    if n == 0 or x < OMNI_X or x >= OMNI_X + omni_w(width.max(1.0), agent) or y < 0.0
        return -1
    row := (y / SUG_ROW).floor().to_int()
    if row < n then row else -1

## The dropdown's rows for `typed`: the text itself first (a URL, or a
## search), then up to `SUG_MAX` history pages whose address or title
## contains it (case does not matter), newest first; none for empty text.
pub fn suggestions(typed str, history List[Suggestion]) List[Suggestion]
    t := typed.trim()
    mut rows := List[Suggestion]()
    if t == ""
        return rows
    rows.push(Suggestion(title: t, url: ""))
    want := t.to_lower()
    mut seen := Set[str]()
    mut k := history.len()
    while k > 0 and rows.len() <= SUG_MAX
        k -= 1
        h := history[k]
        if seen.contains(h.url)
            continue
        if h.url.to_lower().contains(want) or h.title.to_lower().contains(want)
            seen.add(h.url)
            rows.push(h)
    rows

# ---- Tests -----------------------------------------------------------------------------

@test fn find_bar_clicks_land_on_the_text_the_arrows_and_the_close()
    w := 800.0
    x0 := w - FIND_W - 16.0
    assert_eq(find_hit(x0 + 40.0, 20.0, w), "text")
    assert_eq(find_hit(x0 + FIND_W - 90.0, 20.0, w), "up")
    assert_eq(find_hit(x0 + FIND_W - 58.0, 20.0, w), "down")
    assert_eq(find_hit(x0 + FIND_W - 20.0, 20.0, w), "close")
    assert_eq(find_hit(x0 - 10.0, 20.0, w), "")
    assert_eq(find_hit(x0 + 40.0, 50.0, w), "")
    ops := find_ops(dark(), omni("ale"), 0, 3, w, 0x202124, est, Map[str, float]())
    assert(ops.len() > 10)

@test fn the_dropdown_lists_the_typed_text_then_matching_history_newest_first()
    hist := [
        Suggestion(title: "AIL", url: "https://ail.dev/"),
        Suggestion(title: "Garlic", url: "https://github.com/kksimp/garlic"),
        Suggestion(title: "AIL docs", url: "https://ail.dev/docs"),
    ]
    rows := suggestions("ail", hist)
    assert_eq(rows.len(), 3)
    assert_eq(rows[0], Suggestion(title: "ail", url: ""))
    assert_eq(rows[1].url, "https://ail.dev/docs")
    assert_eq(suggestions("", hist).len(), 0)
    assert_eq(suggest_hit(OMNI_X + 10.0, 40.0, 3, 800.0, false), 1)
    assert_eq(suggest_hit(OMNI_X + 10.0, 200.0, 3, 800.0, false), -1)
    assert_eq(suggest_hit(10.0, 10.0, 3, 800.0, false), -1)
    assert(suggest_ops(dark(), rows, 1, 800.0, false, 0x202124, est, Map[str, float]()).len() > 6)

@test fn clicks_land_on_the_tab_its_x_the_plus_and_the_toolbar()
    w := 800.0
    x0 := tab_x(1, 3, w, 0.0)
    assert_eq(hit(x0 + 30.0, 20.0, 3, w, 0.0, false, false), Hit(kind: "tab", k: 1))
    assert_eq(
        hit(x0 + tab_w(3, w, 0.0) - 14.0, 20.0, 3, w, 0.0, false, false),
        Hit(kind: "close", k: 1),
    )
    assert_eq(hit(tab_x(3, 3, w, 0.0) + 10.0, 20.0, 3, w, 0.0, false, false).kind, "plus")
    assert_eq(hit(2.0, 20.0, 3, w, 0.0, false, false).kind, "none")
    assert_eq(hit(20.0, 66.0, 3, w, 0.0, false, false).kind, "back")
    assert_eq(hit(56.0, 66.0, 3, w, 0.0, false, false).kind, "forward")
    assert_eq(hit(92.0, 66.0, 3, w, 0.0, false, false).kind, "reload")
    assert_eq(hit(300.0, 66.0, 3, w, 0.0, false, false).kind, "omni")
    assert_eq(hit(w - 20.0, 66.0, 3, w, 0.0, false, false).kind, "menu")
    assert_eq(hit(w - 20.0, H + 20.0, 3, w, 0.0, false, true).kind, "allow")
    assert_eq(hit(w - 120.0, H + 20.0, 3, w, 0.0, false, true).kind, "deny")
    assert_eq(hit(w - 20.0, H + 20.0, 3, w, 0.0, false, false).kind, "none")

@test fn many_tabs_shrink_to_fit_the_strip()
    assert(tab_w(20, 800.0, 0.0) < tab_w(3, 800.0, 0.0))
    assert_eq(tab_w(1, 1200.0, 0.0), MAX_TAB_W)
    assert_eq(tab_w(40, 800.0, 0.0), MIN_TAB_W)
    assert_eq(tab_x(0, 1, 800.0, 78.0), LEFT + 78.0)
    assert_eq(hit(40.0, 20.0, 1, 800.0, 78.0, false, false).kind, "none")

@test fn the_omnibox_edits_like_a_text_field()
    mut o := omni("example.com")
    o.start()
    assert(o.all)
    assert_eq(o.key("a", false, false), "")
    assert_eq(o.text, "a")
    o.key("b", false, false)
    o.key("left", false, false)
    o.key("x", false, false)
    assert_eq((o.text, o.cursor), ("axb", 2))
    o.key("backspace", false, false)
    assert_eq(o.text, "ab")
    o.key("a", true, false)
    o.key("delete", false, false)
    assert_eq(o.text, "")
    o.insert("ail.dev")
    assert_eq(o.key("enter", false, false), "open")
    assert(not o.editing)
    o.start()
    assert_eq(o.key("escape", false, false), "cancel")

@test fn the_address_shows_without_the_scheme_and_with_its_path_apart()
    assert_eq(pretty("https://example.com/a/b?c"), ("example.com", "/a/b?c"))
    assert_eq(pretty("http://localhost:8080"), ("http://localhost:8080", ""))
    assert_eq(pretty("https://ail.dev"), ("ail.dev", ""))

@test fn the_menu_takes_clicks_on_its_rows()
    assert_eq(menu_hit(110.0, 10.0 + MENU_PAD + ROW_H + 3.0, 3, 100.0, 10.0), 1)
    assert_eq(menu_hit(500.0, 20.0, 3, 100.0, 10.0), -1)
    assert_eq(menu_hit(110.0, 10.0 + MENU_PAD + 3.0 * ROW_H + 1.0, 3, 100.0, 10.0), -1)

@test fn the_chrome_draws_without_a_host()
    th := dark()
    st := State(
        omni: omni("https://example.com/x"),
        can_back: true,
        can_forward: false,
        hover_x: 0.0 - 1.0,
        hover_y: 0.0 - 1.0,
        agent: "",
        ask: "",
        width: 800.0,
        inset_left: 0.0,
    )
    ops := draw(
        th,
        [Item(
            title: "Example",
            url: "https://example.com/x",
            icon: "",
            icon_w: 0,
            icon_h: 0,
            icon_data: "",
            loading: false,
        )],
        0,
        st,
        est,
        Map[str, float](),
    )
    assert(ops.len() > 40)
    assert(status_ops(th, "", 600.0, 0xffffff, est, Map[str, float]()).len() == 0)
    assert(status_ops(th, "https://a.b", 600.0, 0xffffff, est, Map[str, float]()).len() > 2)

@test fn measured_widths_win_over_the_estimate_and_place_the_dim_path()
    mut st := State(
        omni: omni("https://example.com/x"),
        can_back: false,
        can_forward: false,
        hover_x: 0.0 - 1.0,
        hover_y: 0.0 - 1.0,
        agent: "",
        ask: "",
        width: 800.0,
        inset_left: 0.0,
    )
    mut meas := Map[str, float]()
    meas[width_key("example.com", 14.0)] = 100.0
    mut path_x := 0.0
    for op in draw(dark(), [], 0, st, est, meas)
        match op
            Str(x, _, text, _, _, _, _, _, _) => if text == "/x"
                path_x = x
            _ => path_x = path_x
    assert_eq(path_x, OMNI_X + 40.0 + 100.0)
    assert_eq(
        runs(st.omni, [], false, omni(""), 0, 0, "https://a.b"),
        [Run(text: "example.com", size: 14.0), Run(text: "https://a.b", size: 12.0)],
    )
    ## While typing, the caret stays inside the field however long the text is.
    mut big := "a"
    for _ in 0..9
        big = "{big}{big}"
    st.omni = omni(big)
    st.omni.editing = true
    mut caret_x := 0.0
    for op in draw(dark(), [], 0, st, est, Map[str, float]())
        match op
            Fill(x, _, w, _, _) => if w == 1.5
                caret_x = x
            _ => caret_x = caret_x
    assert(caret_x > OMNI_X and caret_x < OMNI_X + omni_w(800.0, false))

@test fn narrow_tabs_show_no_title_and_only_the_shown_one_closes()
    assert(tiny(30, 800.0, 0.0))
    assert(not tiny(3, 800.0, 0.0))
    w := tab_w(30, 800.0, 0.0)
    x0 := tab_x(4, 30, 800.0, 0.0)
    assert_eq(hit(x0 + w - 12.0, 20.0, 30, 800.0, 0.0, false, false), Hit(kind: "tab", k: 4))
    ## The new-tab button stays inside the strip however many tabs there are.
    assert_eq(hit(800.0 - 20.0, 20.0, 60, 800.0, 0.0, false, false).kind, "plus")

## A text width for the tests: a little over half the size per character.
fn est(s str, size float) float
    s.chars().len().to_float() * size * 0.55
